{
  "id": "6ab0d204b9fd3cfec77c9e4b",
  "title": "生きていけない体",
  "created": 1789972999,
  "updated": 1789973425,
  "lines": [
    {
      "id": "6ab0d204b9fd3cfec77c9e4b",
      "text": "生きていけない体",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789972999,
      "updated": 1789972999
    },
    {
      "id": "6ab0d24100000000007f787d",
      "text": "[生存戦略]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789973058,
      "updated": 1789973058
    },
    {
      "id": "6ab0d25f00000000007f7881",
      "text": "[この先生きのこるには]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789973087,
      "updated": 1789973098
    },
    {
      "id": "6ab0d24400000000007f787e",
      "text": "[必須栄養素]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789973061,
      "updated": 1789973067
    },
    {
      "id": "6ab0d25300000000007f7880",
      "text": "[難病]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789973076,
      "updated": 1789973080
    },
    {
      "id": "6ab0d27400000000007f7882",
      "text": "[余命宣告者]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789973109,
      "updated": 1789973114
    },
    {
      "id": "6ab0d27a00000000007f7883",
      "text": "[余命]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789973115,
      "updated": 1789973118
    },
    {
      "id": "6ab0d29200000000007f7885",
      "text": "[誤った思い込み]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789973139,
      "updated": 1789973148
    },
    {
      "id": "6ab0d24500000000007f787f",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789973061,
      "updated": 1789973061
    },
    {
      "id": "6ab0d20600000000007f7870",
      "text": "[知的生産しないと生きていけない]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789972999,
      "updated": 1789973007
    },
    {
      "id": "6ab0d20f00000000007f7872",
      "text": "[コーヒーがないと生きていけないタイプの人類]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789973008,
      "updated": 1789973013
    },
    {
      "id": "6ab0d20c00000000007f7871",
      "text": "[生きとるやないかい！]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789973005,
      "updated": 1789973020
    },
    {
      "id": "6ab0d21900000000007f7873",
      "text": "[生きる道]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789973018,
      "updated": 1789973027
    },
    {
      "id": "6ab0d22100000000007f7874",
      "text": "[生きる意味]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789973026,
      "updated": 1789973032
    },
    {
      "id": "6ab0d22500000000007f7875",
      "text": "[生きてる意味]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789973030,
      "updated": 1789973038
    },
    {
      "id": "6ab0d23600000000007f7877",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789973047,
      "updated": 1789973047
    },
    {
      "id": "6ab0d3a900000000003959fe",
      "text": "[ベンダーロックイン]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1789973417,
      "updated": 1789973425
    },
    {
      "id": "6ab0d3aa00000000003959ff",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1789973419,
      "updated": 1789973419
    }
  ]
}