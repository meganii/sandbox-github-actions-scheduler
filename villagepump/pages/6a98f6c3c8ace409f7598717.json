    {
      "id": "6a98f90a0000000000e8ffd5",
      "text": "",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1788410122,
      "updated": 1788411284
    },
    {
      "id": "6a98fe5c0000000000e9007c",
      "text": "[ダークテーマ対応済みのアイコンの一覧（井戸端用）] への依存関係を切っておく",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1788411484,
      "updated": 1788411484
