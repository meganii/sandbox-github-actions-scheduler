      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786697874,
      "updated": 1786702799
    },
    {
      "id": "6a7eebc10000000000474e7b",
      "text": " 　この茶色を見ていたら気持ち悪くなったのでいつもの寒色系に戻した",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786702787,
      "updated": 1786710228
    },
    {
