  "lines": [
    {
      "id": "6a9646ec9b9e79f88e6190c2",
      "text": "井戸端王",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1788233455,
      "updated": 1788233455
    },
    {
      "id": "6b0145190000000000dfce17",
      "text": "[bg.icon]",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795245337,
      "updated": 1795245338
    },
    {
      "id": "6b01446a0000000000dfce11",
      "text": "[** 当初の文脈]",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795245163,
      "updated": 1795245347
    },
    {
      "id": "6b0144790000000000dfce15",
      "text": " [2026/08/31#6a9543750000000000f8dbb3]",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795245178,
      "updated": 1795245211
    },
    {
      "id": "6b0144740000000000dfce13",
      "text": "　> [hiro.icon]一見するとハチャメチャでバカなことをやっているように見えて、あれよあれよという間に場の中心になってしまうような人っているでしょ",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795245173,
      "updated": 1795245174
    },
    {
      "id": "6b0144750000000000dfce14",
      "text": " >  私なんかすでに「[井戸端王]」と言っていいくらいだし",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795245174,
      "updated": 1795245174
    },
    {
      "id": "6b01446b0000000000dfce12",
      "text": "",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795245163,
      "updated": 1795245163
    },
    {
      "id": "6b0148a60000000000dfce2a",
      "text": "“井戸端王”",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795246247,
      "updated": 1795246258
    },
    {
      "id": "6a9646ee000000000055bed3",
      "text": "とは一体……[zatsma.icon]",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1788233455,
      "updated": 1788233464
    },
    {
      "id": "6a98ba49000000000073ae0f",
      "text": " 誰でも名乗れる[KNo.804C.icon]",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1788394057,
      "updated": 1788394063
    },
    {
      "id": "6a98ba66000000000073ae10",
      "text": "  王は一人に非ず",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1788394087,
      "updated": 1788394094
    },
    {
      "id": "6b0146e50000000000dfce24",
      "text": "  井戸端王は玉座に腰掛けているため、あちこちのトピックやツリーに全くと言ってよいほど顔を出さないのだとか",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795245797,
      "updated": 1795245812
    },
    {
      "id": "6b0146ea0000000000dfce25",
      "text": "   行動範囲を狭めている",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795245803,
      "updated": 1795245803
    },
    {
      "id": "6b0146ea0000000000dfce26",
      "text": "   制約と誓約",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795245803,
      "updated": 1795245803
    },
    {
      "id": "6b0147270000000000dfce28",
      "text": "   呪縛",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795245863,
      "updated": 1795245866
    },
    {
      "id": "6a9646f0000000000055bed4",
      "text": "",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1788233457,
      "updated": 1788233457
    },
    {
      "id": "6a9647130000000000b19240",
      "text": "いーや、Adminこそ王だね",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1788233493,
      "updated": 1788233508
    },
    {
      "id": "6a968e980000000000d2e99e",
      "text": "\tAdminが 王なら Owner は何なのか[Summer498.icon]",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1788251800,
      "updated": 1788251835
    },
    {
      "id": "6a968ee80000000000c420e6",
      "text": "\t スパルタみたいに[王が複数いる]のかも[caki.icon]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788251880,
      "updated": 1788360094
    },
    {
      "id": "6b0145490000000000dfce19",
      "text": "",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795245385,
      "updated": 1795245793
    },
    {
      "id": "6b0144c30000000000dfce16",
      "text": "[bg.icon]",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795245252,
      "updated": 1795245385
    },
    {
      "id": "6b0146010000000000dfce20",
      "text": "[** ここから一般解に関するやり取り]",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795245569,
      "updated": 1795247078
    },
    {
      "id": "6b0146220000000000dfce22",
      "text": " のはず[KNo.804C.icon]",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795245603,
      "updated": 1795245605
    },
    {
      "id": "6b0146300000000000dfce23",
      "text": "  各位、認識齟齬があったら適宜修正をしてくださいませ",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795245616,
      "updated": 1795245638
    },
    {
      "id": "6b0146070000000000dfce21",
      "text": "",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795245576,
      "updated": 1795245576
    },
    {
      "id": "6a964b5f0000000000193763",
      "text": "[自分のアイコンに飾りをつけるUserCSS]をアレンジして👑をつけるといい感じになりそう[caki.icon]",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1788234592,
      "updated": 1795245569
    },
    {
      "id": "6a964b650000000000193764",
      "text": "",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1788234597,
      "updated": 1788234597
    },
    {
      "id": "6a96500000000000005cd107",
      "text": " 井戸端帝（皇帝）",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1788235777,
      "updated": 1788236048
    },
    {
      "id": "6a96503800000000005cd10b",
      "text": "  井戸端王を統べる者[KNo.804C.icon]",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1788235833,
      "updated": 1788236187
    },
    {
      "id": "6a9834af0000000000874bc4",
      "text": "  Admin→帝(みかど)、Owner→王とすると響きがちょっと近い[yosider.icon]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788359853,
      "updated": 1788359899
    },
    {
      "id": "6a9835370000000000874bc5",
      "text": "   でもadminのほうが強そうに聞こえてしまう",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788359989,
      "updated": 1788360013
    },
    {
      "id": "6b0142f20000000000ea48b4",
      "text": "  adminが井戸端帝に+1[KNo.804C.icon]",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795244787,
      "updated": 1795244812
    },
    {
      "id": "6a96501200000000005cd10a",
      "text": " 井戸端神",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1788235796,
      "updated": 1788235858
    },
    {
      "id": "6a96513300000000005cd10e",
      "text": "  井戸端を創造せし者[KNo.804C.icon]",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1788236084,
      "updated": 1788236265
    },
    {
      "id": "6a968ee60000000000d2e9a0",
      "text": "  owner これだわ[Summer498.icon]",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1788251878,
      "updated": 1788251885
    },
    {
      "id": "6b01430f0000000000ea48b5",
      "text": "   +1[KNo.804C.icon]",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795244815,
      "updated": 1795244823
    },
    {
      "id": "6a96500100000000005cd108",
      "text": "",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1788235778,
      "updated": 1788235778
    },
    {
      "id": "6a9655f80000000000c4c39f",
      "text": "王は「おう」と呼ばず「キング」と呼びたいが、イドバタキング、は語感が微妙[Hiro Aki.icon]",
      "userId": "65e1289acd012200235729c0",
      "created": 1788237304,
      "updated": 1788237329
    },
    {
      "id": "6a9656100000000000c4c3a1",
      "text": "\t省略してバタキング？しっくりこない",
      "userId": "65e1289acd012200235729c0",
      "created": 1788237329,
      "updated": 1788237349
    },
    {
      "id": "6a9656390000000000c4c3a2",
      "text": "\t省く場所を調整、イドバタだからドバキング？スカイリムの匂いがしてくるから何か違う",
      "userId": "65e1289acd012200235729c0",
      "created": 1788237370,
      "updated": 1788237415
    },
    {
      "id": "6a96597e000000000016ff45",
      "text": "\tバタキン？[h45te.icon]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788238207,
      "updated": 1788238221
    },
    {
      "id": "6a96598e000000000016ff46",
      "text": "\t これだとバターの王になってしまうか？",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788238222,
      "updated": 1788238239
    },
    {
      "id": "6a966d02000000000076ce6a",
      "text": "\t「海賊王」みたいな雰囲気があって井戸端王もわりとすき[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1788243202,
      "updated": 1788243217
    },
    {
      "id": "6a96aa580000000000fe11f7",
      "text": "\tイドバタキングダムはちょっとリズムが良い",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1788258905,
      "updated": 1788258940
    },
    {
      "id": "6a96abeb0000000000fe11fb",
      "text": "\t6文字なら気持ち良いかもしれない",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1788259308,
      "updated": 1788259318
    },
    {
      "id": "6a96abf50000000000fe11fc",
      "text": "\t ドバタキング",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1788259318,
      "updated": 1788259323
    },
    {
      "id": "6a965a04000000000016ff48",
      "text": "",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788238341,
      "updated": 1788238343
    },
    {
      "id": "6a96599f000000000016ff47",
      "text": "井戸端王→井戸の帝王→well lord→ウェルロード[h45te.icon]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788238239,
      "updated": 1788238347
    },
    {
      "id": "6a965a0c000000000016ff49",
      "text": " もうコウテイ[イドバタニシ]でいいんじゃないですかね",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788238349,
      "updated": 1788238392
    },
    {
      "id": "6a9655f90000000000c4c3a0",
      "text": "[キングタニシ]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1788237306,
      "updated": 1788363424
    },
    {
      "id": "6a968ed70000000000d2e99f",
      "text": "コウテイタニシ",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1788251863,
      "updated": 1788251867
    },
    {
      "id": "6a968fd0000000000028a5d0",
      "text": "[タニシガチャ]で出てくるやつだ[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1788252112,
      "updated": 1788260683
    },
    {
      "id": "6a9690860000000000e735a2",
      "text": "\tハズレ枠には[ジャンボタニシ]かな？[Hiro Aki.icon]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788252295,
      "updated": 1788360078
    },
    {
      "id": "6a96abbb0000000000fe11fa",
      "text": "他にも仲間が居るかもしれない",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1788259260,
      "updated": 1788259270
    },
    {
      "id": "6a9671810000000000ab2556",
      "text": " [タニシナイト]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1788244354,
      "updated": 1788364230
    },
    {
      "id": "6a96aa960000000000fe11f9",
      "text": " [ホイミタニシ]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1788258968,
      "updated": 1788363434
    },
    {
      "id": "6a96aa920000000000fe11f8",
      "text": "",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1788258963,
      "updated": 1788258963
    },
    {
      "id": "6a9835f40000000000874bc6",
      "text": "現実世界なら井戸端会議を取り仕切る一番声がデカいおばちゃんかな[yosider.icon]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788360178,
      "updated": 1788360219
    },
    {
      "id": "6a985b090000000000cccd81",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788369673,
      "updated": 1788369673
    },
    {
      "id": "6a985b4e0000000000cccd84",
      "text": "イフィ「井戸端王に、おれはなる！」（ドン！）[Nrem.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788369742,
      "updated": 1795238889
    },
    {
      "id": "6a985a950000000000cccd80",
      "text": "井戸端王ゴールド・タニシ (51)「おれの財宝か？　欲しけりゃくれてやる。（[タニシガチャ]を）回せ！　井戸端のすべてをそこに置いてきた！」",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788369557,
      "updated": 1795238895
    },
    {
      "id": "6a985e3f0000000000cccd86",
      "text": "　何を置いてきたんだろう。お洗濯物かな…",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788370495,
      "updated": 1788370678
    },
    {
      "id": "6b0133060000000000a5b180",
      "text": "　お洗濯物が井戸端のすべてだったのか～[takker.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795240711,
      "updated": 1795240728
    },
    {
      "id": "6b015bac00000000003f41f0",
      "text": "　捕まった時にちょうど井戸端の辺りに干されていたお洗濯もの説",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1795251178,
      "updated": 1795251189
    },
    {
      "id": "6a985c520000000000cccd85",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788370001,
      "updated": 1788370015
    },
    {
      "id": "6a985b130000000000cccd82",
      "text": "[井戸端王#6b0146e50000000000dfce24][KNo.804C.icon][{ 自分のコメントだけ上部に移しました]",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1788369683,
      "updated": 1795245831
    },
    {
      "id": "6b01092c0000000000ea52a7",
      "text": " エコノミー症候群になりそう[takker.icon]",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795229999,
      "updated": 1795245459
    },
    {
      "id": "6b0108ec0000000000ea52a6",
      "text": "",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1795229933,
      "updated": 1795229933
    },
    {
      "id": "6b0135e80000000000709319",
      "text": "王に似た概念として、[チャンピオン]（champion）がある　[suto3.icon]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795241448,
      "updated": 1795241539
    },
    {
      "id": "6b0135e8000000000070931a",
      "text": "　[Scrapbox Champion] / [Cosense Champion]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795241449,
      "updated": 1795241604
    },
    {
