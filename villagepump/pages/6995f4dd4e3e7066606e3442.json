  "lines": [
    {
      "id": "6996087700000000004defcb",
      "text": "Esperanto",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1771440248,
      "updated": 1771440250
    },
    {
      "id": "6995f4dd4e3e7066606e3442",
      "text": "[エスペラント語]/[エスペラント]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1771435234,
      "updated": 1771440255
    },
    {
      "id": "6995f4e400000000004ff82e",
      "text": "[国際補助語]の一つ。[計画言語]のうち、[人工言語]としては史上最大の話者人口を持つ",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1771435236,
      "updated": 1771440770
    },
    {
      "id": "6ab88a970000000000d61dde",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1790479000,
      "updated": 1790479000
    },
    {
      "id": "6995f4f900000000004ff82f",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1771435258,
      "updated": 1771435258
    },
    {
      "id": "6ab887fd0000000000d61dd7",
      "text": "言語名であるにもかかわらず、ブランド名や作品名によく使われる。",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1790478334,
      "updated": 1790479816
    },
    {
      "id": "6ab88dc70000000000d61dea",
      "text": "例：",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1790479816,
      "updated": 1790479816
    },
    {
      "id": "6ab888790000000000d61dda",
      "text": "　坂本龍一のピアノ曲「エスペラント」",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1790478458,
      "updated": 1790478477
    },
    {
      "id": "6ab888290000000000d61dd9",
      "text": " Esperanto Magazine – 日本発、全編英語で書かれた英語話者のための雑誌",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1790478378,
      "updated": 1790479470
    },
    {
      "id": "6ab88c5a0000000000d61de0",
      "text": " 　雑誌の内容と雑誌編集部のコスモポリタニズム思想ともにエスペラント語とは特に接点がない",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1790479451,
      "updated": 1790479523
    },
    {
      "id": "6ab889ae0000000000d61ddc",
      "text": " 　エスペラント語の創案者ザメンホフの意図をありふれた偏見と曲解をもとに援用し、明示的に言語帝国主義（英語帝国主義）の理念を掲げていたためバッシングを受け、後に「ESP Magazine」に改名（第二号で休刊）",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1790478767,
      "updated": 1790479349
    },
    {
      "id": "6ab88d480000000000d61de9",
      "text": "「韓国語」と題されたピアノ曲や、「Japanese」という名前の化粧品ブランド、『日本語マガジン』と題されたアッシリア語話者のための全編アッシリア語の雑誌（日本に関するテーマは特に出てこない）等を思い浮かべてみればその奇怪さが分かるだろう",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1790479689,
      "updated": 1790479894
    },
    {
      "id": "6ab88d1e0000000000d61de3",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1790479647,
      "updated": 1790479647
    }
  ]
}