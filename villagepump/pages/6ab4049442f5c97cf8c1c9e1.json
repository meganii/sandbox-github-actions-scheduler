      "created": 1790220733,
      "updated": 1790220737
    },
    {
      "id": "6ab499f800000000003d0858",
      "text": "  部屋の空気が湿っている",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1790220794,
      "updated": 1790220820
    },
    {
      "id": "6ab4a3cb00000000000292d0",
      "text": " gyazoさん恋しい",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1790223307,
      "updated": 1790223316
    },
    {
      "id": "6ab499be00000000003d0857",
