  "lines": [
    {
      "id": "69d3b5b439a3f284e460fe0a",
      "text": "●●するための●●がない",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1775482294,
      "updated": 1775482294
    },
    {
      "id": "69d3b5b500000000000943a1",
      "text": "[服を買いに行く服がない]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1775482294,
      "updated": 1775482295
    },
    {
      "id": "69d3b5b600000000000943a2",
      "text": "[体力を維持する体力がない]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1775482295,
      "updated": 1775482295
    },
    {
      "id": "69d3b5b600000000000943a3",
      "text": "[体力をつけるための体力がない]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1775482295,
      "updated": 1775482295
    },
    {
      "id": "69d3b5b600000000000943a4",
      "text": "[知識を得るための知識がない]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1775482295,
      "updated": 1775482295
    },
    {
      "id": "69d3b5b700000000000943a5",
      "text": "[うんこするためのうんこがない]",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1775482296,
      "updated": 1778493677
    },
    {
      "id": "69d3bd650000000000484dbf",
      "text": "\t[うんこがない]にも関わらず、[うんこしないといけない]状況がどういう状況かわからないけど、一応腸内が空っぽの状態にも関わらず[うんこしなくてはいけない]状況なら、[うんこするためのうんこがない]は成立する。[Summer498.icon]",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1775484262,
      "updated": 1778493767
    },
    {
      "id": "69d3bde50000000000484dc1",
      "text": " \tトイレは今のうちに行っといて下さいねー！の時か",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1775484389,
      "updated": 1778493769
    },
    {
      "id": "6a890b140000000000647d14",
      "text": "  大腸カメラ前に大量の下剤を飲んでる状態を連想[taktamur.icon]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1787366162,
      "updated": 1787366211
