    {
      "id": "5fa5c7784daa920000e77b91",
      "text": "[Wikipedia][_ ではない]",
      "userId": "5bc5772df30ff700134daa92",
      "created": 1604700025,
      "updated": 1604700031
    },
    {
      "id": "661d198b71b3c20000ec6c40",
      "text": "みんな勘違いしてるけどWikipediaをWiKiって略す人が悪い",
      "userId": "661b6e882a96e9002371b3c2",
      "created": 1713183108,
      "updated": 1713183125
    },
    {
      "id": "6a788b8f00000000008a0bc5",
      "text": "",
