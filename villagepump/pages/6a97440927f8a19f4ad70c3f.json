    {
      "id": "6a974409000000000071d725",
      "text": "2026-09-02-06:30:48[おは.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788298249,
      "updated": 1788300119
    },
    {
      "id": "6a974b570000000000831c16",
      "text": "　7:02[Nrem.icon][おは.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788300119,
      "updated": 1788300149
    },
    {
      "id": "6a974b780000000000831c17",
      "text": "　　事後報告ですが、[UserScript: スニペット候補系.icon]を作成しました",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788300152,
      "updated": 1788300196
    },
    {
      "id": "6a974b9a0000000000831c18",
      "text": "　　作ってから気づきましたが、該当UserScriptが意外と少ない…",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788300186,
      "updated": 1788300274
    },
    {
      "id": "6a97ab5900000000008e1e0f",
      "text": "　　[suto3.icon][おつかれさまでした.icon]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788324698,
      "updated": 1788324728
    },
    {
      "id": "6a97abd000000000008e1e10",
      "text": "　　　あと作りたいのが、UserCSSとUserScriptの合わせ技みたいなやつ",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788324816,
      "updated": 1788324945
    },
    {
      "id": "6a97ac2200000000008e1e11",
      "text": "　　　典型的な使い方としては、",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788324898,
      "updated": 1788324937
    },
    {
      "id": "6a97ac5a00000000008e1e12",
      "text": "　　　 UserCSSで[CSSカスタムプロパティ]（[CSS変数]）を用意して",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788324955,
      "updated": 1788325378
    },
    {
      "id": "6a97ad9500000000008e1e13",
      "text": "　　　 UserScriptでCSS変数を操作する（値を変更する）",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788325270,
      "updated": 1788325422
    },
    {
      "id": "6a97adc400000000008e1e14",
      "text": "　　　といった使い方",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788325317,
      "updated": 1788325330
    },
    {
      "id": "6a974409000000000071d726",
