      "text": "",
      "userId": "63042e42f2ab90001d68385a",
      "created": 1787832926,
      "updated": 1787832926
    },
    {
      "id": "69dcf6e80000000000c8ca37",
      "text": "[更新行をスクロールバーに表示、を非表示にする]",
      "userId": "63042e42f2ab90001d68385a",
      "created": 1776088809,
      "updated": 1776088809
    },
    {
      "id": "69dcf6e80000000000c8ca38",
      "text": " code:style.css",
      "userId": "63042e42f2ab90001d68385a",
      "created": 1776088809,
      "updated": 1776088819
    },
    {
      "id": "69dcf6e80000000000c8ca39",
      "text": "  .scroll-bar-overlay {",
      "userId": "63042e42f2ab90001d68385a",
      "created": 1776088809,
      "updated": 1776088813
    },
    {
      "id": "69dcf6e80000000000c8ca3a",
      "text": "      display: none;",
      "userId": "63042e42f2ab90001d68385a",
      "created": 1776088809,
      "updated": 1776088813
    },
    {
      "id": "69dcf6e80000000000c8ca3b",
      "text": "  }",
      "userId": "63042e42f2ab90001d68385a",
      "created": 1776088809,
      "updated": 1776088813
    },
    {
      "id": "698fdc3e0000000000f5dfad",
      "text": "スマホから見れないようにする",
      "userId": "63042e42f2ab90001d68385a",
      "created": 1771035711,
      "updated": 1780751106
    },
    {
      "id": "6a241afd0000000000bf7637",
      "text": " code:style.css",
      "userId": "63042e42f2ab90001d68385a",
      "created": 1780751102,
      "updated": 1780751102
    },
    {
      "id": "6a241afd0000000000bf7638",
      "text": "  @media (pointer: coarse) {",
      "userId": "63042e42f2ab90001d68385a",
      "created": 1780751102,
      "updated": 1780751102
    },
    {
      "id": "6a241afd0000000000bf7639",
      "text": "  \t\t.container {",
      "userId": "63042e42f2ab90001d68385a",
      "created": 1780751102,
      "updated": 1780751102
    },
    {
      "id": "6a241afd0000000000bf763a",
