  "lines": [
    {
      "id": "643b60ef841cae001c529093",
      "text": "小人さん活動の報酬",
      "userId": "60508ed36a7abc00235e90c0",
      "created": 1681613046,
      "updated": 1681613061
    },
    {
      "id": "643b60f85e90c000002ae045",
      "text": " [小人さん活動]にはいかなる報酬があるか？",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1681613048,
      "updated": 1745485198
    },
    {
      "id": "643b60f95e90c000002ae046",
      "text": "  It's my pleasure的なとこがある",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1681613049,
      "updated": 1681637617
    },
    {
      "id": "643b61315e90c000002ae049",
      "text": "  他人に報酬を求めているというかはただ単にリンクがつながるのがおもしろい",
      "userId": "60508ed36a7abc00235e90c0",
      "created": 1681613105,
      "updated": 1681613129
    },
    {
      "id": "643bc282e5172d0000394fd2",
      "text": "  [内発的動機づけ]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1681638019,
      "updated": 1681638023
    },
    {
      "id": "643b610d5e90c000002ae047",
      "text": "  掃除した時の達成感のようなもの",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1681613069,
      "updated": 1785887769
    },
    {
      "id": "6a727d0400000000004b368f",
      "text": "  ハロウィンの仮装がうまくいった時の感覚ではなく、その後のお片付けで街並みがきれいになった時の感覚",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1785888006,
      "updated": 1785888501
    },
    {
      "id": "6a72f81f00000000005a59af",
      "text": "  [道のメタファー]で言うと[近道]や迂回路を見つけた時の感覚",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1785919519,
      "updated": 1785919644
    },
