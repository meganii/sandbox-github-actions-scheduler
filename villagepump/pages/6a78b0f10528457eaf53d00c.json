      "updated": 1786295225
    },
    {
      "id": "6a78b3890000000000c78550",
      "text": " よく見たら文字の形が放つ雰囲気も",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786295178,
      "updated": 1786295178
    },
    {
      "id": "6a78b0f10000000000802321",
      "text": "  手描きしたのが仇となったか",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786294514,
      "updated": 1786294536
    },
    {
      "id": "6a78b0f10000000000802322",
      "text": " [うんこ]と読んでください",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786294514,
      "updated": 1786294514
    },
    {
      "id": "6a78b0f10000000000802323",
      "text": " うんこと呼んでください",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786294514,
      "updated": 1786294514
    },
    {
      "id": "6a78b0f10000000000802324",
      "text": " 意図的だと思っていた[caki.icon][Nrem.icon][zatsma.icon][yosider.icon]",
