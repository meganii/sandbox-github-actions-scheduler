  "lines": [
    {
      "id": "6a9f94f46d4c988e33c7e610",
      "text": "ホロスターズ 運営体制の変更",
      "userId": "660605441655f300254ac7c2",
      "created": 1788843261,
      "updated": 1788843271
    },
    {
      "id": "6a9f970a0000000000a16d57",
      "text": "[2026/04/03]",
      "userId": "660605441655f300254ac7c2",
      "created": 1788843786,
      "updated": 1788843829
    },
    {
      "id": "6a9f954f00000000001f3671",
      "text": " 個人活動を主軸とした活動方針に変更",
      "userId": "660605441655f300254ac7c2",
      "created": 1788843351,
      "updated": 1788843354
    },
    {
      "id": "6a9f950700000000001f366a",
      "text": " 一部のサポートを制限・終了",
      "userId": "660605441655f300254ac7c2",
      "created": 1788843272,
      "updated": 1788843355
    },
    {
      "id": "6a9f951f00000000001f366b",
      "text": "  会社主導による各種施策",
      "userId": "660605441655f300254ac7c2",
      "created": 1788843295,
      "updated": 1788843359
    },
    {
      "id": "6a9f953000000000001f366c",
      "text": "  自社スタジオを利用したタレント配信",
      "userId": "660605441655f300254ac7c2",
      "created": 1788843312,
      "updated": 1788843359
    },
    {
      "id": "6a9f953000000000001f366d",
      "text": "  記念日をはじめとした各種グッズの新規発売",
      "userId": "660605441655f300254ac7c2",
      "created": 1788843312,
      "updated": 1788843359
    },
    {
      "id": "6a9f953000000000001f366e",
      "text": "  オリジナル楽曲制作、リリース",
      "userId": "660605441655f300254ac7c2",
      "created": 1788843312,
      "updated": 1788843359
    },
    {
      "id": "6a9f953b00000000001f366f",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1788843323,
      "updated": 1788843323
    },
    {
      "id": "6a9f953b00000000001f3670",
      "text": "卒業タレント・活動継続タレント",
      "userId": "660605441655f300254ac7c2",
      "created": 1788843323,
      "updated": 1788843409
    },
    {
      "id": "6a9f959100000000001f3673",
      "text": " [花咲みやび]",
      "userId": "660605441655f300254ac7c2",
      "created": 1788843409,
      "updated": 1788843522
    },
    {
      "id": "6a9f959600000000001f3674",
      "text": " [岸堂天真]",
