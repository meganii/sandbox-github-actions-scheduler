{
  "id": "6b0045a1d9e954979f83f524",
  "title": "批判厳禁",
  "created": 1795179940,
  "updated": 1795181477,
  "lines": [
    {
      "id": "6b0045a1d9e954979f83f524",
      "text": "批判厳禁",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795179940,
      "updated": 1795179940
    },
    {
      "id": "6b0045a300000000008fcdca",
      "text": "　ブレインストーミングの4原則のひとつ",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795179940,
      "updated": 1795180013
    },
    {
      "id": "6b0045cb00000000008fcdcb",
      "text": "　他人のアイデアを否定しない",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795179980,
      "updated": 1795180015
    },
    {
      "id": "6b0045e900000000008fcdcc",
      "text": "　他人の意見に対して 批判的なコメントが出ると、参加者は積極的に意見を言おうとしなくなる",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795180009,
      "updated": 1795180062
    },
    {
      "id": "6b00461b00000000008fcdcd",
      "text": "　　批判するとアイデアの総量が減る",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795180060,
      "updated": 1795180065
    },
    {
      "id": "6b00461b00000000008fcdce",
      "text": "　批判をするより、もっと良いアイデアを考える",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795180060,
      "updated": 1795180071
    },
    {
      "id": "6b00461b00000000008fcdcf",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795180060,
      "updated": 1795180060
    },
    {
      "id": "6b00462800000000008fcdd0",
      "text": "　批判禁止",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795180073,
      "updated": 1795181477
    },
    {
      "id": "6b00464e00000000008fcdd1",
      "text": "　[評価懸念]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795180111,
      "updated": 1795180203
    },
    {
      "id": "6b00466600000000008fcdd2",
      "text": " 雰囲気作り",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795180134,
      "updated": 1795180194
    },
    {
      "id": "6b00469b00000000008fcdd3",
      "text": " [心理的安全性]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795180188,
      "updated": 1795180188
    },
    {
      "id": "6b00469b00000000008fcdd4",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795180188,
      "updated": 1795180188
    }
  ]
}