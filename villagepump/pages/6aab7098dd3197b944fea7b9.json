{
  "id": "6aab7098dd3197b944fea7b9",
  "title": "最速先行",
  "created": 1789620380,
  "updated": 1789621905,
  "lines": [
    {
      "id": "6aab7098dd3197b944fea7b9",
      "text": "最速先行",
      "userId": "660605441655f300254ac7c2",
      "created": 1789620380,
      "updated": 1789621827
    },
    {
      "id": "6aab73150000000000d70d32",
      "text": "[最速先行抽選]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789621014,
      "updated": 1789621027
    },
    {
      "id": "6aab71e10000000000d70d28",
      "text": " [コンサート・ライブ]の[現地]参加チケットの申し込み方法",
      "userId": "660605441655f300254ac7c2",
      "created": 1789620706,
      "updated": 1789621024
    },
    {
      "id": "6aab72210000000000d70d2a",
      "text": " \t一般販売に先駆けてどこよりも早く開始される最初の抽選受付・購入機会",
      "userId": "660605441655f300254ac7c2",
      "created": 1789620770,
      "updated": 1789621024
    },
    {
      "id": "6aab709c0000000000d70d1f",
      "text": "  下記内容はによって変わる",
      "userId": "660605441655f300254ac7c2",
      "created": 1789620381,
      "updated": 1789621024
    },
    {
      "id": "6aab70a40000000000d70d21",
      "text": "  \t[ファンクラブ]（[FC]）や[有料]の会員が対象",
      "userId": "660605441655f300254ac7c2",
      "created": 1789620388,
      "updated": 1789621024
    },
    {
      "id": "6aab71110000000000d70d22",
      "text": "  \tCD等の特定の[物販]を買うことで申し込み",
      "userId": "660605441655f300254ac7c2",
      "created": 1789620497,
      "updated": 1789621024
    },
    {
      "id": "6aab71270000000000d70d23",
      "text": "  \t特定のサイト限定で申し込める",
      "userId": "660605441655f300254ac7c2",
      "created": 1789620520,
      "updated": 1789621024
    },
    {
      "id": "6aab71a30000000000d70d27",
      "text": "  \t申し込んでも必ず当選する訳では無い",
      "userId": "660605441655f300254ac7c2",
      "created": 1789620643,
      "updated": 1789621024
    },
    {
      "id": "6aab71510000000000d70d25",
      "text": "  \t\t当選確率はどのイベントでも非公開",
      "userId": "660605441655f300254ac7c2",
      "created": 1789620562,
      "updated": 1789621024
    },
    {
      "id": "6aab7644000000000042dc97",
      "text": " 最速先行抽選から落ちると、現地チケットが手に入らないことが多々ある",
      "userId": "660605441655f300254ac7c2",
      "created": 1789621830,
      "updated": 1789621905
    },
    {
      "id": "6aab72390000000000d70d2b",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1789620794,
      "updated": 1789620907
    },
    {
      "id": "6aab72ab0000000000d70d2c",
      "text": "抽選順番",
      "userId": "660605441655f300254ac7c2",
      "created": 1789620907,
      "updated": 1789620916
    },
    {
      "id": "6aab72b30000000000d70d2e",
      "text": "\t最速先行",
      "userId": "660605441655f300254ac7c2",
      "created": 1789620916,
      "updated": 1789621031
    },
    {
      "id": "6aab72b80000000000d70d2f",
      "text": "\t[先行抽選]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789620920,
      "updated": 1789621060
    },
    {
      "id": "6aab72bd0000000000d70d30",
      "text": "\t[一般販売]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789620926,
      "updated": 1789621063
    },
    {
      "id": "6aab72af0000000000d70d2d",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1789620911,
      "updated": 1789620911
    }
  ]
}