    },
    {
      "id": "6aa94210000000000077be40",
      "text": "[https://youtu.be/zS0Jp2YMv2A]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789477396,
      "updated": 1789477397
    },
    {
      "id": "6aa94212000000000077be41",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1789477397,
      "updated": 1789477397
    },
    {
      "id": "6aa941d9000000000077be38",
      "text": ">[東京]のどこかを走る[タクシー]。",
      "userId": "660605441655f300254ac7c2",
      "created": 1789477338,
      "updated": 1789477783
    },
    {
      "id": "6aa941de000000000077be3a",
      "text": "> 乗ってくるのは、仕事を終えた二人組。",
      "userId": "660605441655f300254ac7c2",
      "created": 1789477343,
      "updated": 1789477343
    },
    {
      "id": "6aa941de000000000077be3b",
      "text": "> 車内には寡黙な[ドライバー]と乗客だけ。",
      "userId": "660605441655f300254ac7c2",
      "created": 1789477343,
      "updated": 1789477787
    },
    {
      "id": "6aa941de000000000077be3c",
      "text": "> そこでは密室ゆえの気取らない会話が繰り広げられ、",
      "userId": "660605441655f300254ac7c2",
      "created": 1789477343,
      "updated": 1789477343
    },
    {
      "id": "6aa941de000000000077be3d",
      "text": "> 人前では見せない本音が飛び出すのだった…。",
      "userId": "660605441655f300254ac7c2",
      "created": 1789477343,
      "updated": 1789477343
    },
    {
      "id": "6aa941de000000000077be3e",
      "text": "> 果たして今夜は誰が乗ってくるのか？",
      "userId": "660605441655f300254ac7c2",
      "created": 1789477343,
      "updated": 1789477560
    },
    {
      "id": "6aa941dc000000000077be39",
      "text": " https://metataxi.jp/",
      "userId": "660605441655f300254ac7c2",
      "created": 1789477340,
      "updated": 1789477381
    },
