    },
    {
      "id": "6b099fb51280f000000008bc8b",
      "text": "第48週: 日月火水木金[[土]]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795792820,
      "updated": 1795792820
    },
    {
      "id": "6b099fb51280f0000000905d70",
      "text": "2026年 90.96％経過",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795792820,
      "updated": 1795792820
    },
    {
      "id": "6b099fb51280f0000000e16a7e",
      "text": "",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795792820,
      "updated": 1795792820
    },
    {
      "id": "6b099fb51280f000000028006b",
      "text": "[hiro.icon]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1795792820,
      "updated": 1795813357
    },
    {
      "id": "6b09efcf0000000000052d72",
      "text": " [出木杉のび太の朝 https://dlt.kitetu.com/KNo.F85E/555F-3BF7]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1795813357,
      "updated": 1795813368
    },
    {
      "id": "6b09f71900000000002c1a2e",
      "text": "  他人の苦労も弱さも知らなければならない",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1795815223,
      "updated": 1795815230
    },
    {
      "id": "6b09f73200000000002c1a2f",
      "text": "  [出木杉ジャイアン]から[出木杉のび太]になる",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1795815248,
      "updated": 1795815256
    },
    {
      "id": "6b09f73b00000000002c1a30",
      "text": " [希哲館訳語よもやま話]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1795815257,
      "updated": 1795815274
    },
    {
      "id": "6b09f74d00000000002c1a31",
      "text": "  [ヘイトスピーチ]の希哲館訳語は「[弊吐]」でほぼ確定",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1795815275,
      "updated": 1795815325
    },
    {
      "id": "6b09f77800000000002c1a32",
      "text": "  スピーチを「[説表]」として「憎悪説表」としてもいいが，「ヘイト」だけで通用するようになってしまっているので，それに対してやや冗長感がある",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1795815318,
      "updated": 1795815381
    },
    {
      "id": "6b09f7bf00000000002c1a33",
      "text": "   「説表」に似た訳語に「[早飛]（度）」（さっぴ，スピード）がある",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1795815389,
      "updated": 1795815457
    },
    {
      "id": "6b09f7f600000000002c1a34",
      "text": "    どっちも結構凄くない？",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1795815444,
      "updated": 1795815478
    },
    {
      "id": "6b0a14280000000000277e5f",
      "text": "",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1795822633,
      "updated": 1795822633
    },
    {
      "id": "6b0a14280000000000277e60",
      "text": "[はるひ.icon]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1795822633,
      "updated": 1795822634
    },
    {
      "id": "6b0a16360000000000277e62",
      "text": " https://x.com/asobodesign/status/2126232833136222433?a=AwcioOPEDGRjjjgbyU8&s=20",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1795823159,
      "updated": 1795824137
    },
    {
      "id": "6b0a1a09000000000031af66",
      "text": "  凄い",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1795824138,
      "updated": 1795824142
    },
    {
      "id": "6b0a1d600000000000e515bc",
      "text": "  デザイン？センスがあるなぁ[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1795824992,
      "updated": 1795824997
    },
    {
      "id": "6b0a1d640000000000e515bd",
      "text": "  \tこういうのマジでわからん、魔法みたいだ",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1795824997,
      "updated": 1795825003
    },
    {
      "id": "6b0a1d8a0000000000e515bf",
      "text": "  \t無限の選択肢からなぜそれを選べる？みたいな",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1795825034,
      "updated": 1795825042
    },
    {
      "id": "6b0a1d6e0000000000e515be",
      "text": "  \t[Halop.icon]さんのコセンスとかもそうだけど",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1795825007,
      "updated": 1795825016
    },
    {
      "id": "6b0a1cf2000000000031af67",
      "text": " 当直明け",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1795824882,
      "updated": 1795825186
    },
    {
      "id": "6b0a1e23000000000031af68",
      "text": "",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1795825187,
      "updated": 1795827777
    },
    {
      "id": "6b099fb51280f0000000343763",
      "text": "",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795792820,
      "updated": 1795792820
    },
    {
      "id": "6b0a1a1c0000000000921779",
      "text": "[seibe.icon]",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1795824157,
      "updated": 1795824158
    },
    {
      "id": "6b0a1a1e000000000092177b",
      "text": " 入力だけを極快適に出来るアプリが欲しい",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1795824159,
      "updated": 1795824174
    },
    {
      "id": "6b0a1bd5000000000092177c",
      "text": "  文脈：AIに精度高く考えてもらうには入力をたくさんしたい。けれども入力というのは面倒である。そこで入力だけに特化して、そこの摩擦ができるだけ小さくなるようなものが欲しい",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1795824597,
      "updated": 1795824663
    },
    {
      "id": "6b0a1a41000000000054777c",
      "text": "",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1795824193,
      "updated": 1795824193
    },
    {
      "id": "6b0a1a41000000000054777d",
      "text": "[terang.icon]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1795824193,
      "updated": 1795824196
    },
    {
      "id": "6b0a1a45000000000054777e",
      "text": " 参加しているカントの読書会わず",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1795824198,
      "updated": 1795824215
    },
    {
      "id": "6b0a1a98000000000054777f",
      "text": "  来週も楽しみ",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1795824281,
      "updated": 1795824286
    },
    {
      "id": "6b0a1a1d000000000092177a",
      "text": "",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1795824157,
      "updated": 1795824157
    },
    {
      "id": "6b0a21e00000000000cb7b50",
      "text": "[inajob.icon]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1795826144,
      "updated": 1795826145
    },
    {
      "id": "6b0a21e10000000000cb7b52",
      "text": "\tリビングで使っているマウスのホイールの調子が悪い",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1795826145,
      "updated": 1795826153
    },
    {
      "id": "6b0a21e90000000000cb7b53",
      "text": "\t\t非破壊で分解するのが難しそう",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1795826153,
      "updated": 1795826163
    },
    {
      "id": "6b0a21f40000000000cb7b54",
      "text": "\t\t\t少なくとも裏面のシールをはがしてネジ穴を露出させるなどが必要そう",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1795826164,
      "updated": 1795826175
    },
    {
      "id": "6b0a22000000000000cb7b55",
      "text": "\t\tまだ1年ちょっとしか経っていないのだがな・・",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1795826177,
      "updated": 1795826184
    },
    {
      "id": "6b0a220c0000000000cb7b56",
      "text": "\t\t自作マウスってあまり聞かないな",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1795826188,
      "updated": 1795826193
    },
    {
      "id": "6b0a21e00000000000cb7b51",
      "text": "",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1795826144,
      "updated": 1795826144
    },
