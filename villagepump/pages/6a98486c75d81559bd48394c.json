    {
      "id": "6a98486c75d81559bd48394c",
      "text": "タニシガチャUserScript",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a98486c00000000001b5f72",
      "text": "from [times-suto3-2026-09-02]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a98486c00000000001b5f73",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364916
    },
    {
      "id": "6a9849a20000000000e9686e",
      "text": "[タニシガチャ]のボタン`🐚`を追加し、クリック時にランダムにタニシのアイコンを選択して表示する機能。",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788365219,
      "updated": 1788370772
    },
    {
      "id": "6a9849aa0000000000e9686f",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788365226,
      "updated": 1788365226
    },
    {
      "id": "6a98486c00000000001b5f74",
      "text": " code:script.js",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a98486c00000000001b5f75",
      "text": "   const choice = (arr) => arr[Math.floor(Math.random()*arr.length)]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a98486c00000000001b5f76",
      "text": "    scrapbox.PopupMenu.addButton({",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a98486c00000000001b5f77",
      "text": "      title: '🐚',",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a98486c00000000001b5f78",
      "text": "      onClick: text => choice([",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a98486c00000000001b5f79",
      "text": "         '[/ [タニシガチャ: キングタニシ.icon]] ',",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a98486c00000000001b5f7a",
      "text": "         '[/ [タニシガチャ: adminタニシ.icon]] ',",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a98486c00000000001b5f7b",
      "text": "         '[/ [タニシガチャ: タニシナイト.icon]] ',",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a98486c00000000001b5f7c",
      "text": "         '[/ [タニシガチャ: ホイミタニシ.icon]] ',",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a98486c00000000001b5f7d",
      "text": "         '[/ [タニシガチャ: イドバタニシ.icon]] ',",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a98486c00000000001b5f7e",
      "text": "       　'[/ [タニシガチャ: ジャンボタニシ.icon]] ',",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a98486c00000000001b5f7f",
      "text": "       　'[/ [タニシガチャ: +1タニシ.icon]] ',",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a98486c00000000001b5f80",
      "text": "     　　'[/ [タニシガチャ: 水浴びタニシ.icon]] ',",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a98486c00000000001b5f81",
      "text": "     　　'[/ [タニシガチャ: タニシ.icon]] '])+text,",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a98486c00000000001b5f82",
      "text": "    });",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a98486c00000000001b5f83",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a984c8b0000000000e55212",
      "text": "[タニシガチャを回すページ]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788365963,
      "updated": 1788418800
    },
    {
      "id": "6a98486c00000000001b5f84",
      "text": "[/ [タニシガチャ: ジャンボタニシ.icon]] 動作例",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788365679
    },
    {
      "id": "6a98486c00000000001b5f85",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788364909,
      "updated": 1788364909
    },
    {
      "id": "6a9849f30000000000e55208",
      "text": "[サイコロトークUserScript]をちょっとだけ変更したもの",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788365299,
      "updated": 1788365335
