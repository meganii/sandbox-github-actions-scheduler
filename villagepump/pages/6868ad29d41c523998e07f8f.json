    {
      "id": "6a62a4e500000000007fe843",
      "text": "[https://www.cyberpunk.net/ja/edgerunners2 『サイバーパンク: エッジランナーズ２』制作決定！]",
      "userId": "6a629fd54bfcbf501d46404a",
      "created": 1784849638,
      "updated": 1784849638
    },
    {
      "id": "6a62a4e500000000007fe844",
      "text": "2026年秋に[Netflix]限定公開。",
      "userId": "6a629fd54bfcbf501d46404a",
      "created": 1784849638,
      "updated": 1784849638
    },
    {
      "id": "6a62a4e500000000007fe845",
      "text": "[サイバーパンク:エッジランナーズ]に2がついている……が、ティザー時点では前作のキャラは出てきていない。",
      "userId": "6a629fd54bfcbf501d46404a",
      "created": 1784849638,
      "updated": 1784849638
