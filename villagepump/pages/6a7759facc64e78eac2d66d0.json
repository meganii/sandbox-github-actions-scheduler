      "created": 1786208248,
      "updated": 1786208255
    },
    {
      "id": "6a77620000000000002fbfda",
      "text": "#衝動性",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786208768,
      "updated": 1786208768
    },
    {
      "id": "6a77617400000000002fbfd3",
