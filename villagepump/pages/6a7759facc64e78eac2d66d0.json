      "updated": 1786208362
    },
    {
      "id": "6a775fd900000000002fbfbb",
      "text": "#ネガティブフィードバック #フィードバック",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786208217,
      "updated": 1786208303
    },
    {
      "id": "6a7760be00000000002fbfc3",
      "text": "#ネガティブな感情",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786208447,
      "updated": 1786208447
    },
    {
      "id": "6a775ff800000000002fbfbe",
