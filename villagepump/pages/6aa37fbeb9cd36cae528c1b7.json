{
  "id": "6aa37fbeb9cd36cae528c1b7",
  "title": "シャニマス キャッチコピー",
  "created": 1789099967,
  "updated": 1789099968,
  "lines": [
    {
      "id": "6aa37fbeb9cd36cae528c1b7",
      "text": "シャニマス キャッチコピー",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099967,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317d9",
      "text": "[シャイニーカラーズ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317da",
      "text": " [イルミネーションスターズ]（[イルミネ]）",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317db",
      "text": " \t瞳に輝く、無限の可能性",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317dc",
      "text": " [アンティーカ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317dd",
      "text": " \t回せ、錆びついた運命の鍵を",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317de",
      "text": " [放課後クライマックスガールズ]（[放クラ]）",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317df",
      "text": " \t女の子はいつだって放課後がクライマックス！",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317e0",
      "text": " [アルストロメリア]（[アルスト]）",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317e1",
      "text": " \t花ざかり、私達の幸福論",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317e2",
      "text": " [ストレイライト]（[ストレイ]）",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317e3",
      "text": " \t身に纏うは迷光、少女たちは偶像となる",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317e4",
      "text": " [ノクチル]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317e5",
      "text": " \tさよなら、透明だった僕たち（チルアウト・ノクチルカ）",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317e6",
      "text": " [シーズ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317e7",
      "text": " \t耀いて、スパンコール・シャンデリア",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317e8",
      "text": " [コメティック]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317e9",
      "text": " \t新時代到来の予兆、黒色彗星（カラーレス・アイドル）",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317ea",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317eb",
      "text": "[PJ: REFRAC7IONS]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317ec",
      "text": " [I'm a Cutie Finder]（[アイキュー]）",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317ed",
      "text": " \t世界のカワイイをみんなに届けたい♡♡♡♡♡",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317ee",
      "text": " [Fumage]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317ef",
      "text": " \t火よ、それは痛みと夢の？",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317f0",
      "text": " [Sonic Heart (and Signal)]（[ソニハ]）",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317f1",
      "text": " \tSpeed Up! Keep Running!",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317f2",
      "text": " [Σ Desire]（[シグマ]）",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317f3",
      "text": " \tNo desire, No reward.",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317f4",
      "text": " [ザ・ふたりトラベラー]（[たりラ]）",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317f5",
      "text": " \t旅しよう、好き時間。",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317f6",
      "text": " [彼岸流]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317f7",
      "text": " \t咲きし悲願の赤き花、手向けるも儚し",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317f8",
      "text": " [No 1 feel alone]（[ノフィロ]）",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317f9",
      "text": "\t\tこの頃みんな1人じゃない？",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317fa",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317fb",
      "text": "[キャッチコピー]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317fc",
      "text": "[シャニマス]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    },
    {
      "id": "6aa37fbf00000000004317fd",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1789099968,
      "updated": 1789099968
    }
  ]
}