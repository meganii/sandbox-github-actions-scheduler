    },
    {
      "id": "6aaa6cd60000000000eed207",
      "text": "  \tsrc: url(https://fonts.gstatic.com/s/atkinsonhyperlegiblenext/v4/NaPNcYPdHfdVxJw0IfIP0lvYFqijb-UxCtm5_wdGseiJn3o.woff2) format('woff2');",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789553879,
      "updated": 1789553879
    },
    {
      "id": "6aaa6cd60000000000eed208",
      "text": "  \tunicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789553879,
      "updated": 1789553879
    },
    {
      "id": "6aaa6cd60000000000eed209",
      "text": "  }",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789553879,
      "updated": 1789553879
    },
    {
      "id": "6aaa6cc50000000000eed1d8",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789553863,
      "updated": 1789553863
    },
    {
      "id": "6aaa6cc50000000000eed1d9",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789553863,
      "updated": 1789553863
    },
    {
      "id": "6aaa68620000000000eed1b7",
      "text": "[*** 2. [Roboto Flex]]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789552740,
      "updated": 1789554034
    },
    {
      "id": "6aaa690e0000000000eed1ba",
      "text": "　バリアブルフォント",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789552912,
      "updated": 1789553296
    },
    {
      "id": "6aaa68c20000000000eed1b9",
      "text": " デフォルトの字幅が Roboto に比べて若干広い",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789552836,
      "updated": 1789552907
    },
    {
      "id": "6aaa69c00000000000eed1c7",
      "text": " このフォントは [grade] に対応している",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789553090,
      "updated": 1789553351
    },
    {
      "id": "6aaa6abf0000000000eed1d0",
      "text": "  `--text-axis` は [font-variation-settings]: \"GRAD\" の値",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789553345,
      "updated": 1789553428
    },
    {
      "id": "6aaa68620000000000eed1b8",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789552740,
      "updated": 1789552740
    },
    {
      "id": "6aaa63080000000000eed195",
      "text": " code:robotoflex.css",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789551369,
      "updated": 1789551435
    },
    {
      "id": "6aaa6b610000000000eed1d2",
      "text": "  @import url('https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Roboto+Flex:opsz,wdth,wght,GRAD,XOPQ,XTRA,YOPQ,YTDE,YTFI,YTLC,YTUC@8..144,25..151,100..1000,-200..150,96,468,79,-203,738,514,712&display=swap');",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789553506,
      "updated": 1789553508
    },
    {
      "id": "6aaa631d0000000000eed19d",
      "text": "  .editor {",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789551390,
      "updated": 1789551390
    },
    {
      "id": "6aaa67730000000000eed1af",
      "text": "  \tfont-stretch: var(--page-font-width, none);\tfont-width: var(--page-font-width, none);",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789552501,
      "updated": 1789552501
    },
    {
      "id": "6aaa6b420000000000eed1d1",
      "text": "  \tfont-family: \"Roboto Flex\", \"Roboto\", Helvetica, \"Arial\", \"Hiragino Sans\", sans-serif, var(--icons, AppIcons);",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789553476,
      "updated": 1789553486
    },
    {
      "id": "6aaa631d0000000000eed19e",
      "text": " \t\tfont-weight: 400;",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789551390,
      "updated": 1789551678
    },
    {
      "id": "6aaa63080000000000eed196",
      "text": "\t\t\t@media (prefers-color-scheme: dark) {",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789551369,
      "updated": 1789551369
    },
    {
      "id": "6aaa63080000000000eed197",
      "text": "   \t\tfont-variation-settings: \"GRAD\" var(--text-axis, 0);",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789551369,
      "updated": 1789551730
    },
    {
      "id": "6aaa63080000000000eed198",
      "text": "   \t\tfont-width: 106.3%;",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789551369,
      "updated": 1789551979
    },
    {
      "id": "6aaa63080000000000eed199",
      "text": "   \t\tletter-spacing: 0.01em;",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789551369,
      "updated": 1789551982
    },
    {
      "id": "6aaa63080000000000eed19a",
      "text": "   \t\tfont-size-adjust: .52;",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789551369,
      "updated": 1789551988
    },
    {
      "id": "6aaa63080000000000eed19b",
      "text": "   \t\tfont-family: \"Roboto Flex\", \"Roboto\", Helvetica, \"Arial\", \"Hiragino Sans\", \"BIZ UDGothic\", sans-serif, var(--icons, AppIcons);",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789551369,
      "updated": 1789551909
    },
    {
      "id": "6aaa63080000000000eed19c",
      "text": "   \t}",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789551369,
      "updated": 1789551369
    },
    {
      "id": "6aaa63200000000000eed19f",
      "text": "   }",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789551393,
      "updated": 1789551397
    },
    {
      "id": "6aaa6fcb0000000000eed213",
      "text": "  .stream a,",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789554636,
      "updated": 1789554636
    },
    {
      "id": "6aaa6fcb0000000000eed214",
      "text": "  .formula-line { font-family: inherit; font-weight: inherit; font-width: inherit; font-stretch: inherit; letter-spacing: inherit; }",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789554636,
      "updated": 1789554636
    },
    {
      "id": "6aaa6fcb0000000000eed215",
      "text": "  strong:not(.level, .level-1) { font-stretch: inherit; letter-spacing: inherit; }",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789554636,
      "updated": 1789554636
    },
    {
      "id": "6aaa635c0000000000eed1a1",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789551453,
      "updated": 1789551455
    },
    {
      "id": "6aaa64860000000000eed1a5",
      "text": "[*** 1. [Inter]]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789551752,
      "updated": 1789554042
    },
    {
      "id": "6aaa67dd0000000000eed1b2",
      "text": " Roboto と比較して",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789552606,
      "updated": 1789552613
    },
    {
      "id": "6aaa67e40000000000eed1b3",
      "text": " 　x-height が Roboto 僅かに高い（2%程度）",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789552613,
      "updated": 1789552648
    },
    {
      "id": "6aaa67aa0000000000eed1b1",
      "text": " 　i のドット等の高さがやや高い",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789552555,
      "updated": 1789552618
    },
    {
      "id": "6aaa68270000000000eed1b6",
      "text": " このフォントは [grade] に対応していない",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789552681,
      "updated": 1789552681
    },
    {
      "id": "6aaa66670000000000eed1ac",
      "text": "  `--text-axis` は weight に加算する",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789552232,
      "updated": 1789553001
    },
    {
      "id": "6aaa6d7e0000000000eed20c",
      "text": " 読み続けやすいフォントだけど、文字の個性がないせいかダークテーマでは目が文字の上を滑る感じ[Nrem.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789554047,
      "updated": 1789554659
    },
    {
      "id": "6aaa648d0000000000eed1a7",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789551758,
      "updated": 1789551758
    },
    {
      "id": "6aaa60bd0000000000eed173",
      "text": " code:inter.css",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789550782,
      "updated": 1789550992
    },
    {
      "id": "6aaa6b680000000000eed1d3",
      "text": "  @import url('https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Roboto+Flex:opsz,wdth,wght,GRAD,XOPQ,XTRA,YOPQ,YTDE,YTFI,YTLC,YTUC@8..144,25..151,100..1000,-200..150,96,468,79,-203,738,514,712&display=swap');",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789553514,
      "updated": 1789553517
    },
    {
      "id": "6aaa61770000000000eed174",
      "text": "  .editor {",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789550968,
      "updated": 1789551064
    },
    {
      "id": "6aaa67790000000000eed1b0",
      "text": "  \tfont-stretch: var(--page-font-width, none);\tfont-width: var(--page-font-width, none);",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789552506,
      "updated": 1789553022
    },
    {
      "id": "6aaa62630000000000eed180",
      "text": " \t\tfont-weight: calc(400 + var(--text-axis, 0));",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789551205,
      "updated": 1789551211
    },
    {
      "id": "6aaa6b8b0000000000eed1d4",
      "text": " \t\tfont-family: \"Inter Variable\", \"Inter\", \"Roboto Flex\", \"Roboto\", Helvetica, \"Arial\", \"Hiragino Sans\", sans-serif, var(--icons, AppIcons);",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789553548,
      "updated": 1789553561
    },
    {
      "id": "6aaa61cd0000000000eed17d",
      "text": "  \t@media (prefers-color-scheme: dark) {",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789551054,
      "updated": 1789551054
    },
    {
      "id": "6aaa69980000000000eed1c6",
      "text": "  \t\t--text-axis: -30;",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789553049,
      "updated": 1789553049
    },
    {
      "id": "6aaa61770000000000eed176",
      "text": "  \t\t--page-font-width: normal;",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789550968,
      "updated": 1789553060
    },
    {
      "id": "6aaa61770000000000eed178",
      "text": "  \t\tfont-size-adjust: .52;",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789550968,
      "updated": 1789550968
    },
    {
      "id": "6aaa61770000000000eed179",
      "text": "  \t\tletter-spacing: 0.01em;",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789550968,
      "updated": 1789550968
    },
    {
      "id": "6aaa61770000000000eed17a",
      "text": "  \t\tfont-family: \"Inter Variable\", \"Inter\", \"Roboto Flex\", \"Roboto\", Helvetica, \"Arial\", \"Hiragino Sans\", \"BIZ UDGothic\", sans-serif, var(--icons, AppIcons);",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789550968,
      "updated": 1789551881
    },
    {
      "id": "6aaa61770000000000eed17b",
      "text": "  \t}",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789550968,
      "updated": 1789550968
    },
    {
      "id": "6aaa61db0000000000eed17e",
      "text": "  }",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789551068,
      "updated": 1789551070
    },
    {
      "id": "6aaa6fd20000000000eed216",
      "text": "  .stream a,",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789554643,
      "updated": 1789554643
    },
    {
      "id": "6aaa6fd20000000000eed217",
      "text": "  .formula-line { font-family: inherit; font-weight: inherit; font-width: inherit; font-stretch: inherit; letter-spacing: inherit; }",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789554643,
      "updated": 1789554643
    },
    {
      "id": "6aaa6fd20000000000eed218",
      "text": "  strong:not(.level, .level-1) { font-stretch: inherit; letter-spacing: inherit; }",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789554643,
      "updated": 1789554643
    },
