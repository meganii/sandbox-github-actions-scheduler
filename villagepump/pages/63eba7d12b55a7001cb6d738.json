  "lines": [
    {
      "id": "63eba7d12b55a7001cb6d738",
      "text": "idobatanish",
      "userId": "60508ed36a7abc00235e90c0",
      "created": 1676388311,
      "updated": 1676388311
    },
    {
      "id": "63eba80b5e90c000009c2a21",
      "text": "(形)",
      "userId": "60508ed36a7abc00235e90c0",
      "created": 1676388363,
      "updated": 1676388369
    },
    {
      "id": "63eba7d75e90c000009c2a1d",
      "text": "　[井戸端] + [接尾辞] [-ish]",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1676388311,
      "updated": 1676448756
    },
    {
      "id": "63eba7f65e90c000009c2a1f",
      "text": "　井戸端っぽい、井戸端的な",
      "userId": "60508ed36a7abc00235e90c0",
      "created": 1676388342,
      "updated": 1676388356
    },
    {
      "id": "63ec9217e6003500005a6695",
      "text": "",
      "userId": "62a91a7a083437001de60035",
      "created": 1676448281,
      "updated": 1676448281
    },
    {
      "id": "63ec9218e6003500005a6696",
      "text": "[https://ejje.weblio.jp/content/ish 英語「ish」の意味・使い方・読み方 | Weblio英和辞書]",
      "userId": "62a91a7a083437001de60035",
      "created": 1676448281,
      "updated": 1676448281
    },
    {
      "id": "63ec9218e6003500005a6697",
      "text": "[https://www.kenkyusha.co.jp/uploads/history_of_english/series/s07.html 連載 第7回 接尾辞 -ish の歴史的展開]",
      "userId": "62a91a7a083437001de60035",
      "created": 1676448281,
      "updated": 1676448281
    },
    {
      "id": "63ec921ce6003500005a6698",
      "text": "",
      "userId": "62a91a7a083437001de60035",
      "created": 1676448285,
      "updated": 1676448285
    },
    {
      "id": "63ec921de6003500005a6699",
      "text": "#造語 #イドバタニッシュ",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1676448286,
      "updated": 1676448714
    },
    {
      "id": "63ec921d6eb4060000a2b05a",
      "text": "",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1676448289,
      "updated": 1676448289
    },
    {
      "id": "63ec921d6eb4060000a2b05b",
      "text": "\t[タニシ]感があるな[inajob.icon]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1676448289,
      "updated": 1676448314
    },
    {
      "id": "63ec923a6eb4060000a2b05d",
      "text": "\t\t[イドバタニシ]っぽい、も同じ語になりそう",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1676448318,
      "updated": 1676448336
    },
    {
      "id": "63ec924e6eb4060000a2b05e",
      "text": "\t\t\tidobatanish-ish",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1676448337,
      "updated": 1676448384
    },
    {
      "id": "63ec92626eb4060000a2b05f",
      "text": "\t\t\t\tイドバタニシッシュ？",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1676448357,
      "updated": 1676448367
    },
    {
      "id": "63ec921f6eb4060000a2b05c",
      "text": "\t\t\tちょっと違うか",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1676448291,
      "updated": 1676448397
    },
    {
      "id": "63ec92866eb4060000a2b060",
      "text": "",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1676448393,
      "updated": 1676448393
    },
    {
      "id": "63ec93a37838e300000d9af3",
      "text": "他には？[Mijikko.icon]",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1676448634,
      "updated": 1676448636
    },
    {
      "id": "63ec93a67838e300000d9af5",
      "text": "\tイドバタニサー（-er）",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1676448637,
      "updated": 1676448651
    },
    {
      "id": "63ec93b57838e300000d9af6",
      "text": "\tイドバタニスト（-ist）",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1676448652,
      "updated": 1676448742
    },
    {
      "id": "63ec93a57838e300000d9af4",
      "text": "\t井戸端の場合[inajob.icon]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1676448636,
      "updated": 1676449032
    },
    {
      "id": "63ec96d46eb40600003552bc",
      "text": "\t\t\tでもこれは人に書けるものだから上ので正しそう",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1676449496,
      "updated": 1676449508
    },
    {
      "id": "63ec94ee6eb40600003552ba",
      "text": "\t\tイドバター",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1676449010,
      "updated": 1676449022
    },
    {
      "id": "63ec950a55cbd30000e9d08f",
      "text": "\t\t [プレデター]っぽい[mtane0412.icon]",
      "userId": "62a91a7a083437001de60035",
      "created": 1676449034,
      "updated": 1676451651
    },
    {
      "id": "63ec94fa6eb40600003552bb",
      "text": "\t\tイドバティスト",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1676449022,
      "updated": 1676449487
    },
    {
      "id": "63ec99245b98c2000003dcaa",
      "text": "\t\t[イドの怪物]（[id-monster]）",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1676450085,
      "updated": 1749423543
    },
    {
      "id": "6aeeb9f10000000000b6d15c",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794030065,
      "updated": 1794030072
    },
    {
      "id": "6aeeba820000000000b6d163",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794030209,
      "updated": 1794030209
    },
    {
      "id": "6aeeba910000000000b6d167",
      "text": "[Nrem.icon]これ、正確には「井戸端 + 接尾辞 [-an] + 接尾辞 -ish」ですよね",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794030225,
      "updated": 1794031048
    },
    {
      "id": "6aeeb9f50000000000b6d15e",
      "text": "> (形)",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794030068,
      "updated": 1794030218
    },
    {
      "id": "6aeeba8a0000000000b6d164",
      "text": "> 　井戸端 + 接尾辞 -ish",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794030217,
      "updated": 1794030217
    },
    {
      "id": "6aeeb9f50000000000b6d15f",
      "text": "> 　井戸端っぽい、井戸端的な",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794030068,
      "updated": 1794030068
    },
    {
      "id": "6aeeba440000000000b6d162",
      "text": "\tもし `[井戸端] + [接尾辞] [-ish]` ならば [idobatish] になるはず",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794030148,
      "updated": 1794030324
    },
    {
      "id": "6aeebcdd0000000000b6d175",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794030813,
      "updated": 1794030813
    },
    {
      "id": "6aeebbcf0000000000b6d170",
      "text": "以下も「[\" イドバター] (idobater)」[. [idobatanish#63ec94ee6eb40600003552ba]]「[\" イドバティスト] (idobatist)」[. [idobatanish#63ec94fa6eb40600003552bb]]であってる",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794030543,
      "updated": 1794030871
    },
    {
      "id": "6aeebbc30000000000b6d16a",
      "text": "> 他には？[Mijikko.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794030531,
      "updated": 1794030531
    },
    {
      "id": "6aeebbc30000000000b6d16b",
      "text": "> \tイドバタニサー（-er）",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794030531,
      "updated": 1794030531
    },
    {
      "id": "6aeebbc30000000000b6d16c",
      "text": "> \tイドバタニスト（-ist）",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794030531,
      "updated": 1794030531
    },
    {
      "id": "6aeebc1d0000000000b6d172",
      "text": "> \t井戸端の場合[inajob.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794030621,
      "updated": 1794030621
    },
    {
      "id": "6aeebc1d0000000000b6d173",
      "text": "> \t\t\tでもこれは人に書けるものだから上ので正しそう",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794030621,
      "updated": 1794030621
    },
    {
      "id": "6aeebbb70000000000b6d169",
      "text": "\t\t\t\t-er や -ist には「人」を含むからその上のは正しくないと思う[Nrem.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794030518,
      "updated": 1794030837
    },
    {
      "id": "6aeebc260000000000b6d174",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794030629,
      "updated": 1794030629
    }
  ]
