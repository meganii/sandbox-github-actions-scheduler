      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1787979850,
      "updated": 1787979850
    },
    {
      "id": "6a92af3a000000000080b711",
      "text": "製作者:[Mijikko.icon]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1787998010,
      "updated": 1787998045
    },
    {
      "id": "6a92af3a000000000080b712",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1787998010,
      "updated": 1787998010
    },
    {
      "id": "6a92af3a000000000080b713",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1787998010,
      "updated": 1787998010
    },
    {
      "id": "6277217f7838e3000066f7ac",
      "text": "code:style.css",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651974528,
      "updated": 1651974532
    },
    {
      "id": "627721857838e3000066f7ae",
      "text": " @keyframes icon-rotate {",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651974533,
      "updated": 1651974533
    },
    {
      "id": "627721857838e3000066f7af",
      "text": "   0%{ transform: rotate(0);}",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651974533,
      "updated": 1651974533
    },
    {
      "id": "627721857838e3000066f7b0",
      "text": "   100%{ transform: rotate(360deg);}",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651974533,
      "updated": 1651974533
    },
    {
      "id": "627721857838e3000066f7b1",
      "text": " }",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651974533,
      "updated": 1651974533
    },
    {
      "id": "627721857838e3000066f7b2",
      "text": " .deco-- img.icon {",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651974533,
      "updated": 1651980662
    },
    {
      "id": "627721857838e3000066f7b3",
      "text": "   animation: 1.5s icon-rotate linear infinite;",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651974533,
      "updated": 1651974533
    },
    {
      "id": "627721857838e3000066f7b4",
      "text": " }",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651974533,
      "updated": 1651974533
    },
    {
      "id": "627721887838e3000066f7b5",
      "text": "",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651974536,
      "updated": 1651974536
    },
    {
      "id": "6277218b7838e3000066f7b6",
      "text": "\t完全に[ネタ]で作ったので、旬が過ぎたら外してください[Mijikko.icon]",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651974540,
      "updated": 1651975798
    },
    {
      "id": "63ce92d67838e30000b95fed",
      "text": "\t　[2023/01/23] これ作ったのお前だったのか…[Mijikko.icon]",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1674482391,
      "updated": 1674482459
    },
    {
      "id": "6277218b7838e3000066f7b7",
      "text": "　[時計回り]/[右回り]に回転する",
      "userId": "62a91a7a083437001de60035",
      "created": 1651974540,
      "updated": 1668423997
    },
    {
      "id": "6372213ce600350000bb2d99",
      "text": " 　あまり意味のない派生だけれど、[逆回転]とか...[hatori.icon]",
      "userId": "62a91a7a083437001de60035",
      "created": 1668423997,
      "updated": 1668423997
    },
    {
      "id": "6372213de600350000bb2d9a",
      "text": "",
      "userId": "62a91a7a083437001de60035",
      "created": 1668423998,
      "updated": 1668423998
    },
    {
      "id": "6277219c7838e3000066f7b8",
      "text": "[** 使い方]",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651974557,
      "updated": 1651974562
    },
    {
      "id": "627721b17838e3000066f7bb",
      "text": "\tアイコンを書く",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651974577,
      "updated": 1651974582
    },
    {
      "id": "627721a27838e3000066f7ba",
      "text": "\t\t[deno.icon]",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651974562,
      "updated": 1651975072
    },
    {
      "id": "6277219c7838e3000066f7b9",
      "text": "\tアイコンを`[- ]`で囲む",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651974557,
      "updated": 1651974601
    },
    {
      "id": "627721c97838e3000066f7bd",
      "text": "\t\t[- [deno.icon]]",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651974601,
      "updated": 1651975076
    },
    {
      "id": "627723a87838e3000067e7b1",
      "text": "\t\tわかりにくいって？[Mijikko.icon]",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651975081,
      "updated": 1651975087
    },
    {
      "id": "627723ba7838e3000067e7b3",
      "text": "\t\t\tほい",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651975098,
      "updated": 1651975100
    },
    {
      "id": "627723af7838e3000067e7b2",
      "text": "\t\t\t[/- [deno.icon]]",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651975088,
      "updated": 1651975093
    },
    {
      "id": "627723a77838e3000067e7b0",
      "text": "",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651975079,
      "updated": 1651975079
    },
    {
      "id": "627743a279d3a90000d406ce",
      "text": "",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1651983266,
      "updated": 1651983266
    },
    {
      "id": "627745ac5b98c20000b22251",
      "text": "[- [Settings.icon]][Settings] そうか、こんなふうに使うのか[-**** [suto3.icon]]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1651983788,
      "updated": 1652347956
    },
    {
      "id": "62774c4c7838e30000f6d45d",
      "text": "",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651985485,
      "updated": 1651985485
    },
    {
      "id": "62774c587838e30000f6d460",
      "text": "ためしに、`*`の数によって速度が変わるようにしてみた[-****** [Mijikko.icon]]",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651985497,
      "updated": 1651985765
    },
    {
      "id": "62774c4d7838e30000f6d45e",
      "text": "\t[https://gyazo.com/56a33d1fb5aa97eb4d4de51f15453913]",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651985485,
      "updated": 1651985499
    },
    {
      "id": "62774c527838e30000f6d45f",
      "text": "  視力検査の悪夢みたいだ[cFQ2f7LRuLYP.icon]",
      "userId": "60508ed36a7abc00235e90c0",
      "created": 1651985491,
      "updated": 1651985526
    },
    {
      "id": "62774cbd55cbd30000a419dc",
      "text": "  [ゲッダン]",
      "userId": "5ae7fecf7766b7001455cbd3",
      "created": 1651985598,
      "updated": 1651985600
    },
    {
      "id": "627c6ec28ee92a0000e2a9db",
      "text": "  大きいのをゆっくり回したい [増井俊之.icon]",
      "userId": "566fa156776c9b11008ee92a",
      "created": 1652321987,
      "updated": 1652321996
    },
    {
      "id": "627c85267838e3000039aed2",
      "text": "  　`*`が奇数個の時はゆっくりで、偶数個の時ははやくなるようにしようかな[Mijikko.icon]",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1652327719,
      "updated": 1652327775
    },
    {
      "id": "627cab978ee92a0000e2a9dc",
      "text": "  　そういう仕様はわかりにくいのでは [増井俊之.icon]",
      "userId": "566fa156776c9b11008ee92a",
      "created": 1652337559,
      "updated": 1652337567
    },
    {
      "id": "627ccf9255cbd3000046db6d",
      "text": "  　みんな回転に真剣で良い[mtane0412.icon][nishio.icon]",
      "userId": "582e63d27c56960011aff09e",
      "created": 1652346770,
      "updated": 1652346845
    },
    {
      "id": "63ce81a16eb4060000d4f727",
      "text": " [副作用]としてアイコンを含む発言を取り消し線すると、アイコンが回る[inajob.icon]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1674477987,
      "updated": 1674478010
    },
    {
      "id": "63ce81a26eb4060000d4f728",
      "text": "  \t\t[- こういう[inajob.icon]感じ]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1674477988,
      "updated": 1674477988
    },
    {
      "id": "62774c897838e30000317ac0",
      "text": " ソース",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651985545,
      "updated": 1651985548
    },
    {
      "id": "62774c8b7838e30000317ac1",
      "text": " \tcode:changeable.css",
      "userId": "60fb0a79f3364000237838e3",
      "created": 1651985548,
      "updated": 1651985591
    },
    {
      "id": "64ebfcfaed60e60000caf73a",
      "text": " \t @keyframes icon-rotate {",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187323,
      "updated": 1693187326
    },
    {
      "id": "64ebfcfded60e60000caf73c",
      "text": "     0%{ transform: rotate(0);}",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187326,
      "updated": 1693187326
    },
    {
      "id": "64ebfcfded60e60000caf73d",
      "text": "     100%{ transform: rotate(360deg);}",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187326,
      "updated": 1693187326
    },
    {
      "id": "64ebfcfded60e60000caf73e",
      "text": "   }",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187326,
      "updated": 1693187326
    },
    {
      "id": "64ebfcfded60e60000caf73f",
      "text": "   body { --icon-ratate-animation: icon-rotate linear infinite; }",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187326,
      "updated": 1693187326
    },
    {
      "id": "64ebfcfded60e60000caf740",
      "text": "   .deco-- img.icon { animation: 1.5s var(--icon-ratate-animation); }",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187326,
      "updated": 1693187326
    },
    {
      "id": "64ebfcfded60e60000caf741",
      "text": "   .level-1  [class=\"deco-- deco-\\*\"] img.icon { animation: 3s var(--icon-ratate-animation); }",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187326,
      "updated": 1693187326
    },
    {
      "id": "64ebfcfded60e60000caf742",
      "text": "   .level-2  [class=\"deco-- deco-\\*\"] img.icon { animation: 1.5s var(--icon-ratate-animation); }",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187326,
      "updated": 1693187326
    },
    {
      "id": "64ebfcfded60e60000caf743",
      "text": "   .level-3  [class=\"deco-- deco-\\*\"] img.icon { animation: 1s var(--icon-ratate-animation); }",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187326,
      "updated": 1693187326
    },
    {
      "id": "64ebfcfded60e60000caf744",
      "text": "   .level-4  [class=\"deco-- deco-\\*\"] img.icon { animation: 0.7s var(--icon-ratate-animation); }",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187326,
      "updated": 1693187326
    },
    {
      "id": "64ebfcfded60e60000caf745",
      "text": "   .level-5  [class=\"deco-- deco-\\*\"] img.icon { animation: 0.4s var(--icon-ratate-animation); }",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187326,
      "updated": 1693187326
    },
    {
      "id": "64ebfcfded60e60000caf746",
      "text": "   .level-6  [class=\"deco-- deco-\\*\"] img.icon { animation: 0.3s var(--icon-ratate-animation); }",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187326,
      "updated": 1693187326
    },
    {
      "id": "64ebfcfded60e60000caf747",
      "text": "   .level-7  [class=\"deco-- deco-\\*\"] img.icon { animation: 0.2s var(--icon-ratate-animation); }",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187326,
      "updated": 1693187326
    },
    {
      "id": "64ebfcfded60e60000caf748",
      "text": "   .level-8  [class=\"deco-- deco-\\*\"] img.icon { animation: 0.1s var(--icon-ratate-animation); }",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187326,
      "updated": 1693187326
    },
    {
      "id": "64ebfcfded60e60000caf749",
      "text": "   .level-9  [class=\"deco-- deco-\\*\"] img.icon { animation: 0.07s var(--icon-ratate-animation); }",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187326,
      "updated": 1693187326
    },
    {
      "id": "64ebfcfded60e60000caf74a",
      "text": "   .level-10 [class=\"deco-- deco-\\*\"] img.icon { animation: 0.05s var(--icon-ratate-animation); }",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187326,
      "updated": 1693187326
    },
    {
      "id": "64ebfd25ed60e60000caf74b",
      "text": "  回転速度をそのままにしてサイズだけ変えられるようにした`[**********- [Summer498.icon]]`[**********- [Summer498.icon]]",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187366,
      "updated": 1693188049
    },
    {
      "id": "64ebfd50ed60e60000caf74c",
      "text": "  \t順番を変えると回転速度が変わる `[-********** [Summer498.icon]]`[-********** [Summer498.icon]]",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187409,
      "updated": 1693188047
    },
    {
      "id": "6a9288cd0000000000d702f6",
      "text": "   \t60HzのPCモニターと120Hzのスマホ画面で回転の見え方が違うことに気づいて、素直に120Hzの凄さを実感している[KNo.804C.icon]",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787988175,
      "updated": 1787988250
    },
    {
      "id": "6a92895a0000000000d702f7",
      "text": "    \t120Hzだともはや自分の視覚処理が追いつかなくてゆっくりに見える",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787988315,
      "updated": 1787988462
    },
    {
      "id": "64ebfcfbed60e60000caf73b",
      "text": "  code:changeable-old.css",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1693187324,
      "updated": 1693187361
    },
    {
      "id": "62774cb67838e30000317ac2",
      "text": " \t @keyframes icon-rotate {",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1651985591,
      "updated": 1693187361
    },
    {
      "id": "62774cb77838e30000317ac3",
      "text": "     0%{ transform: rotate(0);}",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1651985591,
      "updated": 1693187361
    },
    {
      "id": "62774cb77838e30000317ac4",
      "text": "     100%{ transform: rotate(360deg);}",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1651985591,
      "updated": 1693187361
    },
    {
      "id": "62774cb77838e30000317ac5",
      "text": "   }",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1651985591,
      "updated": 1693187361
    },
    {
      "id": "62774cb77838e30000317ac6",
      "text": "   body {",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1651985591,
      "updated": 1693187361
    },
    {
      "id": "62774cb77838e30000317ac7",
      "text": "     --icon-ratate-animation: icon-rotate linear infinite;",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1651985591,
      "updated": 1693187361
    },
    {
      "id": "62774cb77838e30000317ac8",
      "text": "   }",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1651985591,
      "updated": 1693187361
    },
    {
      "id": "62774cb77838e30000317ac9",
      "text": "   .deco-- img.icon {",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1651985591,
      "updated": 1693187361
    },
    {
      "id": "62774cb77838e30000317aca",
      "text": "     animation: 1.5s var(--icon-ratate-animation);",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1651985591,
      "updated": 1693187361
    },
    {
      "id": "62774cb77838e30000317acb",
      "text": "   }",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1651985591,
      "updated": 1693187361
    },
    {
      "id": "62774cb77838e30000317acc",
      "text": "   .level-1 .deco-- img.icon {",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1651985591,
      "updated": 1693187361
    },
    {
      "id": "62774cb77838e30000317acd",
      "text": "     animation: 3s var(--icon-ratate-animation);",
      "userId": "6436266c7ac3c0001bed60e6",
