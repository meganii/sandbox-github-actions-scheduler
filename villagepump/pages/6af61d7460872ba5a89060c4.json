    },
    {
      "id": "6af710420000000000b45f4b",
      "text": "  気の利いたコメント貰えて神",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1794576450,
      "updated": 1794576581
    },
    {
      "id": "6af70e4e00000000001d849a",
