      "updated": 1786355389
    },
    {
      "id": "6a799d8a00000000007094d5",
      "text": "関連",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786355082,
      "updated": 1786355084
    },
    {
      "id": "6a799d7600000000007094d3",
      "text": " #部屋でじっとしていればいいのにそれができない。そのためにわざわざ自分で不幸を招いている",
      "userId": "58a90dd3ee5de7001150db17",
