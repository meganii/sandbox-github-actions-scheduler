  "updated": 1791424547,
  "lines": [
    {
      "id": "6ac56bda00dcaee52af27e2c",
      "text": "2026/10/07",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1791323102,
      "updated": 1791323102
    },
    {
      "id": "6ac57aa76eb4060000001e252a",
      "text": "第41週: 日月火[[水]]木金土",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791326887,
      "updated": 1791326887
    },
    {
      "id": "6ac57aa76eb406000000ac3969",
      "text": "2026年 76.71％経過",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791326887,
      "updated": 1791326887
    },
    {
      "id": "6ac57aa76eb406000000f53871",
      "text": "",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791326887,
      "updated": 1791326887
    },
    {
      "id": "6ac56bdd000000000059a099",
      "text": "[hiro.icon]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1791323102,
      "updated": 1791323103
    },
    {
      "id": "6ac56bdd000000000059a09b",
      "text": " [深さへの旅人の朝 https://dlt.kitetu.com/KNo.F85E/555F-6051]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1791323103,
      "updated": 1791323114
    },
    {
      "id": "6ac56bdd000000000059a09a",
      "text": "",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1791323103,
      "updated": 1791323103
    },
    {
      "id": "6ac591ec00000000000cc49e",
      "text": "[Hiro Aki.icon]",
      "userId": "65e1289acd012200235729c0",
      "created": 1791332844,
      "updated": 1791332845
    },
    {
      "id": "6ac591ed00000000000cc49f",
      "text": "\tおはようございます",
      "userId": "65e1289acd012200235729c0",
      "created": 1791332845,
      "updated": 1791332849
    },
    {
      "id": "6ac591f000000000000cc4a0",
      "text": "\t朝涼しいけど日中暑い",
      "userId": "65e1289acd012200235729c0",
      "created": 1791332849,
      "updated": 1791332865
    },
    {
      "id": "6ac5920200000000000cc4a1",
      "text": "\t\tというか仕事部屋が暑い",
      "userId": "65e1289acd012200235729c0",
      "created": 1791332866,
      "updated": 1791332889
    },
    {
      "id": "6ac5921a00000000000cc4a2",
      "text": "\t台風３姉妹、仲がいいな",
      "userId": "65e1289acd012200235729c0",
      "created": 1791332890,
      "updated": 1791345773
    },
    {
      "id": "6ac5c46c00000000000cc4a3",
      "text": "\t\t[https://gyazo.com/1665d8df0c16f658ea7b2f51a2d52ac2]",
      "userId": "65e1289acd012200235729c0",
      "created": 1791345773,
      "updated": 1791345775
    },
    {
      "id": "6ac5c46e00000000000cc4a4",
      "text": "\t\t27号、チョーイワンが通った北東へ進む形を追いかけるように28号ノロが来て、そのノロが通った跡を追いかけるように29号コグマが追う形になるのか",
      "userId": "65e1289acd012200235729c0",
      "created": 1791345775,
      "updated": 1791345859
    },
    {
      "id": "6ac591eb00000000000cc49d",
      "text": "",
      "userId": "65e1289acd012200235729c0",
      "created": 1791332844,
      "updated": 1791332844
    },
    {
      "id": "6ac59d280000000000a4f512",
      "text": "[atohs.icon]",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791335721,
      "updated": 1791335722
    },
    {
      "id": "6ac59d2a0000000000a4f514",
      "text": "　体調不良はかなりよくなってきた",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791335722,
      "updated": 1791335759
    },
    {
      "id": "6ac59d4f0000000000a4f515",
      "text": "　\t喉の痛みは増してきたような気がする",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791335759,
      "updated": 1791335772
    },
    {
      "id": "6ac59d5c0000000000a4f516",
      "text": "　\t咳をしすぎてちょっと胸のあたりも痛い",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791335772,
      "updated": 1791335790
    },
    {
      "id": "6ac59d6d0000000000a4f517",
      "text": "　\t頭は少し重いが、頭痛という感じはしない",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791335790,
      "updated": 1791335804
    },
    {
      "id": "6ac59d7c0000000000a4f518",
      "text": "　\t首のあたりは凝り固まっている",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791335804,
      "updated": 1791335812
    },
    {
      "id": "6ac59d840000000000a4f519",
      "text": "　\tまだ長時間立っているのはきつい",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791335812,
      "updated": 1791335824
    },
    {
      "id": "6ac59d9d0000000000a4f51b",
      "text": "　\tPC作業はだいたいできるが、タイピングスピートがあまり出ない",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791335837,
      "updated": 1791335854
    },
    {
      "id": "6ac5a25c0000000000a4f51d",
      "text": "　実験することは好きだが、何が何でも目標を達成したいみたいな胆力はないので、ちょっと社会に向いてない",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791337052,
      "updated": 1791337079
    },
    {
      "id": "6ac62e010000000000ff496f",
      "text": "　今週末の戯曲のリーディングワークショップで何読むかまだ決まっていない",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791372801,
      "updated": 1791372822
    },
    {
      "id": "6ac62e1d0000000000ff4970",
      "text": "　\t候補も特にない",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791372829,
      "updated": 1791372835
    },
    {
      "id": "6ac62e230000000000ff4971",
      "text": "　",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791372835,
      "updated": 1791372835
    },
    {
      "id": "6ac59f9800000000003d4db5",
      "text": "",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791336342,
      "updated": 1791336342
    },
    {
      "id": "6ac59f9800000000003d4db6",
      "text": "[taktamur.icon]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791336342,
      "updated": 1791336344
    },
    {
      "id": "6ac59f9b00000000003d4db7",
      "text": " ",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791336345,
      "updated": 1791336346
    },
    {
      "id": "6ac59d290000000000a4f513",
      "text": "",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791335721,
      "updated": 1791335721
    },
    {
      "id": "6ac5a8f40000000000beda71",
      "text": "[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791338740,
      "updated": 1791338742
    },
    {
      "id": "6ac5a8f60000000000beda72",
      "text": " c型のこて先やばい",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791338743,
      "updated": 1791338751
    },
    {
      "id": "6ac5a9020000000000beda73",
      "text": "  どんどんできる",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791338754,
      "updated": 1791338759
    },
    {
      "id": "6ac5a9520000000000beda78",
      "text": "   できる…できるぞ…！",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791338834,
      "updated": 1791338842
    },
    {
      "id": "6ac5a90d0000000000beda75",
      "text": "  鉛フリーはんだにしたことによる影響は意外にも出ていない",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791338765,
      "updated": 1791338797
    },
    {
      "id": "6ac5a92d0000000000beda76",
      "text": "   というか適切な太さのはんだを買ったのでむしろやりやすくなり、肩すかし",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791338798,
      "updated": 1791338819
    },
    {
      "id": "6ac5a9440000000000beda77",
      "text": "    前のは太すぎた",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791338820,
      "updated": 1791338825
    },
    {
      "id": "6ac5a9730000000000beda79",
      "text": "    太すぎると無駄にいっぱいハンダが流れてしまうのでやりにくいのだと思われる",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791338867,
      "updated": 1791338897
    },
    {
      "id": "6ac5ed400000000000561c35",
      "text": "    そうなんだ[takker.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791356225,
      "updated": 1791356235
    },
    {
      "id": "6ac5aa3c00000000003e684d",
      "text": "",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1791339069,
      "updated": 1791339069
    },
    {
      "id": "6ac5aa3c00000000003e684e",
      "text": "[terang.icon]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1791339069,
      "updated": 1791339070
    },
    {
      "id": "6ac5aa3d00000000003e684f",
      "text": "\t鳥瞰路線図",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1791339070,
      "updated": 1791339074
    },
    {
      "id": "6ac5aa4100000000003e6850",
      "text": "\t\t[https://maps.chizutodesign.com/chokanzu/?route=tokaido-shinkansen 東海道新幹線｜鳥瞰路線図]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1791339074,
      "updated": 1791339074
    },
    {
      "id": "6ac5aa6100000000003e6852",
      "text": "\t\t[https://maps.chizutodesign.com/chokanzu/?route=hokuriku-shinkansen 北陸新幹線｜鳥瞰路線図]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1791339105,
      "updated": 1791339105
    },
    {
      "id": "6ac5aa4300000000003e6851",
      "text": "\t\t眺めてて楽しい",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1791339075,
      "updated": 1791339080
    },
    {
      "id": "6ac5bb6b000000000034c8cd",
      "text": "\t\t\t+1[sta.icon][koyoshi.icon]",
      "userId": "6606ca1148e7150024f0f07d",
      "created": 1791343468,
      "updated": 1791347041
    },
    {
      "id": "6ac635f00000000000dd590f",
      "text": "\t\tすげ～[はるひ.icon]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791374832,
      "updated": 1791374834
    },
    {
      "id": "6ac635f20000000000dd5910",
      "text": "\t\t\t[https://note.com/chizutodesign/n/na3264d8fcdd3 吉田初三郎に敬意を込めて。全国の鉄道路線の鳥瞰図を作りました｜地図とかデザインとか]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791374834,
      "updated": 1791374837
    },
    {
      "id": "6ac635f40000000000dd5911",
      "text": "   よい‼️",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791374837,
      "updated": 1791374841
    },
    {
      "id": "6ac5cb8e0000000000c4798a",
      "text": "\t明日の読書会の準備せねば",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1791347598,
      "updated": 1791347605
    },
    {
      "id": "6ac5cb970000000000c4798b",
      "text": "\t\t明日の範囲は、[伊吹浩一『武器としての現代思想』]のフーコーの章とマルチチュードについての章",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1791347607,
      "updated": 1791347814
    },
    {
      "id": "6ac5cbb90000000000c4798c",
      "text": "\t\t今回の期は明日で終わりで、来月からは新しい本を読み始める",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1791347642,
      "updated": 1791347656
    },
    {
      "id": "6ac5cbf30000000000c4798d",
      "text": "\t\t[大澤真幸]の[『資本主義の〈その先〉へ』]を、いつものように3回に分けて読むことにした",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1791347700,
      "updated": 1791347741
    },
    {
      "id": "6ac5cc1c0000000000c4798f",
      "text": "\t\t\t[ご案内 https://slow-book202611202701.peatix.com/view]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1791347741,
      "updated": 1791347744
    },
    {
      "id": "6ac5a9080000000000beda74",
      "text": "",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791338760,
      "updated": 1791338761
    },
    {
      "id": "6ac5bdb500000000006b857b",
      "text": "[はるひ.icon]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791344054,
      "updated": 1791344056
    },
    {
      "id": "6ac5bdb700000000006b857d",
      "text": " 吉野家で朝ごはん食べた [牛鉄板焼肉定食]うま！",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791344058,
      "updated": 1791373258
    },
    {
      "id": "6ac630060000000000dd590c",
      "text": " おかげで元気",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791373318,
      "updated": 1791373318
    },
    {
      "id": "6ac62fd50000000000dd590b",
      "text": " おろしポン酢付きのを頼んだ。また、吉野家に行く前に、家でミディトマトと納豆を食べた。",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791373269,
      "updated": 1791373314
    },
    {
      "id": "6ac630110000000000dd590d",
      "text": " また食べたい。",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791373329,
      "updated": 1791373332
    },
    {
      "id": "6ac630580000000000dd590e",
      "text": " それはそうと朝食限定の定食を頼んだほうがよほど安いな。",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791373400,
      "updated": 1791373418
    },
    {
      "id": "6ac6198e0000000000c6148a",
      "text": " すぐ売り切れて諦めてたドメブラ服が高島屋のポップアップで1着だけ出ておりゲット！うれぴ",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791367567,
      "updated": 1791367628
    },
    {
      "id": "6ac61d160000000000c6149d",
      "text": " 洋服楽しいなやはり",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791368471,
      "updated": 1791368480
    },
    {
      "id": "6ac6201c0000000000c6149e",
      "text": " 欲しいものも色々見つけた。cpカンパニーのダウン。TATRASの異常に肌触りの良いモコモコ。y-3のコーデュロイのスウェット。",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791369245,
      "updated": 1791369479
    },
    {
      "id": "6ac6409b0000000000b47161",
      "text": " TATRASのモコモコかなり欲しいな",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791377563,
      "updated": 1791377569
    },
    {
      "id": "6ac61c5d0000000000c61492",
      "text": " 音声入力を常態化させたいパソコンでマイ",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791368285,
      "updated": 1791368312
    },
    {
      "id": "6ac61c7a0000000000c61493",
      "text": "マイクおいとけばいいのかなわからん",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791368314,
      "updated": 1791368327
    },
    {
      "id": "6ac61c870000000000c61495",
      "text": "文文字起こし、ソフトとかも何かいい感じのがあるといいよね",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791368327,
      "updated": 1791368338
    },
    {
      "id": "6ac61c940000000000c61497",
      "text": "ちちなみに、スクラップボックスはiPhoneの音声認識があまりうまく反映されないゴミ",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791368341,
      "updated": 1791368359
    },
    {
      "id": "6ac5bdb500000000006b857c",
      "text": "",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791344054,
      "updated": 1791344054
    },
    {
      "id": "6ac5c63900000000005d75bf",
      "text": "[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791346233,
      "updated": 1791346234
    },
    {
      "id": "6ac5c63900000000005d75c0",
      "text": "\t吉野家いいなぁ",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791346234,
      "updated": 1791346237
    },
    {
      "id": "6ac5c63c00000000005d75c1",
      "text": "\t\t松屋もいい",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791346237,
      "updated": 1791346238
    },
    {
      "id": "6ac5c63e00000000005d75c2",
      "text": "\t\tすき家じゃない牛丼チェーンが近くにほしいんご",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791346239,
      "updated": 1791346249
    },
    {
      "id": "6ac5c64800000000005d75c3",
      "text": "\t\t松屋が一番いいかも",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791346249,
      "updated": 1791346252
    },
    {
      "id": "6ac5c67500000000005d75c4",
      "text": "\t誰も見てないprivateプロジェクトでもはしゃぐンゴ",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791346294,
      "updated": 1791346358
    },
    {
      "id": "6ac5c67f00000000005d75c5",
      "text": "\t\t[https://gyazo.com/efb6927a4909987721ce20de6fe6fd6f]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791346304,
      "updated": 1791346305
    },
    {
      "id": "6ac5c68000000000005d75c6",
      "text": "\t\t一種の鍛錬なのである。このようなノリは一朝一夕にはつくれない",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791346305,
      "updated": 1791346319
    },
    {
      "id": "6ac5c68e00000000005d75c7",
      "text": "\t\t僕はリアルではうんちな陰キャチー牛なので、ネットで明るく振る舞える練習に投資するのは生存戦略の一",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791346319,
      "updated": 1791346334
    },
    {
      "id": "6ac601b600000000006b8582",
      "text": "\t\tじきに漏洩するからどこではしゃいでも🆗[はるひ.icon]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791361463,
      "updated": 1791361492
    },
    {
      "id": "6ac60d7b00000000000d976f",
      "text": "\t\t\t草[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791364476,
      "updated": 1791364478
    },
    {
      "id": "6ac5e36c0000000000d8a81c",
      "text": "\t久々に[クチャラー]に遭遇",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791353707,
      "updated": 1791353895
    },
    {
      "id": "6ac5f51b00000000008c0871",
      "text": "\t[【大島璃音】これが若さか…スマホのフリック入力がめっちゃ速いのんちゃん ウェザーニュースLive切り抜き - YouTube https://www.youtube.com/watch?v=8fnroea9YVw]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791358237,
      "updated": 1791358237
    },
    {
      "id": "6ac5f51c00000000008c0872",
      "text": "\t\tフリックこんな早いのすげーな",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791358237,
      "updated": 1791358242
    },
    {
      "id": "6ac5f52100000000008c0873",
      "text": "\t\tフリック、僕は結局諦めたわ、タッチパネルに馴染める才能？がなかった",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791358242,
      "updated": 1791358256
    },
    {
      "id": "6ac61c110000000000c61491",
      "text": "\t\tこのアプリおもろそう[はるひ.icon]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791368210,
      "updated": 1791368247
    },
    {
      "id": "6ac5e0ca0000000000fb6539",
      "text": "",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791353035,
      "updated": 1791353035
    },
    {
      "id": "6ac5e0ca0000000000fb653a",
      "text": "[takker.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791353035,
      "updated": 1791353037
    },
    {
      "id": "6ac5eb2f0000000000561c2e",
      "text": " [/motoso/LLMで研究を自動化#6a2cd2aa0000000000ff94c1]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791355697,
      "updated": 1791355699
    },
    {
      "id": "6ac5eb310000000000561c2f",
      "text": "  自分は今大学院生だがこれをやってる",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791355699,
      "updated": 1791355716
    },
    {
      "id": "6ac5eb450000000000561c30",
      "text": "  1ヶ月くらいで、全く解析方法に詳しくない分野のデータを解析しきった",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791355718,
      "updated": 1791355769
    },
    {
      "id": "6ac5ebd40000000000561c31",
      "text": "  更に理論的な説明が出来ないか、新たに論文を検索させて、それをヒントに新たな解析手法を出して実行して補強する",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791355861,
      "updated": 1791355973
    },
    {
      "id": "6ac5ec790000000000561c32",
      "text": "   [Gemini 3.8 Flash]だとソースを取り違えたのでもう少し工夫する必要ありそう",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791356026,
      "updated": 1791356074
    },
    {
      "id": "6ac6eeda000000000012c085",
      "text": "  自動化できない律速が多いジャンルだろうから、自動化できるところは自動化しきって、できないところにリソースを割きたいと自分なら思うかな[基素.icon]",
      "userId": "59fb21121207900012774b17",
      "created": 1791422170,
      "updated": 1791422239
    },
    {
      "id": "6ac6ef38000000000012c086",
      "text": "   でも理解はしないといけない。まだそこはLLMに完全に任せると結果がしょぼくなるから。みたいな感覚。",
      "userId": "59fb21121207900012774b17",
      "created": 1791422265,
      "updated": 1791422317
    },
    {
      "id": "6ac5e0cd0000000000fb653b",
      "text": " 自分の長所って何だろ",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791353038,
      "updated": 1791353058
    },
    {
      "id": "6ac5e0e10000000000fb653c",
      "text": "  ははに聞いたら一つのことに集中できることと言われたが、ほんまかいな",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791353058,
      "updated": 1791353085
    },
    {
      "id": "6ac5e1100000000000fb653d",
      "text": "  [過集中]は心配だが凄いなと思ってる、ユーザースクリプト開発とか[sta.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791353106,
      "updated": 1791424547
    },
    {
      "id": "6ac5e97a0000000000561c2b",
      "text": "   そういえばそんなことしてた、遠い記憶[takker.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791355259,
      "updated": 1791355278
    },
    {
      "id": "6ac5e9990000000000561c2c",
      "text": "   確かに一度集中してかつやることに迷いがなければ、身体が動く限りずっとやれる",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791355291,
      "updated": 1791355348
    },
    {
      "id": "6ac5e9e90000000000561c2d",
      "text": "  幅広い分野に興味がある、はそうでもなさそう",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791355370,
      "updated": 1791356156
    },
    {
      "id": "6ac5ed000000000000561c33",
      "text": "   どこで分野を区切るかにもよるが",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791356161,
      "updated": 1791356179
    },
    {
      "id": "6ac5ed120000000000561c34",
      "text": "  [大抵のことにやれば興味を持てる]はありそう？",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791356179,
      "updated": 1791356202
    },
    {
      "id": "6ac61b300000000000c6148d",
      "text": "　なんで自分の長所を聞いたかというと、今日23:59締切の卓越大学院教育プログラムWINGS-CFSの申請スライドを作るのに必要でして",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791367984,
      "updated": 1791382054
    },
    {
      "id": "6ac6522500000000009867c1",
      "text": "　 まあ自分で思いつくことを書くしかないか",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791382056,
      "updated": 1791382062
    },
    {
      "id": "6ac6615f00000000009175f2",
      "text": "　締切4分前くらいに応募書類出した！",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791385953,
      "updated": 1791385960
    },
    {
      "id": "6ac6616700000000009175f3",
      "text": "　　慌てて色々記入して提出したから、もしかしたら不備あるかも……",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791385960,
      "updated": 1791386016
    },
    {
      "id": "6ac651e900000000009867c0",
      "text": "",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791382015,
      "updated": 1791382015
    },
    {
      "id": "6ac5fc6300000000005b780d",
      "text": "[mtane0412.icon]",
      "userId": "5ae7fecf7766b7001455cbd3",
      "created": 1791360099,
      "updated": 1791360099
    },
    {
      "id": "6ac5fc6300000000005b780e",
      "text": " 職場体験に来てた高校生がいたのでYakuza LLM Wikiを見せてた",
      "userId": "5ae7fecf7766b7001455cbd3",
      "created": 1791360099,
      "updated": 1791360112
    },
    {
      "id": "6ac5fc6200000000005b780c",
      "text": "",
      "userId": "5ae7fecf7766b7001455cbd3",
      "created": 1791360098,
      "updated": 1791360098
    },
    {
      "id": "6ac5ffec0000000000436710",
      "text": "[Rutile3.icon]",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1791361005,
      "updated": 1791361005
    },
    {
      "id": "6ac5ffed0000000000436711",
      "text": " [https://chromewebstore.google.com/detail/tab-link-exporter/amhdckliiakknahhmcfljaidkkkojboe Tab Link Exporter - Chrome ウェブストア]",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1791361005,
      "updated": 1791361023
    },
    {
      "id": "6ac602c0000000000043671a",
      "text": "　 [https://gyazo.com/d9348d64f53f4574041b9c0a3c72faa4]",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1791361727,
      "updated": 1791361727
    },
    {
      "id": "6ac601da0000000000436713",
      "text": "  公開できた。",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1791361497,
      "updated": 1791361545
    },
    {
      "id": "6ac641c70000000000492385",
      "text": "  　🎉[seibe.icon][takker.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791377863,
      "updated": 1791382015
    },
    {
      "id": "6ac602300000000000436716",
      "text": "  今回のアップデートで、カスタム書式が使えるようになった。",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1791361584,
      "updated": 1791361869
    },
    {
      "id": "6ac6023c0000000000436717",
      "text": "  　`⬜[{{url}} {{title}}]`とか。",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1791361594,
      "updated": 1791361862
    },
    {
      "id": "6ac602860000000000436718",
      "text": "  作った理由",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1791361669,
      "updated": 1791362027
    },
    {
      "id": "6ac603ec000000000043671d",
      "text": "   ニュースや記事を探すとき、新しいタブで気になるページを開きまくる。",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1791362027,
      "updated": 1791362027
    },
    {
      "id": "6ac603ec000000000043671e",
      "text": "   ただ、開きすぎるとChromeが重くなる。",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1791362027,
      "updated": 1791362033
    },
    {
      "id": "6ac603ec000000000043671f",
      "text": "   なので、いったんScrapboxの日記に退避して、読み終わったらチェックを付ける運用にしたかった。",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1791362027,
      "updated": 1791362034
    },
    {
      "id": "6ac603ec0000000000436720",
      "text": "  自分が欲しかった機能は一通り満たせたので、満足。",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1791362027,
      "updated": 1791362030
    },
    {
      "id": "6ac6020d0000000000436715",
      "text": "",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1791361549,
      "updated": 1791361549
    },
    {
      "id": "6ac651c90000000000c99354",
      "text": "[inajob.icon]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791381962,
      "updated": 1791381962
    },
    {
      "id": "6ac651cb0000000000c99356",
      "text": "\tポッドキャストの編集を[Audacity]から[Blender]に変更しようとしている",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791381963,
      "updated": 1791381976
    },
    {
      "id": "6ac651d90000000000c99357",
      "text": "\t\tAudacityのマクロがあまり好きではない",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791381977,
      "updated": 1791381984
    },
    {
      "id": "6ac651e30000000000c99358",
      "text": "\t\t\tヘッドレスで動かない",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791381987,
      "updated": 1791381995
    },
    {
      "id": "6ac651ec0000000000c99359",
      "text": "\t\t\tGUIポチポチをそのままスクリプトにするような構造",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791381996,
      "updated": 1791382005
    },
    {
      "id": "6ac651f70000000000c9935a",
      "text": "\t\tBlenderは本来そういうツールではない・・",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791382007,
      "updated": 1791382016
    },
    {
      "id": "6ac6521d0000000000c9935b",
      "text": "\t\t\t[https://gyazo.com/59a262dcd07d86f0c98d42bdde3d670f]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791382046,
      "updated": 1791382085
    },
    {
      "id": "6ac652450000000000c9935c",
      "text": "\t\t\t画面はそれっぽい",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791382085,
      "updated": 1791382092
    },
    {
      "id": "6ac6617700000000009175f4",
      "text": "\t\t\tBlenderって音声データ編集もできるんだ[takker.icon]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791385976,
      "updated": 1791386119
    },
    {
      "id": "6ac6620700000000009c6402",
      "text": "\t\t\t映像編集の機能の音声部分だけ使ってる感じですね[inajob.icon]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791386119,
      "updated": 1791386132
    },
    {
      "id": "6ac6621400000000009c6403",
      "text": "\t\t\t\t音声処理はトリミングとフェードイン・フェードアウトとかしかできない",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791386133,
      "updated": 1791386209
    },
    {
      "id": "6ac6621f00000000009c6404",
      "text": "\t\t\t\tラウドネスノーマライズとか無音の切りつめとかは事前にffmpegとかでやったうえで、Blenderで並べてつなげるという感じ",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791386143,
      "updated": 1791386168
    },
    {
      "id": "6ac65c3d000000000079f9fd",
      "text": "\t\t！？[はるひ.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791384638,
      "updated": 1791385975
    },
    {
      "id": "6ac651ca0000000000c99355",
      "text": "",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791381962,
      "updated": 1791381962
    },
