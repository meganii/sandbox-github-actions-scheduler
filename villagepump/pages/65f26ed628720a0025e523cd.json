    {
      "id": "6aae95db00000000008e3554",
      "text": "[LZH]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789826526,
      "updated": 1789826726
    },
    {
      "id": "6aae96d700000000008e3556",
      "text": "[ファイルアーカイブ]ソフトウェアまたはファイル形式の一つ。",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789826777,
      "updated": 1789826998
    },
    {
      "id": "65f26f105b98c20000668bfb",
      "text": "LHAでデータ圧縮をして保存することを「凍らせる」（freeze）",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1710386960,
      "updated": 1710387138
    },
    {
      "id": "65f26f4e5b98c20000668bfc",
      "text": "LHAで圧縮したファイルを元に戻すことを「解凍する」（melt）という",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1710387023,
      "updated": 1710387096
    },
    {
      "id": "65f26f605b98c20000668bfd",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1710387040,
      "updated": 1710387040
    },
    {
