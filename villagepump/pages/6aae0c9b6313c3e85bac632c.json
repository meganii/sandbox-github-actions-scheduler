    {
      "id": "6aae0c9b6313c3e85bac632c",
      "text": "ブラケット形式でページリンクをコピーするUserScript",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1789791392,
      "updated": 1789791414
    },
    {
      "id": "6aae0f150000000000145399",
      "text": "[UserScript.icon]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1789792021,
      "updated": 1789792029
    },
    {
      "id": "6aae0f21000000000014539a",
      "text": "",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1789792033,
      "updated": 1789792033
    },
    {
      "id": "6aae0d88000000000060898a",
      "text": " `[/プロジェクト名/ページ名]`のブラケット形式でページリンクをコピーできるようにする",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1789791652,
      "updated": 1789791903
    },
    {
      "id": "6aae0d6d0000000000608989",
      "text": "  外部プロジェクトにページリンクを貼るときの形式",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1789791598,
      "updated": 1789791830
    },
    {
      "id": "6aae0d5c0000000000608988",
      "text": "  同一プロジェクトで貼り付けるとプロジェクト名の部分が消えて",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1789791580,
      "updated": 1789791834
    },
    {
      "id": "6aae0e5e000000000060898f",
      "text": "   通常のプロジェクト内リンクに変換される？",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1789791839,
      "updated": 1789792059
    },
    {
      "id": "6aae0e700000000000608990",
      "text": "   `[/villagepump/イドバタニシ] -> [イドバタニシ]`",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1789791856,
      "updated": 1789792082
    },
    {
      "id": "6aae2ec10000000000c2e289",
      "text": "",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1789800129,
      "updated": 1789800129
    },
    {
      "id": "6aae0ce3000000000060896d",
      "text": "$ import 'https://scrapbox.io/api/code/villagepump/ブラケット形式でページリンクをコピーするUserScript/script.js';",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1789791459,
      "updated": 1789791566
    },
    {
      "id": "6aae0dfc000000000060898c",
      "text": "",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1789791740,
      "updated": 1789792405
    },
    {
      "id": "6aae0cee000000000060896f",
      "text": "code:script.js",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1789791470,
      "updated": 1789791574
    },
    {
      "id": "6aae0cf50000000000608970",
      "text": " scrapbox.PageMenu.addMenu({",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1789791477,
      "updated": 1789800147
    },
    {
      "id": "6aae2db50000000000c2e27d",
      "text": "   title: 'CopyAsBracket',",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1789799861,
      "updated": 1789799861
    },
    {
      "id": "6aae2db50000000000c2e27e",
      "text": "   icon: 'kamon kamon-copy',",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1789799861,
      "updated": 1789799861
    },
    {
      "id": "6aae2db50000000000c2e27f",
      "text": "   onClick: () => {navigator.clipboard.writeText(`[${decodeURIComponent(new URL(document.URL).pathname)}]`)}",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1789799861,
      "updated": 1789800213
    },
    {
      "id": "6aae2db50000000000c2e280",
      "text": " });",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1789799861,
      "updated": 1789799861
    },
