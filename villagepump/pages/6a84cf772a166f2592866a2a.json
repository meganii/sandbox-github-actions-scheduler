      "updated": 1787090867
    },
    {
      "id": "6a84e59400000000006887a8",
      "text": "8小節：イントロ",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787094421,
      "updated": 1787094426
    },
    {
      "id": "6a84e59500000000006887a9",
      "text": "\t調：E-リディアン",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787094421,
      "updated": 1787094426
    },
    {
      "id": "6a84e59500000000006887aa",
      "text": "\t\t音セット：A-dur",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787094421,
      "updated": 1787094426
    },
    {
      "id": "6a84e59500000000006887ab",
      "text": "\tメロディ",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787094421,
      "updated": 1787094426
    },
    {
      "id": "6a84e59500000000006887ac",
      "text": "\t\t問掛：E B E D",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787094421,
      "updated": 1787094426
    },
    {
      "id": "6a84e59500000000006887ad",
      "text": "\t\t\t1 5 1 b7",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787094421,
      "updated": 1787094426
    },
    {
      "id": "6a84e59500000000006887ae",
      "text": "\t\t応答：E E G, E E A, E E Ais, E E B\t`// ポケモンフレーズ`",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787094421,
      "updated": 1787094426
    },
    {
      "id": "6a84e59500000000006887af",
      "text": "\t\t\t1 1 3, 1 1 5↓↓, 1 1 5↓, 1 1 5",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787094421,
      "updated": 1787094426
    },
    {
      "id": "6a84e59500000000006887b0",
      "text": "\t\t問掛：F C F D",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787094421,
      "updated": 1787094426
    },
    {
      "id": "6a84e59500000000006887b1",
      "text": "\t\t\t2 6 2 b7\t`// 末尾を期待される5から下げることで落ち着きを出す`",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787094421,
      "updated": 1787094426
    },
    {
      "id": "6a84e59500000000006887b2",
      "text": "\t\t応答：F F G, F F H, F F B F F C\t`// EEG~EEBを半音上げる`",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787094421,
      "updated": 1787094426
    },
    {
      "id": "6a84e59500000000006887b3",
      "text": "\t\t\t2 2 3, 2 2 6↓↓, 2 2 6↓, 2 2 6",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787094421,
      "updated": 1787094426
    },
    {
      "id": "6a84e59500000000006887b4",
      "text": "\tベース",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787094421,
      "updated": 1787094426
    },
    {
      "id": "6a84e59500000000006887b5",
      "text": "\t\tEパワー",
      "userId": "6436266c7ac3c0001bed60e6",
