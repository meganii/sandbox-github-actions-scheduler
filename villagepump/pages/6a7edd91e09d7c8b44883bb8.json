    {
      "id": "6a7edd91e09d7c8b44883bb8",
      "text": "井戸端詠み人知らず部",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786699157,
      "updated": 1786699180
    },
    {
      "id": "6a7eddad00000000009888e3",
      "text": "[詠み人知らず](ゲーム)、井戸端でやったら面白そう",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786699181,
      "updated": 1786699217
    },
    {
      "id": "6a7edf0800000000009888f3",
      "text": "",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786699529,
      "updated": 1786699529
    },
    {
      "id": "6a7eddd100000000009888e5",
      "text": " 1文字ずつ書いていって[川柳]を作るゲーム",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786699217,
      "updated": 1786699531
    },
    {
      "id": "6a7ede3a00000000009888e7",
      "text": "  お題があってそれに沿った川柳を作ることを目指す",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786699322,
      "updated": 1786699534
    },
    {
      "id": "6a7ede4a00000000009888e8",
      "text": " 「井戸端詠み人知らず部 お題」みたいなタイトルでページ作ってピンしといたらいいかも",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786699338,
      "updated": 1786699484
    },
    {
      "id": "6a7ede9000000000009888e9",
      "text": "  [井戸端詠み人知らず部 お盆]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786699408,
      "updated": 1786699483
    },
    {
      "id": "6a7edf1200000000009888f4",
      "text": "   作ってみた",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786699539,
      "updated": 1786699542
    },
    {
      "id": "6a7edecf00000000009888f0",
      "text": " 1回書いた人は2回書き込めないみたいなのだと厳しそう",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786699471,
      "updated": 1786699497
    },
    {
      "id": "6a7edee900000000009888f1",
      "text": "  N文字あけたらまた書いていいみたいなルールあると良さそう",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786699497,
      "updated": 1786699515
    },
    {
      "id": "6a7edefb00000000009888f2",
      "text": "   3文字くらいか？",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786699515,
      "updated": 1786699520
    },
