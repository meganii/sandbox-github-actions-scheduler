    {
      "id": "6a63ebb3f83cb27327d5eb69",
      "text": "希哲荘",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1784933302,
      "updated": 1784933309
    },
    {
      "id": "6a63eb7e0000000000cca3cd",
      "text": " 現在の私と[希哲館事業]の本拠地[hiro.icon]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1784933309,
      "updated": 1784933367
    },
    {
      "id": "6a63ec700000000000cca3d6",
      "text": "  通称ゴールデンハウス",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1784933552,
      "updated": 1784933557
    },
    {
      "id": "6a63eb780000000000cca3cc",
      "text": "  [浦安]元町中心部に所在する一戸建て",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1784933303,
      "updated": 1784933401
    },
    {
      "id": "6a694fe00000000000c8cb76",
      "text": "   市内最古の寺社、市の有形文化財、初代市長邸がすぐ近所に集まっている土地柄",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1785286690,
      "updated": 1785286750
    },
    {
      "id": "6a63ebf00000000000cca3d1",
      "text": "  [希哲館浦安本館]が出来るまでの希哲館仮本館",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1784933423,
      "updated": 1784933452
    },
    {
      "id": "6a63efdb0000000000cca3d8",
      "text": "   [希哲館手の平本館]も安置されている",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1784934426,
      "updated": 1784934435
    },
    {
      "id": "6a63eb970000000000cca3ce",
      "text": "  [https://dlt.kitetu.com/KNo.F85E/0758-3443.webp?20260729095706]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1784933334,
      "updated": 1785286656
    },
    {
      "id": "6a694fbe0000000000c8cb75",
      "text": "   なんとか医院みたいな所でしか見ない格子状の窓がある[yosider.icon]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1785286656,
      "updated": 1785334147
    },
    {
      "id": "6a6a2a1c0000000000a68481",
      "text": "    確かに言われてみれば個人宅だと珍しい[zatsma.icon]",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1785342492,
      "updated": 1785342510
    },
    {
      "id": "6a6a30550000000000815a64",
      "text": "   ドアがなんか良い[はるひ.icon]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1785344087,
      "updated": 1785344110
    },
