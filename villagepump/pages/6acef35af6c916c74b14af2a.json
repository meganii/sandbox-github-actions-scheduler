{
  "id": "6acef35af6c916c74b14af2a",
  "title": "カレンダーを表示するUserCSS",
  "created": 1791947612,
  "updated": 1791955442,
  "lines": [
    {
      "id": "6acef35af6c916c74b14af2a",
      "text": "カレンダーを表示するUserCSS",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947612,
      "updated": 1791947612
    },
    {
      "id": "6acef35c0000000000bcb53e",
      "text": "[calendar]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947612,
      "updated": 1791947698
    },
    {
      "id": "6acef3b10000000000bcb53f",
      "text": "code:style.css",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947698
    },
    {
      "id": "6acef3b10000000000bcb540",
      "text": " @media only screen and (min-width: 480px) {",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947698
    },
    {
      "id": "6acef3b10000000000bcb541",
      "text": "   a[type=\"hashTag\"][href=\"/villagepump/calendar\"]::after {",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947727
    },
    {
      "id": "6acef3b10000000000bcb542",
      "text": "     --scale: 0.5;",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947698
    },
    {
      "id": "6acef3b10000000000bcb543",
      "text": "     --width: calc(590px * var(--scale));",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947698
    },
    {
      "id": "6acef3b10000000000bcb544",
      "text": "     --height: calc(590px * var(--scale));",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947698
    },
    {
      "id": "6acef3b10000000000bcb545",
      "text": "     ",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947698
    },
    {
      "id": "6acef3b10000000000bcb546",
      "text": "     position: fixed;",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947698
    },
    {
      "id": "6acef3b10000000000bcb547",
      "text": "     top: 25px;",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947698
    },
    {
      "id": "6acef3b10000000000bcb548",
      "text": "     right: 10px;",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947698
    },
    {
      "id": "6acef3b10000000000bcb549",
      "text": "     display: block;",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947698
    },
    {
      "id": "6acef3b10000000000bcb54a",
      "text": "     width: var(--width);",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947698
    },
    {
      "id": "6acef3b10000000000bcb54b",
      "text": "     height: var(--height);",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947698
    },
    {
      "id": "6acef3b10000000000bcb54c",
      "text": "     content: \"\";",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947698
    },
    {
      "id": "6acef3b10000000000bcb54d",
      "text": "     background-image: url(\"https://icon.soui.dev/month.svg\");",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947698
    },
    {
      "id": "6acef3b10000000000bcb54e",
      "text": "     background-size: var(--width) var(--height);",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947698
    },
    {
      "id": "6acef3b10000000000bcb54f",
      "text": "    }",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947698
    },
    {
      "id": "6acef3b10000000000bcb550",
      "text": " }",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947698
    },
    {
      "id": "6acef3b10000000000bcb551",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791947698,
      "updated": 1791947698
    },
