{
  "id": "6a845e12b7b22c8289576429",
  "title": "たこ焼きを食う",
  "created": 1787059731,
  "updated": 1787062638,
  "lines": [
    {
      "id": "6a845e12b7b22c8289576429",
      "text": "たこ焼きを食う",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059731,
      "updated": 1787059731
    },
    {
      "id": "6a845e120000000000b54cc4",
      "text": "[たこ焼き]を食う",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059731,
      "updated": 1787059734
    },
    {
      "id": "6a845e170000000000b54cd0",
      "text": "",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059736,
      "updated": 1787059736
    },
    {
      "id": "6a845e120000000000b54cc5",
      "text": "たこやきを",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059731,
      "updated": 1787059731
    },
    {
      "id": "6a845e120000000000b54cc6",
      "text": " ソースで食う[zatsma.icon][yosider.icon][terang.icon]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787059731,
      "updated": 1787060408
    },
    {
      "id": "6a845e120000000000b54cc7",
      "text": " 塩で食う[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059731,
      "updated": 1787059731
    },
    {
      "id": "6a84608500000000001b9068",
      "text": "  [たこ焼きを塩で食う]",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1787060358,
      "updated": 1787060366
    },
    {
      "id": "6a846955000000000033c4f9",
      "text": "  たまたま行った店で塩たこやきがあり頼んでみたらハマってしまった[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787062613,
      "updated": 1787062638
    },
    {
      "id": "6a845e120000000000b54cc8",
      "text": " ポン酢で食う[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059731,
      "updated": 1787059731
    },
    {
      "id": "6a845e120000000000b54cc9",
      "text": " 出汁で食う[zatsma.icon]",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1787059731,
      "updated": 1787059825
    },
    {
      "id": "6a845e390000000000b54cd8",
      "text": " ケチャップで食う",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059770,
      "updated": 1787059773
    },
    {
      "id": "6a845eb00000000000b54cd9",
      "text": " 朝食う",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059888,
      "updated": 1787059891
    },
    {
      "id": "6a845eb20000000000b54cda",
      "text": " 昼食う[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059891,
      "updated": 1787059893
    },
    {
      "id": "6a845eb50000000000b54cdb",
      "text": " 夜食う[zatsma.icon][caki.icon][terang.icon]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787059893,
      "updated": 1787060414
    },
    {
      "id": "6a845ed500000000006ed277",
      "text": "  入手できる場所さえ近くにあれば[夕方のおやつ]として優秀なのではないか[zatsma.icon]",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1787059926,
      "updated": 1787059951
    },
    {
      "id": "6a845eb70000000000b54cdc",
      "text": " ごはんと食う",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059896,
      "updated": 1787059899
    },
    {
      "id": "6a845ecb0000000000b54cdd",
      "text": " ビールと食う[yosider.icon]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1787059916,
      "updated": 1787060149
    },
    {
      "id": "6a8460ea00000000009cb9cf",
      "text": "",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787060459,
      "updated": 1787060459
    },
    {
      "id": "6a8460ea00000000009cb9d0",
      "text": "紅生姜を",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787060459,
      "updated": 1787060461
    },
    {
      "id": "6a8460ed00000000009cb9d1",
      "text": "\t入れる[terang.icon]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787060462,
      "updated": 1787060466
    },
    {
      "id": "6a8460ef00000000009cb9d2",
      "text": "\t入れない",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787060464,
      "updated": 1787060465
    },
    {
      "id": "6a845e120000000000b54cca",
      "text": "",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059731,
      "updated": 1787059731
    },
    {
      "id": "6a845e290000000000b54cd4",
      "text": "かつぶしを",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059753,
      "updated": 1787059756
    },
    {
      "id": "6a845e2c0000000000b54cd5",
      "text": " かける[caki.icon][zatsma.icon][yosider.icon][terang.icon]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787059756,
      "updated": 1787060420
    },
    {
      "id": "6a845e2f0000000000b54cd6",
      "text": " かけない",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059760,
      "updated": 1787059761
    },
    {
      "id": "6a845e310000000000b54cd7",
      "text": "",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059761,
      "updated": 1787059761
    },
    {
      "id": "6a845e120000000000b54ccb",
      "text": "マヨを",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059731,
      "updated": 1787059731
    },
    {
      "id": "6a845e120000000000b54ccc",
      "text": " かける[zatsma.icon][yosider.icon]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1787059731,
      "updated": 1787060143
    },
    {
      "id": "6a845e120000000000b54ccd",
      "text": " かけない[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059731,
      "updated": 1787059731
    },
    {
      "id": "6a8460cd00000000009cb9ce",
      "text": " 気分次第[terang.icon]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787060430,
      "updated": 1787060433
    },
    {
      "id": "6a845e120000000000b54cce",
      "text": "",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059731,
      "updated": 1787059731
    },
    {
      "id": "6a845e1d0000000000b54cd1",
      "text": "青のりを",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059742,
      "updated": 1787059744
    },
    {
      "id": "6a845e200000000000b54cd2",
      "text": " かける[caki.icon][zatsma.icon][yosider.icon][terang.icon]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787059744,
      "updated": 1787060426
    },
    {
      "id": "6a845e220000000000b54cd3",
      "text": " かけない",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787059747,
      "updated": 1787059748
    },
