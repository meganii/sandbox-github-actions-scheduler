  "lines": [
    {
      "id": "6a867d5002a2f939720ae9e7",
      "text": "アイドルマスター XENOGLOSSIA",
      "userId": "660605441655f300254ac7c2",
      "created": 1787198841,
      "updated": 1787198841
    },
    {
      "id": "6a867d780000000000e20e42",
      "text": "[アイドルマスター ゼノグラシア]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787198841,
      "updated": 1787198844
    },
    {
      "id": "6a8681930000000000e20e6a",
      "text": "\tアニメーション制作：[サンライズ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787199892,
      "updated": 1787199897
    },
    {
      "id": "6a867d7e0000000000e20e44",
      "text": "\t[ロボットアニメ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787198846,
      "updated": 1787198862
    },
    {
      "id": "6a867f070000000000e20e4c",
      "text": "\t[アイマス]では珍しくOPはアイドルが歌わず[橋本みゆき]が1・2クール共に担当",
      "userId": "660605441655f300254ac7c2",
      "created": 1787199239,
      "updated": 1787199258
    },
    {
      "id": "6a868c700000000000ee06ed",
      "text": "\t\t1クール：[微熱S.O.S!!]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787202673,
      "updated": 1787202846
    },
    {
      "id": "6a868c770000000000ee06ee",
      "text": "\t\t2クール：[残酷よ希望となれ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787202680,
      "updated": 1787202834
    },
    {
      "id": "6a867d790000000000e20e43",
      "text": "\t[THE IDOLM@STER]の初代AC版に出てたアイドルが出る",
      "userId": "660605441655f300254ac7c2",
      "created": 1787198841,
      "updated": 1787199866
    },
    {
      "id": "6a867e2a0000000000e20e48",
      "text": "\t\tアイドルの声優は全員異なる",
      "userId": "660605441655f300254ac7c2",
      "created": 1787199018,
      "updated": 1787199093
    },
    {
      "id": "6a867d980000000000e20e45",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1787198872,
      "updated": 1787199121
    },
    {
      "id": "6a867d980000000000e20e46",
      "text": "table:登場アイドル（765プロのみ）",
      "userId": "660605441655f300254ac7c2",
      "created": 1787198873,
      "updated": 1787199832
    },
    {
      "id": "6a867f520000000000e20e4e",
      "text": " アイドル\tオリジナルCV\tゼノクラシアCV",
      "userId": "660605441655f300254ac7c2",
      "created": 1787199314,
      "updated": 1787199613
    },
    {
      "id": "6a867f790000000000e20e50",
      "text": "　[天海春香]\t[中村繪里子]\t[井口裕香]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787199353,
      "updated": 1787199636
    },
    {
      "id": "6a8680650000000000e20e5d",
      "text": "　[高槻やよい]\t[仁後真耶子] \t[小清水亜美]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787199590,
      "updated": 1787199796
    },
    {
      "id": "6a8680650000000000e20e5e",
      "text": "　[星井美希]\t[長谷川明子]\t未登場",
      "userId": "660605441655f300254ac7c2",
      "created": 1787199590,
      "updated": 1787199810
    },
    {
      "id": "6a8680650000000000e20e5f",
      "text": " [萩原雪歩]\t[浅倉杏美]\t[堀江由衣]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787199590,
      "updated": 1787199659
    },
    {
      "id": "6a8680650000000000e20e60",
      "text": " [菊地真]\t[平田宏美]\t[喜多村英梨]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787199590,
      "updated": 1787199699
    },
    {
      "id": "6a8680650000000000e20e61",
      "text": " [如月千早]\t[今井麻美]\t[清水香里]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787199590,
      "updated": 1787199781
    },
    {
      "id": "6a8680650000000000e20e62",
      "text": " [双海亜美]\t[下田麻美]\t[名塚佳織]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787199590,
      "updated": 1787199709
    },
    {
      "id": "6a8680650000000000e20e63",
      "text": " [双海真美]\t[下田麻美]\t[斎藤桃子]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787199590,
      "updated": 1787199721
    },
    {
      "id": "6a8680650000000000e20e64",
      "text": " [三浦あずさ]\t[たかはし智秋]\t[櫻井智]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787199590,
      "updated": 1787199736
    },
    {
      "id": "6a8680650000000000e20e65",
      "text": " [水瀬伊織]\t[釘宮理恵]\t[田村ゆかり]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787199590,
      "updated": 1787199688
    },
    {
      "id": "6a8680650000000000e20e66",
      "text": " [秋月律子]\t[若林直美]\t[中原麻衣]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787199590,
      "updated": 1787199752
    },
    {
      "id": "6a8680650000000000e20e67",
      "text": " [我那覇響]\t[沼倉愛美] \t未登場",
      "userId": "660605441655f300254ac7c2",
      "created": 1787199590,
      "updated": 1787199814
    },
    {
      "id": "6a8680650000000000e20e68",
      "text": " [四条貴音]\t[原由実]\t未登場",
      "userId": "660605441655f300254ac7c2",
      "created": 1787199590,
      "updated": 1787199815
    },
    {
      "id": "6a8680650000000000e20e69",
      "text": " [音無小鳥]\t[滝田樹里]\t未登場",
      "userId": "660605441655f300254ac7c2",
      "created": 1787199590,
      "updated": 1787199816
    },
