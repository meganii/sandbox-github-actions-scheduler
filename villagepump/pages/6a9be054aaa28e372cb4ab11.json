  "lines": [
    {
      "id": "6a9be054aaa28e372cb4ab11",
      "text": "ディティール過多",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788600411,
      "updated": 1788600411
    },
    {
      "id": "6a9be05b0000000000673e43",
      "text": "　器に対して過剰なものを追加してしまうこと。",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788600411,
      "updated": 1788600455
    },
    {
      "id": "6a9be0800000000000673e49",
      "text": "　　大抵不親切で場合によっては気持ち悪い。",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788600448,
      "updated": 1788600486
    },
    {
      "id": "6a9be06c0000000000673e48",
      "text": "　　親切によって発生している場合は周囲との認識が歪んでいるぞ",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788600428,
      "updated": 1788600599
    },
    {
      "id": "6a9be1020000000000673e4b",
      "text": "",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788600578,
      "updated": 1788600578
    },
    {
      "id": "6a9be05b0000000000673e44",
      "text": "例：https://togetter.com/li/2459282",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788600411,
      "updated": 1788600416
    },
    {
      "id": "6a9be05b0000000000673e46",
      "text": "[https://gyazo.com/6cc3dc7b455664446ca5a09aaccb3c34]",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788600412,
      "updated": 1788600423
    },
    {
      "id": "6a9be0670000000000673e47",
      "text": "　デフォルメに対するディティール過多が起きている。",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788600423,
      "updated": 1788600499
