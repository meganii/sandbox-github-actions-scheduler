      "created": 1788050395,
      "updated": 1788050395
    },
    {
      "id": "6a937b0f0000000000f7f26a",
      "text": "難点",
      "userId": "688c296691686a314f82fb52",
      "created": 1788050191,
      "updated": 1788050194
    },
    {
      "id": "6a937b110000000000f7f26c",
      "text": "　構築したデータの互換性",
