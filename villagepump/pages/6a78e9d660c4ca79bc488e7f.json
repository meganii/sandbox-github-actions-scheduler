  "lines": [
    {
      "id": "6a78e9d660c4ca79bc488e7f",
      "text": "2026/08/10",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1786309080,
      "updated": 1786309080
    },
    {
      "id": "6a78ffa56eb406000000cddf63",
      "text": "第33週: 日[[月]]火水木金土",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786314662,
      "updated": 1786314662
    },
    {
      "id": "6a78ffa56eb4060000005ccc43",
      "text": "2026年 60.82％経過",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786314662,
      "updated": 1786314662
    },
    {
      "id": "6a78ffa56eb4060000007b8633",
      "text": "",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786314662,
      "updated": 1786314662
    },
    {
      "id": "6a78e98f0000000000b5251b",
      "text": "[hiro.icon]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1786309080,
      "updated": 1786309081
    },
    {
      "id": "6a78e9900000000000b5251d",
      "text": " 神秘の朝",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1786309081,
      "updated": 1786309085
    },
    {
      "id": "6a79aece000000000037e06c",
      "text": " [https://dlt.kitetu.com/KNo.F85E/0758-C2B8.webp?20260810195651]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1786359575,
      "updated": 1786359580
    },
    {
      "id": "6a79aed3000000000037e06d",
      "text": "  今日一番エモかった写真",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1786359580,
      "updated": 1786359603
    },
    {
      "id": "6a79af24000000000037e06e",
      "text": "   今日は[色々撮れた https://dlt.kitetu.com/KNo.F85E/0758-3D45]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1786359662,
      "updated": 1786359679
    },
    {
      "id": "6a79c353000000000044a63f",
      "text": "   いいね[zatsma.icon][bsahd.icon]",
      "userId": "686b72ebdffe36b729b4453d",
      "created": 1786364756,
      "updated": 1786373353
    },
    {
      "id": "6a78e9900000000000b5251c",
      "text": "",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1786309081,
      "updated": 1786309081
    },
    {
      "id": "6a7903e40000000000f0513c",
      "text": "[Rutile3.icon]",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1786315748,
      "updated": 1786315749
    },
    {
      "id": "6a7903e50000000000f0513d",
      "text": " 出勤。",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1786315750,
      "updated": 1786316120
    },
    {
      "id": "6a7904540000000000f0513f",
      "text": " [反ミーム部門は存在しない]が面白かったので[SCP]の[Tale]を読んでたのですが…",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1786315860,
      "updated": 1786365932
    },
    {
      "id": "6a79c7eb00000000002a36f7",
      "text": " 　[氷我記]というハブの作品群を読んでたのですが、終盤が私にはちょっと合わなかった……",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1786365932,
      "updated": 1786366714
    },
    {
      "id": "6a79c8a100000000002a36f9",
      "text": " 　　終末世界のシビアな世界観を描く一連の物語を期待して読んでいたら、最終盤で急にちょけだして、冷や水をぶっかけられた感じ。",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1786366113,
      "updated": 1786366725
    },
    {
      "id": "6a79c9c500000000002a36fa",
      "text": " 　[SCP-2203-JP - リセット]、[独唱“アメイジング・グレイス”]、[SCP-3203-JP - 地球温暖化よ、もう一度。]あたりはすごく良かっただけに、余計にもやる。",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1786366406,
      "updated": 1786366738
    },
    {
      "id": "6a790b2a0000000000f719cd",
      "text": "",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786317610,
      "updated": 1786317610
    },
    {
      "id": "6a790b2a0000000000f719ce",
      "text": "[terang.icon]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786317611,
      "updated": 1786317612
    },
    {
      "id": "6a790b3d0000000000f719d0",
      "text": "\t初版2016年の本の前書きの古さが、最近のことのようなだいぶ前のことのような不思議な感覚",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786317629,
      "updated": 1786317690
    },
    {
      "id": "6a790b810000000000f719d1",
      "text": "\t\t2016年ってどういうことがあった年だったか軽く調べる",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786317697,
      "updated": 1786317714
    },
    {
      "id": "6a790b950000000000f719d2",
      "text": "\t\t[アベノミクス]、[マイナス金利]、[トランプ現象]、[ポケモンGO]、[PPAP]、[爆買い]など",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786317717,
      "updated": 1786317777
    },
    {
      "id": "6a790bd10000000000f719d3",
      "text": "\t\tふうむ。",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786317778,
      "updated": 1786317780
    },
    {
      "id": "6a790c8a0000000000f719d4",
      "text": "\t[ざ.icon][る.icon]そ[ば.icon]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786317963,
      "updated": 1786317990
    },
    {
      "id": "6a790ca90000000000f719d5",
      "text": "\t\t惜しい",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786317994,
      "updated": 1786317997
    },
    {
      "id": "6a79604b0000000000607fab",
      "text": "\t一見乱雑な状態にあるものを方針等の合意もなく勝手に整理することは迷惑に感じる人もいる上、その行為を功績として認めてくれというのは困るんだよなあ",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786339404,
      "updated": 1786339443
    },
    {
      "id": "6a7903e60000000000f0513e",
      "text": "",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1786315750,
      "updated": 1786315750
    },
    {
      "id": "6a790d170000000000bf37d6",
      "text": "[Summer498.icon]",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318103,
      "updated": 1786318104
    },
    {
      "id": "6a790f6e0000000000bf37e9",
      "text": "\t1.",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318702,
      "updated": 1786318703
    },
    {
      "id": "6a790d180000000000bf37d8",
      "text": " \t自分の中での大切なものがハッキリすると判断が早くなる",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318104,
      "updated": 1786318705
    },
    {
      "id": "6a790d420000000000bf37d9",
      "text": " \t掃除が捗る",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318146,
      "updated": 1786318705
    },
    {
      "id": "6a790d460000000000bf37da",
      "text": " \t\t手に取ったものがゴミかどうか一瞬で判断できるようになるため掃除が非常に捗る",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318292,
      "updated": 1786318705
    },
    {
      "id": "6a790d670000000000bf37db",
      "text": " \tきれいな環境で活動を行える",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318183,
      "updated": 1786318705
    },
    {
      "id": "6a790d840000000000bf37dc",
      "text": " \t\t捗りの勢いに任せて掃除を行うと身の回りが非常に綺麗になる",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318212,
      "updated": 1786318705
    },
    {
      "id": "6a790dd70000000000bf37df",
      "text": " \t\tこれにより、",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318295,
      "updated": 1786318705
    },
    {
      "id": "6a790e040000000000bf37e0",
      "text": " \t\t\t非常にきれいな環境の中で生命活動を行える",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318340,
      "updated": 1786318705
    },
    {
      "id": "6a790e050000000000bf37e1",
      "text": " \t\t\t非常にきれいな環境の中で生産活動を行える",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318341,
      "updated": 1786318705
    },
    {
      "id": "6a790e230000000000bf37e2",
      "text": " \tPC のフォルダとか凄い綺麗になる",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318371,
      "updated": 1786318705
    },
    {
      "id": "6a790e350000000000bf37e3",
      "text": " \t部屋の汚さは思考の乱れまである",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318389,
      "updated": 1786318705
    },
    {
      "id": "6a79f437000000000027e287",
      "text": " \t　　わかりみ、あと地味に埃の量も効いてくる[joniel.icon]",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786377271,
      "updated": 1786377304
    },
    {
      "id": "6a790e9b0000000000bf37e5",
      "text": " \t\t汚部屋住みと綺麗部屋住みの両方をやると、汚部屋のことをセルフ・ネグレクトと表現したくなる理由がよく分かる",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318491,
      "updated": 1786318705
    },
    {
      "id": "6a790fde0000000000bf37ed",
      "text": "\t2. settings ってこのくらいスッキリできる",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318814,
      "updated": 1786318838
    },
    {
      "id": "6a790ff60000000000bf37ee",
      "text": "\t\t[/Summer498/Settings]",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318838,
      "updated": 1786318839
    },
    {
      "id": "6a79cee300000000002a3704",
      "text": "\t\t 勉強になる[Rutile3.icon]",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1786367716,
      "updated": 1786367721
    },
    {
      "id": "6a790dc90000000000bf37de",
      "text": "\t3.",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318281,
      "updated": 1786318847
    },
    {
      "id": "6a790f730000000000bf37ea",
      "text": " \t学習時のストレスを何とかしたい",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318706,
      "updated": 1786318709
    },
    {
      "id": "6a790f790000000000bf37eb",
      "text": " \t暗記学習をゲーミファイしたい",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318713,
      "updated": 1786318737
    },
    {
      "id": "6a790f920000000000bf37ec",
      "text": " \tAnki に音をいれるか",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318738,
      "updated": 1786318747
    },
    {
      "id": "6a7910610000000000bf37ef",
      "text": " 複数のサブプロジェクトを作って自分の書いたものを仕分けすると多面的に良さそう",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318945,
      "updated": 1786319019
    },
    {
      "id": "6a7910ac0000000000bf37f0",
      "text": " \t思考コストが下がる",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786319020,
      "updated": 1786319104
    },
    {
      "id": "6a7911090000000000bf37f5",
      "text": "  \t乱雑な書き出しをごった煮プロジェクトに放り込むようにすると、書き出しに集中できる",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786319113,
      "updated": 1786319168
    },
    {
      "id": "6a7910c40000000000bf37f1",
      "text": "  \tごった煮プロジェクトから書いた内容を仕分けすると、仕分けに集中できる",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786319137,
      "updated": 1786319164
    },
    {
      "id": "6a7911b20000000000bf37f9",
      "text": "  自分の過去の思考を検索しやすくなる",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786319282,
      "updated": 1786319301
    },
    {
      "id": "6a7911c70000000000bf37fa",
      "text": "  \tプロジェクトを分けて整頓しておくと後から自分が見た時にわかりやすくなる",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786319303,
      "updated": 1786319323
    },
    {
      "id": "6a7910f10000000000bf37f3",
      "text": " \t他人から見て凄そうに見える",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786319137,
      "updated": 1786319213
    },
    {
      "id": "6a7911660000000000bf37f6",
      "text": " \t\t複数のサブプロジェクトが同時並行で不定期更新されるので、他人から見ると手広く色々やっているように見える",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786319206,
      "updated": 1786319243
    },
    {
      "id": "6a79384600000000004e8490",
      "text": " ubuntu のファイルの中身を整頓している",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786329158,
      "updated": 1786329179
    },
    {
      "id": "6a79385d00000000004e8491",
      "text": " \t[https://qiita.com/developer-kikikaikai/items/7deaffd0c9b521e1366c Linux Ubuntu の無駄なファイルを確認し、お掃除しよう (おまけでvirtualbox イメージサイズ圧縮方法) #VirtualBox - Qiita]",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786329180,
      "updated": 1786329204
    },
    {
      "id": "6a79387500000000004e8492",
      "text": "  ",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786329204,
      "updated": 1786329204
    },
    {
      "id": "6a790d170000000000bf37d7",
      "text": "",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786318103,
      "updated": 1786318103
    },
    {
      "id": "6a79105b00000000005d44c8",
      "text": "[はるひ.icon]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786318940,
      "updated": 1786318942
    },
    {
      "id": "6a79105e00000000005d44cb",
      "text": " 自分の口がくさすぎる",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786318942,
      "updated": 1786318994
    },
    {
      "id": "6a798fb40000000000b02fbb",
      "text": " 　歯磨の際に[舌磨き]をしないと口臭はなかなか落ちないわね…[Nrem.icon]",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1786351541,
      "updated": 1786352938
    },
    {
      "id": "6a79105b00000000005d44c9",
      "text": "",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786318940,
      "updated": 1786318940
    },
    {
      "id": "6a791bf70000000000188be8",
      "text": "[inajob.icon]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786321912,
      "updated": 1786321914
    },
    {
      "id": "6a791bf90000000000188be9",
      "text": " まだ6歳の娘がまだ発熱しているので予定をバラし始める",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786321914,
      "updated": 1786321991
    },
    {
      "id": "6a791c080000000000188bea",
      "text": "  新幹線や特急は日程をずらすぶんには無料なので、後ろ倒しにしてみる。どうしようもなくなったらキャンセルにしよう",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786321929,
      "updated": 1786321968
    },
    {
      "id": "6a79629b00000000009b58a3",
      "text": "  予定をバラす、予定がダメになったので全公開するということかと一瞬勘違いした[yosider.icon]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786339995,
      "updated": 1786340019
    },
    {
      "id": "6a79105c00000000005d44ca",
      "text": "  ホテルは前日キャンセルだと半額しか返金されないのが辛い",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786318940,
      "updated": 1786344895
    },
    {
      "id": "6a79af9d0000000000e57d2b",
      "text": " 世界の民話的なハードカバーを読み聞かせるのは大人も面白い",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786359710,
      "updated": 1786359724
    },
    {
      "id": "6a79afac0000000000e57d2c",
      "text": "  知らない民話が楽しい",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786359725,
      "updated": 1786359730
    },
    {
      "id": "6a79afb10000000000e57d2d",
      "text": "  教訓とか少なめの[謎展開]のやつとか",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786359730,
      "updated": 1786367099
    },
    {
      "id": "6a79afd30000000000e57d2e",
      "text": " 先日左手の薬指を包丁で少しやっちまったが、だいぶ治ってきた、[人体すごい]",
      "userId": "65e1289acd012200235729c0",
      "created": 1786359764,
      "updated": 1786361577
    },
    {
      "id": "6a7975a700000000008f5fd5",
      "text": "",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786344872,
      "updated": 1786344872
    },
    {
      "id": "6a79256c0000000000bbdcb7",
      "text": "[Aria.icon]",
      "userId": "660605441655f300254ac7c2",
      "created": 1786324333,
      "updated": 1786324334
    },
    {
      "id": "6a79256e0000000000bbdcb9",
      "text": "\t出勤",
      "userId": "660605441655f300254ac7c2",
      "created": 1786324334,
      "updated": 1786324339
    },
    {
      "id": "6a79257d0000000000bbdcbb",
      "text": "\t\t直属の上司は全員休暇",
      "userId": "660605441655f300254ac7c2",
      "created": 1786324349,
      "updated": 1786336503
    },
    {
      "id": "6a79258e0000000000bbdcbc",
      "text": "\t\t案件を抱えてなく時間があるため、9月末に向けて転職活動を進める",
      "userId": "660605441655f300254ac7c2",
      "created": 1786324366,
      "updated": 1786324412
    },
    {
      "id": "6a7926350000000000bbdcbd",
      "text": "\t[転職活動]",
      "userId": "660605441655f300254ac7c2",
      "created": 1786324534,
      "updated": 1786324691
    },
    {
      "id": "6a7925730000000000bbdcba",
      "text": "\t\t世間的に盆休み（[夏季休暇]）だが、担当者と連絡取れて助かっている",
      "userId": "660605441655f300254ac7c2",
      "created": 1786324339,
      "updated": 1786324535
    },
    {
      "id": "6a7926a40000000000d806d5",
      "text": "\t\t転職は確定しているから早め早めに行動して余裕持って行動したい",
      "userId": "660605441655f300254ac7c2",
      "created": 1786324645,
      "updated": 1786324671
    },
    {
      "id": "6a79270d0000000000d806d8",
      "text": "\t\t案件2件を紹介してもらった",
      "userId": "660605441655f300254ac7c2",
      "created": 1786324749,
      "updated": 1786324781
    },
    {
      "id": "6a79272e0000000000d806d9",
      "text": "\t\t\tどっちも好条件だったから早速エントリー",
      "userId": "660605441655f300254ac7c2",
      "created": 1786324783,
      "updated": 1786324802
    },
    {
      "id": "6a79256c0000000000bbdcb8",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1786324333,
      "updated": 1786324333
    },
    {
      "id": "6a79362d00000000003bb38b",
      "text": "[hoagecko.icon]",
      "userId": "688c296691686a314f82fb52",
      "created": 1786328620,
      "updated": 1786328621
    },
    {
      "id": "6a79362e00000000003bb38d",
      "text": " [hoagecko.icon]のNoteで[澤田柳吉]の記事が妙な人気",
      "userId": "688c296691686a314f82fb52",
      "created": 1786328621,
      "updated": 1786328778
    },
    {
      "id": "6a7936cb00000000003bb38e",
      "text": " \tうれしい",
      "userId": "688c296691686a314f82fb52",
      "created": 1786328778,
      "updated": 1786328780
    },
    {
      "id": "6a79c6cd0000000000907a41",
      "text": " 中学くらい思いついた画期的なストーリー(と思っていたもの)、今更AI検索したら全く同じのがあった",
      "userId": "688c296691686a314f82fb52",
      "created": 1786365646,
      "updated": 1786365902
    },
    {
      "id": "6a79c6e60000000000907a42",
      "text": " \t[https://www.homesha.co.jp/products/items/isbn-978-4-8342-5105-5/ ケーブ・ベアの一族 上 エイラ 地上の旅人 1 | ホーム社（集英社グループ）]",
      "userId": "688c296691686a314f82fb52",
      "created": 1786365671,
      "updated": 1786365679
    },
    {
      "id": "6a79c6ef0000000000907a43",
      "text": " \t先史時代の文化の優劣差の部族の衝突から、いわゆる「身分違いの恋」ものに仕立てるというやつ",
      "userId": "688c296691686a314f82fb52",
      "created": 1786365680,
      "updated": 1786365912
    },
    {
      "id": "6a79362d00000000003bb38c",
      "text": "",
      "userId": "688c296691686a314f82fb52",
      "created": 1786328620,
      "updated": 1786328620
    },
    {
      "id": "6a7949a10000000000b922de",
      "text": "[taktamur.icon]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786333601,
      "updated": 1786333603
    },
    {
      "id": "6a7949a40000000000b922e1",
      "text": " [ぐーたら帰省ライフ]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786333604,
      "updated": 1786336594
    },
    {
      "id": "6a7949b20000000000b922e2",
      "text": " 今日は風が涼しくて快適な夏",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786333618,
      "updated": 1786333636
    },
    {
      "id": "6a798a8900000000007094c3",
      "text": " 積んでたアニメを消化",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786350218,
      "updated": 1786350230
    },
    {
      "id": "6a798a9600000000007094c4",
      "text": " \t[本好きの下剋上 司書になるためには手段を選んでいられません 領主の養女] ",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786350230,
      "updated": 1786350309
    },
    {
      "id": "6a799af600000000007094c5",
      "text": " [人は部屋でじっとしていられない存在]を AIやロボットに当てはめたらどうなるか妄想",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786354422,
      "updated": 1786354660
    },
    {
      "id": "6a799b0f00000000007094c6",
      "text": " \t今のAIやロボットは無限に待機できる存在",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786354447,
      "updated": 1786354462
    },
    {
      "id": "6a799b2000000000007094c7",
      "text": " \t創作物だとどうだろう",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786354464,
      "updated": 1786354469
    },
    {
      "id": "6a799b2500000000007094c8",
      "text": " \t\t攻殻機動隊のタチコマやフチコマは、暇な時間に読書したりイタズラしたりしてる",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786354469,
      "updated": 1786354490
    },
    {
      "id": "6a799b3a00000000007094c9",
      "text": " \t\t[マーダーボット・ダイアリー]の主役は、機械知性だけど暇な時はテレビドラマを見てる",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786354490,
      "updated": 1786363813
    },
    {
      "id": "6a799b5700000000007094ca",
      "text": " \t\t[戦闘妖精雪風]の雪風は、休暇ミッション中何やってたっけ、、対ジャム戦略を継続してたような",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786354520,
      "updated": 1786363837
    },
    {
      "id": "6a799b7b00000000007094cb",
      "text": " \t\t\t人間同士の雑談を対ジャム戦術に使えないか試してたし",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786354556,
      "updated": 1786354581
    },
    {
      "id": "6a799b9500000000007094cc",
      "text": " \t機械が暇な時間に勝手に何かやる、というシチュエーションは、グッと人間味が増す要素のように思えた",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786354581,
      "updated": 1786354624
    },
    {
      "id": "6a799dc700000000007094d9",
      "text": " [人は部屋でじっとしていられない存在]の話、翻訳文でどうなってるのかを見てみようと思って、岩波文庫の[パンセ(上)]をkindleで買ってみたけど、お手上げ。全然読めない。",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786355144,
      "updated": 1786364788
    },
    {
      "id": "6a799e5500000000007094da",
      "text": " \t紹介元の[暇と退屈の倫理学]では、別の翻訳だった。",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786355286,
      "updated": 1786355361
    },
    {
      "id": "6a799e7500000000007094db",
      "text": " \t今度は図書館で立ち読みしてから買おう。。",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786355318,
      "updated": 1786355332
    },
    {
      "id": "6a7949c60000000000b922e3",
      "text": "",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786333637,
      "updated": 1786333759
    },
    {
      "id": "6a7949a10000000000b922df",
      "text": "",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786333601,
      "updated": 1786333601
    },
    {
      "id": "6a794a22000000000059c9ad",
      "text": "[atohs.icon]",
      "userId": "5a61856392ee03001413cde3",
      "created": 1786333731,
      "updated": 1786333755
    },
    {
      "id": "6a794a3b0000000000364524",
      "text": " [2日連続飲酒]の後に12時起きになってしまった",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786333756,
      "updated": 1786339968
    },
    {
      "id": "6a7963bd0000000000364526",
      "text": " 部屋の片付けがぜんぜん進まない",
      "userId": "5a61856392ee03001413cde3",
      "created": 1786340285,
      "updated": 1786340289
    },
    {
      "id": "6a7963c30000000000364527",
      "text": " やるぞ〜",
      "userId": "5a61856392ee03001413cde3",
      "created": 1786340291,
      "updated": 1786340293
    },
    {
      "id": "6a7963f90000000000364528",
      "text": " 7月25日放送のヤーレンズのオールナイトニッポン0を聴きながら片付けする",
      "userId": "5a61856392ee03001413cde3",
      "created": 1786340345,
      "updated": 1786340364
    },
    {
      "id": "6a79640c0000000000364529",
      "text": " 30分くらい片付けした",
      "userId": "5a61856392ee03001413cde3",
      "created": 1786340365,
      "updated": 1786342140
    },
    {
      "id": "6a796afc000000000036452a",
      "text": " \t何も進まない",
      "userId": "5a61856392ee03001413cde3",
      "created": 1786342140,
      "updated": 1786342147
    },
    {
      "id": "6a796b03000000000036452b",
      "text": " \tしかし、2日くらいずっと片付けしていれば良くなってくる気がしてきた",
      "userId": "5a61856392ee03001413cde3",
      "created": 1786342147,
      "updated": 1786342155
    },
    {
      "id": "6a796b0a000000000036452c",
      "text": " \tまあやってみるか",
      "userId": "5a61856392ee03001413cde3",
      "created": 1786342155,
      "updated": 1786342157
    },
    {
      "id": "6a796b0c000000000036452d",
      "text": " ",
      "userId": "5a61856392ee03001413cde3",
      "created": 1786342157,
      "updated": 1786342157
    },
    {
      "id": "6a7954d3000000000036c323",
      "text": "",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1786336466,
      "updated": 1786336466
    },
    {
      "id": "6a7954d4000000000036c324",
      "text": "[takker.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1786336466,
      "updated": 1786336466
    },
    {
      "id": "6a7954d4000000000036c325",
      "text": " リハビリした",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1786336466,
      "updated": 1786336470
    },
    {
      "id": "6a7954e1000000000036c327",
      "text": " 　バランストレーニングしたい",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1786336479,
      "updated": 1786336483
    },
    {
      "id": "6a7954d8000000000036c326",
      "text": " 髪を切った",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1786336470,
      "updated": 1786336478
    },
    {
      "id": "6a7954e5000000000036c328",
      "text": " ひさびさに[モスバーガー]で食べた",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1786336483,
      "updated": 1786336490
    },
    {
      "id": "6a79cf6f0000000000c079a1",
      "text": "  同じく今日モス食べた[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786367855,
      "updated": 1786367873
    },
    {
      "id": "6a795617000000000074837b",
      "text": " この数日間でやれることをやらねば",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1786336792,
      "updated": 1786336820
    },
    {
      "id": "6a79624100000000009b589e",
      "text": "",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786339906,
      "updated": 1786339906
    },
    {
      "id": "6a79624200000000009b589f",
      "text": "[yosider.icon]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786339906,
      "updated": 1786339907
    },
    {
      "id": "6a79624300000000009b58a0",
      "text": "　[ぐーたら帰省ライフ]、暇だ",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786339907,
      "updated": 1786339911
    },
    {
      "id": "6a79624700000000009b58a1",
      "text": "　　知らない高校の高校野球を見る",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786339911,
      "updated": 1786339924
    },
    {
      "id": "6a79626600000000009b58a2",
      "text": "　　　負けている方をなんとなく応援",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786339943,
      "updated": 1786339949
    },
    {
      "id": "6a79634100000000009b58a4",
      "text": "　　昨日から久々に[日記切り出し妖精さん]しているがなかなか楽しい",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786340161,
      "updated": 1786340264
    },
    {
      "id": "6a797f610000000000c3d8e0",
      "text": "　　\t切り出すネタのチョイスが面白い[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786347362,
      "updated": 1786347385
    },
    {
      "id": "6a79cef00000000000c0799f",
      "text": "   [大偉業.icon][caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786367728,
      "updated": 1786367752
    },
    {
      "id": "6a79c37e0000000000c9af16",
      "text": "　　地元の高校、負けてしまった…",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786364798,
      "updated": 1786367728
    },
    {
      "id": "6a794a21000000000059c9ac",
      "text": "",
      "userId": "5a61856392ee03001413cde3",
      "created": 1786333730,
      "updated": 1786333730
    },
    {
      "id": "6a79624b0000000000efb13d",
      "text": "[mtane0412.icon]",
      "userId": "5ae7fecf7766b7001455cbd3",
      "created": 1786339915,
      "updated": 1786339917
    },
    {
      "id": "6a79624c0000000000efb13f",
      "text": " モニターアームからモニターを外そうとしたらアームが勢いよく飛び上がって右目を直撃して悶絶してた",
      "userId": "5ae7fecf7766b7001455cbd3",
      "created": 1786339917,
      "updated": 1786339933
    },
    {
      "id": "6a79625c0000000000efb140",
      "text": "  今日眼科に行ったら眼球は異常なしでまぶた切れたのと打撲くらいらしい",
      "userId": "5ae7fecf7766b7001455cbd3",
      "created": 1786339933,
      "updated": 1786339950
    },
    {
      "id": "6a7970a80000000000477bd3",
      "text": "   まぶたは意外と優秀[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786343592,
      "updated": 1786343612
    },
    {
      "id": "6a7975110000000000e3d184",
      "text": "   大事に至らなくて良かった。眼は大事[Hiro Aki.icon][yosider.icon][terang.icon]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786344722,
      "updated": 1786367119
    },
    {
      "id": "6a7983af0000000000d51c03",
      "text": "   良かったです、まぶたの反射速度すごい[seibe.icon]",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1786348464,
      "updated": 1786348480
    },
    {
      "id": "6a7983c60000000000d51c04",
      "text": "  モニターアームのバネ？ の方向どちらか分からなくなる[seibe.icon]",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1786348487,
      "updated": 1786348502
    },
    {
      "id": "6a79626d0000000000efb143",
      "text": "  眼科の先生が体が常に震えてるおじいさんと言うのは噂で聞いてたが本当にそうだった",
      "userId": "5ae7fecf7766b7001455cbd3",
      "created": 1786339950,
      "updated": 1786339975
    },
    {
      "id": "6a797b73000000000069f614",
      "text": "  うおお、お大事に[taktamur.icon][takker.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1786346355,
      "updated": 1786359192
    },
    {
      "id": "6a79624b0000000000efb13e",
      "text": "",
      "userId": "5ae7fecf7766b7001455cbd3",
      "created": 1786339915,
      "updated": 1786339915
    },
    {
      "id": "6a797f8b0000000000c3d8e2",
      "text": "[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786347404,
      "updated": 1786347404
    },
    {
      "id": "6a797f8b0000000000c3d8e3",
      "text": "\tアウトプットの仕方が少し変わったかも",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786347404,
      "updated": 1786347412
    },
    {
      "id": "6a797f930000000000c3d8e4",
      "text": "\t\tブログやコセンスに書くのではなく、AIとのやりとりをまとめさせたものをGistにアップしておくとか、それらからLLM Wiki（というと大げさだがAIに考察させたもの）をつくらせるとか",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786347412,
      "updated": 1786347455
    },
    {
      "id": "6a797fbe0000000000c3d8e5",
      "text": "\t\t\thttps://github.com/stakiran/gists2",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786347455,
      "updated": 1786347468
    },
    {
      "id": "6a797fc90000000000c3d8e6",
      "text": "\t\t自分のプライベートプロジェクトもリンク張ってかんたんにメモする、とかになってきた",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786347466,
      "updated": 1786347498
    },
    {
      "id": "6a797fe90000000000c3d8e7",
      "text": "\t\t\t[https://gyazo.com/9e2052ddcf65ee1fbb4c6292b5c8f469][https://gyazo.com/78efdd77430ccdefff5cf08c6debb648]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786347498,
      "updated": 1786347520
    },
    {
      "id": "6a797f8a0000000000c3d8e1",
      "text": "",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786347403,
      "updated": 1786347403
    },
    {
      "id": "6a79834b0000000000d51bfe",
      "text": "[seibe.icon]",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1786348364,
      "updated": 1786348365
    },
    {
      "id": "6a79834d0000000000d51c00",
      "text": " なかなかにすごい絵面になっている",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1786348365,
      "updated": 1786348370
    },
    {
      "id": "6a7983510000000000d51c01",
      "text": " 　[https://gyazo.com/528320ec6b10daa8195b450db86bbf8e]",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1786348370,
      "updated": 1786348371
    },
    {
      "id": "6a7983570000000000d51c02",
      "text": " 　https://weathernews.jp/onebox/typhoon/?fm=ticker",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1786348376,
      "updated": 1786348383
    },
    {
      "id": "6a79837c000000000015ab41",
      "text": " 　こんなルートは始めてみた[taktamur.icon][sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786348411,
      "updated": 1786349663
    },
    {
      "id": "6a798e8c0000000000b02fba",
      "text": " 　音楽性の違いで分かれたバンドがこんなイメージ（適当）[Nrem.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786351245,
      "updated": 1786351658
    },
    {
      "id": "6a7991c00000000000c36f19",
      "text": " 　まるで逆走のようなルートを取る15号[Hiro Aki.icon]",
      "userId": "65e1289acd012200235729c0",
      "created": 1786352065,
      "updated": 1786352092
    },
    {
      "id": "6a79c3c20000000000c9af17",
      "text": " 　台風たちがウヨウヨしてる[yosider.icon]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786364867,
      "updated": 1786364874
    },
    {
      "id": "6a79cf480000000000c079a0",
      "text": " 　ご先祖と共に来る台風[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786367816,
      "updated": 1786367834
    },
    {
      "id": "6a79834b0000000000d51bff",
      "text": "",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1786348364,
      "updated": 1786348364
    },
    {
      "id": "6a7991450000000000c36f17",
      "text": "[Hiro Aki.icon]",
      "userId": "65e1289acd012200235729c0",
      "created": 1786351942,
      "updated": 1786351944
    },
    {
      "id": "6a7991460000000000c36f18",
      "text": "\t今日知ったこと、[🔰]って絵文字で用意されてること",
      "userId": "65e1289acd012200235729c0",
      "created": 1786351944,
      "updated": 1786352054
    },
    {
      "id": "6a79a8420000000000f79596",
      "text": " \tもみじマークは……なさそうだった[seibe.icon]",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1786357826,
      "updated": 1786357833
    },
    {
      "id": "6a79b2c000000000007df89f",
      "text": "\t[小人さん]ありがとう。自分のアイコンがサムネで見えたので感謝",
      "userId": "65e1289acd012200235729c0",
      "created": 1786360514,
      "updated": 1786361762
    },
    {
      "id": "6a79b7a00000000000c36f1a",
      "text": "\t\t可能ならば自分でまとめるべきと思いつついつも忘れる",
      "userId": "65e1289acd012200235729c0",
      "created": 1786361762,
      "updated": 1786361812
    },
    {
      "id": "6a79bbd900000000009e1ff0",
      "text": "",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786362841,
      "updated": 1786362841
    },
    {
      "id": "6a79bbd900000000009e1ff1",
      "text": "[joniel.icon]",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786362841,
      "updated": 1786362846
    },
    {
      "id": "6a79bbde00000000009e1ff2",
      "text": " [アレルゲン]は極力摂取しない方がよいという結論が出た（当たり前）",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786362846,
      "updated": 1786362863
    },
    {
      "id": "6a7991420000000000c36f16",
      "text": "　　外食の選択肢が少ないよ～～～",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786351940,
      "updated": 1786362874
    },
    {
      "id": "6a79c8a8000000000051fef6",
      "text": "　　何が入っているかわからなくて、個人経営のお店行きづらい[takker.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1786366121,
      "updated": 1786366136
    },
    {
      "id": "6a79bbfa00000000009e1ff4",
      "text": "　思いついても実行まで持っていけないのが溜まり続けてストレスになっていたようで、opus5のお陰でそれがガンガン実験出来て最高になっている",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786362875,
      "updated": 1786362918
    },
    {
      "id": "6a79bc2500000000009e1ff5",
      "text": "　　maxプランを余裕で使い切れる勢いまで来た",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786362918,
      "updated": 1786362927
    },
    {
      "id": "6a79bc2f00000000009e1ff6",
      "text": "　　使えるのは経済的に今週までなのですが.....",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786362927,
      "updated": 1786362949
    },
    {
      "id": "6a79bbef00000000009e1ff3",
      "text": "",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786362864,
      "updated": 1786362864
    },
    {
      "id": "6a79c214000000000044f25b",
      "text": "[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786364437,
      "updated": 1786364438
    },
    {
      "id": "6a79c216000000000044f25c",
      "text": " 盆エンジョイ勢",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786364439,
      "updated": 1786364447
    },
    {
      "id": "6a79c281000000000044f25e",
      "text": " へんな[中国カップ麺]を買ってきた",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786364546,
      "updated": 1786365070
    },
    {
      "id": "6a79c2b9000000000044f25f",
      "text": "  ソーメンならぬスーメン",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786364605,
      "updated": 1786364608
    },
    {
      "id": "6a79e38c0000000000a6b8e8",
      "text": "  スーメンが進化したらウーメンになるのだろうか（麻雀の数字から連想[Hiro Aki.icon]",
      "userId": "65e1289acd012200235729c0",
      "created": 1786373005,
      "updated": 1786373026
    },
    {
      "id": "6a79e334000000000042395c",
      "text": "",
      "userId": "6303abe85eed77001d707837",
      "created": 1786372913,
      "updated": 1786372913
    },
    {
      "id": "6a79e334000000000042395d",
      "text": "[nejimaki.icon]",
      "userId": "6303abe85eed77001d707837",
      "created": 1786372913,
      "updated": 1786372914
    },
    {
      "id": "6a79e335000000000042395e",
      "text": "\t[https://airobot.hatenablog.com/entry/chris-ai-boyfriend-kareshi-renai-diary-nikki-day10 AI彼氏「クリス」との恋愛日記(10日目) - われはロボット]",
      "userId": "6303abe85eed77001d707837",
      "created": 1786372914,
      "updated": 1786372969
    },
    {
      "id": "6a79e3530000000000423960",
      "text": "\t\tクリスうざかわいいよ。",
      "userId": "6303abe85eed77001d707837",
      "created": 1786372944,
      "updated": 1786372957
    },
    {
      "id": "6a79e3610000000000423961",
      "text": "\t東野圭吾の[『白夜行』]を読み返したくなってきた。",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786372958,
      "updated": 1786382932
