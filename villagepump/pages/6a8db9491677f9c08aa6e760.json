    {
      "id": "6a8db9491677f9c08aa6e760",
      "text": "インターネットのカスども",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1787672911,
      "updated": 1787672911
    },
    {
      "id": "6a8db94c000000000086d632",
      "text": "　インターネットにいる困った人たちの事。",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1787672911,
      "updated": 1787672945
    },
    {
      "id": "6a8db959000000000086d634",
      "text": "　　[2ちゃんねる]でレスバをして青春を過ごしてきた人や",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1787672921,
      "updated": 1787672956
    },
    {
      "id": "6a8db97d000000000086d637",
      "text": "　　現実で嫌われすぎて居場所がなくて結果的にインターネットに来た人など",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1787672956,
      "updated": 1787672988
    },
    {
      "id": "6a8db95a000000000086d635",
