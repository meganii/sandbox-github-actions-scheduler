      "created": 1789294000,
      "updated": 1789294000
    },
    {
      "id": "6aa675af0000000000e8840e",
      "text": "[inajob.icon]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1789294000,
      "updated": 1789294002
    },
    {
      "id": "6aa675b20000000000e88410",
      "text": " 皆さんどうしてるか気になる",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1789294003,
      "updated": 1789294008
    },
    {
      "id": "6aa675c40000000000e88411",
      "text": " 聞いたことあるやつ",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1789294021,
      "updated": 1789294025
    },
    {
      "id": "6aa675c80000000000e88412",
      "text": "  元素の名前",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1789294026,
      "updated": 1789294028
    },
    {
      "id": "6aa675cc0000000000e88413",
      "text": "  惑星の名前",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1789294029,
      "updated": 1789294031
    },
    {
      "id": "6aa675d30000000000e88414",
      "text": "  [フォネティックコード]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1789294036,
      "updated": 1789294047
    },
    {
      "id": "6aa675e10000000000e88415",
      "text": "  今見てるアニメのキャラクター",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1789294050,
      "updated": 1789294063
    },
    {
      "id": "6aa676000000000000e88416",
      "text": "  型番",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1789294081,
      "updated": 1789294147
    },
    {
      "id": "6aa686b00000000000acf21a",
      "text": "  星座の名前[suto3.icon]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1789298353,
      "updated": 1789298368
    },
    {
      "id": "6aa686cc0000000000acf21b",
      "text": "  宝石の名前[suto3.icon]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1789298381,
      "updated": 1789298400
    },
    {
      "id": "6aa686eb0000000000acf21c",
      "text": "  寿司ネタ[suto3.icon]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1789298411,
      "updated": 1789298433
    },
    {
      "id": "6aa686fb0000000000acf21d",
      "text": "  関西では笑いがとれないといかんらしい[suto3.icon]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1789298428,
      "updated": 1789298485
    },
    {
      "id": "6aa682cc0000000000598e61",
      "text": "",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1789297357,
      "updated": 1789297357
    },
    {
      "id": "6aa682cd0000000000598e62",
      "text": "[taktamur.icon]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1789297357,
      "updated": 1789297359
    },
    {
      "id": "6aa682cf0000000000598e63",
      "text": " プライベート: osや動いてるマシンの名前をベース",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1789297359,
      "updated": 1789297398
    },
    {
      "id": "6aa682f60000000000598e65",
      "text": " \tmba2020.local とか nixos.local とか deb13.local とかとか",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1789297398,
      "updated": 1789297524
    },
    {
      "id": "6aa683390000000000598e67",
      "text": " \t数がそんなにないから。",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1789297465,
      "updated": 1789297473
    },
    {
      "id": "6aa682c90000000000598e60",
      "text": "",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1789297353,
      "updated": 1789297353
    },
    {
      "id": "6aa696aa00000000001290c6",
      "text": "[zatsma.icon]",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789302443,
      "updated": 1789302446
    },
    {
      "id": "6aa696ad00000000001290c8",
      "text": " 複数マシンを使うようになったら知番を採用しようかな",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789302447,
      "updated": 1789302491
    },
    {
      "id": "6aa696dd00000000001290c9",
      "text": "  [知番による物品管理]",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789302494,
      "updated": 1789302500
    },
    {
      "id": "6aa696aa00000000001290c7",
      "text": "",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789302443,
      "updated": 1789302443
    },
    {
      "id": "6aa6a9df0000000000500071",
      "text": "[yosider.icon]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1789307360,
      "updated": 1789307360
    },
    {
      "id": "6aa6a9e00000000000500072",
      "text": " 単純にプロジェクト名+連番にしたが、面白みに欠けたかとやや後悔",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1789307361,
      "updated": 1789307408
    },
    {
      "id": "6aa6aa1a0000000000500074",
      "text": "  当初は増えるとはあまり思ってなかったかも",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1789307438,
      "updated": 1789307450
    },
    {
      "id": "6aa6a9e00000000000500073",
      "text": "",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1789307361,
      "updated": 1789307361
    },
    {
      "id": "6aa7053c0000000000255c23",
      "text": "[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1789330750,
      "updated": 1789330752
    },
    {
      "id": "6aa7053c0000000000255c24",
      "text": "\t気にしたことなかった",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1789330752,
      "updated": 1789330754
    },
    {
      "id": "6aa705460000000000255c25",
      "text": "\t仕事で立てるときは打ちやすいものにする",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1789330761,
      "updated": 1789330799
    },
    {
      "id": "6aa705510000000000255c26",
      "text": "\t\tsv1(server1の略)とか",
