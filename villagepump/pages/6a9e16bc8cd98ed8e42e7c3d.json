    {
      "id": "6a9e179600000000002acb05",
      "text": "盤面のルール",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1788745623,
      "updated": 1788745656
    },
    {
      "id": "6a9e17bb00000000002acb09",
      "text": "　白or黒の所に当たったら外側の数字が得点",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1788745665,
      "updated": 1788745717
    },
    {
      "id": "6a9e17f400000000002acb0c",
      "text": "　外側の緑or赤が2倍、内側のが3倍",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1788745717,
      "updated": 1788745732
    },
    {
      "id": "6a9e180400000000002acb0d",
      "text": "　真ん中がブル、基本ルールでは50点",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1788745733,
      "updated": 1788745761
    },
    {
      "id": "6a9e181f00000000002acb0e",
      "text": "　 一部25点のゲームもある(01のセパブル、クリケット)",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1788745761,
      "updated": 1788745783
    },
    {
      "id": "6a9e17e700000000002acb0a",
      "text": "　[https://www.youtube.com/watch?v=NPY5MsSzwvA]",
