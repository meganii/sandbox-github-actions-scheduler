    {
      "id": "6259c73d8ee92a0000a2c970",
      "text": " [GIGAスクール]で使われているのだとか?",
      "userId": "566fa156776c9b11008ee92a",
      "created": 1650050878,
      "updated": 1650050891
    },
    {
      "id": "6a563fc40000000000aeacba",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1784037318,
      "updated": 1784037318
    },
    {
      "id": "6af0390800000000009acb66",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794128136,
      "updated": 1794128136
    },
    {
      "id": "6af0390900000000009acb67",
      "text": "from [2025/12/08#693668810000000000bee36f]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794128137,
      "updated": 1794128154
    },
    {
      "id": "6af038ec00000000009acb58",
      "text": "[QWOP.icon][Amazon ブラックフライデー 2025]でChromeOSのノートPCを買ってはじめて迎えた週末の感想",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794128109,
      "updated": 1794128167
    },
    {
      "id": "6af038f200000000009acb5f",
      "text": "\t結論：買って正解",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794128114,
      "updated": 1794132504
    },
    {
      "id": "6af038f200000000009acb60",
      "text": "\t\tベッド上で気軽に使えて楽",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794128114,
      "updated": 1794132504
    },
    {
      "id": "6af038f200000000009acb61",
      "text": "\t\tタッチパネルで直感で操作できていい",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794128114,
      "updated": 1794132504
    },
    {
      "id": "6af038f200000000009acb62",
      "text": "\t\t重い作業しない前提だったからスペックが少し低いが今のところ不満なし",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794128114,
      "updated": 1794132504
    },
    {
      "id": "6af038f200000000009acb63",
      "text": "\t[USB Type-C]ポートが1ポートしかなくすこし不便",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794128114,
      "updated": 1794132504
    },
    {
      "id": "6af038f200000000009acb64",
      "text": "\t\t家に転がっていたモバイル[USBハブ]を使って解決済",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794128114,
      "updated": 1794132504
    },
    {
      "id": "6af038f200000000009acb65",
      "text": "\t\t\t使っているハブ：[Anker PowerExpand 6-in-1 USB-C PD イーサネット ハブ https://www.ankerjapan.com/products/a8365]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794128114,
      "updated": 1794132504
    },
