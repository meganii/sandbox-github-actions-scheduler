    {
      "id": "6a96a2115b8005c8ff7d4f5e",
      "text": "Rez",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788256790,
      "updated": 1788256790
    },
    {
      "id": "6a96a2170000000000fe9a48",
      "text": "> うって、ノッて、絶頂へ。",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788256791,
      "updated": 1788256901
    },
    {
      "id": "6a96a21d0000000000fe9a49",
      "text": "",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788256797,
      "updated": 1788256797
    },
    {
      "id": "6a96a2d70000000000fe9a4a",
      "text": " [ユナイテッド・ゲーム・アーティスツ]が制作した「ミッドナイト・ハイ・シューティング」",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788256983,
      "updated": 1788257134
    },
    {
      "id": "6a96a3720000000000fe9a4d",
      "text": "  [水口哲也]プロデュース",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788257139,
      "updated": 1788257153
    },
    {
      "id": "6a96a3150000000000fe9a4c",
      "text": "  [音楽ゲーム]+[レールシューティング]というと近いか",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788257046,
      "updated": 1788257205
    },
    {
      "id": "6a96a8d50000000000fe9a59",
      "text": "   個人的には遊べるテクノアルバムという表現がしっくりくるかも[h45te.icon]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788258517,
      "updated": 1788258583
    },
    {
      "id": "6a96a3850000000000fe9a4e",
      "text": "  [SEGA]の[PS2]参入1作目",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788257157,
      "updated": 1788258591
    },
    {
      "id": "6a96abdd0000000000fe9a71",
      "text": "  現行機では[Rez infinite https://www.rezinfinite.com/]として発売中",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788259293,
      "updated": 1788259409
    },
    {
      "id": "6a96ac550000000000fe9a73",
      "text": "   VR対応や新エリア(Area X)が追加されている",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788259413,
      "updated": 1788259469
    },
    {
      "id": "6a96a9980000000000fe9a61",
      "text": "",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788258712,
      "updated": 1788258717
    },
    {
      "id": "6a96a9230000000000fe9a5c",
      "text": " 遊び方",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788258595,
      "updated": 1788258860
    },
    {
      "id": "6a96aa2d0000000000fe9a63",
      "text": "  現行機版は文章だけだった気がする",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788258861,
      "updated": 1788258888
    },
    {
      "id": "6a96aa490000000000fe9a64",
      "text": "  [https://youtu.be/t4TccYPJYyg]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788258889,
      "updated": 1788258896
    },
    {
      "id": "6a96aa930000000000fe9a65",
      "text": "",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788258963,
      "updated": 1788258963
    },
    {
      "id": "6a96a3ba0000000000fe9a50",
      "text": " CMがシュール",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788257211,
      "updated": 1788257372
    },
    {
      "id": "6a96a8b30000000000fe9a56",
      "text": "  [https://youtu.be/n9A2NAmOafs]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788258484,
      "updated": 1788258496
    },
    {
      "id": "6a96a4550000000000fe9a55",
      "text": "",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788257365,
      "updated": 1788257365
    },
    {
      "id": "6a96aaa00000000000fe9a66",
      "text": " ステージの深部へ行くにつれて鳴る音の数が増えていく",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788258976,
      "updated": 1788259017
    },
    {
      "id": "6a96aac20000000000fe9a68",
      "text": "  ボス戦でピークになる",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788259010,
      "updated": 1788259041
    },
    {
      "id": "6a96aaf50000000000fe9a6b",
      "text": "  焦らした後のサビ感がとても好きである[h45te.icon]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788259061,
      "updated": 1788259087
    },
    {
      "id": "6a96aaec0000000000fe9a6a",
      "text": " 一応ストーリー付き",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788259052,
      "updated": 1788259120
    },
    {
      "id": "6a96ab300000000000fe9a6c",
      "text": " 初代の発売時トランスバイブレーターという機器が同時に発売された",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788259121,
      "updated": 1788259185
    },
    {
      "id": "6a96ab730000000000fe9a6d",
      "text": "  リズムに合わせて振動する。それだけ",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788259187,
      "updated": 1788259223
    },
    {
      "id": "6a96ab9a0000000000fe9a6e",
      "text": "  このゲームとの親和性はめちゃくちゃ高い",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788259227,
      "updated": 1788259232
    },
    {
      "id": "6a96aba00000000000fe9a6f",
      "text": "   と[思われる]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788259232,
      "updated": 1788259247
    },
    {
      "id": "6a96abb50000000000fe9a70",
      "text": "   実機が無いから何とも言えない[h45te.icon]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788259254,
      "updated": 1788259282
    },
