{
  "id": "6abb10aa0d0c1d293bc4e880",
  "title": "準伝ポケモン",
  "created": 1790644397,
  "updated": 1790644406,
  "lines": [
    {
      "id": "6abb10aa0d0c1d293bc4e880",
      "text": "準伝ポケモン",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a44",
      "text": "table: ",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a45",
      "text": " 世代\t地方\tグループ名・通称\tポケモン名",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a46",
      "text": " 第1世代\tカントー\t[三鳥]\t[フリーザー]、[サンダー]、[ファイヤー]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a47",
      "text": " 第2世代\tジョウト\t[三犬]\t[ライコウ]、[エンテイ]、[スイクン]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a48",
      "text": " 第3世代\tホウエン\t[レジ系]\t[レジロック]、[レジアイス]、[レジスチル]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644406
    },
    {
      "id": "6abb10ac0000000000ee7a49",
      "text": " \t\t[ラティ兄妹]\t[ラティアス]、[ラティオス]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a4a",
      "text": " 第4世代\tシンオウ\t[UMA]\t[ユクシー]、[エムリット]、[アグノム]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a4b",
      "text": " \t\tその他\t[ヒードラン]、[レジギガス]、[クレセリア]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a4c",
      "text": " 第5世代\tイッシュ\t[三闘]\t[コバルオン]、[テラキオン]、[ビリジオン]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a4d",
      "text": " \t\t[コピペロス]\t[トルネロス]、[ボルトロス]、[ランドロス]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a4e",
      "text": " 第6世代\tカロス\t-\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a4f",
      "text": " 第7世代\tアローラ\t[カプ神]\t[カプ・コケコ]、[カプ・テテフ]、[カプ・ブルル]、[カプ・レヒレ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a50",
      "text": " \t\tその他\t[タイプ：ヌル]、[シルヴァディ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a51",
      "text": " 第8世代\tガラル\t[ガラル三鳥]\t[ガラルフリーザー]、[ガラルサンダー]、[ガラルファイヤー]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a52",
      "text": " \t\tレジ系\t[レジエレキ]、[レジドラゴ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a53",
      "text": " \tヒスイ\tコピペロス\t[ラブトロス]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a54",
      "text": " 第9世代\tパルデア\t[四災]\t[チオンジェン]、[パオジアン]、[ディンルー]、[イーユイ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a55",
      "text": " \t\t[ともっこ]\t[イイネイヌ]、[マシマシラ]、[キチキギス]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a56",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a57",
      "text": "[伝説ポケモン]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a58",
      "text": "準伝ポケモン",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a59",
      "text": "[幻ポケモン]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
    {
      "id": "6abb10ac0000000000ee7a5a",
      "text": "[ポケモン]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644397,
      "updated": 1790644397
    },
