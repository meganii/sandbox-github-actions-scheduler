      "userId": "5b5e7121417cf700145b98c2",
      "created": 1787420079,
      "updated": 1787420136
    },
    {
      "id": "6a89dde80000000000542b3b",
      "text": "というわけで、新キャラのお名前募集中",
      "userId": "5b5e7121417cf700145b98c2",
