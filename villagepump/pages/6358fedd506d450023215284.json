    {
      "id": "6358fedd506d450023215284",
      "text": "ページ作成・編集のスタイル",
      "userId": "60508ed36a7abc00235e90c0",
      "created": 1666776806,
      "updated": 1666776813
    },
    {
      "id": "6358feed5e90c00000539c5f",
      "text": "井戸端を見ていると人によりけりで好みのスタイルがありそう",
      "userId": "60508ed36a7abc00235e90c0",
      "created": 1666776814,
      "updated": 1666776833
    },
    {
      "id": "6358ff035e90c00000539c61",
      "text": "",
      "userId": "60508ed36a7abc00235e90c0",
      "created": 1666776836,
      "updated": 1666776836
    },
    {
      "id": "6358ff045e90c00000539c62",
      "text": "",
      "userId": "60508ed36a7abc00235e90c0",
      "created": 1666776836,
      "updated": 1666776836
    },
    {
      "id": "6358ff045e90c00000539c63",
      "text": "　[赤リンクを埋める]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1666776836,
      "updated": 1687284053
    },
    {
      "id": "6358ff0c5e90c00000539c64",
      "text": "　[議論を切り出す]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1666776845,
      "updated": 1787151791
    },
    {
      "id": "6358ff185e90c00000539c65",
      "text": "　[連想した語でページを作る]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1666776857,
      "updated": 1787098362
    },
    {
      "id": "6358ff255e90c00000539c66",
      "text": "　[辞書・事典的にページを作る]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1666776869,
      "updated": 1787151514
    },
    {
      "id": "6358ff465e90c00000539c67",
      "text": "　[ページとページのハブを作る]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1666776902,
      "updated": 1787100202
    },
    {
      "id": "6358ff6d5e90c00000539c68",
      "text": "　[リスト・列挙]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1666776941,
      "updated": 1787149144
    },
    {
      "id": "6358fef45e90c00000539c60",
      "text": "　[とりあえずブラケティングする]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1666776820,
      "updated": 1787149374
    },
    {
      "id": "635900c65e90c00000539c6f",
      "text": "　[表記揺れをまとめる]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1666777287,
      "updated": 1787098190
    },
