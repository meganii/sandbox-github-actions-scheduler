  "lines": [
    {
      "id": "6a95daf39725a6b9bd674dcc",
      "text": "非難の文化",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788205852,
      "updated": 1788205852
    },
    {
      "id": "6a95db1c0000000000bf08e8",
      "text": "ミスやトラブルが発生した際に、原因の追究よりも「誰が悪いのか」という個人の責任を追及し、非難や処罰を行うことに終始する組織風土のこと",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788205852,
      "updated": 1788205854
    },
    {
      "id": "6a95db1d0000000000bf08e9",
      "text": "ブレームカルチャー（blame culture）",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788205854,
      "updated": 1788216047
    },
    {
      "id": "6a95db330000000000bf08ea",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788205876,
      "updated": 1788205876
    },
    {
      "id": "6a95db610000000000bf08eb",
      "text": "対義語",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788205921,
      "updated": 1788205930
    },
    {
      "id": "6a95db6b0000000000bf08ed",
      "text": "[公正な文化]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788205931,
      "updated": 1788205952
    },
    {
      "id": "6a95db690000000000bf08ec",
      "text": "[学習する文化]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788205930,
      "updated": 1788205980
    },
    {
      "id": "6a95db980000000000bf08ee",
      "text": "[非難なき文化]",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1788205977,
      "updated": 1788314232
    },
    {
      "id": "6a975cc60000000000c3c861",
