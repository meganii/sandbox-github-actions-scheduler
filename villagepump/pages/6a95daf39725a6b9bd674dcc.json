      "created": 1788205876,
      "updated": 1788205876
    },
    {
      "id": "6a95db610000000000bf08eb",
      "text": "対義語",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788205921,
      "updated": 1788205930
    },
    {
      "id": "6a95db6b0000000000bf08ed",
      "text": "[公正な文化]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1788205931,
      "updated": 1788205952
    },
    {
      "id": "6a95db690000000000bf08ec",
