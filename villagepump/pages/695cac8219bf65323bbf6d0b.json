  "lines": [
    {
      "id": "695cac8219bf65323bbf6d0b",
      "text": "ソロ曲 シャニマス",
      "userId": "660605441655f300254ac7c2",
      "created": 1767681155,
      "updated": 1787720722
    },
    {
      "id": "6a8e74110000000000187716",
      "text": "table: ",
      "userId": "660605441655f300254ac7c2",
      "created": 1787720722,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b40000000000187744",
      "text": "\tユニット\tアイドル\t声優\t1st\t2nd\tその他",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b40000000000187745",
      "text": "\t[イルミネーションスターズ]\t[櫻木真乃]\t[関根瞳]\t [ありったけの輝きで]\t [MAGICAL FOREST]\t [想像のつばさ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b40000000000187746",
      "text": "\t\t[風野灯織]\t[近藤玲奈]\t [スローモーション]\t[Embers glow]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b40000000000187747",
      "text": "\t\t[八宮めぐる]\t[峯田茉優]\t [HAREBARE!!]\t[Take Ur Time]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b40000000000187748",
      "text": "\t[アンティーカ]\t[月岡恋鐘]\t[礒部花凜]\t [アポイント・シグナル]\t[恋するクオリア]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b40000000000187749",
      "text": "\t\t[田中摩美々]\t[菅沼千紗]\t [誰ソ彼アイデンティティー]\t[正解な不正解]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b4000000000018774a",
      "text": "\t\t[白瀬咲耶]\t[八巻アンナ]\t [千夜アリア]\t[Lights on me]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b4000000000018774b",
      "text": "\t\t[三峰結華]\t[希水しお]\t [プラスチック・アンブレラ]\t[最上級パンチライン]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b4000000000018774c",
      "text": "\t\t[幽谷霧子]\t[結名美月]\t [雪・月・風・花]\t[カラースプレーとうさぎさん]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b4000000000018774d",
      "text": "\t[放課後クライマックスガールズ]\t[小宮果穂]\t[河野ひより]\t [ハナマルバッジ]\t[ハグルマヒマワリ]\t[絶対正義 EVERY DAY]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b4000000000018774e",
      "text": "\t\t[西城樹里]\t[永井真里子]\t [過純正ブリーチ]\t[パラボラ / 西城樹里]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721748
    },
    {
      "id": "6a8e77b4000000000018774f",
      "text": "\t\t[有栖川夏葉]\t[涼本あきほ]\t[Damascus Cocktail]\t[Be-witched]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b40000000000187750",
      "text": "\t\t[杜野凛世]\t[丸岡和佳奈]\t [常咲の庭]\t[月とネオンと薄紅と]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b40000000000187751",
      "text": " \t[園田智代子]\t[白石晴香]\t [チョコレート・サンデー]\t[ナイススパイス研究会]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b40000000000187752",
      "text": " [アルストロメリア]\t[大崎甘奈]\t[黒木ほの香]\t [Sweet Memories]\t[どっちみちLOVE]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b40000000000187753",
      "text": " \t[大崎甜花]\t[前川涼子]\t [また明日]\t[Odette]\t [デビ太郎のうた]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b40000000000187754",
      "text": " \t[桑山千雪]\t[芝崎典子]\t [Darling you!]\t[Sweet Boozy]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b40000000000187755",
      "text": " [ストレイライト]\t[芹沢あさひ]\t[田中有紀]\t [星をめざして]\t[ワタシグラビティ]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b40000000000187756",
      "text": " \t[黛冬優子]\t[幸村恵理]\t [SOS]\t[ガガリズム]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1788413368
    },
    {
      "id": "6a8e77b40000000000187757",
      "text": " \t[和泉愛依]\t[北原沙弥香]\t [Going my way]\t[Hold on me]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b40000000000187758",
      "text": " [ノクチル]\t[浅倉透]\t[和久井優]\t [statice]\t[Paradox]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721732
    },
    {
      "id": "6a8e77b40000000000187759",
      "text": " \t[樋口円香]\t[土屋李央]\t [夢見鳥]\t[ダミーガール]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b4000000000018775a",
      "text": " \t[福丸小糸]\t[田嶌紗蘭]\t [わたしの主人公はわたしだから！]\t[Here for you]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b4000000000018775b",
      "text": " \t[市川雛菜]\t[岡咲美保]\t [あおぞらサイダー]\t[ハートフルデイ ハートフルミー]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b4000000000018775c",
      "text": " [シーズ]\t[七草にちか]\t[紫月杏朱彩]\t [フェアリー・ガール]\t[Unstoppable]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721710
    },
    {
      "id": "6a8e77b4000000000018775d",
      "text": " \t[緋田美琴]\t[山根綺]\t [Look up to the sky]\t[Crying Diamond]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b4000000000018775e",
      "text": " [コメティック]\t[斑鳩ルカ]\t[川口莉奈]\t [1/3]\t[HELL-O]\t[神様は死んだ、って]",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b4000000000018775f",
      "text": " \t[鈴木羽那]\t[三川華月]\t [無垢]\t[Imaginary]\t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721652
    },
    {
      "id": "6a8e77b40000000000187760",
      "text": " \t[郁田はるき]\t[小澤麗那]\t [夢模様キャンバス]\t[HSV色空間 / 郁田はるき] \t",
      "userId": "660605441655f300254ac7c2",
      "created": 1787721652,
      "updated": 1787721724
    },
    {
      "id": "6a8e74110000000000187734",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1787720722,
      "updated": 1787720722
    },
    {
      "id": "6a8e74110000000000187735",
      "text": "補足",
      "userId": "660605441655f300254ac7c2",
      "created": 1787720722,
      "updated": 1787720722
    },
    {
      "id": "6a8e74b30000000000187740",
      "text": "\t1st",
      "userId": "660605441655f300254ac7c2",
      "created": 1787720884,
      "updated": 1788413331
    },
    {
      "id": "6a99059300000000000d7f9d",
      "text": "\t\tTHE IDOLM@STER SHINY COLORS COLORFUL FE@THERSに収録",
      "userId": "660605441655f300254ac7c2",
      "created": 1788413331,
      "updated": 1788413331
    },
    {
      "id": "6a99059300000000000d7f9e",
      "text": "\t\t\t[Team.Sol]、[Team.Luna]、[Team.Stella]のユニット毎に収録",
      "userId": "660605441655f300254ac7c2",
      "created": 1788413331,
      "updated": 1788413331
    },
    {
      "id": "6a99059300000000000d7f9f",
      "text": "\t\t\tシーズ・コメティックはユニット結成後、個別で発売",
      "userId": "660605441655f300254ac7c2",
      "created": 1788413331,
      "updated": 1788413331
    },
    {
      "id": "6a99059300000000000d7fa0",
      "text": "\t\t\t\tシーズ：COLORFUL FE@THERS -SHHis-",
      "userId": "660605441655f300254ac7c2",
      "created": 1788413331,
      "updated": 1788413331
    },
    {
      "id": "6a99059300000000000d7fa1",
      "text": "\t\t\t\tコメティック：COLORFUL FE@THERS -Cometik-",
      "userId": "660605441655f300254ac7c2",
      "created": 1788413331,
      "updated": 1788413331
    },
    {
      "id": "6a99059300000000000d7fa2",
      "text": "\t2nd",
      "userId": "660605441655f300254ac7c2",
      "created": 1788413331,
      "updated": 1788413331
    },
    {
      "id": "6a99059300000000000d7fa3",
      "text": "\t\t[Team.Sol]、[Team.Luna]、[Team.Stella]のユニット毎に収録",
      "userId": "660605441655f300254ac7c2",
      "created": 1788413331,
      "updated": 1788413331
    },
    {
      "id": "6a99059300000000000d7fa4",
      "text": "\t\t\t[THE IDOLM@STER SHINY COLORS HOPEFUL FE@THERS -Sol-]",
      "userId": "660605441655f300254ac7c2",
      "created": 1788413331,
      "updated": 1788413331
    },
    {
      "id": "6a99059300000000000d7fa5",
      "text": "\t\t\t[THE IDOLM@STER SHINY COLORS HOPEFUL FE@THERS -Luna-]",
      "userId": "660605441655f300254ac7c2",
      "created": 1788413331,
      "updated": 1788413331
    },
    {
      "id": "6a99059300000000000d7fa6",
      "text": "\t\t\t[THE IDOLM@STER SHINY COLORS HOPEFUL FE@THERS -Stella-]",
      "userId": "660605441655f300254ac7c2",
      "created": 1788413331,
      "updated": 1788413331
    },
    {
      "id": "6a99059300000000000d7fa7",
      "text": "\t\t各アルバムは[2026/09/16]発売",
      "userId": "660605441655f300254ac7c2",
      "created": 1788413331,
      "updated": 1788413331
    },
    {
      "id": "6a99063200000000000d7fa8",
      "text": "\tその他",
      "userId": "660605441655f300254ac7c2",
      "created": 1788413491,
      "updated": 1788413494
    },
    {
      "id": "6a8e74110000000000187736",
      "text": " \t想像のつばさ",
      "userId": "660605441655f300254ac7c2",
      "created": 1787720722,
      "updated": 1788413497
    },
    {
      "id": "6a8e74110000000000187737",
      "text": " \t\tアニメ [アイドルマスター シャイニーカラーズ] 第1期挿入歌",
      "userId": "660605441655f300254ac7c2",
      "created": 1787720722,
      "updated": 1788413497
    },
    {
      "id": "6a99066900000000000d7fa9",
      "text": " \t\t[ライブ]で1回のみ披露",
      "userId": "660605441655f300254ac7c2",
      "created": 1788413546,
      "updated": 1788413562
    },
    {
      "id": "6a8e74110000000000187738",
      "text": " \t絶対正義 EVERY DAY・デビ太郎のうた",
      "userId": "660605441655f300254ac7c2",
      "created": 1787720722,
      "updated": 1788413497
    },
    {
      "id": "6a8e74110000000000187739",
      "text": " \t\t2020年エイプリルフールに限定実装",
      "userId": "660605441655f300254ac7c2",
      "created": 1787720722,
      "updated": 1788413497
    },
    {
      "id": "6a99045000000000000d7f9b",
      "text": " \t\tサブスク配信なし",
      "userId": "660605441655f300254ac7c2",
      "created": 1788413008,
      "updated": 1788413497
    },
    {
      "id": "6a99045200000000000d7f9c",
      "text": " \t\t\t音源は公式通販CDでのみ入手可能",
      "userId": "660605441655f300254ac7c2",
      "created": 1788413011,
      "updated": 1788413497
    },
    {
      "id": "6a8e7411000000000018773a",
      "text": " \t神様は死んだ、って",
      "userId": "660605441655f300254ac7c2",
      "created": 1787720722,
      "updated": 1788413497
    },
    {
      "id": "6a8e7411000000000018773b",
      "text": " \t\tルカが[シャイニーカラーズ]加入前のソロ曲",
      "userId": "660605441655f300254ac7c2",
      "created": 1787720722,
      "updated": 1788413497
    },
