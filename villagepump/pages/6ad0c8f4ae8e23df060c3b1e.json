    {
      "id": "6ad0c9a90000000000338422",
      "text": "[scrapbox-bundler] の [CSS Nesting] 構文の展開バグっぽいもの",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792068009,
      "updated": 1792068052
    },
    {
      "id": "6ad0c8f8000000000033840f",
      "text": "[このボタン https://scrapbox-bundler.vercel.app/?url=https://scrapbox.io/api/code/villagepump/temp_2026-10-15/a.css&bundle&minify&noUtf8&reload=*://scrapbox.io/*]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792067832,
      "updated": 1792067988
    },
    {
      "id": "6ad0c8f80000000000338410",
      "text": "\t\tこれが",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792067832,
      "updated": 1792067832
    },
    {
      "id": "6ad0c8f80000000000338411",
      "text": " \t\tcode:a.css",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792067832,
      "updated": 1792067832
    },
    {
      "id": "6ad0c8f80000000000338412",
      "text": " \t\t .foo {",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792067832,
      "updated": 1792067832
    },
    {
      "id": "6ad0c8f80000000000338413",
      "text": " \t\t \t:where(.bar) > :is(& + .baz, & + .baz + .baz, & + .baz + .baz + .baz) { ... }",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792067832,
      "updated": 1792067832
    },
    {
      "id": "6ad0c8f80000000000338414",
      "text": " \t\t }",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792067832,
      "updated": 1792067832
    },
    {
      "id": "6ad0c9110000000000338418",
      "text": " \tこうなる",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792067857,
      "updated": 1792067860
    },
    {
      "id": "6ad0c90d0000000000338417",
      "text": " \t\tcode:b.css",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792067853,
      "updated": 1792067856
    },
    {
      "id": "6ad0c90b0000000000338415",
      "text": " \t\t .foo{:where(.bar)>:is(+.baz,+.baz+.baz,+.baz+.baz+.baz){...}}",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792067851,
      "updated": 1792067851
    },
