    },
    {
      "id": "6b03143f6eb4060000009a864e",
      "text": "第48週: 日[[月]]火水木金土",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1795363902,
      "updated": 1795363902
    },
    {
      "id": "6b03143f6eb4060000008075e7",
      "text": "2026年 89.59％経過",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1795363902,
      "updated": 1795363902
    },
    {
      "id": "6b03143f6eb4060000001a0147",
