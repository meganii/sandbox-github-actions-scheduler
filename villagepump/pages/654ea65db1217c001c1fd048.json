      "updated": 1792682391
    },
    {
      "id": "6ada294400000000003de399",
      "text": "\t> [** 異表記・別形]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792682309,
      "updated": 1792682463
    },
    {
      "id": "6ada295f00000000003de39a",
      "text": " > \t[msgk]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792682335,
      "updated": 1792682555
    },
    {
      "id": "6ada2a3d00000000003de3ab",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792682557,
      "updated": 1792682557
    },
    {
      "id": "6ada295f00000000003de39f",
      "text": " > [** 名詞]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792682335,
      "updated": 1792682472
    },
    {
      "id": "6ada295f00000000003de3a0",
      "text": " > [* メスガキ]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792682335,
      "updated": 1792682480
    },
    {
      "id": "6ada295f00000000003de3a1",
      "text": " > \t(フィクション, 卑語) 年長者を性的に[揶揄]うのが好きな幼い（または幼く見える）[少女]。",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792682335,
      "updated": 1792682484
    },
    {
      "id": "6ada295f00000000003de3a2",
      "text": " > [* 同族語]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792682335,
      "updated": 1792682494
    },
    {
      "id": "6ada295f00000000003de3a3",
      "text": " > \t(男性, まれ) [オスガキ]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792682335,
      "updated": 1792682364
    },
    {
      "id": "6ada295f00000000003de3a4",
      "text": " > [* 諸言語への影響]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792682335,
      "updated": 1792682497
    },
    {
      "id": "6ada295f00000000003de3a5",
      "text": " > \t→ 英語: mesugaki",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792682335,
      "updated": 1792682544
    },
    {
      "id": "6ada295f00000000003de3a6",
      "text": " > \t→ 中国語: 雌小鬼 (cíxiǎoguǐ) (翻訳借用)",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792682335,
      "updated": 1792682539
    },
    {
      "id": "6ada295f00000000003de3a7",
      "text": " > \t→ 朝鮮語: 메스가키 (mesŭgak'i)",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792682335,
      "updated": 1792682542
    },
    {
      "id": "6ada295f00000000003de3a8",
      "text": " > [* 参照]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792682335,
      "updated": 1792682502
    },
    {
      "id": "6ada295f00000000003de3a9",
      "text": " > \t[ロリビッチ]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792682335,
      "updated": 1792682372
    },
    {
      "id": "6ada295f00000000003de3aa",
      "text": " > \t[ざぁこ]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1792682335,
      "updated": 1792682374
    },
    {
      "id": "6ada293500000000003de396",
      "text": "",
