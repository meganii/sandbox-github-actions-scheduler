    },
    {
      "id": "6addbdc70000000000e6a9f5",
      "text": "[情報セキュリティの3要素]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1792916935,
      "updated": 1792916936
    },
    {
      "id": "6addbdc80000000000e6a9f6",
      "text": " [機密性]（[Confidentiality]）",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1792916936,
      "updated": 1792916936
    },
    {
      "id": "6addbdc80000000000e6a9f7",
      "text": " [完全性]（[Integrity]）",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1792916936,
      "updated": 1792916936
    },
    {
      "id": "6addbdc80000000000e6a9f8",
      "text": " [可用性]（[Availability]）",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1792916936,
      "updated": 1792916936
    },
    {
      "id": "6addbdc80000000000e6a9f9",
      "text": "追加",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1792916936,
      "updated": 1792916936
    },
    {
      "id": "6addbdc80000000000e6a9fa",
      "text": "　[真正性]（[Authenticity]）",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1792916936,
      "updated": 1792916936
    },
    {
      "id": "6addbdc80000000000e6a9fb",
