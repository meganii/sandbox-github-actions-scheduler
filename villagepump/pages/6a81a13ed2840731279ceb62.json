    {
      "id": "6a81a1e50000000000e7c10a",
      "text": "[1983年]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786880485,
      "updated": 1786881158
    },
    {
      "id": "6a81a1e90000000000e7c10b",
      "text": "[リチャード・マーカンド]というルーカスに見出された新人が監督をしている",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786880489,
      "updated": 1786881154
    },
    {
      "id": "6a81a2140000000000e7c10c",
      "text": "",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786880532,
      "updated": 1786880532
    },
    {
      "id": "6a81a1d30000000000e7c109",
      "text": "奴隷にされるレイア",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786880467,
      "updated": 1786880472
    },
    {
      "id": "6a81a1cf0000000000e7c108",
      "text": "蟻地獄的なやつ",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786880464,
      "updated": 1786880467
    },
    {
      "id": "6a81a1c00000000000e7c106",
      "text": "[ボバ・フェット]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786880449,
      "updated": 1786880606
    },
    {
      "id": "6a81a1770000000000e7c102",
      "text": "[エンドアの戦い]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786880375,
      "updated": 1786880632
    },
    {
      "id": "6a81a1440000000000e7c100",
      "text": "[イウォーク]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786880324,
      "updated": 1786881168
    },
    {
      "id": "6a81a2820000000000e7c10e",
      "text": "\tこういう小動物的なキャラクターが普通に死んじゃうのがショックだった思い出がある",
      "userId": "60c9f2f6c225a50020b8bbfc",
