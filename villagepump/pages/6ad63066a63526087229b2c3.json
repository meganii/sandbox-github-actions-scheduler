    {
      "id": "6ad63066a63526087229b2c3",
      "text": "いかなごのうた",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792421994,
      "updated": 1792421994
    },
    {
      "id": "6ad631b500000000002acaba",
      "text": "[https://youtu.be/QtB3J8SqI7I]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422326,
      "updated": 1792422331
    },
    {
      "id": "6ad631be00000000002acabb",
      "text": "",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422335,
      "updated": 1792422335
    },
    {
      "id": "6ad6306900000000002aca99",
      "text": " [ふじたごうらこ]の詩",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792421994,
      "updated": 1792422346
    },
    {
      "id": "6ad6309a00000000002aca9b",
      "text": "  および[森田交一]([魔王魂])がそれに曲を付けた歌",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422042,
      "updated": 1792422103
    },
    {
      "id": "6ad631b300000000002acab9",
      "text": "",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422324,
      "updated": 1792422324
    },
    {
      "id": "6ad630ef00000000002aca9c",
      "text": " 歌詞([原文リンク https://ncode.syosetu.com/n2493gn/1/])",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422128,
      "updated": 1792422297
    },
    {
      "id": "6ad6314e00000000002aca9e",
      "text": ">「いかなごのうた」 　 ふじたごうらこ　",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422223,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002aca9f",
      "text": "> ",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002acaa0",
      "text": "> わいらはいかなご、なかまがたくさんおってな",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002acaa1",
      "text": "> さとうであまくなって",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002acaa2",
      "text": "> しょうゆでからくなって",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002acaa3",
      "text": "> ちょうどようあまかろうなって",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002acaa4",
      "text": "> しあがりにちょいとしょうがをいれてもろうて",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002acaa5",
      "text": "> ごはんのうえにのっけてたべてくださいや",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002acaa6",
      "text": "> おいしいでえおいしいでえおいしいでえ",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6316500000000002acab4",
      "text": ">",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422246,
      "updated": 1792422249
    },
    {
      "id": "6ad6315100000000002acaa7",
      "text": "> わいらはいかなご、なかまでおいしくかたまって",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002acaa8",
      "text": "> さとうでひかって",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002acaa9",
      "text": "> しょうゆでじっくり",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002acaaa",
      "text": "> ちょうどようあまかろうなって",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002acaab",
      "text": "> しあがりにちょいとさんしょをいれてもろうて",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002acaac",
      "text": "> ごはんのうえにのっけてたべてくださいや",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002acaad",
      "text": "> おいしいでえおいしいでえおいしいでえ",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6316e00000000002acab5",
      "text": ">",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422255,
      "updated": 1792422256
    },
    {
      "id": "6ad6315100000000002acaae",
      "text": "> わいらはいかなご、なかまでいっしょにたべられる",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002acaaf",
      "text": "> おはしでつまれてえがおみて",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002acab0",
      "text": "> あじわられてえがおみる",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002acab1",
      "text": "> おいしいねというこえをきいて",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002acab2",
      "text": "> わいらはよかったなあとよろこぶよ",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422234
    },
    {
      "id": "6ad6315100000000002acab3",
      "text": "> おいしいでえおいしいでえたくさんたべてやあ",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422225,
      "updated": 1792422240
    },
    {
      "id": "6ad6318700000000002acab7",
      "text": "",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422280,
      "updated": 1792422280
    },
    {
      "id": "6ad631cd00000000002acabc",
      "text": "[いかなご]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422349,
      "updated": 1792422352
    },
    {
      "id": "6ad631cd00000000002acabd",
      "text": "[いかなごの釘煮]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1792422350,
      "updated": 1792422365
    },
    {
      "id": "6ad631d700000000002acabe",
