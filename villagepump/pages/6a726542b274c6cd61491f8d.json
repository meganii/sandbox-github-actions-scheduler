      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786870369,
      "updated": 1786870373
    },
    {
      "id": "6a79aa67000000000000e3ff",
      "text": "\tcode:style.css",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786358376,
      "updated": 1786358376
    },
    {
      "id": "6a79aa67000000000000e400",
      "text": "\t\t.grid li.page-list-item.image > a {",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786358376,
      "updated": 1786358376
    },
    {
      "id": "6a79aa67000000000000e401",
