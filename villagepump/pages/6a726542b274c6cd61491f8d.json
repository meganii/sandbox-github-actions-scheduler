      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786179255,
      "updated": 1786179510
    },
    {
      "id": "6a99308f0000000000a6a5da",
      "text": "　[--icon-bg]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788424336,
      "updated": 1788424348
    },
    {
      "id": "6a76eeae00000000009e970f",
      "text": "　　[ダークテーマ対応済みのアイコンの一覧（井戸端用）]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786179247,
      "updated": 1786179511
    },
    {
      "id": "6a9848f700000000009cc7c9",
      "text": "　　[アイコン記法を画像記法っぽくするUserCSS]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788365047,
      "updated": 1788365077
    },
    {
      "id": "6a76ee9600000000009e9709",
      "text": "\tcode:style.css",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786179223,
      "updated": 1786179223
    },
    {
      "id": "6a76ee9600000000009e970a",
      "text": "\t\ta.link > :is(img.icon, img.inline-icon) {",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786179223,
      "updated": 1786870790
    },
    {
      "id": "6a76ee9600000000009e970b",
      "text": "\t\t\tbackground-color: var(--icon-bg, transparent);",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786179223,
      "updated": 1786179223
    },
    {
      "id": "6a76ee9600000000009e970c",
