      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa0000000000758283",
      "text": "\t \tborder-bottom: 1px solid var(--search-result-list-item-border-color, #dcdcdc);",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa0000000000758284",
      "text": "\t \tbackground-color: var(--search-result-list-bg, #fafafa);",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa0000000000758285",
      "text": "\t \tcolor: var(--search-result-list-item-text-color, var(--page-text-color, #444));",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1786091272
    },
    {
      "id": "6a731bfa0000000000758286",
      "text": "\t \t",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa0000000000758287",
      "text": "\t \t&:nth-child(even) {",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa0000000000758288",
      "text": "\t \t\tbackground-color: var(--search-result-list-item-even-bg, #fafafa);",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa0000000000758289",
      "text": "\t\t\t}",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa000000000075828a",
      "text": "\t \t&:nth-child(odd) {",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa000000000075828b",
      "text": "\t \t\tbackground-color: var(--search-result-list-item-odd-bg, #fafafa);",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa000000000075828c",
      "text": "\t\t\t}",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa000000000075828d",
      "text": "\t\t\t",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa000000000075828e",
      "text": "\t\t\t& > a {",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1786091248
    },
    {
      "id": "6a731bfa000000000075828f",
      "text": "\t\t\t\tcolor: var(--search-result-item-text-color, var(--page-text-color, #444));",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1786091332
    },
    {
      "id": "6a731bfa0000000000758290",
      "text": "\t\t\t\t",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa0000000000758291",
      "text": "\t\t\t\t&:active, [data-hover-visible] &:hover {",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa0000000000758292",
      "text": "\t\t\t\t\tbackground-color: var(--search-result-item-hover-bg, #f5f5f5);",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1786093266
    },
    {
      "id": "6a731bfa0000000000758293",
      "text": "\t\t\t\t\tcolor: var(--search-result-list-item-text-hover-color, hsl(0 0% 15%));",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1786093248
    },
    {
      "id": "6a731bfa0000000000758294",
      "text": "\t\t\t\t}",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa0000000000758295",
      "text": "\t \t\t& .description {",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa0000000000758296",
      "text": "\t \t\t\tcolor: var(--search-result-list-item-description-color, #666);",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa0000000000758297",
      "text": "\t \t\t}",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa0000000000758298",
      "text": "\t \t\t& .search-matched {",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa0000000000758299",
      "text": "\t \t\t\t/* 配色は関連ページリストのカードに対するものと共通 */",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1786794128
    },
    {
      "id": "6a80507100000000002aa6de",
      "text": "\t \t\t\tcolor: var(--page-list-item-search-matched-text-color, #333);",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786794098,
      "updated": 1786794098
    },
    {
      "id": "6a731bfa000000000075829a",
      "text": "\t \t\t\tbackground-color: var(--page-list-item-search-matched-text-bg, #ff0);",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa000000000075829b",
      "text": "\t \t\t}",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa000000000075829c",
      "text": "\t\t\t}",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
    {
      "id": "6a731bfa000000000075829d",
      "text": "\t }",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785928699,
      "updated": 1785928699
    },
