      "updated": 1788365116
    },
    {
      "id": "6a98492a00000000005fd9fb",
      "text": " 　[アイコン記法を画像記法っぽくするUserCSS]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788365098,
      "updated": 1788365100
    },
    {
      "id": "6a79ab74000000000000e40e",
      "text": "\tcode:style.css",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786358645,
      "updated": 1786358645
    },
    {
      "id": "6a79ab74000000000000e40f",
      "text": "\t .line img:is(.image, .mordal-image) {",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786358645,
      "updated": 1786358662
    },
    {
