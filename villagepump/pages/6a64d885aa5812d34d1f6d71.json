  "lines": [
    {
      "id": "6a64d885aa5812d34d1f6d71",
      "text": "2026/07/26",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1784993927,
      "updated": 1784993927
    },
    {
      "id": "6a64ea206eb4060000002f2cbf",
      "text": "第31週: [[日]]月火水木金土",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1784998432,
      "updated": 1784998432
    },
    {
      "id": "6a64ea206eb40600000083d851",
      "text": "2026年 56.71％経過",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1784998432,
      "updated": 1784998432
    },
    {
      "id": "6a64ea206eb406000000315096",
      "text": "",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1784998432,
      "updated": 1784998432
    },
    {
      "id": "6a64d8970000000000a12b2f",
      "text": "[はるひ.icon]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1784993944,
      "updated": 1784994798
    },
    {
      "id": "6a64d89a0000000000a12b30",
      "text": " 暑すぎるという問題について考察",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1784993946,
      "updated": 1784993955
    },
    {
      "id": "6a64e03e000000000034887f",
      "text": "  汗かいちゃうな",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1784995903,
      "updated": 1784995910
    },
    {
      "id": "6a64e15e0000000000348881",
      "text": " つぶグミうま",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1784996191,
      "updated": 1784999363
    },
    {
      "id": "6a64edc30000000000d9efce",
      "text": " [TINY TURNIP]おもろい",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1784999363,
      "updated": 1784999821
    },
    {
      "id": "6a655060000000000035cef1",
      "text": " 昨日からベッドから出れなくて詰んどる",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1785024609,
      "updated": 1785047667
    },
    {
      "id": "6a65aa780000000000d9f93a",
      "text": " 連日[モルノダ]をロケットナウで頼んでおり",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1785047680,
      "updated": 1785047724
    },
    {
      "id": "6a65d7120000000000eaa65c",
      "text": " 汗ばんでしまうかもしれない",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1785059096,
      "updated": 1785059097
    },
    {
      "id": "6a65dc030000000000eaa65d",
      "text": " 本日は[バンギバス]を頂けるらしい…ワクワク",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1785060356,
      "updated": 1785060373
    },
    {
      "id": "6a65ff6e0000000000ca8bc2",
      "text": " バンギバスはチャトニやサンバルを混ぜながら食べて腹パン",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1785069422,
      "updated": 1785069443
    },
    {
      "id": "6a65feab0000000000ca8bb9",
      "text": " [https://gyazo.com/d7e97af49e73c6a525f6b85c1414e328]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1785069229,
      "updated": 1785069315
    },
    {
      "id": "6a65ff030000000000ca8bba",
      "text": "\tインドアイスのうまさといったらない",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1785069315,
      "updated": 1785069320
    },
    {
      "id": "6a65ff0f0000000000ca8bbb",
      "text": "\t今日は風があってベンチで寝そべって涼んでいる人が何名かおり加わって涼んでおいた",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1785069328,
      "updated": 1785069356
    },
    {
      "id": "6a65ff3c0000000000ca8bbd",
      "text": " [https://www.youtube.com/watch?v=VGNE7IRxsWI]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1785069372,
      "updated": 1785069372
    },
    {
      "id": "6a65ff3f0000000000ca8bbe",
      "text": " おもろすぎた",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1785069375,
      "updated": 1785069379
    },
    {
      "id": "6a65ff500000000000ca8bc0",
      "text": " 埃まるけの中古品や中古の食器は自分は抵抗があるんだが",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1785069393,
      "updated": 1785069405
    },
    {
      "id": "6a65ff5d0000000000ca8bc1",
      "text": " マイセンの話は母が詳しくて少しだけ知っていた",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1785069405,
      "updated": 1785069418
    },
    {
      "id": "6a64e16f0000000000348882",
      "text": "",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1784996207,
      "updated": 1784996207
    },
    {
      "id": "6a64eae9000000000031728e",
      "text": "[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1784998633,
      "updated": 1784998635
    },
    {
      "id": "6a64eaeb000000000031728f",
      "text": " 鶏胸肉をサラダチキンに変換し終わった",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1784998635,
      "updated": 1784998649
    },
    {
      "id": "6a6568e800000000003070dc",
      "text": " \t[サラダチキンコンバーター]だ[mtane0412.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1785030889,
      "updated": 1785031235
    },
    {
      "id": "6a659e920000000000ff80ea",
      "text": " \tskillにして誰かにやってほしい作業[基素.icon]",
      "userId": "59fb21121207900012774b17",
      "created": 1785044626,
      "updated": 1785044640
    },
    {
      "id": "6a6563b000000000007d65a9",
      "text": " [ポモ]の合間に[狂犬病予防注射会場のドタバタ劇]を見ている",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1785029553,
      "updated": 1785060682
    },
    {
      "id": "6a6581f4000000000066e53d",
      "text": " カフェで隣の人たちが人生相談をしており片方の人が[秘書]の資格を取ることをしきりに勧めていた",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1785037301,
      "updated": 1785053215
    },
    {
      "id": "6a65821b000000000066e53e",
      "text": "  秘書的な仕事はすでにAIがやっているのですぐなくなるんじゃないか、と思ったが、一方現在秘書を雇っているような人たちはたぶん一定の余裕がある人たちや近くに人を置く必要性のある人などで、そういう人たちはたぶん秘書の機能だけ求めて雇ってるわけじゃなさそうだし案外残り続けるかも、とも思った",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1785037339,
      "updated": 1785037738
    },
    {
      "id": "6a6582b8000000000066e540",
      "text": "   秘書として雇われ、ちょい看護師領域に踏み込んだ仕事もしてる人もいるみたいな話をどこかで聞いた気がする",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1785037497,
      "updated": 1785037568
    },
    {
      "id": "6a65019b0000000000d27f7a",
      "text": "",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1785004444,
      "updated": 1785004444
    },
    {
      "id": "6a65019c0000000000d27f7b",
      "text": "[h45te.icon]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1785004444,
      "updated": 1785004446
    },
    {
      "id": "6a65019e0000000000d27f7c",
      "text": " [Typebox]勉強中...",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1785004447,
      "updated": 1785035592
    },
    {
      "id": "6a6502530000000000d27f82",
      "text": "  型安全を意識するとランタイムエラーを意識する機会が減るため非常に楽(な気がする)",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1785004628,
      "updated": 1785004749
    },
    {
      "id": "6a6502890000000000d27f83",
      "text": "   コンパイルエラー:すぐ気づける",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1785004682,
      "updated": 1785004697
    },
    {
      "id": "6a65029c0000000000d27f84",
      "text": "    [TypeScript]は[VS Code]でのサポートが手厚いので特に",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1785004700,
      "updated": 1785038674
    },
    {
      "id": "6a6501b80000000000d27f7d",
      "text": "  そしてちょっと勉強した後に自分のプログラムを見直すと",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1785004472,
      "updated": 1785004672
    },
    {
      "id": "6a6501ef0000000000d27f7e",
      "text": "  　過去の自分のプログラムに非常にユニークな記法を見つけて成長を感じられる",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1785004527,
      "updated": 1785004545
    },
    {
      "id": "6a65eb3500000000007a24b9",
      "text": " [フジロック]の[平沢進]+[会人]を見ていた",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1785064247,
      "updated": 1785064306
    },
    {
      "id": "6a65eb7400000000006d604f",
      "text": "  個人的事情でやむを得ず途中から配信視聴",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1785064308,
      "updated": 1785064333
    },
    {
      "id": "6a65eb8e00000000006d6050",
      "text": "  [救済の技法]がラストに来て嬉しい限り",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1785064334,
      "updated": 1785064402
    },
    {
      "id": "6a65ebd500000000006d6051",
      "text": "   なんというか圧がすごかった",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1785064405,
      "updated": 1785064432
    },
    {
      "id": "6a65ebff00000000006d6052",
      "text": "    [Nurse Cafe]がリアレンジでリズム重視の音作り？だったのも理由かも",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1785064448,
      "updated": 1785064588
    },
    {
      "id": "6a65ec7000000000006d6053",
      "text": "    こちらは原曲に近いバカコーラスが目立つアレンジだった",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1785064560,
      "updated": 1785064635
    },
    {
      "id": "6a65ec9800000000006d6054",
      "text": "     Nurse Cafeのアレンジも新鮮で好きだし、救済の技法のバカコーラスで殴るのも大好き",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1785064601,
      "updated": 1785064757
    },
    {
      "id": "6a65ed3b00000000006d6055",
      "text": "   背景が救済ジャケットの赤い長方形固定なのがジワジワきた",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1785064763,
      "updated": 1785064808
    },
    {
      "id": "6a65edbe0000000000f670e4",
      "text": "  いいなあ。聞きたかった[terang.icon]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1785064895,
      "updated": 1785064899
    },
    {
      "id": "6a64eaf90000000000317290",
      "text": "",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1784998650,
      "updated": 1784998650
    },
    {
      "id": "6a6524e60000000000d94a8f",
      "text": "[hiro.icon]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1785013543,
      "updated": 1785013545
    },
    {
      "id": "6a6524e90000000000d94a91",
      "text": " 理想の朝",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1785013545,
      "updated": 1785013565
    },
    {
      "id": "6a6529f90000000000a3fecd",
      "text": " [https://dlt.kitetu.com/KNo.F85E/0758-CE0B.webp?20260726062556]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1785014842,
      "updated": 1785014843
    },
    {
      "id": "6a652a010000000000a3fed0",
      "text": "  昔の浦安元町の様子（左端の男性が曾祖父・宇田川富蔵）",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1785014849,
      "updated": 1785016222
    },
    {
      "id": "6a65b9d700000000005d353d",
      "text": "  \t活気を感じる…[hoagecko.icon]",
      "userId": "688c296691686a314f82fb52",
      "created": 1785051607,
      "updated": 1785051612
    },
    {
      "id": "6a652b2f0000000000aa6f86",
      "text": "  これがディズニーの街になり、いずれ希哲館を中心とした観光知識都市として世界を牽引する超日本を作っていくと想像してみたら、これ以上のロマンはないな",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1785015152,
      "updated": 1785015930
    },
    {
      "id": "6a652be00000000000aa6f87",
      "text": "  [関東開拓時代]の大遺産",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1785015328,
      "updated": 1785015367
    },
    {
      "id": "6a6546970000000000193bbf",
      "text": "",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1785022102,
      "updated": 1785022102
    },
    {
      "id": "6a6546970000000000193bc0",
      "text": "[taktamur.icon]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1785022102,
      "updated": 1785022106
    },
    {
      "id": "6a65469b0000000000193bc1",
      "text": " ぼへらーや。ぼへらーや。",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1785022107,
      "updated": 1785022125
    },
    {
      "id": "6a6546ae0000000000193bc2",
      "text": " [天幕のジャードゥーガル] これいいね",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1785022126,
      "updated": 1785032899
    },
    {
      "id": "6a6570c20000000000a0bc28",
      "text": " \t絵柄が独特だけどすぐ馴染んだ。むしろこの絵柄が良い",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1785032899,
      "updated": 1785033307
    },
    {
      "id": "6a657272000000000076fbec",
      "text": " \tOpの音楽、[チ。―地球の運動について―] と同じ人かな？すごい連想する。",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1785033331,
      "updated": 1785033359
    },
    {
      "id": "6a658f5a0000000000495a65",
      "text": " \tニコニコ動画で見てるが、アニメ単体でも良い作品だが、コメントでイロイロ解説されててさらに良い[Hiro Aki.icon]",
      "userId": "65e1289acd012200235729c0",
      "created": 1785040731,
      "updated": 1785040795
    },
    {
      "id": "6a658f7f0000000000495a66",
      "text": " \t\t特に当時のモンゴルなお話の解説付きで見られるためより楽しい",
      "userId": "65e1289acd012200235729c0",
      "created": 1785040768,
      "updated": 1785040775
    },
    {
      "id": "6a657e6e000000000076fbee",
      "text": " がっつり降ってる",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1785036398,
      "updated": 1785036402
    },
    {
      "id": "6a657e71000000000076fbef",
      "text": " \t[https://gyazo.com/81370962b3a0c89b35f866e8e0a372d0]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1785036402,
      "updated": 1785036405
    },
    {
      "id": "6a65808f0000000000c52af0",
      "text": " \t雷すっご ",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1785036944,
      "updated": 1785037649
    },
    {
      "id": "6a658351000000000066e541",
      "text": " \t頭痛の雰囲気漂ってたけどこのせいか[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1785037650,
      "updated": 1785037665
    },
    {
      "id": "6a658ce700000000003b8b88",
      "text": " \t自分はこのあとか（千葉）[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785040104,
      "updated": 1785040109
    },
    {
      "id": "6a657e75000000000076fbf0",
      "text": "",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1785036405,
      "updated": 1785036405
    },
    {
      "id": "6a6529fa0000000000a3fece",
      "text": "",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1785014843,
      "updated": 1785014843
    },
    {
      "id": "6a654b1a0000000000d6627a",
      "text": "[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785023258,
      "updated": 1785023258
    },
    {
      "id": "6a654b1a0000000000d6627b",
      "text": "\t[イッヌ #shuffledance #シャッフルダンス - YouTube https://www.youtube.com/shorts/O2-y7qqjXE0]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785023259,
      "updated": 1785023774
    },
    {
      "id": "6a654b280000000000d6627d",
      "text": "\t\t🐶はモザイクかけなくていいんだよね",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785023273,
      "updated": 1785023276
    },
    {
      "id": "6a6570140000000000b8f886",
      "text": "\t\tやはり犬は結構シャッフルダンスを嫌う感じがある",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785032726,
      "updated": 1785032748
    },
    {
      "id": "6a65a9790000000000d9f939",
      "text": " \t\tおもろ[はるひ.icon]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1785047417,
      "updated": 1785047421
    },
    {
      "id": "6a6570dc0000000000b8f887",
      "text": "\tなんだろうな、自分は本能的に上手くないというか「キモイ」感じがある",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785032925,
      "updated": 1785033128
    },
    {
      "id": "6a65717a0000000000b8f88e",
      "text": "\t\t仮説検証で一番早いのはVRChatで踊ってみることだなぁ",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785033083,
      "updated": 1785033093
    },
    {
      "id": "6a6571840000000000b8f88f",
      "text": "\t\t\tが、そんな自宅環境を入手できるのはいつになることやら",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785033093,
      "updated": 1785033107
    },
    {
      "id": "6a6571920000000000b8f890",
      "text": "\t\t\tまずは関東圏を出なければ……",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785033107,
      "updated": 1785033113
    },
    {
      "id": "6a65716d0000000000b8f88d",
      "text": "\t休日は勉強せずに遊びに開き直っているが、これくらいがちょうどいいのかもしれないな",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785033070,
      "updated": 1785033082
    },
    {
      "id": "6a6571160000000000b8f88a",
      "text": "\t\tずっとこれだとこの先生きていけるかわからんが、たまにはいいだろう",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785032983,
      "updated": 1785032991
    },
    {
      "id": "6a654b190000000000d66279",
      "text": "\tyoutubeでは最近犬や赤ちゃん系動画ばかりを見ているが、思えばこういうチート級の幸福装置を持ってる人達が相手なんだよなぁ",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785023258,
      "updated": 1785047282
    },
    {
      "id": "6a65a8f0000000000097cdee",
      "text": "\t\t社内でもごまんといる",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785047282,
      "updated": 1785047287
    },
    {
      "id": "6a65a8f6000000000097cdef",
      "text": "\t\tこれらと一緒に仕事をしなければならない",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785047287,
      "updated": 1785047304
    },
    {
      "id": "6a65a907000000000097cdf0",
      "text": "\t\t当然「全然違う」俺が勝てる・追いつく・馴染めるはずがなく、貢献や生存の戦略は考えねばならぬ",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785047304,
      "updated": 1785047371
    },
    {
      "id": "6a65aa6c000000000097cdf1",
      "text": "\t\tいや強みの問題か？",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785047661,
      "updated": 1785047667
    },
    {
      "id": "6a65aa6e000000000097cdf2",
      "text": "\t\t\t逆に俺は何も抱えていないことによる圧倒的な自由と余裕が武器のはずだ",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785047667,
      "updated": 1785047675
    },
    {
      "id": "6a65aa80000000000097cdf3",
      "text": "\t\tと、このように人生と戦略について悩むことが多い。これもソロ派の一つの弊害か",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785047681,
      "updated": 1785047700
    },
    {
      "id": "6a65a8d9000000000097cded",
      "text": "\tふー、小説過去作ようやく一通り読み終えれた（100万文字超）",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785047259,
      "updated": 1785059104
    },
    {
      "id": "6a65d71f0000000000664922",
      "text": "\t\t内容頭に入ったぞ",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785059104,
      "updated": 1785059107
    },
    {
      "id": "6a65d7220000000000664923",
      "text": "\t\t最後まで書ききってしまいたい",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785059107,
      "updated": 1785059113
    },
    {
      "id": "6a65d7280000000000664924",
      "text": "\t\t今書かないでいつ書くんだ",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785059114,
      "updated": 1785059118
    },
    {
      "id": "6a65d7310000000000664925",
      "text": "\t\t\t生活落ち着いたら、人生落ち着いたらとか言ってたら老人になってしまう",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785059123,
      "updated": 1785059131
    },
    {
      "id": "6a65d7470000000000664926",
      "text": "\t\tしかしClaudeにはお世話になっている",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785059145,
      "updated": 1785059150
    },
    {
      "id": "6a65d74d0000000000664927",
      "text": "\t\t\t外出先でも読むためのHTML化とかもすぐにやってくれた",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785059150,
      "updated": 1785059162
    },
    {
      "id": "6a65d7100000000000664921",
      "text": "",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1785059089,
      "updated": 1785059089
    },
    {
      "id": "6a6552f900000000004bcd54",
      "text": "[hoagecko.icon]",
      "userId": "688c296691686a314f82fb52",
      "created": 1785025271,
      "updated": 1785025272
    },
    {
      "id": "6a6552fb00000000004bcd56",
      "text": " [Cloudflare]の[WARP VPN] (Windows版) が最近になってようやく規約同意画面を出すようになった",
      "userId": "688c296691686a314f82fb52",
      "created": 1785025272,
      "updated": 1785025313
    },
    {
      "id": "6a65532300000000004bcd57",
      "text": " \t悪用する人が多そうなサービスなのに、今までこのポップアップが出なかったのは不思議",
      "userId": "688c296691686a314f82fb52",
      "created": 1785025313,
      "updated": 1785025351
    },
    {
      "id": "6a65ba3c00000000005d353e",
      "text": " 昨日なんやかんやあって個人サイトの開設時期を検討している",
      "userId": "688c296691686a314f82fb52",
      "created": 1785051708,
      "updated": 1785051731
    },
    {
      "id": "6a65ba5f00000000005d353f",
      "text": " \tとりあえず独自ドメインがほしい",
      "userId": "688c296691686a314f82fb52",
      "created": 1785051744,
      "updated": 1785051752
    },
    {
      "id": "6a65ba6e00000000005d3540",
      "text": " \tエロとナチスと多少の差別表現の許容が可能な国内サーバーを探さなきゃいけない",
      "userId": "688c296691686a314f82fb52",
      "created": 1785051759,
      "updated": 1785051905
    },
    {
      "id": "6a65ba7e00000000005d3541",
      "text": " \t\tナチスについては戦前の都市文化が好きな関係で許容が必須",
      "userId": "688c296691686a314f82fb52",
      "created": 1785051774,
      "updated": 1785051792
    },
    {
      "id": "6a65ba9000000000005d3542",
      "text": " \t\t\tN響の前身もナチス党党歌を演奏したりしている",
      "userId": "688c296691686a314f82fb52",
      "created": 1785051793,
      "updated": 1785051886
    },
    {
      "id": "6a65bb0300000000005d3543",
      "text": " \t\tエロはエログロナンセンスの文脈",
      "userId": "688c296691686a314f82fb52",
      "created": 1785051907,
      "updated": 1785051921
    },
    {
      "id": "6a65bb1100000000005d3544",
      "text": " \t\t差別は昭和なのでしゃーない",
      "userId": "688c296691686a314f82fb52",
      "created": 1785051921,
      "updated": 1785051933
    },
    {
      "id": "6a6557af0000000000d96037",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785026481,
      "updated": 1785026481
    },
    {
      "id": "6a6557af0000000000d96038",
      "text": "[Nrem.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785026481,
      "updated": 1785026484
    },
    {
      "id": "6a6557870000000000d96036",
      "text": "　[1.1.1.1 + WARP] と一般的なVPNとの違いの解説記事を読んでいる",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785026443,
      "updated": 1785028651
    },
    {
      "id": "6a6557cf0000000000d96039",
      "text": "　　https://qiita.com/sohsatoh/items/24a0b00e2206285d1092",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785026512,
      "updated": 1785026514
    },
    {
      "id": "6a6557fe0000000000d9603a",
      "text": "　　> そうです、ここでは本当のグローバルIPアドレスが表示されてしまっています。",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785026559,
      "updated": 1785026563
    },
    {
      "id": "6a6558020000000000d9603b",
      "text": "　　昔試した時これに遭遇したんですよね。",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785026564,
      "updated": 1785028656
    },
    {
      "id": "6a6552f900000000004bcd55",
      "text": "",
      "userId": "688c296691686a314f82fb52",
      "created": 1785025271,
      "updated": 1785025271
    },
    {
      "id": "6a65642200000000001da992",
      "text": "[takker.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1785029666,
      "updated": 1785029668
    },
    {
      "id": "6a65642300000000001da994",
      "text": " なんもやるきしない",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1785029668,
      "updated": 1785029670
    },
    {
      "id": "6a65642600000000001da995",
      "text": " からだをうごかしてうごけるようにしたいが、外は暑すぎるらしく外に出れない",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1785029670,
      "updated": 1785029687
    },
    {
      "id": "6a6567b6000000000023bbac",
      "text": " ドライバーセットほしいと相談したら、Amazonより[AliExpress]のほうが安くておすすめと言われた",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1785030582,
      "updated": 1785030601
    },
    {
      "id": "6a6567c9000000000023bbad",
      "text": " 　アカウントを作ってみる",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1785030601,
      "updated": 1785030603
    },
    {
      "id": "6a656dac0000000000d46d06",
      "text": "",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1785032109,
      "updated": 1785032109
    },
    {
      "id": "6a656dad0000000000d46d07",
      "text": "[zatsma.icon]",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1785032109,
      "updated": 1785032111
    },
    {
      "id": "6a656daf0000000000d46d08",
      "text": " リズム天国、ようやくステージ7へ",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1785032112,
      "updated": 1785032188
    },
    {
      "id": "6a656dfc0000000000d46d09",
      "text": "  らしくなってきた",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1785032189,
      "updated": 1785032194
    },
    {
      "id": "6a656f780000000000d46d0b",
      "text": "  ステージ6で一段落",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1785032569,
      "updated": 1785032580
    },
    {
      "id": "6a656e060000000000d46d0a",
      "text": " コロコロ行進とか一定のリズムキープが必要とされるゲームが苦手な事に気づく",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1785032199,
      "updated": 1785033104
    },
    {
      "id": "6a6574e500000000001360e9",
      "text": "",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1785033958,
      "updated": 1785033958
    },
    {
      "id": "6a6574e600000000001360ea",
      "text": "[terang.icon]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1785033958,
      "updated": 1785033959
    },
    {
      "id": "6a6574e700000000001360eb",
      "text": "\tよどよど。",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1785033959,
      "updated": 1785033962
    },
    {
      "id": "6a657fa000000000007a00d8",
      "text": "\tありゃー。1番よくつけてる腕時計の電池が切れた。",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1785036704,
      "updated": 1785036734
    },
    {
      "id": "6a6589e600000000006ce5fa",
      "text": "\t経験主義の二つのドグマ入ってんのかな、という心配はたまにある。",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1785039335,
      "updated": 1785039344
    },
    {
      "id": "6a658ede0000000000ad19c7",
      "text": "\tくどくどしく書かないことは相手への信頼を時に表す、という点には結構同意できる。",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1785040608,
      "updated": 1785040652
    },
    {
      "id": "6a65912a00000000008d833f",
      "text": "\t>[https://x.com/OKB1917/status/2080390258622185554 @OKB1917]: メールはなぜ返信しても増え続けるのか。18世紀までは未読メールは自然発生すると考えられていたが、後に顕微鏡が発明されたことで自然発生説は否定され、俺が悪いことが判明した。",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1785041195,
      "updated": 1785041195
    },
    {
      "id": "6a65912c00000000008d8340",
      "text": "\t\t笑",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1785041196,
      "updated": 1785041197
    },
    {
      "id": "6a65d6cf000000000060b02b",
      "text": "\t\t笑[taktamur.icon]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1785059022,
      "updated": 1785059029
    },
    {
      "id": "6a6592120000000000963d7c",
      "text": "\t今日はこれから非構成なエンカウンター的場のファシリテーター務めるよい",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1785041427,
      "updated": 1785041478
    },
    {
      "id": "6a65dccb00000000007e953a",
      "text": "\t\t終了。",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1785060556,
      "updated": 1785060558
    },
    {
      "id": "6a65dccd00000000007e953b",
      "text": "\t\tいい時間だった。",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1785060558,
      "updated": 1785060560
    },
    {
      "id": "6a65df230000000000ddf0ee",
      "text": "\t\tそして急にとてつもない眠気がきた。",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1785061156,
      "updated": 1785061166
    },
    {
      "id": "6a65642200000000001da993",
      "text": "",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1785029666,
      "updated": 1785029666
    },
    {
      "id": "6a6594d3000000000004e76e",
      "text": "[Hiro Aki.icon]",
      "userId": "65e1289acd012200235729c0",
      "created": 1785042132,
      "updated": 1785042134
    },
    {
      "id": "6a6594d4000000000004e76f",
      "text": "\t[モニターライト]買ってみた",
      "userId": "65e1289acd012200235729c0",
      "created": 1785042134,
      "updated": 1785042144
    },
    {
      "id": "6a6594df000000000004e770",
      "text": "\t\t良い、と思うが上手く言葉に出来ない",
      "userId": "65e1289acd012200235729c0",
      "created": 1785042144,
      "updated": 1785042159
    },
    {
      "id": "6a6594ed000000000004e772",
      "text": "\t\t画面の見やすさが、部屋の明るさと関係がなくなるというのは意外と良い、のかもしれない",
      "userId": "65e1289acd012200235729c0",
      "created": 1785042159,
      "updated": 1785042230
    },
    {
      "id": "6a659534000000000004e773",
      "text": "\t\t買ったのはこれ",
      "userId": "65e1289acd012200235729c0",
      "created": 1785042230,
      "updated": 1785042241
    },
    {
      "id": "6a659540000000000004e774",
      "text": "\t\t\thttps://www.mi.com/jp/product/mi-computer-monitor-light-bar/",
      "userId": "65e1289acd012200235729c0",
      "created": 1785042241,
      "updated": 1785042248
    },
    {
      "id": "6a6594d3000000000004e76d",
      "text": "",
      "userId": "65e1289acd012200235729c0",
      "created": 1785042132,
      "updated": 1785042132
    },
    {
      "id": "6a65c7930000000000d41ce0",
      "text": "[mtane0412.icon]",
      "userId": "5ae7fecf7766b7001455cbd3",
      "created": 1785055123,
      "updated": 1785055124
    },
    {
      "id": "6a65c7940000000000d41ce2",
      "text": " 今更ながら[OpenClaw]入れて[家と対話]できるようにした",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1785055124,
      "updated": 1785065888
    },
    {
      "id": "6a65c79f0000000000d41ce3",
      "text": "  [https://gyazo.com/8fe02d76aef00a325182d119e92fe666]",
      "userId": "5ae7fecf7766b7001455cbd3",
      "created": 1785055135,
      "updated": 1785055137
    },
    {
      "id": "6a65c7ba0000000000d41ce6",
      "text": "  隔離LXC上で動作させて一応n8n経由で色々情報見れるようにしてる",
      "userId": "5ae7fecf7766b7001455cbd3",
      "created": 1785055162,
      "updated": 1785055195
    },
    {
      "id": "6a65c7dc0000000000d41ce7",
      "text": "   n8n噛ませるのだるかったけど[n8n-cli]でClaude Codeが色々やってくれるので楽になった",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1785055197,
      "updated": 1785058895
    },
    {
      "id": "6a65d654000000000060b02a",
      "text": "   n8n-cli 面白そう[taktamur.icon]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1785058899,
      "updated": 1785058913
    },
    {
      "id": "6a65c7f50000000000d41ce9",
      "text": "  [+1.icon][bsahd.icon][taktamur.icon][sta.icon][Hiro Aki.icon]",
      "userId": "65e1289acd012200235729c0",
      "created": 1785055222,
      "updated": 1785059198
    },
    {
      "id": "6a65d0470000000000d41cea",
      "text": " 自宅にscansnap欲しくなってきた",
      "userId": "5ae7fecf7766b7001455cbd3",
      "created": 1785057351,
      "updated": 1785057357
    },
    {
      "id": "6a65d04d0000000000d41ceb",
      "text": "  水道ガスとかの検針・請求書を手入力でNocoDBに保存とかしているがいったんgoogle driveに飛ばして定期タスクで勝手に登録させるようにするとか",
      "userId": "5ae7fecf7766b7001455cbd3",
      "created": 1785057357,
      "updated": 1785057419
    },
    {
      "id": "6a65c7930000000000d41ce1",
      "text": "",
      "userId": "5ae7fecf7766b7001455cbd3",
      "created": 1785055123,
      "updated": 1785055123
    },
    {
      "id": "6a65c9c200000000008019b3",
      "text": "[HelloPeople.icon]",
      "userId": "5f938a902ea5180024085116",
      "created": 1785055682,
      "updated": 1785055684
    },
    {
      "id": "6a65c9c400000000008019b5",
      "text": " art work studioで照明を買った",
      "userId": "5f938a902ea5180024085116",
      "created": 1785055684,
      "updated": 1785055697
    },
    {
      "id": "6a65c9d100000000008019b6",
      "text": " 　6畳の部屋に6畳用の照明を買ったけどこれであってたんだろうか？",
      "userId": "5f938a902ea5180024085116",
      "created": 1785055697,
      "updated": 1785055712
    },
    {
      "id": "6a65c9ea00000000008019b7",
      "text": " 　　というのも、部屋に対して少し暗めの方がリラックスできるなんて情報もあったり",
      "userId": "5f938a902ea5180024085116",
      "created": 1785055722,
      "updated": 1785055737
    },
    {
      "id": "6a65c9f900000000008019b8",
      "text": " 　　　あえて賄いきれないようにすると抜け感ができるとか言われてたり",
      "userId": "5f938a902ea5180024085116",
      "created": 1785055738,
      "updated": 1785055749
    },
    {
      "id": "6a65ca0500000000008019b9",
      "text": " 　　まぁよくわからないので規格にあったものとして買った",
      "userId": "5f938a902ea5180024085116",
      "created": 1785055749,
      "updated": 1785055761
    },
    {
      "id": "6a65ca2000000000008019ba",
      "text": " ヘルシーコンフリクトという言葉を聞くと、衝突自体に健全さってなんだと思ってしまった",
      "userId": "5f938a902ea5180024085116",
      "created": 1785055776,
      "updated": 1785055806
    },
    {
      "id": "6a65ca3e00000000008019bb",
      "text": " 　いや実際健全な衝突ってあるんだろうけど、フライドポテトは野菜だからって言われてるような気分になる",
      "userId": "5f938a902ea5180024085116",
      "created": 1785055807,
      "updated": 1785055834
    },
    {
      "id": "6a662097000000000051bdaf",
      "text": "",
      "userId": "6303abe85eed77001d707837",
      "created": 1785077911,
      "updated": 1785077911
    },
    {
      "id": "6a662097000000000051bdb0",
      "text": "[nejimaki.icon]",
      "userId": "6303abe85eed77001d707837",
      "created": 1785077911,
      "updated": 1785077913
    },
    {
      "id": "6a66209a000000000051bdb1",
      "text": "\tフジロックのマッシヴ・アタック(配信)すごく良かった",
      "userId": "6303abe85eed77001d707837",
      "created": 1785077913,
      "updated": 1785077986
    },
    {
      "id": "6a6620a6000000000051bdb2",
      "text": "\t今日午前中に色々雑用終わらせたので夜まだまだいけます",
      "userId": "6303abe85eed77001d707837",
      "created": 1785077925,
      "updated": 1785077974
    },
