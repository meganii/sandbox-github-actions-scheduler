    {
      "id": "6a7653946eb406000000494797",
      "text": "第32週: 日月火水木金[[土]]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786139540,
      "updated": 1786139540
    },
    {
      "id": "6a7653946eb406000000df8375",
      "text": "2026年 60.27％経過",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786139540,
      "updated": 1786139540
    },
    {
      "id": "6a7759180000000000d34576",
      "text": "#2026-08-08",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786206489,
      "updated": 1786206494
    },
    {
      "id": "6a7653946eb406000000876b76",
      "text": "",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786139540,
      "updated": 1786139540
    },
    {
      "id": "6a7644ce00000000000f5bd2",
      "text": "[はるひ.icon]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786135763,
      "updated": 1786135763
    },
    {
      "id": "6a7644d000000000000f5bd4",
      "text": " kamuiの新譜めっちゃ良い クオリティだいぶ上がってないか",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786135763,
      "updated": 1786135836
    },
    {
      "id": "6a76451c00000000000f5bd7",
      "text": " リザレックα目に入って終わった",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786135836,
      "updated": 1786136779
    },
    {
      "id": "6a76450100000000000f5bd5",
      "text": " サイロ シーズン3の更新に気づいてなかった",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786135809,
      "updated": 1786151422
    },
    {
      "id": "6a76df1a0000000000c69065",
      "text": " ドメの安めのウィメンズブランドに手を出し始めている",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786175259,
      "updated": 1786175276
    },
    {
      "id": "6a76dd3e0000000000c6905b",
      "text": " [FETICO]知らんかったけど良い　柄のジーパンをゲット",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786174783,
      "updated": 1786175206
    },
    {
      "id": "6a76ddd90000000000c69060",
      "text": " \thttps://x.com/STUDIOUS_JP/status/2050361355224641592?s=20 ブラウンのハート🤎絵文字なんてあるのか",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786174937,
      "updated": 1786174958
    },
    {
      "id": "6a76dee60000000000c69062",
      "text": " [tanakadaisuke]のキラキラのついたLOVE Tシャツがおすすめ",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786175207,
      "updated": 1786175221
    },
    {
      "id": "6a76def80000000000c69064",
      "text": " \tTシャツはすぐによれてしまう　もう1枚ゲットしたい",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786175224,
      "updated": 1786175238
    },
    {
      "id": "6a76e1340000000000c6906d",
      "text": " 20分昼寝しよう",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786175797,
      "updated": 1786175799
    },
    {
      "id": "6a77352c0000000000ce894f",
      "text": " 6時間寝た",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786197293,
      "updated": 1786197299
    },
    {
      "id": "6a7681f500000000001dbc0b",
      "text": "",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1786151414,
      "updated": 1786151414
    },
    {
      "id": "6a7646f60000000000561115",
      "text": "[hiro.icon]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1786136382,
      "updated": 1786136385
    },
    {
      "id": "6a7646f90000000000561117",
      "text": " 今日も理想の朝",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1786136385,
      "updated": 1786136394
    },
    {
      "id": "6a76591c00000000002ea446",
      "text": "",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1786140956,
      "updated": 1786140956
    },
    {
      "id": "6a76591c00000000002ea447",
      "text": "[Rutile3.icon]",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1786140956,
      "updated": 1786140957
    },
    {
      "id": "6a76591d00000000002ea448",
      "text": "　朝食に[すき家]へ行ってきた。",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1786140958,
      "updated": 1786142578
    },
    {
      "id": "6a76593b00000000002ea44b",
      "text": "　　[牛まぜのっけ朝食]＋[冷やし汁]変更",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786140988,
      "updated": 1786161145
    },
    {
      "id": "6a765c9400000000002ea44f",
      "text": "　　冷やし汁変更は130円で、アプリクーポンを使って50円引き。",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1786141845,
      "updated": 1786142569
    },
    {
      "id": "6a765e6c00000000002ea462",
      "text": "　　　オクラ入りで美味しかったけど、朝はあったかい汁物の方がほっとできて好きかな～",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1786142316,
      "updated": 1786142594
    },
    {
      "id": "6a76592700000000002ea449",
      "text": "　PCで[アストラル☆パーティー]をプレイしている。",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1786140968,
      "updated": 1786142667
    },
    {
      "id": "6a76593900000000002ea44a",
      "text": "　　普段はスマホでプレイしているけど、やたらとアプリが落ちるので、クロスプラットフォームにも対応してるしってことでPCでプレイ中。",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1786140986,
      "updated": 1786142673
    },
    {
      "id": "6a7659bf00000000002ea44c",
      "text": "　　スマホとは操作感が違い過ぎて、誤操作で大戦犯ムーブをかましてしまった…",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1786141120,
      "updated": 1786142699
    },
    {
      "id": "6a7659f200000000002ea44d",
      "text": "　　　関西人特有の[イラチ]もあいまってか、雑にプレイしがち。",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786141170,
      "updated": 1786144526
    },
    {
      "id": "6a76fb8e00000000002ea463",
      "text": "　　デスクトップの[ショートカット]から開くとCNサーバー版が開く仕様で、理解するのに時間がかかった。",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1786182542,
      "updated": 1786182594
    },
    {
      "id": "6a76fbc400000000002ea464",
      "text": "　　　[/Rutile3/【アストラル☆パーティー Steam版】ショートカットから起動するとCNサーバー版が実行される]",
      "userId": "59ec1026a5ef5200121e5c54",
      "created": 1786182595,
      "updated": 1786182599
    },
    {
      "id": "6a7646f80000000000561116",
      "text": "",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1786136385,
      "updated": 1786136385
    },
    {
      "id": "6a765fcf00000000007950b2",
      "text": "[nyarla.icon]",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786142671,
      "updated": 1786142672
    },
    {
      "id": "6a765fd400000000007950b4",
      "text": " おはようございます",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786142676,
      "updated": 1786142684
    },
    {
      "id": "6a765fdc00000000007950b5",
      "text": " 先日滅んでしまった[投資信託]、気がついたら復興していた",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786142684,
      "updated": 1786176738
    },
    {
      "id": "6a765ffd00000000007950b6",
      "text": "  金の投信が伸びていて、このまま伸び続けたら[含み損]が解消しそう",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786142717,
      "updated": 1786176746
    },
    {
      "id": "6a76602000000000007950b7",
      "text": "  しかし含み損が解消するかな？のタイミングで叩き落とされること多数なので油断できない",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786142752,
      "updated": 1786142859
    },
    {
      "id": "6a76605400000000007950b8",
      "text": "  株系の投信は伸びたり縮んだりしている",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786142804,
      "updated": 1786142838
    },
    {
      "id": "6a766c790000000000d6e635",
      "text": " はてな社の株、そこそこ下がってるが、なんで皆買ってるのか",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786145913,
      "updated": 1786145962
    },
    {
      "id": "6a765fcf00000000007950b3",
      "text": "\t\t株下がってる→あの事件まだ尾を引いているのか……。[Summer498.icon]",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786142671,
      "updated": 1786145965
    },
    {
      "id": "6a766cb30000000000d6e637",
      "text": "\t\t それもあるけど、一回だけの特別配当の権利確定後に売られているって言うのもあるみたいです[nyarla.icon]",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786145971,
      "updated": 1786146044
    },
    {
      "id": "6a766d0f0000000000d6e638",
      "text": "\t\tそもそもはてな社の株自体、配当は今まで無かったし（記念配当などは除く）株価もそんなに高くない[nyarla.icon]",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786146063,
      "updated": 1786146135
    },
    {
      "id": "6a766d570000000000d6e639",
      "text": "\t\tボラティリティもそんなに高くないはずだし、安く買って高く売る、しか稼ぐ方法がない",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786146136,
      "updated": 1786147544
    },
    {
      "id": "6a766dd20000000000d6e63b",
      "text": "\t\t 純粋にはてなを応援したい、の意で持ってるって人は昔居た気がする",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786146258,
      "updated": 1786146308
    },
    {
      "id": "6a7672e40000000000d6e64c",
      "text": "\t\t  これだと買う理由は理解できる",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786147556,
      "updated": 1786147579
    },
    {
      "id": "6a766e040000000000d6e63c",
      "text": "\t\tはてな社は株投資でのうまみはほぼないのに、なぜ皆ここの株を買うんだろう",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786146308,
      "updated": 1786147857
    },
    {
      "id": "6a766f290000000000d6e641",
      "text": "\t\t Yahoo ファイナンスを見ると文句タラタラな様子が見て取れる",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786146601,
      "updated": 1786146633
    },
    {
      "id": "6a766f3c0000000000d6e642",
      "text": "\t\t しかし株投資の文脈だけで見た場合、はてな社に魅力は感じない",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786146620,
      "updated": 1786148001
    },
    {
      "id": "6a7670d00000000000d6e646",
      "text": "\t\t  個人投資家としてだと特にそう",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786147024,
      "updated": 1786148025
    },
    {
      "id": "6a7670de0000000000d6e647",
      "text": "\t\t   機関とかの大口についてはよく分からない",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786147038,
      "updated": 1786147058
    },
    {
      "id": "6a766f7d0000000000d6e643",
      "text": "\t\t  事業自体は堅調だけど、株価からみるとそんなに代わり映えしない",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786146685,
      "updated": 1786146721
    },
    {
      "id": "6a766fd60000000000d6e644",
      "text": "\t\t  はてなを比較的好意的に見てる自分でもはてなの株は買おうと思わない",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786146774,
      "updated": 1786146809
    },
    {
      "id": "6a766ffc0000000000d6e645",
      "text": "\t\t   理由は上記",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786146812,
      "updated": 1786148080
    },
    {
      "id": "6a766e3a0000000000d6e63d",
      "text": "\t\t はてな社の事業への魅力はともかく、株だけを見た場合、他を買った方が良いように思う",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786146362,
      "updated": 1786148091
    },
    {
      "id": "6a7671e00000000000d6e648",
      "text": "\t\t例の詐欺被害もそうだけど、はてな社は良くも悪くもIT系中小企業だと思っている",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786147296,
      "updated": 1786148113
    },
    {
      "id": "6a7672370000000000d6e64a",
      "text": "\t\t なんで緩いところは緩いのだろうし、そこが今回の詐欺被害という事故へ繋がった部分もあるとも感じる",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786147383,
      "updated": 1786148136
    },
    {
      "id": "6a76726f0000000000d6e64b",
      "text": "\t\tはてなに在籍している知人たちには悪いのだけど、個別株と言う視点から見ると、私の評価は上記になる",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786147439,
      "updated": 1786147903
    },
    {
      "id": "6a76763f00000000009f35fd",
      "text": "\tLLM Wiki の AGENTS.md 、 Claude Opus 5 に下書きさせて Fable に仕上げをさせたらいい感じになった",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786148415,
      "updated": 1786148547
    },
    {
      "id": "6a7676b100000000009f35fe",
      "text": "\t Gemma 4 E2B でも理解できるように、と注文をつけたらそのようにしてくれた",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1786148529,
      "updated": 1786148629
    },
    {
      "id": "6a766c8c0000000000d320a6",
      "text": "",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786145932,
      "updated": 1786145932
    },
    {
      "id": "6a7666a50000000000d3209a",
      "text": "[Summer498.icon]",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786144422,
      "updated": 1786144423
    },
    {
      "id": "6a7666a60000000000d3209c",
      "text": "\tグロース株が安上がりでとても嬉しい",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786144423,
      "updated": 1786144439
    },
    {
      "id": "6a766b760000000000d320a4",
      "text": "\t\t分散握力投資をしたいと思っていたのだが、単位株価格が高すぎるのがボトルネックで困っていた",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786145655,
      "updated": 1786145706
    },
    {
      "id": "6a766cd70000000000d320a7",
      "text": "\t\t",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786146012,
      "updated": 1786146012
    },
    {
      "id": "6a7666e40000000000d3209d",
      "text": "\t指標をグラフにプロットして良い感じの株をまとめてピックアップしたい",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786144485,
      "updated": 1786144515
    },
    {
      "id": "6a76672d0000000000d3209e",
      "text": "\tリザレック",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786144558,
      "updated": 1786144569
    },
    {
      "id": "6a7667390000000000d3209f",
      "text": "\t\tリザレックス",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786144569,
      "updated": 1786144573
    },
    {
      "id": "6a76673c0000000000d320a0",
      "text": "\t\t[リザードン]と[ティガレックス]",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786144573,
      "updated": 1786158714
    },
    {
      "id": "6a766ad80000000000d320a1",
      "text": "\t[https://gyazo.com/fd37bb3ab119661fefb202b3eeb9ad36]",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786145497,
      "updated": 1786145504
    },
    {
      "id": "6a769eae0000000000d320a8",
      "text": "\t\tpowered by GPT",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786158767,
      "updated": 1786158775
    },
    {
      "id": "6a766af50000000000d320a3",
      "text": "\t[VSダークライ]始まりそうだな",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786145525,
      "updated": 1786206304
    },
    {
      "id": "6a766adf0000000000d320a2",
      "text": "\t[学習に適した感情]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786145504,
      "updated": 1786206714
    },
    {
      "id": "6a7669f900000000003c8fb6",
      "text": "",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786145273,
      "updated": 1786145273
    },
    {
      "id": "6a7669f900000000003c8fb7",
      "text": "[terang.icon]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786145273,
      "updated": 1786145274
    },
    {
      "id": "6a7669fa00000000003c8fb8",
      "text": "\t出したゴミがカラスにやられたようで朝からバタバタ",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786145274,
      "updated": 1786145284
    },
    {
      "id": "6a766a1400000000003c8fb9",
      "text": "\t\t再発防止にあたってどういう対策が有効なのだろう？",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786145301,
      "updated": 1786145313
    },
    {
      "id": "6a767d2e0000000000b1f89d",
      "text": "\t\t[鳥獣保護管理法]で保護されてるのが解せない、害獣として駆除できないのかなぁとよく考える[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786150191,
      "updated": 1786150212
    },
    {
      "id": "6a7708d200000000000a30f4",
      "text": "\t👀[AIの主力モデル変遷]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786185938,
      "updated": 1786189139
    },
    {
      "id": "6a7708e600000000000a30f5",
      "text": "\t\t>[https://x.com/itoyo_monk/status/2085895121653092617 @itoyo_monk]: 世界史の年表的な雰囲気でAIの主力モデルの変遷を可視化（4oの治世長いね）",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786185958,
      "updated": 1786185965
    },
    {
      "id": "6a7708ed00000000000a30f6",
      "text": "  >[https://gyazo.com/45fae0c3dd57a92b6416cae6450ac833]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786185965,
      "updated": 1786185965
    },
    {
      "id": "6a771cc00000000000ff56ac",
      "text": "  面白い[Hiro Aki.icon]",
      "userId": "65e1289acd012200235729c0",
      "created": 1786191041,
      "updated": 1786191046
    },
    {
      "id": "6a773f8e00000000007761c6",
      "text": " 周囲で、その人にとって人生で初めて自分でボドゲ作り始めた人が少なくとも3人。",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786199951,
      "updated": 1786199969
    },
    {
      "id": "6a773fa100000000007761c7",
      "text": " \t3人同士はお互いに知らないので、今度集まってお互いのゲームをお互いにテストプレイする会でもやろうかなと目論んでいる",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1786199974,
      "updated": 1786200004
    },
    {
      "id": "6a7671a000000000004cdc48",
      "text": "",
      "userId": "649a24da357c4d001c518c25",
      "created": 1786147232,
      "updated": 1786147232
    },
    {
      "id": "6a7671a000000000004cdc49",
      "text": "[meganii.icon]",
      "userId": "649a24da357c4d001c518c25",
      "created": 1786147232,
      "updated": 1786147234
    },
    {
      "id": "6a7671a100000000004cdc4a",
      "text": "\tふたたび[フォルダ管理]に悩んでいる",
      "userId": "649a24da357c4d001c518c25",
      "created": 1786147234,
      "updated": 1786147249
    },
    {
      "id": "6a76f7190000000000cd48c3",
      "text": "\t ご迷惑でなければ、もう少し詳しくお話を聞かせていただけますか？ [suto3.icon]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1786181401,
      "updated": 1786181479
    },
    {
      "id": "6a7720a400000000005f50b8",
      "text": "\t チームで利用する[共有フォルダ]（Boxのフォルダ構成）と、個人利用のための[文書管理]について思いを馳せています[meganii.icon]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1786192036,
      "updated": 1786210473
    },
    {
      "id": "6a7666a50000000000d3209b",
      "text": " [JIS]（[日本産業規格]）ってWebで見れたんだ、知らなかった",
      "userId": "649a24da357c4d001c518c25",
      "created": 1786144422,
      "updated": 1786192291
    },
    {
      "id": "6a7720fc00000000005f50b9",
      "text": "",
      "userId": "649a24da357c4d001c518c25",
      "created": 1786192125,
      "updated": 1786192125
    },
    {
      "id": "6a767cea0000000000b1f89a",
      "text": "[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786150124,
      "updated": 1786150124
    },
    {
      "id": "6a767ceb0000000000b1f89b",
      "text": "\tランニングマンおじさん",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786150124,
      "updated": 1786150128
    },
    {
      "id": "6a767cee0000000000b1f89c",
      "text": "\t\t[ランニングマン練習 #shuffledance #シャッフルダンス - YouTube https://www.youtube.com/shorts/NXg_413Te6c]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786150128,
      "updated": 1786150128
    },
    {
      "id": "6a767cea0000000000b1f899",
      "text": "\tVTuber卒業したと思っていたが、[御子神琴音]にハマリそうかもしれない",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786150123,
      "updated": 1786174190
    },
    {
      "id": "6a76dc1000000000008d1253",
      "text": "\t本当は空き時間のすべてを執筆に充てたいが、頭が尽きたら何もできない",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786174483,
      "updated": 1786174495
    },
    {
      "id": "6a76dc1d00000000008d1254",
      "text": "\t\t再読したマンガ、慣れたゲーム、youtubeくらいしか選択肢がない",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786174495,
      "updated": 1786174506
    },
    {
      "id": "6a76dc3400000000008d1255",
      "text": "\t\t子供ペットパートナーがいたらそれらで色々満たせるんだろうな\t",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786174519,
      "updated": 1786174534
    },
    {
      "id": "6a76dc4400000000008d1256",
      "text": "\t\t\tとおもうと、やっぱりこれに投資する価値は高そうなんだなぁと今さら気づく",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786174534,
      "updated": 1786174544
    },
    {
      "id": "6a76dc4e00000000008d1257",
      "text": "\t\t\t今さら厳しいが",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786174544,
      "updated": 1786174547
    },
    {
      "id": "6a76dc5c00000000008d1258",
      "text": "\t\t犬や猫を手軽に摂取できるサービスがあるといいのか？",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786174558,
      "updated": 1786174804
    },
    {
      "id": "6a76dc6600000000008d1259",
      "text": "\t\t\t猫カフェとかは他人や店員がいて恥ずかしいので嫌だ",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786174569,
      "updated": 1786174578
    },
    {
      "id": "6a76dc7400000000008d125a",
      "text": "\t\t\t一人飯の要領で[一人猫カフェ]？みたいなのがあったら流行ると思うし、俺も行くぜ",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786174583,
      "updated": 1786175342
    },
    {
      "id": "6a76e13a00000000008d125e",
      "text": "\t\t本当はホルモン単位で特定して「このホルモンをこれだけ出せばいい」を導いてそのための最小限の行動で済ませたいが、結局頓挫する",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786175804,
      "updated": 1786175808
    },
    {
      "id": "6a76dd7f00000000008d125c",
      "text": "\t\t\tドーパミン、セロトニン、オキシトシン、",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786174849,
      "updated": 1786174855
    },
    {
      "id": "6a76dd9400000000008d125d",
      "text": "\t\t\tちな抱き枕は試したことあるけど何も効果ない。なんとなくだけど[生き物と相対したときに生じる緊張]？が欠かせない気がする",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786174870,
      "updated": 1786175976
    },
    {
      "id": "6a76dadf0000000000850365",
      "text": "",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1786174177,
      "updated": 1786174177
    },
    {
      "id": "6a7682e500000000007c7758",
      "text": "[hoagecko.icon]",
      "userId": "688c296691686a314f82fb52",
      "created": 1786151653,
      "updated": 1786151655
    },
    {
      "id": "6a7682e800000000007c775a",
      "text": "　[リングフィットアドベンチャー]の[RTA]、マッチョなYoutuberの独占になってて笑った",
      "userId": "688c296691686a314f82fb52",
      "created": 1786151656,
      "updated": 1786151906
    },
    {
      "id": "6a76832900000000007c775b",
      "text": "　普段のRTAで猛威を奮っている連中が寄り付いてない",
      "userId": "688c296691686a314f82fb52",
      "created": 1786151721,
      "updated": 1786151800
    },
    {
      "id": "6a7683e400000000007c7761",
      "text": "　\tまあ全身の筋肉が要求されるのはそうないからね",
      "userId": "688c296691686a314f82fb52",
      "created": 1786151909,
      "updated": 1786151926
    },
    {
      "id": "6a76837800000000007c775e",
      "text": "　見どころは警告とスピード",
      "userId": "688c296691686a314f82fb52",
      "created": 1786151800,
      "updated": 1786151932
    },
    {
      "id": "6a7683fc00000000007c7762",
      "text": "　\t最高負荷なのにあれだけ早いのはすごい",
      "userId": "688c296691686a314f82fb52",
      "created": 1786151932,
      "updated": 1786151943
    },
    {
      "id": "6a76834500000000007c775d",
      "text": "　\t警告表示が一定頻度で出る仕様 (当たり前か) で、最後の方は度々出てくる",
      "userId": "688c296691686a314f82fb52",
      "created": 1786151750,
      "updated": 1786151947
    },
    {
      "id": "6a76837c00000000007c775f",
      "text": "　\t\tそりゃそうかとはなったけどあまり普通に遊んでいて見れるもんじゃないから興味深かった",
      "userId": "688c296691686a314f82fb52",
      "created": 1786151804,
      "updated": 1786151955
    },
    {
      "id": "6a773f7c000000000078f815",
      "text": "　[https://hoagecko.hatenablog.com/entry/ryukichi-sawada-dtm 大正時代のDTM - 澤田柳吉の調和楽とピアノロール - hoageckoのブログ]",
      "userId": "688c296691686a314f82fb52",
      "created": 1786199933,
      "updated": 1786199934
    },
    {
      "id": "6a773f7e000000000078f816",
      "text": "　\tギリギリ毎日投稿に成功した",
      "userId": "688c296691686a314f82fb52",
      "created": 1786199934,
      "updated": 1786199940
    },
    {
      "id": "6a773f85000000000078f817",
      "text": "　\tやったぜ",
      "userId": "688c296691686a314f82fb52",
      "created": 1786199942,
      "updated": 1786199943
    },
    {
      "id": "6a773f9a000000000078f819",
      "text": "　\t澤田柳吉の業績 (目立つものだけ)",
      "userId": "688c296691686a314f82fb52",
      "created": 1786199963,
      "updated": 1786200242
    },
    {
      "id": "6a773fc9000000000078f81d",
      "text": "　\t\t日本初の[ショパン]弾き",
      "userId": "688c296691686a314f82fb52",
      "created": 1786200010,
      "updated": 1786200022
    },
    {
      "id": "6a773fda000000000078f81e",
      "text": "　\t\t草創期のラジオに関わる",
      "userId": "688c296691686a314f82fb52",
      "created": 1786200026,
      "updated": 1786200047
    },
    {
      "id": "6a773fef000000000078f81f",
      "text": "　\t\t国産[ピアノロール]の出版",
      "userId": "688c296691686a314f82fb52",
      "created": 1786200047,
      "updated": 1786200056
    },
    {
      "id": "6a773ffa000000000078f820",
      "text": "　\t\t日本最初の[パントマイム]の創作",
      "userId": "688c296691686a314f82fb52",
      "created": 1786200058,
      "updated": 1786200214
    },
    {
      "id": "6a773fa3000000000078f81a",
      "text": "　\t\tクラシック畑なのに[浅草オペラ]という大衆娯楽へ出演",
      "userId": "688c296691686a314f82fb52",
      "created": 1786199972,
      "updated": 1786200031
    },
    {
      "id": "6a773fbb000000000078f81b",
      "text": "　\t\t[ラグタイム]・[タンゴ]の最初期の演奏",
      "userId": "688c296691686a314f82fb52",
      "created": 1786199995,
      "updated": 1786200249
    },
    {
      "id": "6a773f8b000000000078f818",
      "text": "\t　\t日本初の[ピアノリサイタル]を開く",
      "userId": "688c296691686a314f82fb52",
      "created": 1786199947,
      "updated": 1786200252
    },
    {
      "id": "6a7682e500000000007c7759",
      "text": "",
      "userId": "688c296691686a314f82fb52",
      "created": 1786151653,
      "updated": 1786151653
    },
    {
      "id": "6a768f9d00000000001cd2d9",
      "text": "[inajob.icon]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786154910,
      "updated": 1786154911
    },
    {
      "id": "6a768f9e00000000001cd2db",
      "text": "\t[/fab-wiki/20260802週fabnews]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786154911,
      "updated": 1786154912
    },
    {
      "id": "6a768f9f00000000001cd2dc",
      "text": "\t\t今週は豊作かな",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786154912,
      "updated": 1786154917
    },
    {
      "id": "6a768f9d00000000001cd2da",
      "text": "",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786154910,
      "updated": 1786154910
    },
    {
      "id": "6a7690150000000000cf344f",
      "text": "[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786155030,
      "updated": 1786155032
    },
    {
      "id": "6a7690180000000000cf3450",
      "text": " メイクブラシを洗うのが面倒過ぎるので[超音波洗浄機]を買った",
      "userId": "65e1289acd012200235729c0",
      "created": 1786155033,
      "updated": 1786165552
    },
    {
      "id": "6a76902b0000000000cf3451",
      "text": "  結構きれいになる",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786155051,
      "updated": 1786155069
    },
    {
      "id": "6a76905c0000000000cf3452",
      "text": "  自分は安物の[メイクブラシ]を使っているが、超音波洗浄器はブラシの接着部分を弱めるようなので数万するような高いブラシを使っている人はいれないほうがよさそう",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786155101,
      "updated": 1786173780
    },
    {
      "id": "6a7690a50000000000cf3453",
      "text": "  眼鏡やアクセサリ類もぴかぴかになり満足",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786155174,
      "updated": 1786155194
    },
    {
      "id": "6a76992100000000006ce273",
      "text": " [言語モデルの物理学]を再読せねばと思う場面が増えている",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786157346,
      "updated": 1786157358
    },
    {
      "id": "6a769c94000000000003d67b",
      "text": " 私はちいかわのうさぎに似ているとの友人評",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1786158229,
      "updated": 1786158242
    },
    {
      "id": "6a76a96a0000000000ac82d6",
      "text": "",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786161514,
      "updated": 1786161514
    },
    {
      "id": "6a76a96a0000000000ac82d7",
      "text": "[taktamur.icon]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786161514,
      "updated": 1786161516
    },
    {
      "id": "6a76a96c0000000000ac82d8",
      "text": " 今日は二度寝を繰り返し10時までぐだぐだしてた",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786161516,
      "updated": 1786161545
    },
    {
      "id": "6a76ac890000000000f3b84d",
      "text": " \t[二度寝サイコー]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786162314,
      "updated": 1786162318
    },
    {
      "id": "6a76a9880000000000ac82d9",
      "text": " 自転車で出かけた",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786161545,
      "updated": 1786161564
    },
    {
      "id": "6a76a99c0000000000ac82da",
      "text": " \t外食で昼ごはん食べて",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786161564,
      "updated": 1786161564
    },
    {
      "id": "6a76a99e0000000000ac82db",
      "text": " \t多摩川沿いちょっと流して",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786161566,
      "updated": 1786161576
    },
    {
      "id": "6a76a9b70000000000ac82de",
      "text": " \t\t自転車は空冷式+川沿いの風はちょっと涼しい+今日は風も強め だったので心地よかった",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786161591,
      "updated": 1786161625
    },
    {
      "id": "6a76a9a70000000000ac82dc",
      "text": " \t帰って冷水でシャワー",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786161576,
      "updated": 1786161583
    },
    {
      "id": "6a76a9af0000000000ac82dd",
      "text": " \t\t気持ちいい！",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786161583,
      "updated": 1786161589
    },
    {
      "id": "6a76a9dc0000000000ac82df",
      "text": " 写真をペタペタ",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786161629,
      "updated": 1786161681
    },
    {
      "id": "6a76aa110000000000f3b845",
      "text": " \t[https://gyazo.com/cce806f95a819320954729b9253f80b8]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786161681,
      "updated": 1786162014
    },
    {
      "id": "6a76aac90000000000f3b846",
      "text": "\t \t[ジオゲッサー河川敷2026-07]の近く",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786161865,
      "updated": 1786162036
    },
    {
      "id": "6a76ab750000000000f3b848",
      "text": "\t \t日本語の「青」には緑も含まれるのだけど、[夏の色味]を「青」って名付けたんかなぁと妄想",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786162037,
      "updated": 1786173931
    },
    {
      "id": "6a76ab920000000000f3b849",
      "text": "\t [https://gyazo.com/0417d05152cf5ddf9db5e9a9d5f32a28]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786162067,
      "updated": 1786162097
    },
    {
      "id": "6a76abf80000000000f3b84b",
      "text": "\t \tこっちは [2026/06/21#6a375daa000000000067fcbe] と同じ場所",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786162169,
      "updated": 1786162176
    },
    {
      "id": "6a76d2c1000000000041fb38",
      "text": "\t\t自然が力強く生き生きとしている時に見られる色が「青」って感じする[Summer498.icon]",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1786172097,
      "updated": 1786172127
    },
    {
      "id": "6a76ac460000000000f3b84c",
      "text": "\t溜まっる洗濯物を[洗濯機.icon]で[- [洗濯機.icon]]すぜ",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786162247,
      "updated": 1786162261
    },
    {
      "id": "6a76ad890000000000f3b84e",
      "text": "\tさてちょっと昼寝するか。",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786162570,
      "updated": 1786162578
    },
    {
      "id": "6a76abb10000000000f3b84a",
      "text": "",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1786162097,
      "updated": 1786162097
    },
    {
      "id": "6a76afb40000000000ebe30a",
      "text": "[Hyou.icon]",
      "userId": "657c19a3646988002500645a",
      "created": 1786163125,
      "updated": 1786163125
    },
    {
      "id": "6a76afb40000000000ebe30b",
      "text": "\t夢って脳内で現実を創り上げてるんだなと考えた時、急に怖くなりました",
      "userId": "657c19a3646988002500645a",
      "created": 1786163125,
      "updated": 1786163154
    },
    {
      "id": "6a7759550000000000d34577",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786206549,
      "updated": 1786206549
    },
    {
      "id": "6a76c1560000000000877ebc",
      "text": "[Nrem.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786167638,
      "updated": 1786206548
    },
    {
      "id": "6a76c1590000000000877ebe",
      "text": "　内部リンクの候補が出てこない",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786167641,
      "updated": 1786167656
    },
    {
      "id": "6a76c2080000000000fc0f8d",
      "text": "　　UserCSSを切ったら直った",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786167817,
      "updated": 1786167828
    },
    {
      "id": "6a76f2ce00000000007a6961",
      "text": "　[- 打ち消し線の引かれたテキストが薄くなるようにしてみました]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786180303,
      "updated": 1786180333
    },
    {
      "id": "6a76fadd0000000000651097",
      "text": "　いつかのKindleセールで買った[『地球(テラ)へ…』]全3巻を読了",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786182366,
      "updated": 1786182549
    },
    {
      "id": "6a7706fa0000000000d0b64b",
      "text": "　　エピローグまでの間の後日談が見たかった",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786185467,
      "updated": 1786185516
    },
    {
      "id": "6a7705530000000000d0b648",
      "text": "　世界一赤い校長先生のお話の解説動画を観ている",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786185044,
      "updated": 1786185191
    },
    {
      "id": "6a76fb980000000000651098",
      "text": "　　[https://youtu.be/7WLxueCA4ws]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786182553,
      "updated": 1786185046
    },
    {
      "id": "6a7704e70000000000d0b647",
      "text": "　　最初のアナウンスのところだけやないかい",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786184936,
      "updated": 1786188446
    },
    {
      "id": "6a76c81000000000001b6cd7",
      "text": "",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1786169361,
      "updated": 1786169361
    },
    {
      "id": "6a76c81000000000001b6cd8",
      "text": "[hoshihara.icon]",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1786169361,
      "updated": 1786169363
    },
    {
      "id": "6a76c81300000000001b6cd9",
      "text": " ぷよぷよ9連鎖できた",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1786169363,
      "updated": 1786169376
    },
    {
      "id": "6a76e81d0000000000b7820b",
      "text": "",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786177565,
      "updated": 1786177565
    },
    {
      "id": "6a76e81e0000000000b7820c",
      "text": "[joniel.icon]",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786177565,
      "updated": 1786177572
    },
    {
      "id": "6a76e8260000000000b7820e",
      "text": " 月一の用事で都会に出てきた、気温か[お盆]かだいぶ人が少なかった",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786177572,
      "updated": 1786212945
    },
    {
      "id": "6a76e81e0000000000b7820d",
      "text": "　AIにおいて作品を部品化して活用する方向に進んでたけど、作品を作品のまま飲み込む方がよさそうと思ってきた",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786177565,
      "updated": 1786177692
    },
    {
      "id": "6a76e8930000000000b78210",
      "text": "　　サプリ化するより食材のままの方が栄養価が高いし相乗効果みたいなのがあるみたいな",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786177682,
      "updated": 1786177718
    },
    {
      "id": "6a76e8640000000000b7820f",
      "text": " お米を何合入れたか忘れた状態で水を入れ始めてしまい、3合に賭けた",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786177635,
      "updated": 1786191627
    },
    {
      "id": "6a771eee000000000073d743",
      "text": "　　炊飯器から[おかゆの香り]がし始めている",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786191598,
      "updated": 1786196633
    },
    {
      "id": "6a771f0c000000000073d744",
      "text": "   おかゆができました。水の量で香りが変わるの不思議だな",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786191628,
      "updated": 1786194556
    },
    {
      "id": "6a772a6b000000000073d745",
      "text": " 久しぶりに都会に出たが、お盆なのか気候なのか人が少なかった",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786194540,
      "updated": 1786200405
    },
    {
      "id": "6a774154000000000073d748",
      "text": " 　歩いてるだけで最大HPごと削られるような感覚、病み上がりには厳しい",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786200405,
      "updated": 1786200418
    },
    {
      "id": "6a774162000000000073d749",
      "text": " 　[会社の環境が快適]なので休日の過ごし方に悩む。多分自宅は日中ずっと蒸されてる",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786200419,
      "updated": 1786200661
    },
    {
      "id": "6a774256000000000073d74a",
      "text": " 　　エアコンは効いてるし空気も冷えてはいるのに涼しくない。おそらく壁がかなり熱い",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786200661,
      "updated": 1786200708
    },
    {
      "id": "6a7740cf000000000073d746",
      "text": "　　　いろいろあって在宅が多かったけど昼過ぎから日が落ちるまで自宅でほぼ活動できてない",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786200271,
      "updated": 1786200734
    },
    {
      "id": "6a7740cf000000000073d747",
      "text": "　　明日は午前から美術館でも行きますか...移動中の体力消費が厳しそうで在宅とどっちがましなのか",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786200271,
      "updated": 1786200760
    },
    {
      "id": "6a774286000000000073d74b",
      "text": "",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1786200710,
      "updated": 1786200710
    },
    {
      "id": "6a76f7f90000000000c335eb",
      "text": "[inajob.icon]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786181626,
      "updated": 1786181627
    },
    {
      "id": "6a76f7fb0000000000c335ed",
      "text": " [カタカナマスター]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786181628,
      "updated": 1786189398
    },
    {
      "id": "6a76f8000000000000c335ee",
      "text": "  [カタカナ・ひらがな えらびクイズ https://inajob.github.io/katakana-master/]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1786181633,
      "updated": 1786189391
    },
    {
      "id": "6a76f8020000000000c335ef",
      "text": "  > 子供向けの[カタカナ]学習のWebアプリを考える。 あるカタカナが1文字表示され、それがひらがなのどれかを3択で選ぶようなものが良い。文字が大きく表示されスマートフォンからでも遊べることが望ましい",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786181635,
      "updated": 1786206369
    },
    {
      "id": "6a76f8120000000000c335f0",
      "text": "   これだけのプロンプトでこれが出てくる時代よ",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786181651,
      "updated": 1786181668
    },
    {
      "id": "6a76f8260000000000c335f1",
      "text": "   Geminiのアプリです",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786181671,
      "updated": 1786181679
    },
    {
      "id": "6a771c7b00000000003fad11",
      "text": "  [6歳]の娘には不評だった",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786190972,
      "updated": 1786206385
    },
    {
      "id": "6a771c8400000000003fad12",
      "text": "  \tもう少しゲームっぽくしたいところ",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786190981,
      "updated": 1786190986
    },
    {
      "id": "6a76f7f90000000000c335ec",
      "text": "",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1786181626,
      "updated": 1786181626
    },
