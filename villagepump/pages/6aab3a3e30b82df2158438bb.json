      "created": 1789606498,
      "updated": 1789607089
    },
    {
      "id": "6aab3a6700000000006bcfa8",
      "text": "\t[ナルメア]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789606504,
      "updated": 1789606526
    },
    {
      "id": "6aab3a8000000000006bcfa9",
      "text": "\t\t[グランブルーファンタジー]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789606529,
      "updated": 1789606538
    },
    {
      "id": "6aab3a9400000000006bcfab",
      "text": "\t[ペコリーヌ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789606549,
      "updated": 1789606558
    },
    {
      "id": "6aab3a9700000000006bcfac",
      "text": "\t\t[プリンセスコネクト！Re:Dive]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789606552,
      "updated": 1789606559
    },
    {
      "id": "6aab3a4400000000006bcfa5",
