    },
    {
      "id": "6b05fb021280f0000000861a3b",
      "text": "第48週: 日月火[[水]]木金土",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795554051,
      "updated": 1795554051
    },
    {
      "id": "6b05fb021280f000000009da6b",
      "text": "2026年 90.14％経過",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795554051,
      "updated": 1795554051
    },
    {
      "id": "6b05fb021280f00000003e35a9",
