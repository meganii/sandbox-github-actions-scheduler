      "created": 1791712188,
      "updated": 1791712188
    },
    {
      "id": "6acb569400000000007cdf28",
      "text": "[ギィ・クリムゾン]",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf29",
      "text": "\t原初の赤（ルージュ）",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf2a",
      "text": "\tCV：[石田彰]",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb57b500000000007cdf42",
      "text": "\t[八星魔王]の一人",
      "userId": "660605441655f300254ac7c2",
      "created": 1791711158,
      "updated": 1791711192
    },
    {
      "id": "6acb569400000000007cdf2b",
      "text": "[テスタロッサ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf2c",
      "text": "\t原初の白（ブラン）",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf2d",
      "text": "\tCV：[内山夕実]",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf2e",
      "text": "[ディアブロ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf2f",
      "text": "\t原初の黒（ノワール）",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf30",
      "text": "\tCV：[櫻井孝宏]",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf31",
      "text": "[ミザリー]",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf32",
      "text": "\t原初の緑（ヴェール）",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf33",
      "text": "\tCV：[広瀬ゆうき]",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf34",
      "text": "[カレラ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf35",
      "text": "\t原初の黄（ジョーヌ）",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf36",
      "text": "\tCV：[長谷川育美]",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf37",
      "text": "[ウルティマ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf38",
      "text": "\t原初の紫（ヴィオレ）",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf39",
      "text": "\tCV：[富田美優]",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf3a",
      "text": "[レイン]",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf3b",
      "text": " 原初の青（ブルー）",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf3c",
      "text": "\tCV：[幸村恵理]",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb569400000000007cdf3d",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710868,
      "updated": 1791710868
    },
    {
      "id": "6acb56b600000000007cdf40",
      "text": "[リムル]の家臣、ディアブロ、テスタロッサ、カレラ、ウルティマの名前は[スーパーカー]が由来",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710903,
      "updated": 1791711114
    },
    {
      "id": "6acb56b600000000007cdf41",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1791710903,
      "updated": 1791710903
    },
    {
      "id": "6acb569400000000007cdf3e",
