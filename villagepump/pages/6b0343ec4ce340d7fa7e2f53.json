  "lines": [
    {
      "id": "6b0343ec4ce340d7fa7e2f53",
      "text": "ささやかな工夫",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795376110,
      "updated": 1795376110
    },
    {
      "id": "6b0343ee0000000000dc0ee4",
      "text": "さりげなくも効果的なアイデア",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795376110,
      "updated": 1795376111
    },
    {
      "id": "6b0343ef0000000000dc0ee5",
      "text": "　小さな工夫",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795376111,
      "updated": 1795376158
    },
    {
      "id": "6b03440a0000000000dc0ee6",
      "text": " [思いやり]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795376139,
      "updated": 1795376139
    },
    {
      "id": "6b03440a0000000000dc0ee7",
      "text": " ちょっとしたアイデア",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795376139,
      "updated": 1795376139
    },
    {
      "id": "6b03440a0000000000dc0ee8",
      "text": "\tちょっとした配慮",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795376139,
      "updated": 1795376151
    },
    {
      "id": "6b03440a0000000000dc0ee9",
      "text": " [工夫は共有されるべき]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795376139,
      "updated": 1795376190
    },
    {
      "id": "6b03443e0000000000dc0eea",
      "text": " [暗記はつらいが工夫は楽しい]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795376190,
      "updated": 1795376190
    },
    {
      "id": "6b03443e0000000000dc0eeb",
      "text": " [暗黙知の共有]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1795376190,
      "updated": 1795376190
    }
  ]
}