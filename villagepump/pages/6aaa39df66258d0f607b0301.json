    {
      "id": "6aaa39df66258d0f607b0301",
      "text": "ポケモン30周年",
      "userId": "660605441655f300254ac7c2",
      "created": 1789540833,
      "updated": 1789540833
    },
    {
      "id": "6aaa39e10000000000e78f3c",
      "text": "[https://youtu.be/X618m65s3Gg?si=1rpmaf0b1tZO1E_H]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789540833,
      "updated": 1789540833
    },
    {
      "id": "6aaa39e10000000000e78f3d",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1789540833,
      "updated": 1789540833
    },
    {
      "id": "6aaa39e10000000000e78f3e",
      "text": "1996年2月27日に[ポケモン]最初のゲームソフト『[ポケットモンスター 赤・緑]』発売された[ポケットモンスターシリーズ]が[2026/02/27]に30周年を迎える",
      "userId": "660605441655f300254ac7c2",
      "created": 1789540833,
      "updated": 1789540833
    },
    {
      "id": "6aaa39e10000000000e78f3f",
      "text": "\t[ポケットモンスター ファイアレッド・リーフグリーン]が発売",
      "userId": "660605441655f300254ac7c2",
      "created": 1789540833,
      "updated": 1789540833
    },
    {
      "id": "6aaa39e10000000000e78f40",
      "text": "\t\t[GBA]で発売された本作を[Nintendo Switch]に移植",
      "userId": "660605441655f300254ac7c2",
      "created": 1789540833,
      "updated": 1789540833
    },
    {
      "id": "6aaa39e10000000000e78f41",
      "text": "\t\t[Pokémon Presents 2026.2.27]の放送後に発売開始",
      "userId": "660605441655f300254ac7c2",
      "created": 1789540833,
      "updated": 1789540833
    },
    {
      "id": "6aaa39e10000000000e78f42",
      "text": "\t[新宿ウォール456]で広告掲載されていた",
      "userId": "660605441655f300254ac7c2",
      "created": 1789540833,
      "updated": 1789540833
    },
    {
      "id": "6aaa39e10000000000e78f43",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1789540833,
      "updated": 1789540833
    },
    {
      "id": "6aaa39e10000000000e78f44",
      "text": "2月27日は「[Pokémon Day]」として、[日本記念日協会]に認定されている",
      "userId": "660605441655f300254ac7c2",
      "created": 1789540833,
      "updated": 1789540833
    },
    {
      "id": "6aaa39e10000000000e78f45",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1789540833,
      "updated": 1789540833
    },
    {
      "id": "6aaa39e10000000000e78f46",
      "text": "[ポケモンデー]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789540833,
      "updated": 1789540833
    },
    {
      "id": "6aaa39e10000000000e78f47",
      "text": "[ポケモンプレゼンツ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789540833,
      "updated": 1789540833
    },
    {
      "id": "6aaa39e10000000000e78f48",
