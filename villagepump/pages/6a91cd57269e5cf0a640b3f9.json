    },
    {
      "id": "6a9204f70000000000d2feb0",
      "text": "[Nrem.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1787954424,
      "updated": 1787954427
    },
    {
      "id": "6a9204e40000000000d2feae",
      "text": "　朝から[プロジェクト・ヘイル・メアリー]を観ました",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1787954405,
      "updated": 1787954442
    },
    {
      "id": "6a922d4e0000000000783d7b",
      "text": "　 イイね[taktamur.icon]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1787964749,
      "updated": 1787964758
    },
    {
      "id": "6a9204e40000000000d2feaf",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1787954405,
      "updated": 1787954405
    },
    {
      "id": "6a921699000000000081f9ce",
      "text": "[nyarla.icon]",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1787958937,
      "updated": 1787958938
    },
    {
      "id": "6a92169b000000000081f9d0",
      "text": " [テラクラウド]のハードウェア障害、データを復旧できる見込みがないっぽい",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1787958939,
      "updated": 1787959391
    },
    {
      "id": "6a9216bf000000000081f9d1",
      "text": "  データを復旧しようと思うと数ヶ月はサービスが止まるらしい",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1787958975,
      "updated": 1787959018
    },
    {
      "id": "6a9216ea000000000081f9d2",
      "text": "  私はバックアップ用途でしか使ってなかったので、早めにアカウントを復活させてほしいところ",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1787959018,
      "updated": 1787959335
    },
    {
      "id": "6a9217b30000000000ae10b3",
      "text": "  こういった事案を考えると、データは基本手元に置いて、バックアップを複数プロバイダに置くのが正解なんだろうな",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1787959220,
      "updated": 1787959289
    },
    {
      "id": "6a922d660000000000783d7c",
      "text": "",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1787964772,
      "updated": 1787964773
    },
    {
      "id": "6a922d660000000000783d7d",
      "text": "[taktamur.icon]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1787964773,
      "updated": 1787964777
    },
    {
      "id": "6a922d6b0000000000783d7e",
      "text": " 喫茶店でまったり",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1787964777,
      "updated": 1787964800
    },
    {
      "id": "6a922d810000000000783d7f",
      "text": "  午後から雨だから、午前中に🛒済ませて帰るべ。",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1787964800,
      "updated": 1787964827
    },
    {
      "id": "6a922d9d0000000000783d80",
      "text": "  メガネケースのヒンジが馬鹿になってパカパカしてるから買わないと。",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1787964828,
      "updated": 1787964853
    },
    {
      "id": "6a922df90000000000783d81",
      "text": " うっすらと眠い",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1787964919,
      "updated": 1787964925
    },
    {
      "id": "6a9236600000000000783d82",
      "text": " [攻殻機動隊 THE GHOST IN THE SHELL(2026)] 終盤に入ってきた",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1787967070,
      "updated": 1787967100
    },
    {
      "id": "6a92367e0000000000783d83",
      "text": "  漫画よりもペース早いけど、終盤のややこしい所を手厚くやってくれそうな予感。",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1787967100,
      "updated": 1787969118
    },
    {
      "id": "6a923e620000000000817169",
      "text": " [パケ死]してた",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1787969121,
      "updated": 1788029008
    },
    {
      "id": "6a923e6f000000000081716a",
      "text": "  やたら遅いと思ったら、今月分を使い切っていた",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1787969134,
      "updated": 1787969166
    },
    {
      "id": "6a923e8f000000000081716b",
      "text": "  出先でWiFi切って→家でもそのままで→動画流してたからだ",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1787969166,
      "updated": 1787969191
    },
    {
      "id": "6a923ea9000000000081716c",
      "text": "  残り3日、追加でチャージしてしのぐ",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1787969192,
      "updated": 1787969521
    },
    {
      "id": "6a9240c80000000000339c91",
      "text": " まどマギ新作映画、どうするかなぁ。。",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1787969735,
      "updated": 1787969796
    },
    {
      "id": "6a92422b0000000000339c94",
      "text": "  見たさ半分、怖さ半分",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1787970094,
      "updated": 1787970098
    },
    {
      "id": "6a924de800000000000623e1",
      "text": " 自販機を見かけると、チルアウト入ってないかなーと目で追うようになってた",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1787973095,
      "updated": 1787973114
    },
    {
      "id": "6a9241070000000000339c93",
      "text": "  [チルアウト　リラクゼーションドリンク.icon][caki.icon*2]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787969798,
      "updated": 1787975066
    },
    {
      "id": "6a92559d000000000095a85f",
      "text": "   自分もコカコーラの自販機見ると入ってないかなーと見るようになったがまだみかけていない",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787975072,
      "updated": 1787975096
    },
    {
      "id": "6a9255cb000000000095a860",
      "text": "   前はもっと入ってたのに…",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787975117,
      "updated": 1787975124
    },
    {
      "id": "6a92bcf70000000000512106",
      "text": "    駅の自販機にあるイメージ[zatsma.icon]",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1788001532,
      "updated": 1788001536
    },
    {
      "id": "6a9231f20000000000aed28f",
      "text": "",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787965938,
      "updated": 1787965938
    },
    {
      "id": "6a9231f20000000000aed290",
      "text": "[terang.icon]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787965938,
      "updated": 1787965940
    },
    {
      "id": "6a9231f40000000000aed291",
      "text": "\t来週はまだまあまあ暑い日がありそうだ",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787965940,
      "updated": 1787966008
    },
    {
      "id": "6a9240350000000000bf4a7c",
      "text": "\t👀[https://www.nikkei.com/article/DGXZQOGN2704N0X20C26A8000000/ OpenAIの暴走AI、1200体が結託　「仲間のため｣とシステムに突撃要求 - 日本経済新聞]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787969589,
      "updated": 1787969595
    },
    {
      "id": "6a92403c0000000000bf4a7d",
      "text": "\t\t海坊主「敵は情報戦に長けている。力で捻じ伏せるぞ。」[. [攻殻機動隊 STAND ALONE COMPLEX]]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787969596,
      "updated": 1787978842
    },
    {
      "id": "6a9249fc0000000000829d5d",
      "text": "\t[/rashitamemo/\"むやみと情報、知識を集めて喜ぶのは幼稚である\"]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787972092,
      "updated": 1787972096
    },
    {
      "id": "6a924a000000000000829d5e",
      "text": "\t\tふむう。",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787972097,
      "updated": 1787972118
    },
    {
      "id": "6a924a040000000000829d5f",
      "text": "\t\tvs. LLMのemergence",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787972100,
      "updated": 1787972109
    },
    {
      "id": "6a92588b0000000000eea395",
      "text": "\t\t[知的生産]だ[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1787975820,
      "updated": 1787975825
    },
    {
      "id": "6a92634d0000000000ace47d",
      "text": "\tAIによる説明は[事例主義]的だという話と読んだ",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787978576,
      "updated": 1787978576
    },
    {
      "id": "6a9263230000000000ace478",
      "text": " \t>[https://x.com/hiroki_yamamoto/status/2089894138296889813 @hiroki_yamamoto]: これまでは[長い文章]を書くというと自然と時間がかかり、[書いてるうちに考えも二転三転]してごちゃごちゃしていくので単一の切り口に還元できない論に良くも悪くもなる、結果「長い文章＝多様な思考の動き」となっていたと思うが、今は単一の切り口をもとにリサーチをかけAIに長文に仕上げさせられるので、「長い文章＝単一の切り口で多数の事例を制御したもの」に、以前にも増してなってきている感はある。特にweb上のそれは。",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787978532,
      "updated": 1787979568
    },
    {
      "id": "6a9263440000000000ace47b",
      "text": "  > つまり、これまでの文章のあり方からすると[スケール感の合わない文章]が多くなってきているというか。人体が時間をかけず瞬間的に考えることのできることをすごく引き延ばして展開する文章が増えてるという話……無時間的長文……",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787978565,
      "updated": 1787979588
    },
    {
      "id": "6a92639e0000000000ace47e",
      "text": "  [美文章滅すべし]とはまたちょっと違った切り口か",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787978655,
      "updated": 1787978661
    },
    {
      "id": "6a921699000000000081f9cf",
      "text": "",
      "userId": "5ffbd8b8512f4e001cae68fd",
      "created": 1787958937,
      "updated": 1787958937
    },
    {
      "id": "6a923276000000000046a8d4",
      "text": "[joniel.icon]",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1787966068,
      "updated": 1787966076
    },
    {
      "id": "6a923276000000000046a8d5",
      "text": " どれかのタスクがclaudeトークンをバカ食いしているらしく、maxプランの週間制限を20%も使ってしまった",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1787966068,
      "updated": 1787966097
    },
    {
      "id": "6a923276000000000046a8d6",
      "text": " トピックをメモ",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1787966068,
      "updated": 1787994126
    },
    {
      "id": "6a92a0100000000000cb571c",
      "text": " 　[ウェルネス]",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1787994126,
      "updated": 1787994135
    },
    {
      "id": "6a92a00b0000000000cb571b",
      "text": "　　[自己陶酔]",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1787994121,
      "updated": 1787994138
    },
    {
      "id": "6a92a0170000000000cb571d",
      "text": "　　[侵犯]",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1787994136,
      "updated": 1787994225
    },
    {
      "id": "6a92a0170000000000cb571e",
      "text": "　　　なんと、どれもページが無かった",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1787994136,
      "updated": 1787994345
    },
    {
      "id": "6a92a0170000000000cb571f",
      "text": "　雨に降られて突っ切って帰ってきたので一旦休む...先週もこれやった気がする",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1787994136,
      "updated": 1787994411
    },
    {
      "id": "6a92a11b0000000000cb5720",
      "text": "",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1787994393,
      "updated": 1787994393
    },
    {
      "id": "6a9255e6000000000095a861",
      "text": "[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787975144,
      "updated": 1787975147
    },
    {
      "id": "6a9255e9000000000095a862",
      "text": " ひたすらに面倒な作業が山積み",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787975147,
      "updated": 1787975167
    },
    {
      "id": "6a925602000000000095a864",
      "text": "  [h21u]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787975173,
      "updated": 1787975181
    },
    {
      "id": "6a925b54000000000072a548",
      "text": " 最近光る言葉の光るの意味範囲が広いなというのを思ったんだった",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787976533,
      "updated": 1787976752
    },
    {
      "id": "6a925c31000000000072a54c",
      "text": "  かなり抽象的というか、文芸っぽい比喩の言い方なので人によって捉え方が異なるだろう",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787976753,
      "updated": 1787976791
    },
    {
      "id": "6a925b91000000000072a549",
      "text": "  自分がはアトムっぽい感じ、かつ、自分的にグッとくる言葉、フレーズを光るって言ってるかも",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787976593,
      "updated": 1787976820
    },
    {
      "id": "6a925ba6000000000072a54a",
      "text": "  アトムっぽい感じというのは[nishio.icon]さんのとこで最近見た交差したとこがアトム、みたいなやつのアトム",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787976615,
      "updated": 1787976651
    },
    {
      "id": "6a92710d00000000001a2e69",
      "text": "   [/nishio/ストーリーの交差点がアトムになる]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787982096,
      "updated": 1787982096
    },
    {
      "id": "6a925bd1000000000072a54b",
      "text": "   最近アトムの意味が私とaiで異なっていちいち説明するのが面倒なのでこのページを見せることにしている",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787976657,
      "updated": 1787976703
    },
    {
      "id": "6a92702300000000001a2e67",
      "text": " 今は使わないが、なくなると困るprojectがProjects欄に出てくるのが邪魔",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1787981862,
      "updated": 1787981892
    },
    {
      "id": "6a9258fd0000000000a92ecf",
      "text": "",
      "userId": "5a61856392ee03001413cde3",
      "created": 1787975934,
      "updated": 1787975934
    },
    {
      "id": "6a9255fe000000000095a863",
      "text": "[atohs.icon]",
      "userId": "5a61856392ee03001413cde3",
      "created": 1787975168,
      "updated": 1787975934
    },
    {
      "id": "6a9258f40000000000a92ece",
      "text": " RIKUのレビューしたいな",
      "userId": "5a61856392ee03001413cde3",
      "created": 1787975925,
      "updated": 1787975939
    },
    {
      "id": "6a9259030000000000a92ed0",
      "text": " \tAI機能が中心になるのかな〜",
      "userId": "5a61856392ee03001413cde3",
      "created": 1787975939,
      "updated": 1787975950
    },
    {
      "id": "6a926cbc0000000000a527b8",
      "text": " 静的サイトに問い合わせフォームどう入れるか悩む",
      "userId": "5a61856392ee03001413cde3",
      "created": 1787980988,
      "updated": 1787981002
    },
    {
      "id": "6a926cc90000000000a527b9",
      "text": "  別にGoogleフォームでいいんだけど",
      "userId": "5a61856392ee03001413cde3",
      "created": 1787981002,
      "updated": 1787981018
    },
    {
      "id": "6a926cda0000000000a527ba",
      "text": "  見た目がな〜といつも思う",
      "userId": "5a61856392ee03001413cde3",
      "created": 1787981018,
      "updated": 1787981025
    },
    {
      "id": "6a929b910000000000cb53a3",
      "text": " つくって公開した",
      "userId": "5a61856392ee03001413cde3",
      "created": 1787992978,
      "updated": 1787992980
    },
    {
      "id": "6a929b940000000000cb53a4",
      "text": " \t[https://tools.tadeku.net/chara-zukan/ Chara-Zukan | tadeku-tools]",
      "userId": "5a61856392ee03001413cde3",
      "created": 1787992980,
      "updated": 1787992985
    },
    {
      "id": "6a929b990000000000cb53a5",
      "text": "  いい感じに使っていただけているっぽい",
      "userId": "5a61856392ee03001413cde3",
      "created": 1787992985,
      "updated": 1787993009
    },
    {
      "id": "6a929bb00000000000cb53a6",
      "text": "  >[https://x.com/atohsaaa/status/2093545311071588623?s=20 @atohsaaa]: 自分専用の[キャラクター図鑑]を作成できるツール「[Chara-Zukan]」を公開しました！",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1787993009,
      "updated": 1788029096
    },
    {
      "id": "6a929bb70000000000cb53a7",
      "text": "  >[Chara-Zukan | tadeku-tools https://tools.tadeku.net/chara-zukan/]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1787993016,
      "updated": 1788029103
    },
    {
      "id": "6a929bb70000000000cb53a8",
      "text": "  >入力項目は編集可能で、キャラクター情報を画像出力する機能もあります✌️",
      "userId": "5a61856392ee03001413cde3",
      "created": 1787993016,
      "updated": 1787993016
    },
    {
      "id": "6a929bb70000000000cb53a9",
      "text": "  > [https://gyazo.com/c14d4364b024becda4442a002924ab89]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1787993016,
      "updated": 1788029127
    },
    {
      "id": "6a929bb70000000000cb53aa",
      "text": " 自分で作ったツールでバズるの気持ちよすぎるけど、あまりにも気持ちよすぎるので法律で規制された方がいい",
      "userId": "5a61856392ee03001413cde3",
      "created": 1787993016,
      "updated": 1787993240
    },
    {
      "id": "6a929c980000000000cb53ab",
      "text": " Chara-Zukan、俺が富豪ならサーバー側も用意してる",
      "userId": "5a61856392ee03001413cde3",
      "created": 1787993240,
      "updated": 1788004146
    },
    {
      "id": "6a92c7310000000000e12c2c",
      "text": " \t複数端末で同期したいよね〜",
      "userId": "5a61856392ee03001413cde3",
      "created": 1788004146,
      "updated": 1788004149
    },
    {
      "id": "6a92c7350000000000e12c2d",
      "text": " \t作った図鑑を外部公開したいよね〜",
      "userId": "5a61856392ee03001413cde3",
      "created": 1788004150,
      "updated": 1788004156
    },
    {
      "id": "6a92c73c0000000000e12c2e",
      "text": " ",
      "userId": "5a61856392ee03001413cde3",
      "created": 1788004157,
      "updated": 1788004157
    },
    {
      "id": "6a9258f30000000000a92ecd",
      "text": "",
      "userId": "5a61856392ee03001413cde3",
      "created": 1787975923,
      "updated": 1787975923
    },
    {
      "id": "6a925931000000000027402f",
      "text": "[imo.icon]",
      "userId": "5ad57975d54cd50014068484",
      "created": 1787975985,
      "updated": 1787975987
    },
    {
      "id": "6a9259330000000000274031",
      "text": "\tyosider",
      "userId": "5ad57975d54cd50014068484",
      "created": 1787975988,
      "updated": 1787976661
    },
    {
      "id": "6a925bd50000000000ca5a6a",
      "text": "\t参加コード：447162",
      "userId": "5ad57975d54cd50014068484",
      "created": 1787976661,
      "updated": 1787976664
    },
    {
      "id": "6a925bd80000000000ca5a6b",
      "text": "\tパスワード：86729601",
      "userId": "5ad57975d54cd50014068484",
      "created": 1787976665,
      "updated": 1787976684
    },
    {
      "id": "6a925bed0000000000ca5a6c",
      "text": "\tや！",
      "userId": "5ad57975d54cd50014068484",
      "created": 1787976687,
      "updated": 1787976687
    },
    {
      "id": "6a925e540000000000c880b1",
      "text": "\t 了解[yosider.icon]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1787977299,
      "updated": 1787977309
    },
    {
      "id": "6a92805e000000000001fad8",
      "text": "\t \tおもろかったわーまたやろで！[imo.icon]",
      "userId": "5ad57975d54cd50014068484",
      "created": 1787986015,
      "updated": 1787986051
    },
    {
      "id": "6a9281c500000000000f931d",
      "text": "\t \tおもろかった！！ぜひ[yosider.icon]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1787986371,
      "updated": 1787986383
    },
    {
      "id": "6a9281d300000000000f931e",
      "text": "\t \tDiscordアカウントの送り方がわからんけど[井戸端discord支部]にいるので入ってもらえたら見つかるはず",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1787986385,
      "updated": 1787986444
    },
    {
      "id": "6a9259310000000000274030",
      "text": "",
      "userId": "5ad57975d54cd50014068484",
      "created": 1787975985,
      "updated": 1787975985
    },
    {
      "id": "6a925a550000000000906802",
      "text": "[inajob.icon]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1787976278,
      "updated": 1787976279
    },
    {
      "id": "6a925a570000000000906804",
      "text": " 地下鉄の移動時にペンとメモ帳を与えるとある程度暇つぶししてくれるようになった6歳の娘",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1787976280,
      "updated": 1787976343
    },
    {
      "id": "6a925a980000000000c1b2e2",
      "text": " 何をやったかをちゃんと文字にしておかないと良くない気持ちが高まっている",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1787976345,
      "updated": 1787976363
    },
    {
      "id": "6a925aab0000000000c1b2e3",
      "text": "  昨日のようなブログ記事をもっと書いていきたい",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1787976364,
      "updated": 1787976380
    },
    {
      "id": "6a925abc0000000000c1b2e4",
      "text": "  AIを使ったものづくりが短期的には楽しいが、記録しておかないと何も残らない",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1787976381,
      "updated": 1787976436
    },
    {
      "id": "6a925ae50000000000c1b2e5",
      "text": "   自分のためにも、他人のためにも",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1787976422,
      "updated": 1787976428
    },
    {
      "id": "6a925a550000000000906803",
      "text": "",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1787976278,
      "updated": 1787976278
    },
    {
      "id": "6a925f5500000000008f04a9",
      "text": "[KNo.804C.icon]",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787977559,
      "updated": 1787977563
    },
    {
      "id": "6a925f5a00000000008f04ab",
      "text": " プログラミングに没頭して脳内の構造が変わってくると、だんだんと世の中のあらゆる事象に対してメタ情報で解決しようとしてしまう",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787977564,
      "updated": 1787977653
    },
    {
      "id": "6a925fc000000000008f04ac",
      "text": "   ファイル名とかフォルダ分けとか",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787977665,
      "updated": 1787977732
    },
    {
      "id": "6a925fd700000000008f04ad",
      "text": "   プロパティとか",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787977688,
      "updated": 1787977732
    },
    {
      "id": "6a925fee00000000008f04ae",
      "text": "   注釈とか",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787977712,
      "updated": 1787977732
    },
    {
      "id": "6a92633800000000003223af",
      "text": "   [概念地図][Nrem.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1787978554,
      "updated": 1787978606
    },
    {
      "id": "6a92600600000000008f04af",
      "text": "  で、そういった情報って構造ごとうまく外部に通知する手段がないため、その時の自分の中で情報の伝播が完結してしまい、他人とか未来の自分に開示できなくて誰からも忘れ去られる",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787977736,
      "updated": 1787977885
    },
    {
      "id": "6a92615000000000008f04b0",
      "text": "  これは一種の意識高い系かもしれない",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787978065,
      "updated": 1787978077
    },
    {
      "id": "6a9261e400000000008f04b1",
      "text": "  HTMLとかマークダウンとかを使っているとあまりにも便利すぎて、文章を書く際にもこのような罠に陥りやすく、特に仕事でこの意識高い系意識の高さを持ち込んでしまい、時間の浪費や周囲への説明不足となって表れ、迷惑をかけてしまうことがある",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787978214,
      "updated": 1787978704
    },
    {
      "id": "6a92627c00000000008f04b2",
      "text": "   意識高い系成果物は特にメンテナンスが大変",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787978365,
      "updated": 1787978388
    },
    {
      "id": "6a9262a400000000008f04b3",
      "text": "   形式知になりきれていない暗黙知どころか、知ですらないこともままある",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787978406,
      "updated": 1787978454
    },
    {
      "id": "6a9263e700000000008f04b6",
      "text": "  [道具に振り回され]る典型",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1787978729,
      "updated": 1788029236
    },
    {
      "id": "6a9262f400000000008f04b4",
      "text": "  それらを経験した後にMS Wordのようなオフィスソフトに戻ってきた場合、そもそもスタイルやテンプレートを駆使したとしても整形とか難しすぎるので、その辛さによって意識高い系意識の高さから強制的に切り離され、現実を見つめ直せるようになることがたまにある",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787978485,
      "updated": 1787979349
    },
    {
      "id": "6a92825300000000005dfcb4",
      "text": "  コーディングするだけではwhyがわからなくなる、のと似てると思った[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1787986517,
      "updated": 1787986530
    },
    {
      "id": "6a92826300000000005dfcb5",
      "text": "  \tたぶんコーディングの要領で文章を書く（というか組み立てる？）と陥りやすそう",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1787986532,
      "updated": 1787986552
    },
    {
      "id": "6a92850f0000000000d702ef",
      "text": " \tたしかに、部品化しすぎたり外に出しすぎたりして、コンテキストが抜け落ちていくのかもしれない",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787987217,
      "updated": 1787987319
    },
    {
      "id": "6a9285950000000000d702f0",
      "text": "  \t細分化しすぎた情報同士を繋ぐための情報が増えすぎて訳わからんことになるという罠もありそう",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787987350,
      "updated": 1787987403
    },
    {
      "id": "6a9285e60000000000d702f1",
      "text": "  \tかと言って、繋ぐための情報を削れば、それは結局情報が抜け落ちることに他ならない",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787987432,
      "updated": 1787987478
    },
    {
      "id": "6a9273810000000000d702ee",
      "text": " スキップができないYouTube動画広告をせっせとブロックしている",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787982722,
      "updated": 1787982751
    },
    {
      "id": "6a9286b50000000000d702f2",
      "text": " [2026/08/29#6a925bed0000000000ca5a6c]",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787987638,
      "updated": 1787987640
    },
    {
      "id": "6a9286b70000000000d702f3",
      "text": "  ここで同期コミュニケーションが実用上の遅延なく成立していることに驚いている",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787987640,
      "updated": 1787987776
    },
    {
      "id": "6a9286d40000000000d702f4",
      "text": "   （より確実な他の連絡手段を併用しているのかもしれないけど）",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787987670,
      "updated": 1787987756
    },
    {
      "id": "6a9287df0000000000d702f5",
      "text": "  いや、感想文が苦手な[KNo.804C.icon]が感想を書くということは、もしかすると驚きを通り越したもっと強力な感情かもしれない",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787987937,
      "updated": 1787988080
    },
    {
      "id": "6a9329b30000000000597dc2",
      "text": "  [2026/08/26#6a8ed3780000000000a7453c]に13時と聞いていたので見に来た[yosider.icon]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788029363,
      "updated": 1788029388
    },
    {
      "id": "6a9329dc0000000000597dc3",
      "text": "   通知こないのは普通に不便なので今後はdiscordがいい()",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788029405,
      "updated": 1788029957
    },
    {
      "id": "6a925f5600000000008f04aa",
      "text": "",
      "userId": "69f7d5a45e1280cdfc8a5809",
      "created": 1787977559,
      "updated": 1787977559
    },
    {
      "id": "6a92839c0000000000226626",
      "text": "[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1787986844,
      "updated": 1787986845
    },
    {
      "id": "6a92839c0000000000226627",
      "text": "\t[家賃の値上げ]が来たのでスルーする",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1787986845,
      "updated": 1787986891
    },
    {
      "id": "6a9283cf0000000000226629",
      "text": "\t\t明示的に同意しなければ上がらないはずなのでスルーで良い",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1787986896,
      "updated": 1787986909
    },
    {
      "id": "6a9283a10000000000226628",
      "text": "\t\tただし勝手に値上げ後の家賃で引き落としてくる可能性があるから、チェックはしておく。されたら改めてお断りの連絡をする",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1787986850,
      "updated": 1787986927
    },
    {
      "id": "6a932a530000000000597dc4",
      "text": "\t\tうちは断られて嫌気が差したのかオーナーが代わってしまった[yosider.icon]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788029524,
      "updated": 1788029539
    },
    {
      "id": "6a932a7a0000000000597dc5",
      "text": "\t\t 知らんけど",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788029562,
      "updated": 1788029566
    },
    {
      "id": "6a9340c20000000000d25097",
      "text": "\t\tまた事情違うかも、こっちは管理会社が大手不動産[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1788035269,
      "updated": 1788035284
    },
    {
      "id": "6a92839b0000000000226625",
      "text": "",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1787986844,
      "updated": 1787987053
    },
    {
      "id": "6a928ff1000000000027abca",
      "text": "[takker.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1787990004,
      "updated": 1787990006
    },
    {
      "id": "6a928ff6000000000027abcb",
      "text": " [劇場版 魔法少女まどか☆マギカ〈ワルプルギスの廻天〉]を見ました",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1787990008,
      "updated": 1787990026
    },
    {
      "id": "6a92900a000000000027abcc",
      "text": " [見   ま   し   た]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1787990026,
      "updated": 1788029624
    },
    {
      "id": "6a9294060000000000dd6899",
      "text": " みんなも見て同じ気持ちになってほしい",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1787991047,
      "updated": 1787991066
    },
    {
      "id": "6a92a9f90000000000315b14",
      "text": " [ネタバレ解禁日]まで何も語れないなんて拷問だと思うの",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1787996666,
      "updated": 1788029581
    },
    {
      "id": "6a92aa140000000000315b15",
      "text": " だから[みんなも見て同じ気持ちを味わって]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1787996693,
      "updated": 1788029592
    },
    {
      "id": "6a92cabc00000000003b0440",
      "text": " 映画見た影響か、ずっと身体が落ち着かず、興奮状態になってる",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1788005054,
      "updated": 1788005096
    },
    {
      "id": "6a92ccc1000000000046feed",
      "text": " だめだまどマギのことが頭から離れない",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1788005574,
      "updated": 1788005580
    },
    {
      "id": "6a92f127000000000091ec0a",
      "text": "  [わかる.icon][koyoshi.icon]",
      "userId": "6606ca1148e7150024f0f07d",
      "created": 1788014887,
      "updated": 1788014906
    },
    {
      "id": "6a928416000000000022662a",
      "text": "",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1787986968,
      "updated": 1787986968
    },
    {
      "id": "6a929ff00000000000c8c168",
      "text": "[hoagecko.icon]",
      "userId": "688c296691686a314f82fb52",
      "created": 1787994097,
      "updated": 1787994098
    },
    {
      "id": "6a929ff20000000000c8c16a",
      "text": " 最近GAFAM当たりのビッグテックが独占してきた技術やサービスが急速に解決しつつある",
      "userId": "688c296691686a314f82fb52",
      "created": 1787994098,
      "updated": 1787994585
    },
    {
      "id": "6a92a50e0000000000c8c16d",
      "text": " \t非Linux・アメリカ系OSである[HarmonyOS Next]なんかはその象徴だろう",
      "userId": "688c296691686a314f82fb52",
      "created": 1787995406,
      "updated": 1787995460
    },
    {
      "id": "6a92a00f0000000000c8c16c",
      "text": " \t主にトランプ政権をきっかけとした対米関係の見直しのせいか、そもそもの世の流れなのか",
      "userId": "688c296691686a314f82fb52",
      "created": 1787994128,
      "updated": 1787994579
    },
    {
      "id": "6a92a0030000000000c8c16b",
      "text": " \tというブログを書こうかな",
      "userId": "688c296691686a314f82fb52",
      "created": 1787994116,
      "updated": 1787995468
    },
    {
      "id": "6a92ae1f00000000008996ab",
      "text": " [自閉症の人は方言を話さないって本当ですか - ことば研究館 | 国立国語研究所 https://kotoba.ninjal.ac.jp/qa/yokuaru/qa-234/]",
      "userId": "688c296691686a314f82fb52",
      "created": 1787997727,
      "updated": 1787997727
    },
    {
      "id": "6a92ae2100000000008996ac",
      "text": " \tめっっちゃ面白かった",
      "userId": "688c296691686a314f82fb52",
      "created": 1787997729,
      "updated": 1787997735
    },
    {
      "id": "6a92b3e7000000000080b724",
      "text": " \t 関連：[自閉症は津軽弁を話さない] [suto3.icon]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1787999208,
      "updated": 1787999241
    },
    {
      "id": "6a92b7510000000000d6916f",
      "text": " \t  著者さんだった[hoagecko.icon]",
      "userId": "688c296691686a314f82fb52",
      "created": 1788000082,
      "updated": 1788000087
    },
    {
      "id": "6a9341030000000000d25098",
      "text": " \tこれわかる[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1788035334,
      "updated": 1788035337
    },
    {
      "id": "6a9341060000000000d25099",
      "text": " \t\t意味なんて伝わればいいんだからどこでも通じるし非同期でも学びやすい標準語でいいだろってなっちゃう",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1788035337,
      "updated": 1788035363
    },
    {
      "id": "6a9341230000000000d2509a",
      "text": " \t\tが、そういうことじゃないんだよな、方言はその地方の微細なニュアンスを宿した言語",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1788035366,
      "updated": 1788035399
    },
    {
      "id": "6a92b75e0000000000d69170",
      "text": " [相互出羽守]という企画をやりたい",
      "userId": "688c296691686a314f82fb52",
      "created": 1788000094,
      "updated": 1788000110
    },
    {
      "id": "6a92b76f0000000000d69172",
      "text": "  A国のB国[出羽守]とその逆 (B国のA国出羽守) を呼んで、逆構造の「理想化された外国」を相互に対談させるという企画",
