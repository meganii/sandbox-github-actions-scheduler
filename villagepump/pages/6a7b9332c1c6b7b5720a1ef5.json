      "created": 1786483527,
      "updated": 1786483528
    },
    {
      "id": "6a7bbfe90000000000b1a373",
      "text": " [箱]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1786494953,
      "updated": 1786494957
    },
    {
      "id": "6a7bbfee0000000000b1a374",
      "text": " ボックス",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1786494959,
      "updated": 1786494976
    },
    {
      "id": "6a7bc0010000000000b1a375",
      "text": " [コンテナ]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1786494978,
      "updated": 1786494987
    },
    {
      "id": "6a7bc0330000000000b1a376",
      "text": " [トランク]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1786495027,
      "updated": 1786495037
    },
    {
      "id": "6a7bc03d0000000000b1a377",
      "text": " キャビネット",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1786495038,
      "updated": 1786495058
    },
    {
      "id": "6a7b940f0000000000bd2683",
      "text": "　[箱のメタファ]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1786483727,
      "updated": 1786483727
    },
    {
      "id": "6a7b93490000000000bd267c",
      "text": "",
