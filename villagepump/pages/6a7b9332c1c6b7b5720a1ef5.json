      "created": 1786483529,
      "updated": 1786483735
    },
    {
      "id": "6a7b939c0000000000bd267e",
      "text": "名札にはふたつの種類がある",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1786483613,
      "updated": 1786483653
    },
    {
      "id": "6a7b939d0000000000bd267f",
      "text": "　付けたら外せないもの",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1786483614,
      "updated": 1786483677
    },
    {
      "id": "6a7b94210000000000bd2684",
      "text": "　　[ラベル]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1786483746,
      "updated": 1786483790
    },
    {
      "id": "6a7b94500000000000bd2687",
      "text": "　　 [レーベル]、[レッテル]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1786483792,
      "updated": 1786483812
    },
    {
      "id": "6a7b93c70000000000bd2680",
      "text": "　付け替えできるもの",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1786483656,
      "updated": 1786483715
    },
    {
      "id": "6a7b943a0000000000bd2685",
      "text": "　 [タグ]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1786483770,
      "updated": 1786483779
    },
    {
      "id": "6a7b93fb0000000000bd2682",
