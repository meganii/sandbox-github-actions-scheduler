    {
      "id": "6acf7c380000000000210c1e",
      "text": "見出しセル記法",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982647,
      "updated": 1791982651
    },
    {
      "id": "6acf7c3c0000000000210c20",
      "text": "[UserCSS.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791982651
    },
    {
      "id": "6acf7c3c0000000000210c21",
      "text": "#table記法",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791982682
    },
    {
      "id": "6acf7c3c0000000000210c22",
      "text": "書式：セル内の先頭にスペースを入れる（全角・半角どちらでも可）",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791982651
    },
    {
      "id": "6acf7c410000000000210c3e",
      "text": "製作者：[Nrem.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982656,
      "updated": 1791982672
    },
    {
      "id": "6acf7c3c0000000000210c23",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791982651
    },
    {
      "id": "6acf7c3c0000000000210c24",
      "text": "table: ",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791982651
    },
    {
      "id": "6acf7c3c0000000000210c25",
      "text": "\t \t見出し\t 見出し",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791982651
    },
    {
      "id": "6acf7c3c0000000000210c26",
      "text": "\t 見出し\tセル\tセル",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791982651
    },
    {
      "id": "6acf7c3c0000000000210c27",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791982651
    },
    {
      "id": "6acf7c3c0000000000210c29",
      "text": "code:style.css",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791982651
    },
    {
      "id": "6acf7c3c0000000000210c2a",
      "text": "\t.table-block .cell:has(> .cell-text > .head-space) {",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791982651
    },
    {
      "id": "6acf7c3c0000000000210c2b",
      "text": "\t\tfont-weight: var(--header-cell-font-weight, var(--strong-font-weight, bold));",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791984042
    },
    {
      "id": "6acf7c3c0000000000210c2c",
      "text": "\t\tbackground-color: var(--header-cell-bg, rgb(0 0 0 / .06));",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791984045
    },
    {
      "id": "6acf7c3c0000000000210c2d",
      "text": "\t\tcolor: var(--header-cell-text-color, var(--cell-text-color, unset));",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791984048
    },
    {
      "id": "6acf7c3c0000000000210c2e",
      "text": "\t}",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791982651
    },
    {
      "id": "6acf7c3c0000000000210c2f",
      "text": "\t.head-space:not(.cursor-line *) {",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791982651
    },
    {
      "id": "6acf7c3c0000000000210c30",
      "text": "\t\tdisplay: none;",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791982651
    },
    {
      "id": "6acf7c3c0000000000210c31",
      "text": "\t}",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791982651
    },
    {
      "id": "6acf7c3c0000000000210c32",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791982651
    },
    {
      "id": "6acf7c3c0000000000210c33",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791982651
    },
    {
      "id": "6acf7c3c0000000000210c34",
      "text": "[2026-10-14]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791982651,
      "updated": 1791982873
    },
    {
      "id": "6acf7d190000000000210c62",
      "text": " Settingsに導入",
      "userId": "6780c5dd585ee07f1dc50b2b",
