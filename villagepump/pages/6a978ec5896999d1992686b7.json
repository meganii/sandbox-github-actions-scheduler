    {
      "id": "6a978ec70000000000b35abe",
      "text": "\t.deco-_>a.link.icon>:is(img.icon,img.inline-icon){background-color:color-mix(in hsl, white 85%, var(--page-bg, #fafafa));}",
      "userId": "6436266c7ac3c0001bed60e6",
