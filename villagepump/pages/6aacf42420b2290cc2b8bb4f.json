  "lines": [
    {
      "id": "6aacf42420b2290cc2b8bb4f",
      "text": "ムカ",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789719594,
      "updated": 1789719595
    },
    {
      "id": "6aacf42a0000000000184780",
      "text": "[ムカつ]く",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789719596,
      "updated": 1789719608
    },
    {
      "id": "6aacf4400000000000184783",
      "text": "[むかつく]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789719618,
      "updated": 1789719633
    },
    {
      "id": "6aacf4c2000000000018478e",
      "text": "[ムカつく]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789719748,
      "updated": 1789719751
    },
    {
      "id": "6aacf4500000000000184784",
      "text": "[むかついた]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789719634,
      "updated": 1789719641
    },
    {
      "id": "6aacf53a0000000000184798",
      "text": "[ムカチャッカファイアー]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789719868,
      "updated": 1789719875
    },
    {
      "id": "6aacf43a0000000000184782",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789719612,
      "updated": 1789719612
    },
    {
      "id": "6aacf45d0000000000184785",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789719647,
      "updated": 1789719647
    },
    {
      "id": "6aacf5020000000000184797",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789719812,
      "updated": 1789719812
    },
    {
      "id": "6aacf45d0000000000184786",
      "text": "[自分がむかついてる時には冷静に合理的判断をする能力が下がってる]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789719647,
      "updated": 1789719659
    },
    {
      "id": "6aacf48d000000000018478a",
      "text": "[突き放すような言いまわしに対するムカつき]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789719695,
      "updated": 1789719705
    },
    {
      "id": "6aacf498000000000018478b",
      "text": "[ムカつきを原動力にする]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789719706,
      "updated": 1789719714
    },
    {
      "id": "6aacf4a2000000000018478c",
      "text": "[ムカつきを分析]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789719716,
      "updated": 1789719722
    },
    {
      "id": "6aacf4cc000000000018478f",
      "text": "[くっつくパンツか ムカつくパンツか]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789719758,
      "updated": 1789719765
    },
    {
      "id": "6aacf4d40000000000184791",
      "text": "[ソフトがいちいちバグってムカつく]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789719766,
      "updated": 1789719772
    },
    {
      "id": "6aacf4db0000000000184793",
      "text": "[多くの人がムカつくであろうことを避ける]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789719773,
      "updated": 1789719786
    },
    {
      "id": "6aacf4ed0000000000184795",
      "text": "[人の一挙手・一投足・言・動・容姿・存在がムカつく]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1789719791,
      "updated": 1789719801
    },
    {
      "id": "6aacf4ed0000000000184796",
