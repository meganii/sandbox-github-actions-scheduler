    {
      "id": "6af0f97f0000000000331a20",
      "text": "フルール・ド・リス（fleur-de-lis）",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794177408,
      "updated": 1794177677
    },
    {
      "id": "6af0f9810000000000331a21",
      "text": "ヨーロッパの[紋章]や旗などに使われる、ユリの花をかたどったシンボル",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794177409,
      "updated": 1794240439
    },
    {
      "id": "6af0fb3500000000009ba720",
      "text": "美しさや高貴さ、フランス王家の象徴として使われる、らしい",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794177846,
      "updated": 1794177880
    },
    {
      "id": "6af0fa4a0000000000331a23",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794177611,
      "updated": 1794177611
    },
    {
      "id": "6af0fa530000000000331a24",
      "text": "実は、ユリの花ではなくて、[アヤメ]の花らしい",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794177619,
      "updated": 1794240444
