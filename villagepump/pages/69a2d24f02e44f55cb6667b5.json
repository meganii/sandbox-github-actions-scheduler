  "lines": [
    {
      "id": "69a2d24f02e44f55cb6667b5",
      "text": "ツンデレ",
      "userId": "5f938a902ea5180024085116",
      "created": 1772278354,
      "updated": 1772278354
    },
    {
      "id": "6aa8ca2100000000002fc904",
      "text": ">ツンデレは、特定の人間関係において敵対的な態度と過度に好意的な態度の二つの性質を持つ様子、またはそうした人物を指す。",
      "userId": "660605441655f300254ac7c2",
      "created": 1789446689,
      "updated": 1789446691
    },
    {
      "id": "69a2d2540000000000bde838",
      "text": "\t[https://ja.wikipedia.org/wiki/ツンデレ ツンデレ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1772278355,
      "updated": 1789446700
    },
    {
      "id": "69a2d2560000000000bde839",
      "text": "",
      "userId": "5f938a902ea5180024085116",
      "created": 1772278357,
      "updated": 1772278357
    },
    {
      "id": "69a2d2570000000000bde83a",
      "text": " もはや一般的に自然と馴染んでいるような",
      "userId": "5f938a902ea5180024085116",
      "created": 1772278358,
      "updated": 1772278373
    },
    {
      "id": "69a2d2590000000000bde83b",
      "text": "　これまで一部のオタクにしか使われていなかったスラングが平気で一般的に使われてる",
      "userId": "5f938a902ea5180024085116",
      "created": 1772278360,
      "updated": 1772278420
    },
    {
      "id": "69a2d27b0000000000bde83d",
      "text": "　　全然他にもありそう",
      "userId": "5f938a902ea5180024085116",
      "created": 1772278394,
      "updated": 1772278417
    },
    {
      "id": "69a2d29b0000000000bde83e",
      "text": "",
      "userId": "5f938a902ea5180024085116",
      "created": 1772278425,
      "updated": 1772278425
    },
    {
      "id": "6aa8c6d900000000002fc8fa",
      "text": "関連",
      "userId": "660605441655f300254ac7c2",
      "created": 1789445849,
      "updated": 1789445852
    },
    {
      "id": "6aa8c6db00000000002fc8fb",
      "text": "\t[クーデレ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789445852,
      "updated": 1789445858
    },
    {
      "id": "6aa8c72100000000002fc8fd",
      "text": "\t[ヤンデレ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1789445921,
      "updated": 1789445927
    },
