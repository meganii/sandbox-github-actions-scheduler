    {
      "id": "6af3172b15e87b6467eb83b8",
      "text": "ビビンバ",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1794318663,
      "updated": 1794318663
    },
    {
      "id": "6af321460000000000e9efb8",
      "text": "分類",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1794318663,
      "updated": 1794318664
    },
    {
      "id": "6af321470000000000e9efb9",
      "text": " ポトン（普通の）ピビンバ",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1794318664,
      "updated": 1794318664
    },
    {
      "id": "6af321470000000000e9efba",
      "text": "  おそらく最も[オーソドックス]なビビンバ",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1794318664,
      "updated": 1794318664
    },
    {
      "id": "6af321470000000000e9efbb",
      "text": " 全州ピビンバ",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1794318664,
      "updated": 1794318664
    },
    {
      "id": "6af321470000000000e9efbc",
      "text": "  牛肉出汁や豆もやしの野菜出汁で米を炊く",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1794318664,
      "updated": 1794318664
    },
    {
      "id": "6af321470000000000e9efbd",
      "text": " 晋州ピビンバ",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1794318664,
      "updated": 1794318664
    },
    {
      "id": "6af321470000000000e9efbe",
      "text": "  [ユッケ]が乗ってる",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1794318664,
      "updated": 1794318664
    },
    {
      "id": "6af321470000000000e9efbf",
      "text": "  [ヘジャンクク](温スープ)が添えられる",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1794318664,
      "updated": 1794318664
    },
    {
      "id": "6af329e00000000000bf7bc0",
      "text": " (マイケル・ジャクソン・ビビンバ)",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1794320865,
      "updated": 1794321347
    },
    {
      "id": "6af329e70000000000bf7bc1",
      "text": "  [マイケル・ジャクソン]がビビンバにドハマりしたため、新羅ホテルが彼のために[コチュジャン]や肉が入っていないビビンバを作った...らしい。",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1794320872,
      "updated": 1794320995
    },
    {
      "id": "6af32a630000000000bf7bc3",
      "text": "   [ソース1 https://web.archive.org/web/20231231182403/https://www.chosunonline.com/site/data/html_dir/2023/12/21/2023122180130.html]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1794320996,
      "updated": 1794321318
    },
    {
      "id": "6af321470000000000e9efc0",
      "text": "   [ソース2 https://plus.hankyung.com/apps/newsinside.view?aid=1998031301661]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1794318664,
      "updated": 1794321323
    },
    {
      "id": "6af32a870000000000bf7bc4",
      "text": "",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1794321032,
      "updated": 1794321032
    },
    {
      "id": "6af321470000000000e9efc1",
      "text": "[表記揺れ]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1794318664,
      "updated": 1794318664
    },
    {
      "id": "6af321470000000000e9efc2",
      "text": " 日本での呼称:ビビンバ",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1794318664,
      "updated": 1794318664
    },
    {
      "id": "6af321470000000000e9efc3",
      "text": " 発音的に正しい:ピビンバ、ピビンパッ",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1794318664,
      "updated": 1794318664
    },
    {
      "id": "6af321470000000000e9efc4",
      "text": "  [ゲシュタルト崩壊]起こしそう[h45te.icon]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1794318664,
      "updated": 1794318664
    },
