{
  "id": "6aab5fb8f8ca3574aaa50729",
  "title": "Gyazoのエクスポート",
  "created": 1789616074,
  "updated": 1789617488,
  "lines": [
    {
      "id": "6aab5fb8f8ca3574aaa50729",
      "text": "Gyazoのエクスポート",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789616074,
      "updated": 1789616074
    },
    {
      "id": "6aab5fd00000000000783782",
      "text": "正式には[全キャプチャの一括ダウンロード]らしい",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789616081,
      "updated": 1789616103
    },
    {
      "id": "6aab5fc80000000000783780",
      "text": " https://help-ja.gyazo.com/全キャプチャの一括ダウンロード",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789616074,
      "updated": 1789616094
    },
    {
      "id": "6aab5fdd0000000000783783",
      "text": " [metadata.json] というファイルに[Gyazoのメタデータ]が出力される",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789616094,
      "updated": 1789616262
    },
    {
      "id": "6aab60310000000000783785",
      "text": "  https://help-ja.gyazo.com/画像をエクスポートする際に付随するメタデータ",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789616178,
      "updated": 1789616187
    },
    {
      "id": "6aab5fe70000000000783784",
      "text": " > エクスポートされるデータに含まれるもの",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789616105,
      "updated": 1789616214
    },
    {
      "id": "6aab60550000000000783787",
      "text": "  > アプリケーション名",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789616214,
      "updated": 1789616223
    },
    {
      "id": "6aab60550000000000783788",
      "text": "  > キャプチャ元のWebサイトURL",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789616214,
      "updated": 1789616223
    },
    {
      "id": "6aab60550000000000783789",
      "text": "  > OCRスキャンされた情報",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789616214,
      "updated": 1789616223
    },
    {
      "id": "6aab6055000000000078378a",
      "text": "  > 説明・コメント",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789616214,
      "updated": 1789616223
    },
    {
      "id": "6aab6055000000000078378b",
      "text": " > エクスポートされるデータに含まれないもの",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789616214,
      "updated": 1789616214
    },
    {
      "id": "6aab6055000000000078378c",
      "text": "  > 画像をアップロードした日時",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789616214,
      "updated": 1789616227
    },
    {
      "id": "6aab60510000000000783786",
      "text": " EXIF情報は入らない？",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789616210,
      "updated": 1789616885
    },
    {
      "id": "6aab62f300000000003b45b2",
      "text": "  EXIFだから画像自体に記録されてるのかな",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789616885,
      "updated": 1789617488
    },
    {
      "id": "6aab62e800000000003b45b1",
      "text": "",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1789616873,
      "updated": 1789616873
    }
  ]
}