    {
      "id": "6a748b3d0000000000ef7916",
      "text": "code:style.css",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786022718,
      "updated": 1786022718
    },
    {
      "id": "6a748b3d0000000000ef7917",
      "text": " .line strike {\ttext-decoration: none !important;\t}",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786022718,
      "updated": 1786022718
    },
    {
      "id": "6a748b3d0000000000ef7918",
      "text": " .line .deco-\\- {",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786022718,
      "updated": 1786179664
    },
    {
      "id": "6a76f04f00000000009e9716",
      "text": " \ttext-decoration: line-through 1.5px var(--page-text-color, #444);",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786179664,
      "updated": 1786179751
    },
    {
      "id": "6a76f0f400000000009e9720",
      "text": " \t/* opacity 0.65 はガンマ補正込みで 0.8 相当 */",
