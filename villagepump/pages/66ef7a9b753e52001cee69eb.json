    },
    {
      "id": "66ef7aa05e90c0000024ec17",
      "text": "[アジャイルサムライ――達人開発者への道 | コンピュータ・一般書,プログラミング・開発,開発技法 | Ohmsha https://shop.ohmsha.co.jp/smartphone/detail.html?id=000000001901]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1726970526,
      "updated": 1788194286
    },
    {
      "id": "6a95adef0000000000e5df1b",
      "text": "",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194287,
      "updated": 1788194287
    },
    {
      "id": "6a95adf00000000000e5df1c",
      "text": "アジャイルサムライ――達人開発者への道",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194288,
      "updated": 1788194296
    },
    {
      "id": "6a95adf80000000000e5df29",
      "text": "[マスターセンセイ]と学ぶ[アジャイル開発]の道",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194296,
      "updated": 1788194396
    },
    {
      "id": "6a95adf80000000000e5df31",
      "text": "著者[Jonathan Rasmusson] 著／[西村直人]・[角谷信太郎] 監訳／[近藤修平]・[角掛拓未] 訳",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194296,
      "updated": 1788194406
    },
    {
      "id": "6a95adf80000000000e5df32",
      "text": "定価2,860 円（本体2,600 円＋税）",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194296,
      "updated": 1788194296
    },
    {
      "id": "6a95adf80000000000e5df33",
      "text": "A5　336頁　2011/07発行",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194296,
      "updated": 1788194296
    },
    {
      "id": "6a95adf80000000000e5df34",
      "text": "ISBN978-4-274-06856-0",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194296,
      "updated": 1788194296
    },
    {
      "id": "6a95ae030000000000e5df35",
      "text": "",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194307,
      "updated": 1788194307
    },
    {
      "id": "6a95ae030000000000e5df36",
      "text": "> このような方におすすめ",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194307,
      "updated": 1788194308
    },
    {
      "id": "6a95ae040000000000e5df38",
      "text": ">  アジャイル開発手法に興味のある人",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194308,
      "updated": 1788194310
    },
    {
      "id": "6a95ae040000000000e5df39",
      "text": ">  すでに現場に導入していて更に知識を深めたい人",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194308,
      "updated": 1788194311
    },
    {
      "id": "6a95ae040000000000e5df3a",
      "text": ">  チームでソフトウェア開発をしている人",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194308,
      "updated": 1788194311
    },
    {
      "id": "6a95ae040000000000e5df3b",
      "text": ">  プログラマ",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194308,
      "updated": 1788194312
    },
    {
      "id": "6a95ae040000000000e5df37",
      "text": "",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194308,
      "updated": 1788194308
    },
    {
      "id": "6a95ae120000000000e5df3c",
      "text": "> 動くソフトウェアを素早く開発するための「アジャイルソフトウェア開発手法」を、実際に導入するにはどうすればよいかを、豊富な図を使い親しみやすい言葉で解説しています。経験豊かな著者が具体的なノウハウをまとめた本書は、アジャイル開発を導入したいと考えている組織や人のための「現場のマニュアル」として役立ってくれることでしょう。",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194323,
      "updated": 1788194323
    },
    {
      "id": "6a95ae130000000000e5df3d",
      "text": "",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194323,
      "updated": 1788194323
    },
    {
      "id": "6a95ae1f0000000000e5df3e",
      "text": "> 日本の読者の皆さんへ",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae200000000000e5df40",
      "text": "> 謝辞",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae200000000000e5df41",
      "text": "> お目にかかれて光栄です",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae830000000000e5df5e",
      "text": "> ",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194436,
      "updated": 1788194436
    },
    {
      "id": "6a95ae200000000000e5df42",
      "text": "> 第I部 「[アジャイル]」入門",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194476
    },
    {
      "id": "6a95ae200000000000e5df43",
      "text": "> 第1章 ざっくりわかるアジャイル開発",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae200000000000e5df44",
      "text": "> 第2章 アジャイルチームのご紹介",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae850000000000e5df5f",
      "text": "> ",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194438,
      "updated": 1788194438
    },
    {
      "id": "6a95ae200000000000e5df45",
      "text": "> 第II部 アジャイルな方向づけ",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae200000000000e5df46",
      "text": "> 第3章 みんなをバスに乗せる",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae200000000000e5df47",
      "text": "> 第4章 全体像を捉える",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae200000000000e5df48",
      "text": "> 第5章 具現化させる",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae870000000000e5df60",
      "text": "> ",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194439,
      "updated": 1788194439
    },
    {
      "id": "6a95ae200000000000e5df49",
      "text": "> 第III部 アジャイルな計画づくり",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae200000000000e5df4a",
      "text": "> 第6章 [ユーザーストーリー]を集める",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194469
    },
    {
      "id": "6a95ae200000000000e5df4b",
      "text": "> 第7章 見積り：当てずっぽうの奥義",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae200000000000e5df4c",
      "text": "> 第8章 アジャイルな計画づくり：現実と向きあう",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194441
    },
    {
      "id": "6a95ae890000000000e5df62",
      "text": "> ",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194442,
      "updated": 1788194442
    },
    {
      "id": "6a95ae200000000000e5df4d",
      "text": "> 第IV部 アジャイルなプロジェクト運営",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae200000000000e5df4e",
      "text": "> 第9章 [イテレーション]の運営：実現させる",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194484
    },
    {
      "id": "6a95ae200000000000e5df4f",
      "text": "> 第10章 アジャイルな意思疎通の作戦",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae200000000000e5df50",
      "text": "> 第11章 現場の状況を目に見えるようにする",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae8b0000000000e5df63",
      "text": "> ",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194443,
      "updated": 1788194443
    },
    {
      "id": "6a95ae200000000000e5df51",
      "text": "> 第V部 アジャイルなプログラミング",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae200000000000e5df52",
      "text": "> 第12章 ユニットテスト：動くことがわかる",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae200000000000e5df53",
      "text": "> 第13章 リファクタリング：技術的負債の返済",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae200000000000e5df54",
      "text": "> 第14章 [テスト駆動開発]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194496
    },
    {
      "id": "6a95ae200000000000e5df55",
      "text": "> 第15章 [継続的インテグレーション]：リリースに備える",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194498
    },
    {
      "id": "6a95ae8c0000000000e5df64",
      "text": "> ",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194445,
      "updated": 1788194445
    },
    {
      "id": "6a95ae200000000000e5df56",
      "text": "> 第VI部 付録",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae200000000000e5df57",
      "text": "> 付録A アジャイルソフトウェア開発の原則",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae200000000000e5df58",
      "text": "> 付録B オンラインリソース",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae200000000000e5df59",
      "text": "> 付録C 参考資料",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae900000000000e5df65",
      "text": "> ",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194448,
      "updated": 1788194448
    },
    {
      "id": "6a95ae200000000000e5df5a",
      "text": "> 監訳者あとがき",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae200000000000e5df5b",
      "text": "> 索引",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae200000000000e5df5c",
      "text": "> 著者・監訳者・訳者について",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    },
    {
      "id": "6a95ae1f0000000000e5df3f",
      "text": "",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1788194336,
      "updated": 1788194336
    }
  ]
}