    },
    {
      "id": "6aff84541280f0000000f2397b",
      "text": "第47週: 日月火水木[[金]]土",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795130455,
      "updated": 1795130455
    },
    {
      "id": "6aff84541280f00000009e7a60",
      "text": "2026年 88.77％経過",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795130455,
      "updated": 1795130455
    },
    {
      "id": "6aff63dc0000000000159391",
      "text": "",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1795122165,
      "updated": 1795122165
    },
    {
      "id": "6aff63df0000000000159394",
      "text": "[hiro.icon]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1795122167,
      "updated": 1795122168
    },
    {
      "id": "6aff63df0000000000159395",
      "text": " [『ファイナルファンタジーDCCC（エイトハンドレット）』の朝 https://dlt.kitetu.com/KNo.F85E/555F-863D]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1795122168,
      "updated": 1795122193
    },
    {
      "id": "6aff63dd0000000000159392",
      "text": "",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1795122166,
      "updated": 1795122166
    },
    {
      "id": "6aff6c1500000000007c02b7",
      "text": "[はるひ.icon]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1795124245,
      "updated": 1795124246
    },
    {
      "id": "6aff6c1700000000007c02b8",
      "text": " [https://fondue.chat/p/fae35954/j/T3CG-7BQU フォンデュで共同日記]!!",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1795124247,
      "updated": 1795125201
    },
    {
      "id": "6aff859a00000000005d827f",
      "text": "  声出せるところあれば参加したい[takker.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795130788,
      "updated": 1795130795
    },
    {
      "id": "6aff8c3a0000000000e295c2",
      "text": "  チャットモードが間もなく生えます〜[blu3mo.icon]",
      "userId": "5d89b1f60230ae001779e113",
      "created": 1795132474,
      "updated": 1795132481
    },
    {
      "id": "6aff83fe0000000000b0a220",
      "text": " 腸管 白黒白 浮腫",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1795130366,
      "updated": 1795130376
    },
    {
      "id": "6aff840b0000000000b0a221",
      "text": "  腸炎 重積も",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1795130379,
      "updated": 1795130383
    },
    {
      "id": "6aff857e0000000000b0a222",
      "text": " 重積造影 白黒白 なら虚血ではないが 白黒の中も黒なら虚血になっており痛みも加味してオペ適だろう",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1795130760,
      "updated": 1795130789
    },
    {
      "id": "6aff812c0000000000b360ea",
      "text": "",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795129647,
      "updated": 1795129647
    },
    {
      "id": "6aff813c0000000000b360ed",
      "text": "[takker.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795129661,
      "updated": 1795129786
    },
    {
      "id": "6aff812d0000000000b360eb",
      "text": " ねむい",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795129647,
      "updated": 1795129787
    },
    {
      "id": "6aff81320000000000b360ec",
      "text": " 2時間しか寝てない",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795129652,
      "updated": 1795129789
    },
    {
      "id": "6aff81bd0000000000b360ee",
      "text": " 代々木公園で学会発表",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795129790,
      "updated": 1795129800
    },
    {
      "id": "6aff81c70000000000b360ef",
      "text": "  すーつめんどい",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795129801,
      "updated": 1795129806
    },
    {
      "id": "6aff81cd0000000000b360f0",
      "text": "  [プログラム | 第23回地盤工学会関東支部発表会 GeoKanto2026 https://onsite.gakkai-web.net/geokanto/program/]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795129806,
      "updated": 1795129891
    },
    {
      "id": "6aff81f50000000000b360f1",
      "text": "  こちらの材料1のセッションになります",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795129846,
      "updated": 1795129868
    },
    {
      "id": "6aff820e0000000000b360f2",
      "text": "  朝イチだ～",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795129871,
      "updated": 1795129884
    },
    {
      "id": "6aff8dbc00000000001694e4",
      "text": "  [加油.icon][Hiro Aki.icon]",
      "userId": "65e1289acd012200235729c0",
      "created": 1795132860,
      "updated": 1795132866
    },
    {
      "id": "6aff856800000000005d827e",
      "text": " スライド修正するの面倒になってきちゃった……",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795130731,
      "updated": 1795130744
    },
    {
      "id": "6aff63dd0000000000159393",
      "text": "",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1795122166,
      "updated": 1795122166
    },
    {
      "id": "6aff871800000000009313e5",
      "text": "[seibe.icon]",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1795131161,
      "updated": 1795131161
    },
    {
      "id": "6aff871900000000009313e7",
      "text": " アイコンなしの言明のほうが強いという仮説",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1795131162,
      "updated": 1795131171
    },
    {
      "id": "6aff872300000000009313e8",
      "text": " 　アイコンがあれば「私はそうなんですよ（他の人はしらんけど）」という意味になる",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1795131171,
      "updated": 1795131194
    },
    {
      "id": "6aff873a00000000009313e9",
      "text": " 　アイコンがないと「絶体絶命そうなんです！」って感じになる",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1795131194,
      "updated": 1795131209
    },
    {
      "id": "6aff8a5100000000005d8280",
      "text": "",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795131990,
      "updated": 1795131990
    },
    {
      "id": "6aff8a5200000000005d8281",
      "text": "",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795131990,
      "updated": 1795131990
    },
    {
      "id": "6aff8aef00000000005d8288",
      "text": "試しにアイコンなしの言明にしてみよう",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795132147,
      "updated": 1795132158
    },
    {
      "id": "6aff8a5200000000005d8282",
      "text": " スライドを修正するのはたいへんめんどう",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795131993,
      "updated": 1795132162
    },
    {
      "id": "6aff8aff00000000005d8289",
      "text": "  学会発表はこれで2回目だ",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795132163,
      "updated": 1795132181
    },
    {
      "id": "6aff8b0e00000000005d828a",
      "text": "  なんとかなれ～",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795132178,
      "updated": 1795132180
    },
    {
      "id": "6aff8a8d00000000005d8284",
      "text": " クオリアさんかわいい",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795132049,
      "updated": 1795132162
    },
    {
      "id": "6aff8b1300000000005d828b",
      "text": "どうだ、アイコンがないから誰が書いたかわかるまい！",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795132183,
      "updated": 1795132204
    },
    {
      "id": "6aff871800000000009313e6",
      "text": "",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1795131161,
      "updated": 1795131161
    },
    {
      "id": "6aff8d1300000000001694e1",
      "text": "[Hiro Aki.icon]",
      "userId": "65e1289acd012200235729c0",
      "created": 1795132691,
      "updated": 1795132691
    },
    {
      "id": "6aff8d1300000000001694e2",
      "text": "\tおはようございます",
      "userId": "65e1289acd012200235729c0",
      "created": 1795132692,
      "updated": 1795132695
    },
    {
      "id": "6aff8d1700000000001694e3",
      "text": "\t寒いし暑い（屋外は寒い、屋内は暖房効きすぎ）",
      "userId": "65e1289acd012200235729c0",
      "created": 1795132695,
      "updated": 1795132710
    },
    {
      "id": "6aff8f0b00000000001694e5",
      "text": "\t音声入力環境が無い、入力環境の用意はやろうと思えば出来るが音声入力に対する恥ずかしさがあり避けてたので[Fondue.icon]に参加出来ず申し訳ない気持ちに",
      "userId": "65e1289acd012200235729c0",
      "created": 1795133195,
      "updated": 1795133711
    },
    {
      "id": "6aff8f6e00000000001694e6",
      "text": "\t\t[フォンデュで最近の井戸端を話す (Fondue)]で共有していただきありがたい",
      "userId": "65e1289acd012200235729c0",
      "created": 1795133295,
      "updated": 1795133303
    },
    {
      "id": "6aff912200000000001694ec",
      "text": "\t\t\tつらつら書いてから思う、↓の話は該当ページに書くべきかも",
      "userId": "65e1289acd012200235729c0",
      "created": 1795133730,
      "updated": 1795133789
    },
    {
      "id": "6aff915c00000000001694ed",
      "text": "\t\t\t[fondue]の参加者ではないという感覚＆今日見た、読んだ、思ったことなので日記かなと思ってここに記述",
      "userId": "65e1289acd012200235729c0",
      "created": 1795133789,
      "updated": 1795133824
    },
    {
      "id": "6aff8f7600000000001694e7",
      "text": "\t\t井戸端を辞書のような使い方をする話が考えさせられる",
      "userId": "65e1289acd012200235729c0",
      "created": 1795133303,
      "updated": 1795133326
    },
    {
      "id": "6aff8f8e00000000001694e8",
      "text": "\t\t日記に書き込むのが基本、そこで出た固有名詞で赤リンクだと、何かしらの情報入れようと思い主に公式サイトから、次にwikipedia、それらでもいい感じなのが無いなら別サイト、そこでもないならテキトーに解説という考えの流れで解説のみのページ作ってた",
      "userId": "65e1289acd012200235729c0",
      "created": 1795133326,
      "updated": 1795133417
    },
    {
      "id": "6aff8fe900000000001694ea",
      "text": "\t\t日記を起点にして枝を出す形だから妥当な伸ばし方なのか、解説のみというのはなんか違うという扱いなのか、なんか違うという扱いであるならば、他者の邪魔をする行為は避けたい性分からするとやめた方が良いのかなと悩む",
      "userId": "65e1289acd012200235729c0",
      "created": 1795133417,
      "updated": 1795133529
    },
    {
      "id": "6aff905900000000001694eb",
      "text": "\t\t悩ましいと言っても「まぁいっか」の成分が多めなので、はっきりやめて欲しいと言われない限りは、日記起点に赤リンクな固有名詞先にテキトーなページ作成をしていきそう",
      "userId": "65e1289acd012200235729c0",
      "created": 1795133529,
      "updated": 1795133598
    },
    {
      "id": "6aff932f00000000001694ee",
      "text": "\tある作業をある部署が「うちの管轄じゃない」として他に投げたとして、だけどその作業自体は消えることはない、該当部署以外で分散して行うとなると「浅く広がる」といった雰囲気を持つがなんか表現として的確じゃない感じ",
      "userId": "65e1289acd012200235729c0",
      "created": 1795134255,
      "updated": 1795134587
    },
    {
      "id": "6aff938600000000001694ef",
      "text": "\t\t作業自体は消えないという点、ある部署で一括でやっていたのを分散させる姿から考えるイメージ",
      "userId": "65e1289acd012200235729c0",
      "created": 1795134343,
      "updated": 1795134420
    },
    {
      "id": "6aff93d300000000001694f0",
      "text": "\t\t\t元は狭い面積で十分な高さがある物体だったのが、分散なので広い面積で小さい高さの物体へ移行という感じを覚える",
      "userId": "65e1289acd012200235729c0",
      "created": 1795134420,
      "updated": 1795134445
    },
    {
      "id": "6aff93ed00000000001694f1",
      "text": "\t\t\tしかし実体としては、それぞれで分散して行うことにより部署間のやりとり回数という、付帯業務が増大するため、イメージ上の体積が増える感覚",
      "userId": "65e1289acd012200235729c0",
      "created": 1795134445,
      "updated": 1795134501
    },
    {
      "id": "6aff948e00000000001694f3",
      "text": "\t\t\t体積は作業量と見る",
      "userId": "65e1289acd012200235729c0",
      "created": 1795134606,
      "updated": 1795134629
    },
    {
      "id": "6aff942500000000001694f2",
      "text": "\t\t体積が増えるのだから、狭く高く、から広くそこそこの高さという姿になるけどなんかこういい感じの表現が思いつかないモヤっと感",
      "userId": "65e1289acd012200235729c0",
      "created": 1795134501,
      "updated": 1795134570
    },
    {
      "id": "6aff94ab00000000001694f4",
      "text": "\t\t分散して作業、というのは場合によっては非効率であると比喩的に簡潔な表現をしたいな、というのが考えの発端",
      "userId": "65e1289acd012200235729c0",
      "created": 1795134636,
      "updated": 1795134678
    },
    {
      "id": "6aff8d1200000000001694e0",
      "text": "",
      "userId": "65e1289acd012200235729c0",
      "created": 1795132690,
      "updated": 1795132690
    },
    {
      "id": "6aff84541280f00000004aa2ee",
      "text": "[2026/11/19.icon] ← 2026/11/20 → [2026/11/21.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795130455,
      "updated": 1795130455
    },
    {
      "id": "6aff84541280f00000005da197",
      "text": "[/ [2026/11.icon]]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1795130455,
      "updated": 1795130455
    }
  ]
}