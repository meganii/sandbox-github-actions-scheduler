  "lines": [
    {
      "id": "6308ac92fb7c3a002164c133",
      "text": "真ん中を数字で略すやつ",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1661512852,
      "updated": 1661512856
    },
    {
      "id": "6308ac9779d3a90000129eab",
      "text": "名前わからないですが",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1661512856,
      "updated": 1661512859
    },
    {
      "id": "6308ac9a79d3a90000129ead",
      "text": "[ヌメロニム]（[numeronym]）または[数略語]というらしい",
      "userId": "62a91a7a083437001de60035",
      "created": 1661512859,
      "updated": 1661556353
    },
    {
      "id": "6308b1315b98c20000087006",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1661514033,
      "updated": 1661514033
    },
    {
      "id": "6308ac9a79d3a90000129eae",
      "text": "table:t",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1661512859,
      "updated": 1661512861
    },
    {
      "id": "6a8ce5450000000000add9b9",
      "text": " [a16z]\tAndreessen Horowitz\t非公開のベンチャーキャピタル企業 in Menlo Park, CA, U.S.",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787618630,
      "updated": 1787618630
    },
    {
      "id": "6a8ce5510000000000add9ba",
      "text": " k8s\tKubernetes",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787618642,
      "updated": 1787618642
    },
    {
      "id": "6a8ce5550000000000add9c1",
      "text": " [K8s]\t[Kubernetes]\tオープンソースの[コンテナオーケストレーションシステム] designed by Google",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787618645,
      "updated": 1787618645
    },
    {
      "id": "6a8ce5810000000000add9c6",
      "text": " [h21u]\thatarakitakunaidegozaru\t働きたくないでござる",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787618689,
      "updated": 1787618689
    },
    {
      "id": "6308aca579d3a90000129eb1",
      "text": " [i18n]\t[Internationalization]\t国際化",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1661512870,
      "updated": 1787618595
    },
    {
      "id": "6309c649e8db320000ebd60c",
      "text": " l10n\tLocalization\t地域化",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1661584971,
      "updated": 1787618761
    },
    {
      "id": "6a8ce58a0000000000add9c9",
      "text": " n18n\t[NullPointerException]\tnull 値の参照型変数を参照しようとした時に発生する実行時エラー",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787618698,
      "updated": 1787618811
    },
    {
      "id": "6a8ce57d0000000000add9c4",
      "text": " o11y\t[Observability]\t観測可能性",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1787618686,
      "updated": 1787618841
    },
    {
      "id": "6a8cf69a0000000000de8e68",
      "text": " Sk8er Boi\tSkater Boy\t[アヴリル・ラヴィーン]の2枚目のシングル曲名",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1787623066,
      "updated": 1787623158
    },
    {
      "id": "670e60e371b3c20000c91315",
      "text": " 承19る \t承認欲求の刺激につながる機能を全て排除する",
      "userId": "661b6e882a96e9002371b3c2",
      "created": 1728995555,
      "updated": 1728995568
    },
    {
      "id": "670e60f271b3c20000c9131a",
      "text": " 金42る\t金銭的な動機、承認欲求を排除したユーザー生成コンテンツのサービスは検索エンジンを凌駕する",
      "userId": "661b6e882a96e9002371b3c2",
      "created": 1728995570,
      "updated": 1728995590
    },
    {
