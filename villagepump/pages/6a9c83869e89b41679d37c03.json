  "lines": [
    {
      "id": "6a9c83869e89b41679d37c03",
      "text": "2026/09/06",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1788642186,
      "updated": 1788642186
    },
    {
      "id": "6a9cc6f4ed60e6000000b8344d",
      "text": "第37週: [[日]]月火水木金土",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1788659445,
      "updated": 1788659445
    },
    {
      "id": "6a9cc6f4ed60e60000007d1781",
      "text": "2026年 68.22％経過",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1788659445,
      "updated": 1788659445
    },
    {
      "id": "6a9cc6f4ed60e60000000b9b37",
      "text": "",
      "userId": "6436266c7ac3c0001bed60e6",
      "created": 1788659445,
      "updated": 1788659445
    },
    {
      "id": "6a9c833000000000004f1179",
      "text": "[hiro.icon]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1788642186,
      "updated": 1788642188
    },
    {
      "id": "6a9c833300000000004f117b",
      "text": " [明鏡止水の朝 https://dlt.kitetu.com/KNo.F85E/0758-4837]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1788642188,
      "updated": 1788642204
    },
    {
      "id": "6a9c833200000000004f117a",
      "text": "",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1788642188,
      "updated": 1788642188
    },
    {
      "id": "6a9cc5f00000000000f61c5b",
      "text": "[atohs.icon]",
      "userId": "5a61856392ee03001413cde3",
      "created": 1788659184,
      "updated": 1788659187
    },
    {
      "id": "6a9cc5f20000000000f61c5d",
      "text": "　朝から[帰熊]に成功",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1788659187,
      "updated": 1788660194
    },
    {
      "id": "6a9cc5fd0000000000f61c5e",
      "text": "　\tJRの乗り換えで1時間くらい待った",
      "userId": "5a61856392ee03001413cde3",
      "created": 1788659198,
      "updated": 1788659206
    },
    {
      "id": "6a9cc6060000000000f61c5f",
      "text": "　\tそんなに電車が来ないとは思わなかった",
      "userId": "5a61856392ee03001413cde3",
      "created": 1788659206,
      "updated": 1788659211
    },
    {
      "id": "6a9cc60a0000000000f61c60",
      "text": "　\t適当に電車に乗りすぎ",
      "userId": "5a61856392ee03001413cde3",
      "created": 1788659211,
      "updated": 1788659218
    },
    {
      "id": "6a9cc9930000000000b5f8d0",
      "text": "　肌寒い日となっており、さすがに半袖半ズボンは馬鹿みたいなのではないかという気持ちになってきた",
      "userId": "5a61856392ee03001413cde3",
      "created": 1788660116,
      "updated": 1788660141
    },
    {
      "id": "6a9cc9ac0000000000b5f8d1",
      "text": "　\t下に長いズボンを履くか",
      "userId": "5a61856392ee03001413cde3",
      "created": 1788660141,
      "updated": 1788660148
    },
    {
      "id": "6a9cc9b40000000000b5f8d2",
      "text": "　",
      "userId": "5a61856392ee03001413cde3",
      "created": 1788660148,
      "updated": 1788660148
    },
    {
      "id": "6a9cc9c60000000000ea39d4",
      "text": "",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1788660166,
      "updated": 1788660166
    },
    {
      "id": "6a9cc9c60000000000ea39d5",
      "text": "[terang.icon]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1788660167,
      "updated": 1788660167
    },
    {
      "id": "6a9cc9c70000000000ea39d6",
      "text": "\t日曜日。",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1788660168,
      "updated": 1788660846
    },
    {
      "id": "6a9cd76c000000000037a835",
      "text": "\t👀[https://anond.hatelabo.jp/20260905121833 「〜る化」はもうやめてくれ]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1788663661,
      "updated": 1788663665
    },
    {
      "id": "6a9cd770000000000037a836",
      "text": "\t\tそんなんあるん化",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1788663665,
      "updated": 1788663667
    },
    {
      "id": "6a9d4dba00000000000a9a7f",
      "text": "\t慮るは“おもんぱかる”と読むのが正しいのだと初めて知った",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1788693946,
      "updated": 1788702127
    },
    {
      "id": "6a9d4dd000000000000a9a80",
      "text": "\t\t“おもんばかる”とこれまで読んでた",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1788693968,
      "updated": 1788693994
    },
    {
      "id": "6a9ccc7100000000005ea805",
      "text": "",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1788660850,
      "updated": 1788660850
    },
    {
      "id": "6a9ccc7100000000005ea806",
      "text": "[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1788660850,
      "updated": 1788660852
    },
    {
      "id": "6a9ccc7500000000005ea807",
      "text": " 雨の日。",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1788660853,
      "updated": 1788660861
    },
    {
      "id": "6a9cd13b00000000006cd020",
      "text": "",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1788662076,
      "updated": 1788662076
    },
    {
      "id": "6a9cd13b00000000006cd021",
      "text": "[はるひ.icon]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1788662076,
      "updated": 1788662078
    },
    {
      "id": "6a9cd13e00000000006cd022",
      "text": " 井戸端に入店",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1788662078,
      "updated": 1788662092
    },
    {
      "id": "6a9cd18600000000006cd023",
      "text": " 本家サラダボウル初めて食べた うま",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1788662150,
      "updated": 1788662168
    },
    {
      "id": "6a9cd1d400000000006cd024",
      "text": " 彼女いない歴2026年9月6日か。",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1788662233,
      "updated": 1788662243
    },
    {
      "id": "6a9d451600000000000b4732",
      "text": " 　処刑されてから3日後に生き返ったエピソードがありそう。立川に住んでそう。ブッダと仲良さそう[Nrem.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788691735,
      "updated": 1788691985
    },
    {
      "id": "6a9cd40c00000000006cd025",
      "text": " ぎりぎり冷房いらないかもしれない",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1788662796,
      "updated": 1788662802
    },
    {
      "id": "6a9d2f45000000000044857c",
      "text": " [https://www.youtube.com/shorts/MvAUiGjUMyU?si=WZYe_ckMGdhCgllf]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1788686150,
      "updated": 1788686150
    },
    {
      "id": "6a9cd17100000000008e0f94",
      "text": "",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1788662132,
      "updated": 1788662132
    },
    {
      "id": "6a9cd17100000000008e0f95",
      "text": "[takker.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1788662132,
      "updated": 1788662133
    },
    {
      "id": "6a9cd17200000000008e0f96",
      "text": "　井戸水を飲む",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1788662133,
      "updated": 1788662142
    },
    {
      "id": "6a9cd3f700000000002073ce",
      "text": "",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1788662774,
      "updated": 1788662775
    },
    {
      "id": "6a9cd3f800000000002073cf",
      "text": "[taktamur.icon]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1788662775,
      "updated": 1788662777
    },
    {
      "id": "6a9cd3fa00000000002073d0",
      "text": " 雨日",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1788662777,
      "updated": 1788662787
    },
    {
      "id": "6a9cd40400000000002073d1",
      "text": "  一気に寒くなったなぁ",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1788662787,
      "updated": 1788662788
    },
    {
      "id": "6a9cd40700000000002073d2",
      "text": "　　　9月前半らしくない気象。ありがたいけども[joniel.icon]",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788662790,
      "updated": 1788663178
    },
    {
      "id": "6a9d3e3000000000002073d4",
      "text": "　今の生成AI界隈は、ペース速すぎて半年遅れのキャッチアップぐらいでちょうどいいかもと感じてる",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1788689968,
      "updated": 1788690176
    },
    {
      "id": "6a9d3eb900000000002073d7",
      "text": "　 半年に1回、それぞれのモデルやアプリを触って、今はこうなのかーって感じるぐらいのペース",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1788690106,
      "updated": 1788690143
    },
    {
      "id": "6a9d3e5100000000002073d5",
      "text": "　そんな中でも、ChatGPTの新しいモデルはまたちょっと違った流れっぽくて、興味が湧いてる",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1788690002,
      "updated": 1788690064
    },
    {
      "id": "6a9d3e9000000000002073d6",
      "text": "　 賢さというよりも、デモムービーが音声指示でやってるのを見て「おっ？」となった。",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1788690064,
      "updated": 1788690088
    },
    {
      "id": "6a9cd56b00000000001523e7",
      "text": "",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788663149,
      "updated": 1788663149
    },
    {
      "id": "6a9cd53000000000001523e3",
      "text": "[joniel.icon]",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788663089,
      "updated": 1788663096
    },
    {
      "id": "6a9cd53700000000001523e5",
      "text": " 久々に二度寝したらなんか全回復した",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788663097,
      "updated": 1788663119
    },
    {
      "id": "6a9cd54e00000000001523e6",
      "text": " 　ここまでちゃんと休めたの本当に久しぶり。気温が丁度いいから？",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788663119,
      "updated": 1788663201
    },
    {
      "id": "6a9cd53100000000001523e4",
      "text": "  別解：機能の作業経験値が適切に還元された",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788663090,
      "updated": 1788663305
    },
    {
      "id": "6a9cc5f20000000000f61c5c",
      "text": "",
      "userId": "5a61856392ee03001413cde3",
      "created": 1788659187,
      "updated": 1788659187
    },
    {
      "id": "6a9cd8b60000000000affaaa",
      "text": "[Hyou.icon]",
      "userId": "657c19a3646988002500645a",
      "created": 1788663991,
      "updated": 1788663993
    },
    {
      "id": "6a9cd8b60000000000affaab",
      "text": "　カフェインがほしい",
      "userId": "657c19a3646988002500645a",
      "created": 1788663991,
      "updated": 1788664013
    },
    {
      "id": "6a9cd8ce0000000000affaad",
      "text": "　\tカフェインがなければ、行動ができない。",
      "userId": "657c19a3646988002500645a",
      "created": 1788664014,
      "updated": 1788664033
    },
    {
      "id": "6a9cd8e30000000000affaae",
      "text": "　\tしかし、今日は摂らないのだ、そういう日だ。",
      "userId": "657c19a3646988002500645a",
      "created": 1788664036,
      "updated": 1788664067
    },
    {
      "id": "6a9cdefc00000000006d4b5a",
      "text": "　\t完全に取らないのは厳しいならば量が少ない何かを摂取はどうか[Hiro Aki.icon]",
      "userId": "65e1289acd012200235729c0",
      "created": 1788665597,
      "updated": 1788665644
    },
    {
      "id": "6a9cdf2b00000000006d4b5b",
      "text": "　\t\tと思ってテキトーに探すとココアが該当。急激に気温が減って内蔵が冷やされているので丁度いいのかもしれない",
      "userId": "65e1289acd012200235729c0",
      "created": 1788665644,
      "updated": 1788665667
    },
    {
      "id": "6a9d48d70000000000769755",
      "text": "\t雨がすごいらしい、こわい",
      "userId": "657c19a3646988002500645a",
      "created": 1788692695,
      "updated": 1788693030
    },
    {
      "id": "6a9d49d90000000000769756",
      "text": "",
      "userId": "657c19a3646988002500645a",
      "created": 1788692953,
      "updated": 1788692953
    },
    {
      "id": "6a9d14180000000000f78a4d",
      "text": "[nishio.icon]",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788679192,
      "updated": 1788679192
    },
    {
      "id": "6a9d14180000000000f78a4e",
      "text": "\thttps://x.com/Dstudio_ai/status/2096475126942560677",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788679193,
      "updated": 1788679195
    },
    {
      "id": "6a9d141b0000000000f78a4f",
      "text": "\t[Tripo]と[Astra]を使うとこんなことができるの？！忙しくて全然キャッチアップできてない",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788679196,
      "updated": 1788679229
    },
    {
      "id": "6a9d143e0000000000f78a50",
      "text": "\t\t名前だけは何度か聞いて気になっている",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788679230,
      "updated": 1788679243
    },
    {
      "id": "6a9d161a0000000000f78a52",
      "text": "\tまずTripoというものについて調べる",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788679707,
      "updated": 1788679715
    },
    {
      "id": "6a9d16290000000000f78a53",
      "text": "\t\t[/work4ai/Tripo] まだからっぽだった",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788679721,
      "updated": 1788679755
    },
    {
      "id": "6a9d20420000000000f78a54",
      "text": "\tAstraが3Dモデリングの作業を始めた",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788682306,
      "updated": 1788692326
    },
    {
      "id": "6a9d5e6f0000000000f78a58",
      "text": "\t\tなんでそれでいいと思うんだ",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788698223,
      "updated": 1788698233
    },
    {
      "id": "6a9d5e780000000000f78a59",
      "text": "\t\t\t[https://gyazo.com/d8d3b8926faa9179a6cb7b9445b7f2fa]",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788698233,
      "updated": 1788698235
    },
    {
      "id": "6a9d6ca40000000000f78a5b",
      "text": "\t\t\tもっと頑張れよと言い続けるだけで一応近づいていく",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788701861,
      "updated": 1788701876
    },
    {
      "id": "6a9d6cb40000000000f78a5c",
      "text": "\t\t\t\t[https://gyazo.com/a0ad6da43461126e453e68519c601de0]",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788701876,
      "updated": 1788701882
    },
    {
      "id": "6a9d6cba0000000000f78a5e",
      "text": "\t\t\t\t[https://gyazo.com/bf76e3390a5937eaeb202af0dee48ab5]",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788701883,
      "updated": 1788701906
    },
    {
      "id": "6a9d6cf20000000000f78a60",
      "text": "\t\t飽きたので終了",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788701938,
      "updated": 1788701946
    },
    {
      "id": "6a9d6cf90000000000f78a61",
      "text": "\t\t\tSNSにいる超絶クオリティの人はどうやってるんだろうな",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788701946,
      "updated": 1788701967
    },
    {
      "id": "6a9d6d0f0000000000f78a62",
      "text": "\t\t\t結局AIが何かのスキルを代替したとしても別のスキルが必要になる",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788701967,
      "updated": 1788701987
    },
    {
      "id": "6a9d6f400000000000f78a63",
      "text": "\t\t\t[https://gyazo.com/9fd04a62bfdfaedb97c196f75eaf9e19]",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788702529,
      "updated": 1788702530
    },
    {
      "id": "6a9d6f420000000000f78a64",
      "text": "\t\t\t\t1: 理想に近い位置にいるBさんと離れたところにいるAさんたちがいる",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788702530,
      "updated": 1788702558
    },
    {
      "id": "6a9d6f5f0000000000f78a65",
      "text": "\t\t\t\t\t例えば描きたいものを描けるのが理想とすると、絵の上手い人と下手な人となる",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788702559,
      "updated": 1788702587
    },
    {
      "id": "6a9d6f7a0000000000f78a66",
      "text": "\t\t\t\t2: AIによってAさんがBさんの位置に移動できる！となる",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788702587,
      "updated": 1788702602
    },
    {
      "id": "6a9d6f8a0000000000f78a67",
      "text": "\t\t\t\t\t誰でも絵が上手になるということ",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788702602,
      "updated": 1788702610
    },
    {
      "id": "6a9d6f920000000000f78a68",
      "text": "\t\t\t\t3: その世界ではAさんたちが移動して、Bさんもまた移動している",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788702610,
      "updated": 1788702647
    },
    {
      "id": "6a9d6fb90000000000f78a6a",
      "text": "\t\t\t\t\t(1)の段階でAさんたちから離れて理想に近づいてたBさんってのは生まれつき理想に近かったんではなくて理想に近づく努力をしたからなんだよね",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788702650,
      "updated": 1788702689
    },
    {
      "id": "6a9d6fe20000000000f78a6b",
      "text": "\t\t\t\t\tなのでそれが必要なくなった世界では、新しいスタートから理想に向けて近づいている",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788702690,
      "updated": 1788702714
    },
    {
      "id": "6a9d6ffa0000000000f78a6c",
      "text": "\t\t\t\t4: なのでこの新しい世界をよくみてみると、実は(1)の世界とあんまり変わっていない",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788702714,
      "updated": 1788702737
    },
    {
      "id": "6a9d6faf0000000000f78a69",
      "text": "",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788702639,
      "updated": 1788702739
    },
    {
      "id": "6a9d47670000000000f78a56",
      "text": "\t水曜の講演の準備がまだなのでClaude Codeに「資料を作らなきゃ」と言ったら、タスク管理とかアイデア出しをしてもらうだけのつもりだったのにArtifactsでスライドが出来上がってしまった、そうじゃない",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788692328,
      "updated": 1788701938
    },
    {
      "id": "6a9d47a20000000000f78a57",
      "text": "\t\t人間の仕事を奪っていく",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788692387,
      "updated": 1788692393
    },
    {
      "id": "6a9d47560000000000f78a55",
      "text": "",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788692311,
      "updated": 1788692311
    },
    {
      "id": "6a9d215d0000000000754546",
      "text": "[inajob.icon]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1788682590,
      "updated": 1788682592
    },
    {
      "id": "6a9d215f0000000000754548",
      "text": " [Maker Faire Tokyo]行ってきた with 6歳の娘",
      "userId": "582e63d27c56960011aff09e",
      "created": 1788682592,
      "updated": 1788684150
    },
    {
      "id": "6a9d21780000000000754549",
      "text": "  基本は娘の気の向くままなので、あまり細かくは見て回れず",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1788682617,
      "updated": 1788682646
    },
    {
      "id": "6a9d2196000000000075454a",
      "text": "  知人には一通り挨拶できたかな",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1788682647,
      "updated": 1788682661
    },
    {
      "id": "6a9d21d7000000000075454b",
      "text": "  インターネットでの知り合いと会えた上に娘を交代で見るなどを提案してもらい、助かった",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1788682712,
      "updated": 1788682741
    },
    {
      "id": "6a9d2222000000000075454c",
      "text": "   誰に自分の娘を任せてよいかは難しい問題かも",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1788682787,
      "updated": 1788682813
    },
    {
      "id": "6a9d2242000000000075454e",
      "text": "   基本うちの娘が人見知りしないので、必要なら親側でフィルターする必要がある",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1788682819,
      "updated": 1788682850
    },
    {
      "id": "6a9d2222000000000075454d",
      "text": "",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1788682787,
      "updated": 1788682787
    },
    {
      "id": "6a9d255300000000002690c0",
      "text": "[Hiro Aki.icon]",
      "userId": "65e1289acd012200235729c0",
      "created": 1788683605,
      "updated": 1788683605
    },
    {
      "id": "6a9d255400000000002690c1",
      "text": "\t[Stable Diffusion web UI(AUTOMATIC111版)]で遊んでたけど[Stability Matrix]経由のForge Neoへ引っ越し",
      "userId": "65e1289acd012200235729c0",
      "created": 1788683606,
      "updated": 1788684205
    },
    {
      "id": "6a9d26a600000000002690c8",
      "text": "\t\tなんて表現すればいいのかぜんぜんわからん",
      "userId": "65e1289acd012200235729c0",
      "created": 1788683944,
      "updated": 1788683950
    },
    {
      "id": "6a9d276f00000000002690c9",
      "text": "\t\t\t正式名称はこっちっぽいから変更しとこう",
      "userId": "65e1289acd012200235729c0",
      "created": 1788684145,
      "updated": 1788684154
    },
    {
      "id": "6a9d277a00000000002690ca",
      "text": "\t\t\t[Stable Diffusion WebUI Forge - Neo]",
      "userId": "65e1289acd012200235729c0",
      "created": 1788684155,
      "updated": 1788684157
    },
    {
      "id": "6a9d258c00000000002690c2",
      "text": "\t\tanima系列のモデルを触ってみたいと思ったのが発端",
      "userId": "65e1289acd012200235729c0",
      "created": 1788683662,
      "updated": 1788683676
    },
    {
      "id": "6a9d259a00000000002690c3",
      "text": "\t\t触ってみたけどプロンプトの指示通りに、バチクソ真面目に生成してくれてすごいなという感想",
      "userId": "65e1289acd012200235729c0",
      "created": 1788683676,
      "updated": 1788683900
    },
    {
      "id": "6a9d25d300000000002690c4",
      "text": "\t\t良いことのはずだけど、個人の好みとしてはSDXL系列のガチャ画像の方になるかもしれない",
      "userId": "65e1289acd012200235729c0",
      "created": 1788683733,
      "updated": 1788683748
    },
    {
      "id": "6a9d25e200000000002690c5",
      "text": "\t\tまだ使えていない、良さげな使い方を見つけていない、誰かの使い方を知れていないだけかもしれない",
      "userId": "65e1289acd012200235729c0",
      "created": 1788683748,
      "updated": 1788683774
    },
    {
      "id": "6a9d261b00000000002690c6",
      "text": "\t\tSDXL系列のも扱えるから何も問題ないな、と思ったらForge Neoの方はweb UIを表示しているブラウザのタブをアクティブにしておかないと処理を回してくれないように思える",
      "userId": "65e1289acd012200235729c0",
      "created": 1788683804,
      "updated": 1788683856
    },
    {
      "id": "6a9d264f00000000002690c7",
      "text": "\t\t設定で調整出来そうな気がするが深刻じゃないしまぁいっかという雑な扱い中",
      "userId": "65e1289acd012200235729c0",
      "created": 1788683856,
      "updated": 1788683883
    },
    {
      "id": "6a9d255300000000002690bf",
      "text": "",
      "userId": "65e1289acd012200235729c0",
      "created": 1788683604,
      "updated": 1788683604
    },
    {
      "id": "6a9d380e000000000055b97b",
      "text": "[seibe.icon]",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1788688399,
      "updated": 1788688400
    },
    {
      "id": "6a9d380f000000000055b97d",
      "text": " 豪雨やばそう",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1788688400,
      "updated": 1788688402
    },
    {
      "id": "6a9d3a000000000000781bbc",
      "text": " \t飲食店でカツ丼食べてたら[瞬停]くらってびっくりするなどした[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1788688898,
      "updated": 1788688914
    },
    {
      "id": "6a9d39180000000000781bb5",
      "text": "",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1788688668,
      "updated": 1788688668
    },
    {
      "id": "6a9d39190000000000781bb6",
      "text": "[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1788688668,
      "updated": 1788688668
    },
    {
      "id": "6a9d39190000000000781bb7",
      "text": "\t[Astra気になるので調べてた https://gist.github.com/stakiran/e558c5826d656ae2f3356e88b7980fc3]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1788688668,
      "updated": 1788688806
    },
    {
      "id": "6a9d391e0000000000781bb8",
      "text": "\t\tサイバー攻撃が強いだけじゃなくて、画面操作も強いらしい",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1788688671,
      "updated": 1788688685
    },
    {
      "id": "6a9d392c0000000000781bb9",
      "text": "\t\t\tLive 2Dつくるソフト？みたいな複雑なGUIの操作もできるレベルなんだとか",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1788688685,
      "updated": 1788688700
    },
    {
      "id": "6a9d393b0000000000781bba",
      "text": "\t\t個人レベルでもGUIフォーム要するような操作をガンガン任せられそうだが、Proなのでお高いぜ",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1788688701,
      "updated": 1788688728
    },
    {
      "id": "6a9d395d0000000000781bbb",
      "text": "\t\tSIerに蔓延る泥臭い仕事を撲滅してくれぃ",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1788688734,
      "updated": 1788688756
    },
    {
      "id": "6a9d380e000000000055b97c",
      "text": "",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1788688399,
      "updated": 1788688399
    },
    {
      "id": "6a9d462e00000000000b4733",
      "text": "[Nrem.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788692015,
      "updated": 1788692019
    },
    {
      "id": "6a9d463300000000000b4735",
      "text": "　令和の秋消失バグ",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788692020,
      "updated": 1788692032
    },
    {
      "id": "6a9d4e420000000000ebe2b4",
      "text": "",
