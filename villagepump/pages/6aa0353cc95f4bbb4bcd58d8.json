      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788948457,
      "updated": 1788950408
    },
    {
      "id": "6aa12ffe0000000000f9812c",
      "text": " 　急激に気圧が上がってきており復活してきた",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788948476,
      "updated": 1788948487
    },
    {
      "id": "6aa130080000000000f9812d",
      "text": " 　今日はサボるけど",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788948487,
      "updated": 1788948492
    },
    {
      "id": "6aa121a100000000005eec34",
      "text": " ニンダイを見た",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788944801,
      "updated": 1788967265
    },
    {
      "id": "6aa1795a000000000069c803",
