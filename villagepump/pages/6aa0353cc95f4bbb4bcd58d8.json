      "created": 1788948457,
      "updated": 1788948457
    },
    {
      "id": "6aa12feb0000000000f9812a",
      "text": "[joniel.icon]",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788948457,
      "updated": 1788948464
    },
    {
      "id": "6aa12feb0000000000f9812b",
