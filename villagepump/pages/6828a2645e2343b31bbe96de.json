    {
      "id": "6828a2645e2343b31bbe96de",
      "text": "ポケットモンスター Let's Go! ピカチュウ・Let's Go! イーブイ",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1747493481,
      "updated": 1747493481
    },
    {
      "id": "6abb1af700000000005d7131",
      "text": "[https://youtu.be/JWhNT8cGTiM?si=zelsvv-uIaAwbo0-]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790647032,
      "updated": 1790647034
    },
    {
      "id": "6abb1af900000000005d7132",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1790647034,
      "updated": 1790647034
    },
    {
      "id": "6828a26900000000009f3cd7",
      "text": "[トップページ｜『ポケットモンスター Let’s Go! ピカチュウ』『ポケットモンスター Let’s Go! イーブイ』公式サイト https://www.pokemon.co.jp/ex/pika_vee/]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1747493481,
      "updated": 1747493481
    },
    {
      "id": "6828a26900000000009f3cd8",
      "text": "\t[ポケットモンスター ピカチュウ]がベース",
      "userId": "660605441655f300254ac7c2",
      "created": 1747493481,
      "updated": 1790644535
    },
    {
      "id": "6abb113c0000000000ee7a5e",
      "text": "\t[FRLG]で追加された要素（[ナナシマ]・[三犬]入手イベント等）は一切ない",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644541,
      "updated": 1790645460
    },
    {
      "id": "6abb15c80000000000ee7a73",
      "text": "\t\t[カントー地方]以外のポケモンは出現しない",
      "userId": "660605441655f300254ac7c2",
      "created": 1790645705,
      "updated": 1790645726
    },
    {
      "id": "6abb15e10000000000ee7a78",
      "text": "\t\t\t一部の[リージョンフォーム]のポケモンは特定のトレーナーと交換することで入手可能",
      "userId": "660605441655f300254ac7c2",
      "created": 1790645730,
      "updated": 1790645769
    },
    {
      "id": "6abb151c0000000000ee7a6f",
      "text": "\tポケモンを捕まえることがメイン",
      "userId": "660605441655f300254ac7c2",
      "created": 1790645532,
      "updated": 1790645555
    },
    {
      "id": "6abb13500000000000ee7a66",
      "text": "\t\t野生のポケモンと戦闘はしない",
      "userId": "660605441655f300254ac7c2",
      "created": 1790645073,
      "updated": 1790645555
    },
    {
      "id": "6abb13640000000000ee7a67",
      "text": "\t\t\t[ポケモンGO]と同じシステムが導入されている",
      "userId": "660605441655f300254ac7c2",
      "created": 1790645093,
      "updated": 1790645556
    },
    {
      "id": "6abb141a0000000000ee7a6a",
      "text": "\t\t\t[三鳥]と[ミュウツー]は戦闘が発生",
      "userId": "660605441655f300254ac7c2",
      "created": 1790645275,
      "updated": 1790645557
    },
    {
      "id": "6abb15380000000000ee7a70",
      "text": "\t\tポケモンを捕まえることで強化アイテム（[アメ]）および経験値が入手できる",
      "userId": "660605441655f300254ac7c2",
      "created": 1790645561,
      "updated": 1790645606
    },
    {
      "id": "6abb15720000000000ee7a71",
      "text": "\tパートナーの[ピカチュウ]と[イーブイ]にいろんなタイプの強い専用技を覚えさせられる",
      "userId": "660605441655f300254ac7c2",
      "created": 1790645619,
      "updated": 1790645791
    },
    {
      "id": "6abb15a50000000000ee7a72",
      "text": "\t\t上記より難易度は他の作品と比べて低い",
      "userId": "660605441655f300254ac7c2",
      "created": 1790645670,
      "updated": 1790645694
    },
    {
      "id": "6abb11360000000000ee7a5d",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1790644535,
      "updated": 1790644535
    },
    {
      "id": "6abb13dc0000000000ee7a68",
      "text": "[ピカブイ]",
      "userId": "660605441655f300254ac7c2",
      "created": 1790645213,
      "updated": 1790645217
    },
    {
      "id": "6828bc89000000000061ca41",
      "text": "[ポケモン]",
      "userId": "65d0d54ba4356b00242d00f4",
      "created": 1747500169,
      "updated": 1747500172
    },
    {
      "id": "6828bc8c000000000061ca42",
