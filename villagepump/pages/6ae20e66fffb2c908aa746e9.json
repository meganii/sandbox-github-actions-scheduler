      "userId": "58a90dd3ee5de7001150db17",
      "created": 1793259950,
      "updated": 1793259953
    },
    {
      "id": "6ae2f9b300000000003e2ab3",
      "text": " [「日本人は集団主義的」という通説は誤り]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1793259955,
      "updated": 1793259958
    },
    {
      "id": "6ae31fcc0000000000e08721",
