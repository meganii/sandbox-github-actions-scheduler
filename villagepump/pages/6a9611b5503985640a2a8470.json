{
  "id": "6a9611b5503985640a2a8470",
  "title": "言いたくない",
  "created": 1788219832,
  "updated": 1788220106,
  "lines": [
    {
      "id": "6a9611b5503985640a2a8470",
      "text": "言いたくない",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788219832,
      "updated": 1788219832
    },
    {
      "id": "6a9611c60000000000cc6b18",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788219847,
      "updated": 1788219847
    },
    {
      "id": "6a9611c60000000000cc6b19",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788219847,
      "updated": 1788219847
    },
    {
      "id": "6a9612510000000000cc6b24",
      "text": "[bg.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788219987,
      "updated": 1788220005
    },
    {
      "id": "6a9612630000000000cc6b25",
      "text": "編集用。光る言葉リンクの表記揺れが多すぎるのであとで整理する",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788220005,
      "updated": 1788220070
    },
    {
      "id": "6a9611c60000000000cc6b1a",
      "text": "[言ってない]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788219847,
      "updated": 1788219907
    },
    {
      "id": "6a9612060000000000cc6b1d",
      "text": "[言葉にできない]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788219912,
      "updated": 1788219922
    },
    {
      "id": "6a9612320000000000cc6b20",
      "text": "[言語化できない意見]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788219955,
      "updated": 1788219967
    },
    {
      "id": "6a9612110000000000cc6b1e",
      "text": "[うまく言葉にできない]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788219923,
      "updated": 1788219940
    },
    {
      "id": "6a9612b20000000000cc6b28",
      "text": "[その人がされて嫌なことをその人にしない]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788220084,
      "updated": 1788220100
    },
    {
      "id": "6a9612c30000000000cc6b29",
      "text": "[自分がやられて嫌なことは他人にしない]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788220101,
      "updated": 1788220106
    },
    {
      "id": "6a9612240000000000cc6b1f",
      "text": "[言語化できない]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788219941,
      "updated": 1788219948
    },
    {
      "id": "6a96123f0000000000cc6b21",
      "text": "[まだ言語化しなくてよい]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788219969,
      "updated": 1788219976
    },
    {
      "id": "6a9612480000000000cc6b22",
      "text": "[言語化している途中で返信される]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788219977,
      "updated": 1788219984
    },
    {
      "id": "6a96124f0000000000cc6b23",
      "text": "[言語化しないでほしい]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788219985,
      "updated": 1788220023
    },
    {
      "id": "6a9612770000000000cc6b26",
      "text": "[下手に言語化しない]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788220024,
      "updated": 1788220030
    },
    {
      "id": "6a96127f0000000000cc6b27",
      "text": "[感覚は言語化しないと未来に持ち越せない]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788220032,
      "updated": 1788220040
    },
    {
      "id": "6a9611c60000000000cc6b1b",
      "text": "[人に言えないことを相談する手法]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788219847,
      "updated": 1788219903
    },
    {
      "id": "6a9611be0000000000cc6b17",
      "text": "[誰にも言えない]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788219839,
      "updated": 1788219896
    },
    {
      "id": "6a9611c70000000000cc6b1c",
      "text": "[使いたくない表現]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788219848,
      "updated": 1788219848
    },
    {
      "id": "6a9611ba0000000000cc6b16",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1788219835,
      "updated": 1788219835
    }
  ]
}