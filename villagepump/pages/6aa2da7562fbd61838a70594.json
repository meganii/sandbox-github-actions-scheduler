{
  "id": "6aa2da7562fbd61838a70594",
  "title": "ダーツ日記",
  "created": 1789057669,
  "updated": 1789218894,
  "lines": [
    {
      "id": "6aa2da7562fbd61838a70594",
      "text": "ダーツ日記",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789057669,
      "updated": 1789057669
    },
    {
      "id": "6aa2da850000000000a956a8",
      "text": "とりあえず[wogikaze.icon]がデカい題で占有しちゃえ",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789057669,
      "updated": 1789057725
    },
    {
      "id": "6aa2dabd0000000000a956aa",
      "text": "　他の人が来たら分ける",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789057725,
      "updated": 1789057725
    },
    {
      "id": "6aa2dbc10000000000a956b7",
      "text": "　[ダーツ]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1789057985,
      "updated": 1789202373
    },
    {
      "id": "6aa2dbcc0000000000a956b8",
      "text": "　　①ダーツというゲーム",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789057997,
      "updated": 1789058007
    },
    {
      "id": "6aa2dbcd0000000000a956b9",
      "text": "　　②ダーツというゲームで使う的[ダーツ.icon]",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789057997,
      "updated": 1789058028
    },
    {
      "id": "6aa2dbdc0000000000a956ba",
      "text": "　　③ダーツというゲームで使う矢",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789058012,
      "updated": 1789058019
    },
    {
      "id": "6aa2de0f0000000000a956c5",
      "text": "",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789058575,
      "updated": 1789058575
    },
    {
      "id": "6aa2dc250000000000a956bc",
      "text": "2026/9",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789058085,
      "updated": 1789058434
    },
    {
      "id": "6aa2df510000000000a956d0",
      "text": " max 537",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789058897,
      "updated": 1789059041
    },
    {
      "id": "6aa2e11d0000000000232317",
      "text": " 家投げ環境を作りたいような気もする[wogikaze.icon]",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789059358,
      "updated": 1789059386
    },
    {
      "id": "6aa2e13a0000000000232319",
      "text": " 　対戦機能ありの静音な[DARTSLIVE Home Pro]が45,000円ぐらい",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789059386,
      "updated": 1789059794
    },
    {
      "id": "6aa2e15a000000000023231a",
      "text": " 　対戦機能なしなら[DARTSLIVE ZERO]が10,000円ぐらい",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789059418,
      "updated": 1789059792
    },
    {
      "id": "6aa2f4bc000000000057ac37",
      "text": " 　 ほ、ほしい[はるひ.icon]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1789064381,
      "updated": 1789064384
    },
    {
      "id": "6aa2dd820000000000a956c0",
      "text": "2026/8",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789058435,
      "updated": 1789058436
    },
    {
      "id": "6aa2defd0000000000a956cd",
      "text": "　LOW TONがそこそこ出るように",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789058814,
      "updated": 1789218894
    },
    {
      "id": "6aa2ddb30000000000a956c3",
      "text": " 初HIGH TON[wogikaze.icon]",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789058485,
      "updated": 1789058492
    },
    {
      "id": "6aa2dbb70000000000a956b6",
      "text": "2026/7",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789057976,
      "updated": 1789058417
    },
    {
      "id": "6aa2debb0000000000a956c7",
      "text": "　ちびちびブルに入るように",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789058747,
      "updated": 1789058802
    },
    {
      "id": "6aa2df230000000000a956cf",
      "text": "　　avg 400",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789058851,
      "updated": 1789059024
    },
    {
      "id": "6aa2dd940000000000a956c2",
      "text": " 初ハットトリック[wogikaze.icon]",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789058452,
      "updated": 1789058457
    },
    {
      "id": "6aa2dedb0000000000a956c9",
      "text": " 　やる日は毎日出したい",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789058779,
      "updated": 1789058796
    },
    {
      "id": "6aa2de180000000000a956c6",
      "text": " マイダーツ購入",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789058585,
      "updated": 1789058756
    },
    {
      "id": "6aa2dec30000000000a956c8",
      "text": " 　選び方なんもわからんので[タングステン]の安いやつを",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789058756,
      "updated": 1789058777
    },
    {
      "id": "6aa2dd1a0000000000a956bd",
      "text": "2026/5",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789058331,
      "updated": 1789058339
    },
    {
      "id": "6aa2dd230000000000a956be",
      "text": " [DARTSLIVE]アプリでアカウント作成",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789058339,
      "updated": 1789058363
    },
    {
      "id": "6aa2dd3c0000000000a956bf",
      "text": " 　レートが出た: 3.01",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789058364,
      "updated": 1789058403
    },
    {
      "id": "6aa2dadf0000000000a956ab",
      "text": "2026/4/11",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789057760,
      "updated": 1789057763
    },
    {
      "id": "6aa2dae30000000000a956ad",
      "text": " ルールを知ったうえでダーツ初体験",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789057763,
      "updated": 1789057827
    },
    {
      "id": "6aa2db240000000000a956b1",
      "text": " むずかしい",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789057828,
      "updated": 1789057837
    },
    {
      "id": "6aa2db2c0000000000a956b2",
      "text": " 　自他共に認める[ノーコン]なので初めは的に当たらなかった",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789057838,
      "updated": 1789057945
    },
    {
      "id": "6aa2db4b0000000000a956b3",
      "text": " 　的の近くに画面があり、壁にもぶつけるのが怖い",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789057868,
      "updated": 1789057958
    },
    {
      "id": "6aa2db670000000000a956b4",
      "text": " 　　(ソフトダーツなら)先はプラスチックなので普通に投げる分には壁を破壊したりしないので気にしないでいいらしい",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789057896,
      "updated": 1789057931
    },
    {
      "id": "6aa2dadf0000000000a956ac",
      "text": "",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789057760,
      "updated": 1789057760
    },
    {
      "id": "6aa2dae90000000000a956ae",
      "text": "それ以前の経験",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789057770,
      "updated": 1789057800
    },
    {
      "id": "6aa2db070000000000a956b0",
      "text": "　2024年以前にルールも知らずに[ラウンドワン]で一回触れただけ",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789057800,
      "updated": 1789057820
    },
    {
      "id": "6aa2dae90000000000a956af",
      "text": "",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1789057770,
      "updated": 1789057770
    }
  ]
}