{
  "id": "6af18ee23c006a7a715420cd",
  "title": "航海のメタファ",
  "created": 1794215655,
  "updated": 1794216063,
  "lines": [
    {
      "id": "6af18ee23c006a7a715420cd",
      "text": "航海のメタファ",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794215655,
      "updated": 1794215655
    },
    {
      "id": "6af18ef50000000000d5577f",
      "text": "行先、目的地",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794215669,
      "updated": 1794215699
    },
    {
      "id": "6af18f170000000000d55780",
      "text": "　目的地をめざして航海する",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794215703,
      "updated": 1794215741
    },
    {
      "id": "6af18f660000000000d55782",
      "text": "船",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794215783,
      "updated": 1794215789
    },
    {
      "id": "6af18f6d0000000000d55783",
      "text": "　限りある資源をやりくりする",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794215790,
      "updated": 1794215817
    },
    {
      "id": "6af18f8c0000000000d55784",
      "text": "船長",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794215820,
      "updated": 1794215827
    },
    {
      "id": "6af18f920000000000d55785",
      "text": "　リーダーシップ",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794215827,
      "updated": 1794215840
    },
    {
      "id": "6af18f1c0000000000d55781",
      "text": "乗組員",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794215709,
      "updated": 1794215851
    },
    {
      "id": "6af18fab0000000000d55787",
      "text": "　チーム",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794215851,
      "updated": 1794215861
    },
    {
      "id": "6af18fb50000000000d55788",
      "text": "　役割分担",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794215861,
      "updated": 1794215872
    },
    {
      "id": "6af18fa10000000000d55786",
      "text": "羅針盤と地図",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794215842,
      "updated": 1794215900
    },
    {
      "id": "6af18fdc0000000000d5578a",
      "text": "　現在位置を特定するためのツール",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794215900,
      "updated": 1794215934
    },
    {
      "id": "6af18fc00000000000d55789",
      "text": "天気、天候",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794215873,
      "updated": 1794216005
    },
    {
      "id": "6af190450000000000d5578b",
      "text": "　コントロールできない事象",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794216005,
      "updated": 1794216063
    },
    {
      "id": "6af190460000000000d5578c",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794216007,
      "updated": 1794216007
    },
    {
      "id": "6af18ee70000000000d5577d",
      "text": "[航海]の[メタファ]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794215655,
      "updated": 1794215703
    },
    {
      "id": "6af18ee70000000000d5577e",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1794215656,
      "updated": 1794215656
    }
  ]
}