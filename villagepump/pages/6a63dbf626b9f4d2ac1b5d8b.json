    {
      "id": "6a63dbf626b9f4d2ac1b5d8b",
      "text": "頭のいい言動",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1784929272,
      "updated": 1784929272
    },
    {
      "id": "6a63dbf80000000000c38eb2",
      "text": " 結論から話し、話の構造がシンプルである",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1784929272,
      "updated": 1784929280
    },
    {
      "id": "6a63dc000000000000c38eb4",
      "text": " 専門用語をかみ砕き、相手の知識レベルに合わせて説明する",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1784929280,
      "updated": 1784929287
    },
    {
      "id": "6a63dc070000000000c38eb5",
      "text": " 知らないことを知ったかぶりせず、素直に質問する",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1784929287,
      "updated": 1784929292
    },
    {
      "id": "6a63dc0b0000000000c38eb6",
      "text": " 相手の意見を否定から入らず、一度受け止める",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1784929292,
      "updated": 1784929297
    },
    {
      "id": "6a63dbf90000000000c38eb3",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1784929273,
      "updated": 1784929273
    },
    {
      "id": "6a63dec70000000000c38ebe",
      "text": "[Anonymous.icon]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1784929992,
      "updated": 1784930003
    },
    {
      "id": "6a63dd470000000000c38eb9",
      "text": "[頭がいいごっこ]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1784929608,
      "updated": 1784929609
    },
    {
      "id": "6a63dd520000000000c38eba",
