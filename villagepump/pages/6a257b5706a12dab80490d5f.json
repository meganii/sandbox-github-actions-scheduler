      "id": "6a9599e100000000008a4d04",
      "text": "    & .char-index:nth-child(11n) { --r: 180deg; }",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4d05",
