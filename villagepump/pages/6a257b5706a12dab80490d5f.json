      "id": "6a9599e100000000008a4d19",
      "text": "      color: transparent; position: relative;",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4d1a",
      "text": "    }",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4d1b",
      "text": "    & .lines .line:nth-child(n+37) .char-index[data-char=\"の\"]::after,",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4d1c",
      "text": "    & .lines .line:nth-child(n+37) .char-index[data-char=\"た\"]::after,",
