      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4d36",
      "text": "    & .lines .line:nth-child(n+49) .char-index:nth-child(6n) { --bx: 12px; --by: -60px; --br: -80deg; --d: .90s; }",
