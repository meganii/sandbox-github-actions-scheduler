      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4cf4",
      "text": "    & .lines .line:nth-child(n+17) .text { font-size: 1.12em; }",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4cf5",
      "text": "    & .lines .line:nth-child(n+25) .text { font-size: 1.22em; }",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4cf6",
      "text": "    & .lines .line:nth-child(n+33) .text { font-size: 1.38em; }",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4cf7",
      "text": "    & .lines .line:nth-child(n+41) .text { font-size: 1.60em; }",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4cf8",
      "text": "    /* ---------- 縦軸 3: 13行目〜 RGB が分離する ---------- */",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4cf9",
      "text": "    & .lines .line:nth-child(n+13) .text {",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4cfa",
      "text": "      text-shadow: 1.5px 0 rgba(255,0,80,.85), -1.5px 0 rgba(0,255,255,.85);",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4cfb",
      "text": "    }",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4cfc",
      "text": "    /* ---------- 縦軸 4: 17行目〜 文字が1字ずつ傾く ---------- */",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4cfd",
      "text": "    & .lines .line:nth-child(n+17) .char-index {",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4cfe",
      "text": "      display: inline-block;",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4cff",
      "text": "      transform: rotate(var(--r, 0deg)) translateY(var(--y, 0));",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4d00",
      "text": "    }",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4d01",
      "text": "    & .char-index:nth-child(3n) { --r: 13deg; --y: -2px; }",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4d02",
      "text": "    & .char-index:nth-child(5n) { --r: -21deg; --y: 3px; }",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4d03",
      "text": "    & .char-index:nth-child(7n) { --r: 97deg; }",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
