      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4d33",
      "text": "    & .lines .line:nth-child(n+49) .char-index:nth-child(6n+3) { --bx: -18px; --by: -22px; --br: 95deg; --d: .36s; }",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4d34",
      "text": "    & .lines .line:nth-child(n+49) .char-index:nth-child(6n+4) { --bx: 64px; --by: -44px; --br: -260deg; --d: .54s; }",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
