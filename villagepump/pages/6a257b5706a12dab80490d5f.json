      "text": "      animation: g-boom 4.5s cubic-bezier(.2,.7,.4,1) var(--d, 0s) infinite both;",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4d30",
      "text": "    }",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
