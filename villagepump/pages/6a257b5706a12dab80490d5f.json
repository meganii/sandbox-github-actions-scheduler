      "id": "6a9599e100000000008a4cf1",
      "text": "    & .lines .line:nth-child(n+5) .text { filter: hue-rotate(25deg) saturate(1.6); }",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4cf2",
