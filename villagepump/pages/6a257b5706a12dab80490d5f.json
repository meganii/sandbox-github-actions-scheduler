      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4d06",
      "text": "    & .lines .line:nth-child(n+21) img.icon { animation: g-spin 2.3s linear infinite; }",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4d07",
