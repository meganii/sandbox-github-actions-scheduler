      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4d0d",
      "text": "    & .lines .line:nth-child(n+33) { position: relative; }",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4d0e",
      "text": "    & .lines .line:nth-child(n+33)::after {",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
    {
      "id": "6a9599e100000000008a4d0f",
      "text": "      content: \"▒▓█░▒█▓░▒▓█░█▒▓░▒█▓░▒▓█░\";",
      "userId": "6a257912c40c8afba490c3cc",
      "created": 1788189153,
      "updated": 1788189153
    },
