    },
    {
      "id": "663452081280f000009d6481",
      "text": " ",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1714704904,
      "updated": 1714704904
    },
    {
      "id": "663451e51280f000009d645d",
      "text": "CSSがとんでもなく複雑だ[takker.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1714704869,
      "updated": 1714705201
    },
    {
      "id": "663453311280f000009d6679",
      "text": "なんとかシンプルにできないものか",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1714705201,
      "updated": 1714705209
    },
    {
      "id": "6a6c6a310000000000ea3af9",
      "text": "",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1785489969,
      "updated": 1785489969
    },
    {
      "id": "663453271280f000009d6678",
      "text": "動作が非常に重そうなCSSだという印象がある[Nrem.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1714705191,
      "updated": 1784969965
    },
    {
      "id": "6a647ba20000000000d419a5",
      "text": "　Settingsに導入するだけで重くなるタイプのスタイル指定です",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1784970146,
      "updated": 1784970184
    },
    {
      "id": "6a647aec0000000000d4199f",
      "text": "　無名のspan",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1784969965,
      "updated": 1784970062
    },
    {
      "id": "6a647aec0000000000d419a0",
      "text": "　　`.line:not(.cursor-line) .deco-\\. a:is(.page-link:not(.icon), .link) span:not(.empty-char-index) + span + span ~ span {`",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1784969965,
      "updated": 1784970062
    },
    {
      "id": "6a647b260000000000d419a4",
      "text": "　.char-index",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1784970023,
      "updated": 1785312202
    },
    {
      "id": "6a647b050000000000d419a2",
      "text": "　　`.page-link:not(.icon) span.empty-char-index ~ span.char-index {`",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1784969990,
      "updated": 1784970062
    },
    {
      "id": "6a647aec0000000000d419a1",
      "text": "　[Scrapboxの動作が遅い]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1784969965,
      "updated": 1784970062
    },
    {
      "id": "6a6c654c00000000005cc873",
