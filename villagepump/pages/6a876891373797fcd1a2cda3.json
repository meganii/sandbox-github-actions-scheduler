  "id": "6a876891373797fcd1a2cda3",
  "title": "他罰主義",
  "created": 1787259027,
  "updated": 1787259357,
  "lines": [
    {
      "id": "6a876891373797fcd1a2cda3",
      "text": "他罰主義",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1787259027,
      "updated": 1787259027
    },
    {
      "id": "6a8768920000000000602c06",
      "text": "問題や不満の原因を自分以外の他者に求め、その他者を罰したり非難したりする考え方や心理傾向",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1787259027,
      "updated": 1787259031
    },
    {
      "id": "6a8768930000000000602c07",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1787259028,
      "updated": 1787259028
    },
    {
      "id": "6a8768b30000000000602c08",
      "text": "他人に厳しく自分に甘い",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1787259059,
      "updated": 1787259113
    },
    {
      "id": "6a8768ea0000000000602c0b",
      "text": "[自己正当化]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1787259114,
      "updated": 1787259136
    },
    {
      "id": "6a8768fd0000000000602c0c",
      "text": "[他責思考]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1787259134,
      "updated": 1787259314
    },
    {
      "id": "6a8769b50000000000602c0d",
      "text": "[タブロイド思考]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1787259317,
      "updated": 1787259357
    },
    {
      "id": "6a8769d90000000000602c0e",
