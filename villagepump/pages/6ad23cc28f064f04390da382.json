    },
    {
      "id": "6ad23d006eb40600000027b16b",
      "text": "第42週: 日月火水木金[[土]]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1792163072,
      "updated": 1792163072
    },
    {
      "id": "6ad23d006eb406000000884d8f",
      "text": "2026年 79.45％経過",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1792163072,
      "updated": 1792163072
    },
    {
      "id": "6ad23d006eb4060000009f62bd",
      "text": "",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1792163072,
      "updated": 1792163072
    },
    {
      "id": "6ad23cc600000000001511a2",
      "text": "[hoshihara.icon]",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1792163014,
      "updated": 1792163016
    },
    {
      "id": "6ad23cc900000000001511a4",
      "text": " ああ",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1792163017,
      "updated": 1792163018
    },
    {
      "id": "6ad23cca00000000001511a5",
      "text": " Bloodborneやりすぎ",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1792163018,
      "updated": 1792163027
    },
    {
      "id": "6ad23cfd00000000001511a6",
      "text": "  8月からはじめて370時間に達してしまった",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1792163077,
      "updated": 1792163080
    },
    {
      "id": "6ad23eab00000000001511ab",
      "text": "  可処分時間の隅々に染み込んできている、、、",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1792163500,
      "updated": 1792163526
    },
    {
      "id": "6ad2406200000000001511b4",
      "text": "  面白い",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1792163938,
      "updated": 1792163940
    },
    {
      "id": "6ad23d1a00000000001511a7",
      "text": " インフルの波…なんだろう、来てる、確実に、俺たちのほうに。",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1792163099,
      "updated": 1792163193
    },
    {
      "id": "6ad23d8800000000001511a8",
      "text": " [FX戦士くるみちゃん]観て見たら序盤思ったより重い展開だった",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1792163208,
      "updated": 1792164044
    },
    {
      "id": "6ad23ded00000000001511a9",
      "text": " 少し前に痩せすぎということで[エネーボ]という栄養剤を処方してもらったが1日2本のノルマをまったくこなせていない。せいぜい1本くらい",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1792163309,
      "updated": 1792183023
    },
    {
      "id": "6ad23e3400000000001511aa",
      "text": "  一缶250mlで300kcal",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1792163381,
      "updated": 1792163419
    },
    {
      "id": "6ad23ed200000000001511ac",
      "text": "  味は美味しくも不味くもない",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1792163538,
      "updated": 1792163552
    },
    {
      "id": "6ad23ef400000000001511ad",
      "text": "  しかし14台だったBMIは15台に持ち直した",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1792163572,
      "updated": 1792163603
    },
    {
      "id": "6ad289e90000000000fecb9b",
      "text": "  \tすごい、自分も低い方で自慢していたが勝てない[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1792182762,
      "updated": 1792182776
    },
    {
      "id": "6ad23f2300000000001511ae",
      "text": " いろいろ腰が重くてできてないなー",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1792163620,
      "updated": 1792163636
    },
    {
      "id": "6ad23f4000000000001511af",
      "text": "  図書館で本借りるだけ借りといてブラボしてるので読む時間ないという、、、",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1792163648,
      "updated": 1792163699
    },
    {
      "id": "6ad23f7300000000001511b0",
      "text": "  学校の勉強も然り。まあ授業出れてればいいしなんなら全サボりじゃなければなんでもいいというスタートラインで、、、",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1792163699,
      "updated": 1792163699
    },
    {
      "id": "6ad28af7000000000041ae6b",
      "text": "   小さく始めるのだいじ[takker.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1792183033,
      "updated": 1792183044
    },
    {
      "id": "6ad23f8a00000000001511b2",
      "text": "  無駄に疲れてるし",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1792163722,
      "updated": 1792163728
    },
    {
      "id": "6ad23fa700000000001511b3",
      "text": " せめて睡眠相前進させなきゃな",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1792163751,
      "updated": 1792163774
    },
    {
      "id": "6ad23f8300000000001511b1",
      "text": "",
      "userId": "640b5ab62ffe46001b897bef",
      "created": 1792163715,
      "updated": 1792163720
    },
    {
      "id": "6ad28b04000000000041ae6c",
      "text": "[takker.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1792183047,
      "updated": 1792183048
    },
    {
      "id": "6ad28b07000000000041ae6e",
      "text": " 結局徹夜で山に行くことに",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1792183049,
      "updated": 1792183063
    },
    {
      "id": "6ad28b15000000000041ae6f",
      "text": " 絶対にまねしないでください",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1792183063,
      "updated": 1792183112
    },
    {
      "id": "6ad28b04000000000041ae6d",
