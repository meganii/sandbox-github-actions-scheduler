    {
      "id": "6ab98851a61f1208769d281e",
      "text": "Iconify",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1790544045,
      "updated": 1790544045
    },
    {
      "id": "6ab988ac0000000000914c68",
      "text": "[https://iconify.design/ Iconify Design: All popular icon sets, one framework.]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1790544045,
      "updated": 1790544046
    },
    {
      "id": "6ab988ae0000000000914c69",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1790544046,
      "updated": 1790544046
    },
    {
      "id": "6ab988af0000000000914c6a",
      "text": " [Font Awesome]等のオープンソースのアイコンセットを透過的に利用できてるアイコンライブラリ",
      "userId": "686b72ebdffe36b729b4453d",
      "created": 1790544047,
      "updated": 1794313595
    },
    {
      "id": "6ae766730000000000ea0cd4",
      "text": " 使用できるアイコンセットは200以上",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1793549939,
      "updated": 1793549939
    },
    {
      "id": "6ae766730000000000ea0cd5",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1793549939,
      "updated": 1793549939
    },
    {
      "id": "6ae6b6cd0000000000d11674",
      "text": "[https://img.shields.io/badge/Iconify-026C9C.svg?style=for-the-badge&logo=Iconify&logoColor=white]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1793504974,
      "updated": 1793504974
    },
    {
      "id": "6ae6b6ce0000000000d11675",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1793504974,
      "updated": 1793664001
    },
    {
      "id": "6ae8e89300000000002087bc",
      "text": "[Iconifyでアイコンをつくる]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1793648787,
      "updated": 1793648801
    },
    {
      "id": "6ae802c000000000007eb786",
      "text": "[Iconifyでwhoさんをつくる]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1793589952,
      "updated": 1793589995
    },
    {
      "id": "6ae802c200000000007eb787",
      "text": "",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1793589954,
      "updated": 1793589954
    },
    {
      "id": "6ae765e60000000000ea0cb0",
      "text": " SVG画像を動的に生成する",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1793549799,
      "updated": 1793549801
    },
    {
      "id": "6ae765e90000000000ea0cb1",
      "text": "  URL形式: `https://api.iconify.design/{prefix}/{name}.svg`",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1793549801,
      "updated": 1793549801
    },
    {
      "id": "6ae765e90000000000ea0cb2",
      "text": "  主なクエリパラメータ",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1793549801,
      "updated": 1793549801
    },
    {
      "id": "6ae765e90000000000ea0cb3",
      "text": "   color=色名 または HEXコード（色の変更）",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1793549801,
      "updated": 1793549801
    },
    {
      "id": "6ae765e90000000000ea0cb4",
      "text": "   width=24 または height=24（サイズ変更。片方のみ指定すると比率を維持）",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1793549801,
      "updated": 1793549801
    },
    {
      "id": "6ae765e90000000000ea0cb5",
      "text": "   rotate=90 （90, 180, 270度で回転）",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1793549801,
      "updated": 1793549801
    },
    {
      "id": "6ae765e90000000000ea0cb6",
      "text": "   flip=horizontal または flip=vertical （反転）",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1793549801,
      "updated": 1793549801
    },
    {
      "id": "6af2f102000000000090cf44",
      "text": "  解説助かります[Nrem.icon]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1794306306,
      "updated": 1794306327
    },
