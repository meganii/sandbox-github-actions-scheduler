      "created": 1644499541,
      "updated": 1644499541
    },
    {
      "id": "620512631280f00000648e05",
      "text": "[斜体記法]を上書きする",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499555,
      "updated": 1644499574
    },
    {
      "id": "620512a11280f00000648e07",
      "text": "code:style.css",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499616,
      "updated": 1644499620
    },
    {
      "id": "620512a51280f00000648e08",
      "text": " .line .deco-\\/ img.icon {",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499620,
      "updated": 1644499621
    },
    {
      "id": "620512a61280f00000648e09",
      "text": "   margin: 3px 0;",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499621,
      "updated": 1644499621
    },
    {
      "id": "620512a61280f00000648e0a",
      "text": "   max-width: 100%;",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499621,
      "updated": 1644499621
    },
    {
      "id": "620512a61280f00000648e0b",
      "text": "   max-height: 300px;",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499621,
      "updated": 1644499621
    },
    {
      "id": "620512a61280f00000648e0c",
      "text": "   height: revert;",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499621,
      "updated": 1644499621
    },
    {
      "id": "620512a61280f00000648e0d",
      "text": " }",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499621,
      "updated": 1644499621
    },
    {
      "id": "620512641280f00000648e06",
      "text": "",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499555,
      "updated": 1644499555
    },
    {
      "id": "620512bd1280f00000648e0e",
      "text": "code:style.css",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499644,
      "updated": 1644499649
    },
    {
      "id": "620512c11280f00000648e10",
      "text": " .line .deco-\\/.deco-\\* img.icon {",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499649,
      "updated": 1644499649
    },
    {
      "id": "620512c21280f00000648e11",
      "text": "   margin: 3px 0;",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499649,
      "updated": 1644499649
    },
    {
      "id": "620512c21280f00000648e12",
      "text": "   max-width: 95%;",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499649,
      "updated": 1644499649
    },
    {
      "id": "620512c21280f00000648e13",
      "text": "   max-height: none;",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499649,
      "updated": 1644499649
    },
    {
      "id": "620512c21280f00000648e14",
      "text": "   height: revert;",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499649,
      "updated": 1644499649
    },
    {
      "id": "620512c21280f00000648e15",
      "text": "   display: inline-block;",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499649,
      "updated": 1644499649
    },
    {
      "id": "620512c21280f00000648e16",
      "text": "   vertical-align: middle;",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499649,
      "updated": 1644499649
    },
    {
      "id": "620512c21280f00000648e17",
      "text": " }",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499649,
      "updated": 1644499649
    },
    {
      "id": "620512be1280f00000648e0f",
      "text": "",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1644499645,
      "updated": 1644499645
    },
    {
      "id": "6a79a80c000000000000e3f8",
      "text": "画像と同じ filter を適用する",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786357773,
      "updated": 1786357992
    },
    {
      "id": "6a79a8e6000000000000e3fb",
      "text": "cf. [ダークテーマに表示される画像の輝度を落とす]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786357992,
      "updated": 1786358001
    },
    {
      "id": "6a79a952000000000000e3fc",
      "text": "　[--page-image-filter]",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1786358100,
      "updated": 1786358113
    },
    {
      "id": "6a79a88a000000000000e3fa",
