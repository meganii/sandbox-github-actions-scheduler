  "lines": [
    {
      "id": "6ac9558618bb27a4109e3d18",
      "text": "2026/10/10",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1791579531,
      "updated": 1791579531
    },
    {
      "id": "6ac95ebc6eb406000000380d8c",
      "text": "第41週: 日月火水木金[[土]]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791581884,
      "updated": 1791581884
    },
    {
      "id": "6ac95ebc6eb406000000f83e53",
      "text": "2026年 77.53％経過",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791581884,
      "updated": 1791581884
    },
    {
      "id": "6ac95ebc6eb4060000005eef02",
      "text": "",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791581884,
      "updated": 1791581884
    },
    {
      "id": "6ac9558800000000009d3f85",
      "text": "[hiro.icon]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1791579531,
      "updated": 1791579531
    },
    {
      "id": "6ac9558a00000000009d3f87",
      "text": " [金銭王の朝 https://dlt.kitetu.com/KNo.F85E/555F-0801]",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1791579532,
      "updated": 1791579542
    },
    {
      "id": "6aca21a60000000000dab3de",
      "text": "  金を貯める上手さと金を使う上手さは別物",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1791631785,
      "updated": 1791631806
    },
    {
      "id": "6ac9558900000000009d3f86",
      "text": "",
      "userId": "5f11a68e5fc065001ecf5795",
      "created": 1791579531,
      "updated": 1791579531
    },
    {
      "id": "6ac96b47000000000034ec99",
      "text": "[inajob.icon]",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791585096,
      "updated": 1791585098
    },
    {
      "id": "6ac96b4a000000000034ec9b",
      "text": " 6歳の娘の運動会の日",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791585099,
      "updated": 1791585108
    },
    {
      "id": "6ac9727d0000000000accbfc",
      "text": " \t良い時期だ[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791586942,
      "updated": 1791586945
    },
    {
      "id": "6ac9ee42000000000079f844",
      "text": " ブレイブボード、ジェイボード、エスボード などと呼ばれるものを体験",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791618626,
      "updated": 1791618645
    },
    {
      "id": "6ac9ee7b000000000079f846",
      "text": " \tキャスターボード、リップスティック などの名前も見かける、どうなってるのだ・・",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791618684,
      "updated": 1791618702
    },
    {
      "id": "6ac9ee56000000000079f845",
      "text": " \tひねることが出来るインラインスケボーみたいなやつ",
      "userId": "58442db3ee4a2400116eb406",
      "created": 1791618646,
      "updated": 1791618658
    },
    {
      "id": "6ac96e8b00000000005473b1",
      "text": "",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791585931,
      "updated": 1791585931
    },
    {
      "id": "6ac96e8b00000000005473b2",
      "text": "[taktamur.icon]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791585931,
      "updated": 1791585933
    },
    {
      "id": "6ac96e8e00000000005473b3",
      "text": " 連休初日の朝",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791585934,
      "updated": 1791585942
    },
    {
      "id": "6ac96e9600000000005473b4",
      "text": "  [最of高]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791585942,
      "updated": 1791585954
    },
    {
      "id": "6ac982e00000000000085469",
      "text": " todoリストとして[todoist]が気に入ってきた",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791591140,
      "updated": 1791591598
    },
    {
      "id": "6ac983b9000000000008546e",
      "text": "  なんとなく「[ものぐさがものぐさのままで使える]」感じがしてる",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1791591353,
      "updated": 1791615167
    },
    {
      "id": "6ac9840c000000000008546f",
      "text": "   いつかやるタスクを登録しておく。別にそれを今日やってもいいよね。←という使い方でも馴染む",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791591437,
      "updated": 1791591583
    },
    {
      "id": "6ac98306000000000008546a",
      "text": "  昨日期限のものをまとめて今日にリスケできる",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791591174,
      "updated": 1791591214
    },
    {
      "id": "6ac9832e000000000008546b",
      "text": "  サブタスクのあるやつを繰り返しにしておくと、完了した時にサブタスクをクリアしてくれる",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791591214,
      "updated": 1791591268
    },
    {
      "id": "6ac98364000000000008546c",
      "text": "   出勤時の持ち物チェックで便利",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791591268,
      "updated": 1791591285
    },
    {
      "id": "6ac98375000000000008546d",
      "text": "  繰り返しタスクの1週間後とかを、「完了した日から1週間後」での再設定ができる",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791591285,
      "updated": 1791591342
    },
    {
      "id": "6ac9b7200000000000248abc",
      "text": " 駅の方まで散歩して帰ってきた。",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791604512,
      "updated": 1791604524
    },
    {
      "id": "6ac9b72c0000000000248abd",
      "text": "  昼寝するべ。",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791604524,
      "updated": 1791604528
    },
    {
      "id": "6ac9fe5a0000000000068073",
      "text": " やってしまった。",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791622746,
      "updated": 1791622750
    },
    {
      "id": "6ac9fe5e0000000000068074",
      "text": "  整体の予約を完全に忘れてて、予約時間に気付いた",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791622750,
      "updated": 1791622769
    },
    {
      "id": "6ac9fe720000000000068075",
      "text": "  慌てて連絡して、明日に再予約した。",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791622769,
      "updated": 1791622784
    },
    {
      "id": "6ac9fe810000000000068076",
      "text": "  自分でもこれを忘れてたのがとてもショックだった",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791622784,
      "updated": 1791622801
    },
    {
      "id": "6ac9fe960000000000068077",
      "text": "   もの忘れ系こわぃ",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791622806,
      "updated": 1791622817
    },
    {
      "id": "6aca0dce0000000000f2f5e2",
      "text": "    こわぃ[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791626702,
      "updated": 1791626712
    },
    {
      "id": "6ac9feb50000000000068078",
      "text": " 当たり前だけど、忘れているときはきれいさっぱり忘れている",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791622837,
      "updated": 1791622853
    },
    {
      "id": "6ac9fec50000000000068079",
      "text": "  「何か忘れてないっけ？」という疑念も何も出てこない",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791622853,
      "updated": 1791622870
    },
    {
      "id": "6ac9fef1000000000006807a",
      "text": "  このタイプには、チェックリストとかリマインドが効く",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791622897,
      "updated": 1791622921
    },
    {
      "id": "6ac9ff0a000000000006807b",
      "text": "   視界に入れば即座に思い出す",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791622921,
      "updated": 1791622982
    },
    {
      "id": "6ac96ebf00000000005473b5",
      "text": "",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791585986,
      "updated": 1791585991
    },
    {
      "id": "6ac97b240000000000e67934",
      "text": "[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791589156,
      "updated": 1791589157
    },
    {
      "id": "6ac97b240000000000e67935",
      "text": "\t音ゲーの動きをそらで行うダンス、余地あると思うんだよなぁ",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791589157,
      "updated": 1791589176
    },
    {
      "id": "6ac97b280000000000e67936",
      "text": "\t\t[音ゲーダンス - YouTube https://www.youtube.com/shorts/UQoIauszEV8]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791589161,
      "updated": 1791589161
    },
    {
      "id": "6ac97b380000000000e67938",
      "text": "\t\t従来のダンスと違って上半身や全身や顔とかは構わなくていい",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791589177,
      "updated": 1791589190
    },
    {
      "id": "6ac97b460000000000e67939",
      "text": "\t\t足とリズムだけで楽しめる",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791589190,
      "updated": 1791589195
    },
    {
      "id": "6ac97bb60000000000e6793d",
      "text": "\t\t\tなんていうかリズム + 軽いアクションで音とリズムとアクションの3つを楽しむ活動、みたいな",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791589303,
      "updated": 1791589317
    },
    {
      "id": "6ac97bc50000000000e6793e",
      "text": "\t\t\t[リズム天国]も割と近いが、あれは創作の余地がない",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791589317,
      "updated": 1791589337
    },
    {
      "id": "6ac97b510000000000e6793a",
      "text": "\t\tシャッフルダンスでもいいが、これみたいに踏むだけでも楽しい",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791589202,
      "updated": 1791589212
    },
    {
      "id": "6ac97b8c0000000000e6793b",
      "text": "\tまたマイクラMODつくっている",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791589261,
      "updated": 1791619643
    },
    {
      "id": "6ac9f23900000000009efed3",
      "text": "\t\t[stakiran/gezan: 下山マイクラ。アンプリファイド100マス世界で丸石だけで最高点→地上を目指す https://github.com/stakiran/gezan]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791619643,
      "updated": 1791619643
    },
    {
      "id": "6aca01190000000000661131",
      "text": "\t\tデモプレイ見せる用にライブ配信もした、アーカイブ: [下山マイクラ デモプレイ #minecraft #マインクラフト #マイクラ - YouTube https://www.youtube.com/watch?v=Nhue8YxnBgE]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791623451,
      "updated": 1791623460
    },
    {
      "id": "6aca01540000000000661132",
      "text": "\tDeno、[/sushitecture/hashrock]さんがたしかいたはずと思ったが、2024年までだったか",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791623510,
      "updated": 1791623566
    },
    {
      "id": "6ac9f23400000000009efed2",
      "text": "",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791619637,
      "updated": 1791619637
    },
    {
      "id": "6ac97da300000000001a0626",
      "text": "[Hiro Aki.icon]",
      "userId": "65e1289acd012200235729c0",
      "created": 1791589796,
      "updated": 1791589796
    },
    {
      "id": "6ac97da400000000001a0627",
      "text": "\t[AceCombat8]、とりあえず１周クリア",
      "userId": "65e1289acd012200235729c0",
      "created": 1791589797,
      "updated": 1791589821
    },
    {
      "id": "6ac97dbd00000000001a0628",
      "text": "\t\t個人的には前作の方が好きだった",
      "userId": "65e1289acd012200235729c0",
      "created": 1791589821,
      "updated": 1791589834
    },
    {
      "id": "6ac97dc900000000001a0629",
      "text": "\t\t見える範囲だと前作は酷かっただとか、前作のダメなところを改善しただとか前作sage進行を見かけ違和感",
      "userId": "65e1289acd012200235729c0",
      "created": 1791589834,
      "updated": 1791589870
    },
    {
      "id": "6ac97dee00000000001a062a",
      "text": "\t\t前作が初のエスコンシリーズだったから甘い評価になっているのかもしれない",
      "userId": "65e1289acd012200235729c0",
      "created": 1791589870,
      "updated": 1791589909
    },
    {
      "id": "6ac97e1500000000001a062b",
      "text": "\t\tいや、前作のような様々なシチュエーションの方がゲーム性としては優れていると言えるのでは？と思う",
      "userId": "65e1289acd012200235729c0",
      "created": 1791589909,
      "updated": 1791589942
    },
    {
      "id": "6ac97e3500000000001a062c",
      "text": "\t\t前作の砂嵐のステージとか渓谷とか雷雲とか護衛は不評だけど、ステージごとのメリハリという要素として結構楽しめていたのだろう",
      "userId": "65e1289acd012200235729c0",
      "created": 1791589942,
      "updated": 1791618040
    },
    {
      "id": "6ac9e1500000000000c2c76e",
      "text": "\t\t 渓谷ないのか…[yosider.icon]",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1791615310,
      "updated": 1791615317
    },
    {
      "id": "6ac9eb50000000000023bfb6",
      "text": "\t\t あるにはあるけど、7みたいな緊張感ある、絶対に上に出るなだとか、文字通り谷を縫うような渓谷ミッションは無い[Hiro Aki.icon]",
      "userId": "65e1289acd012200235729c0",
      "created": 1791617872,
      "updated": 1791617922
    },
    {
      "id": "6ac9eb96000000000023bfb7",
      "text": "\t\t \t完全に無いわけじゃないか、1つだけ特殊で強烈に制限かかるやつはある",
      "userId": "65e1289acd012200235729c0",
      "created": 1791617943,
      "updated": 1791617972
    },
    {
      "id": "6ac97e6700000000001a062d",
      "text": "\t\tストーリー的にも前作の、地位が急降下して最底辺まで落ちてからの空の彼方へ飛び上がる流れは好みだった",
      "userId": "65e1289acd012200235729c0",
      "created": 1791589991,
      "updated": 1791590043
    },
    {
      "id": "6ac97e9e00000000001a062e",
      "text": "\t\tあとは前作の狂った仲間達も気に入っていたのだろう",
      "userId": "65e1289acd012200235729c0",
      "created": 1791590047,
      "updated": 1791590064
    },
    {
      "id": "6ac97eaf00000000001a062f",
      "text": "\t\t\t特にAIすら騙す詐欺師は良い展開だった",
      "userId": "65e1289acd012200235729c0",
      "created": 1791590064,
      "updated": 1791590089
    },
    {
      "id": "6aca1de0000000000023bfb9",
      "text": "\t突然散歩しようと思い立ち公園へ行きぐるっと回って帰宅するだけの行動を実施",
      "userId": "65e1289acd012200235729c0",
      "created": 1791630817,
      "updated": 1791630845
    },
    {
      "id": "6aca1dfc000000000023bfba",
      "text": "\t\t公園内の自販機にて[チルアウト　リラクゼーションドリンク.icon]を見かけたので購入",
      "userId": "65e1289acd012200235729c0",
      "created": 1791630845,
      "updated": 1791630866
    },
    {
      "id": "6aca1e12000000000023bfbb",
      "text": "\t\t自販機価格だからか1本[210円]もするんだな",
      "userId": "6780c5dd585ee07f1dc50b2b",
      "created": 1791630866,
      "updated": 1791638354
    },
    {
      "id": "6aca1e21000000000023bfbc",
      "text": "\t\t味は薄っすら柑橘系で飲みやすさ重点な雰囲気",
      "userId": "65e1289acd012200235729c0",
      "created": 1791630881,
      "updated": 1791630899
    },
    {
      "id": "6aca1e34000000000023bfbd",
      "text": "\t\tこれまで飲んだ中だと、[ソルティライチ]の味を薄めというか、香りを抑えたようなイメージ",
      "userId": "65e1289acd012200235729c0",
      "created": 1791630900,
      "updated": 1791630950
    },
    {
      "id": "6aca20180000000000ed9c5c",
      "text": "\t\t [うますぎずうまい][caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791631385,
      "updated": 1791631398
    },
    {
      "id": "6aca1e66000000000023bfbe",
      "text": "\t\t散歩とGABA成分のお陰で元気になったはず。しらんけど",
      "userId": "65e1289acd012200235729c0",
      "created": 1791630950,
      "updated": 1791630982
    },
    {
      "id": "6ac9804e0000000000a5c56e",
      "text": "",
      "userId": "649a24da357c4d001c518c25",
      "created": 1791590477,
      "updated": 1791590477
    },
    {
      "id": "6ac9804f0000000000a5c56f",
      "text": "[meganii.icon]",
      "userId": "649a24da357c4d001c518c25",
      "created": 1791590477,
      "updated": 1791590479
    },
    {
      "id": "6ac980510000000000a5c570",
      "text": " ゴミ出しチャレンジ失敗。良い朝過ぎた",
      "userId": "649a24da357c4d001c518c25",
      "created": 1791590479,
      "updated": 1791590492
    },
    {
      "id": "6ac9ee9c0000000000d49d63",
      "text": " [VIVANT]を最初から見始めた",
      "userId": "649a24da357c4d001c518c25",
      "created": 1791618716,
      "updated": 1791618757
    },
    {
      "id": "6ac99d14000000000085e104",
      "text": "",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791597845,
      "updated": 1791597845
    },
    {
      "id": "6ac99d14000000000085e105",
      "text": "[takker.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791597845,
      "updated": 1791597847
    },
    {
      "id": "6ac99d16000000000085e106",
      "text": " [Geminiたん]初めて知ったけどすき",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791597848,
      "updated": 1791597866
    },
    {
      "id": "6ac9a92300000000000e7760",
      "text": "  おっとりしててかわいい",
      "userId": "5f938a902ea5180024085116",
      "created": 1791600931,
      "updated": 1791600935
    },
    {
      "id": "6ac9a4ca0000000000aafe47",
      "text": "",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1791599819,
      "updated": 1791599819
    },
    {
      "id": "6ac9a4ca0000000000aafe48",
      "text": "[terang.icon]",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1791599819,
      "updated": 1791599820
    },
    {
      "id": "6ac9a4cb0000000000aafe49",
      "text": "\tラジオのニュースで「キョウセイ社会」の語が耳に入る",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1791599820,
      "updated": 1791599853
    },
    {
      "id": "6ac9a4d90000000000aafe4a",
      "text": "\t\t共生か矯正か強制か一瞬迷う",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1791599833,
      "updated": 1791599847
    },
    {
      "id": "6ac9fa2d0000000000a51717",
      "text": "\t散歩行って帰ってきた。",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1791621677,
      "updated": 1791621681
    },
    {
      "id": "6ac9fa320000000000a51718",
      "text": "\t\tGoogleマップ氏によると6kmちょっと歩いたらしい",
      "userId": "5d69dde930e3c500170f1ffd",
      "created": 1791621683,
      "updated": 1791621695
    },
    {
      "id": "6ac97b290000000000e67937",
      "text": "",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1791589162,
      "updated": 1791589162
    },
    {
      "id": "6ac9c3bd00000000004e2291",
      "text": "[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791607741,
      "updated": 1791607743
    },
    {
      "id": "6ac9c3bf00000000004e2292",
      "text": " [はんだ付け]練習、完",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1791607743,
      "updated": 1791615530
    },
    {
      "id": "6ac9c3ca00000000004e2293",
      "text": "  [Hiro Aki.icon]さんにコツを教えてもらったあとの半田付けかなり良くなったはぐれメタル",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791607754,
      "updated": 1791607795
    },
    {
      "id": "6ac9c3f500000000004e2294",
      "text": "  はんだ付けの時はんだをこて先に当てて溶かすものかと思っていたが、十分に温まっているとどこにつけても溶けるということがわかった",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791607798,
      "updated": 1791607857
    },
    {
      "id": "6ac9c43000000000004e2295",
      "text": "  [https://gyazo.com/fb5d1986278dafbcd4dadfe86077da58]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791607857,
      "updated": 1791608051
    },
    {
      "id": "6ac9c4f300000000004e2296",
      "text": "   最初に半田付けした抵抗のとこ(赤矢印の列)と最後に付けたIcのとこ(手前)比べると上から見ても上手くなってる感ある",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791608051,
      "updated": 1791608126
    },
    {
      "id": "6aca1dc7000000000023bfb8",
      "text": "   [caki.icon]さんはワシが育てた（誇張表現[Hiro Aki.icon]",
      "userId": "65e1289acd012200235729c0",
      "created": 1791630791,
      "updated": 1791630801
    },
    {
      "id": "6aca1fda0000000000ed9c5b",
      "text": "    そだった🌱[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791631322,
      "updated": 1791631332
    },
    {
      "id": "6aca9d6f0000000000b830f4",
      "text": "    いいはなし[はるひ.icon]",
      "userId": "60c9f2f6c225a50020b8bbfc",
      "created": 1791663471,
      "updated": 1791663474
    },
    {
      "id": "6aca0d180000000000f2f5de",
      "text": " 黙々と作業するの楽しくて血迷って自作キーボードに手を出しそうになっている",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791626520,
      "updated": 1791626550
    },
    {
      "id": "6aca0d390000000000f2f5df",
      "text": "  友人からお前はそんなことをしている場合ではないと言われている",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791626553,
      "updated": 1791626569
    },
    {
      "id": "6aca0da80000000000f2f5e1",
      "text": "   締切の迫る原稿を放置しているため",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791626664,
      "updated": 1791626686
    },
    {
      "id": "6aca20730000000000ed9c5d",
      "text": " 太りをなんとかしないと、ということでAIに相談し、世話をさせようとしている",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791631476,
      "updated": 1791631503
    },
    {
      "id": "6aca20b20000000000ed9c5e",
      "text": " googleのモーダルUI？（GTMとかの右からにゅっとでてくるやつ）とRTMとbacklogのキメラみたいなタスク管理ツールをAIに作らせている",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791631539,
      "updated": 1791631600
    },
    {
      "id": "6aca20f60000000000ed9c5f",
      "text": " \t最終形駆動でUIだけまずできている",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791631606,
      "updated": 1791631625
    },
    {
      "id": "6ac9c4310000000000d24d38",
      "text": "",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1791607858,
      "updated": 1791607858
    },
    {
      "id": "6ac9c4320000000000d24d39",
      "text": "[seibe.icon]",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1791607858,
      "updated": 1791607860
    },
    {
      "id": "6ac9c4340000000000d24d3d",
      "text": " 確かに[AIのものはAIの場所に、人は人の場所に書く]、のを分けたほうがよいなと思った",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791607860,
      "updated": 1791617612
    },
    {
      "id": "6ac9c5470000000000d24d3e",
      "text": " 　というリンクどこかにあったっけ",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1791608136,
      "updated": 1791608145
    },
    {
      "id": "6ac9c4320000000000d24d3a",
      "text": "",
      "userId": "5eb247ae6474d4001ea56fda",
      "created": 1791607858,
      "updated": 1791607858
    },
    {
      "id": "6ac9c4320000000000d24d3b",
      "text": "[atohs.icon]",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791607858,
      "updated": 1791608567
    },
    {
      "id": "6ac9c6f600000000007ff31a",
      "text": "　病み上がりだからつらいのか、普段からこのくらいつらいのか、よくわからなくなってきちゃった",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791608567,
      "updated": 1791608583
    },
    {
      "id": "6ac9c70700000000007ff31b",
      "text": "　水分補給にいつも失敗するので、なんか良い感じの方法を発明したい",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791608583,
      "updated": 1791608592
    },
    {
      "id": "6ac9c71000000000007ff31c",
      "text": "　僕のやり方の問題なのかもしれないけど、AIと一緒に画面を変更していくにあたって、WordPressを使うよりもAstroを使った方がかなり楽",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791608592,
      "updated": 1791609587
    },
    {
      "id": "6ac9caf300000000007ff31d",
      "text": "　はやくぜんぶをAstroにしたい",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791609587,
      "updated": 1791609592
    },
    {
      "id": "6ac9caf800000000007ff31e",
      "text": "　別にAstroじゃなくても良いが、WordPress経由であんまり触りたくないい",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791609592,
      "updated": 1791609609
    },
    {
      "id": "6ac9cb0900000000007ff31f",
      "text": "　やはり2個くらい同時に開発していた方が集中力を保てるかもしれない",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791609609,
      "updated": 1791610126
    },
    {
      "id": "6ac9cd0e00000000007ff320",
      "text": "　\tずっと仕様を考えていれば良い、という状態になりやすい",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791610126,
      "updated": 1791610134
    },
    {
      "id": "6ac9cd1d00000000007ff321",
      "text": "　\t開発としては同時並行的にやっているが、仕様は指示できるくらいまでは一気に考えてやる",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791610141,
      "updated": 1791610163
    },
    {
      "id": "6ac9cd3200000000007ff322",
      "text": "　画像スライダーの両端ってどう処理するのが一番いいんやろうかと考えている",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791610163,
      "updated": 1791610507
    },
    {
      "id": "6ac9ce8d00000000007ff323",
      "text": "　\tぶつ切りにするとぶつ切りになっちゃつな〜と",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791610510,
      "updated": 1791610518
    },
    {
      "id": "6ac9ce9600000000007ff324",
      "text": "　\t半透明の領域をいれたりするのかしら",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791610518,
      "updated": 1791610532
    },
    {
      "id": "6ac9cea300000000007ff325",
      "text": "　大鶴肥満のピッツァマン見ると元気が出る",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791610532,
      "updated": 1791616746
    },
    {
      "id": "6ac9ebbc0000000000d512ad",
      "text": "　インターネット、家事、読書、運動のいずれかをやっていることにしておきたい",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791617981,
      "updated": 1791617991
    },
    {
      "id": "6ac9ebc70000000000d512ae",
      "text": "　\tインターネットを長めにできるようにしたいよなあ",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791617991,
      "updated": 1791618001
    },
    {
      "id": "6ac9ebd10000000000d512af",
      "text": "　\tインターネットをやるといっても、なんかぼーっと見つめている時間を増やしたいのではなく、インターネットにコミットしている時間を増やしたいという気持ち",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791618001,
      "updated": 1791618020
    },
    {
      "id": "6ac9ebe40000000000d512b0",
      "text": "　\tあんまり適当に「インターネット」という言葉を使わない方が良いという気がしつつ、言葉の守備範囲が広くて便利という話がある",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791618020,
      "updated": 1791618043
    },
    {
      "id": "6ac9f57d0000000000d512b2",
      "text": "　今日あんまり仕事進んでないけど、なぜなのかはあんまり覚えていない",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791620477,
      "updated": 1791620487
    },
    {
      "id": "6ac9f5870000000000d512b3",
      "text": "\t　普通に仕事をはじめたのが昼過ぎからだからなのではないか",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791620487,
      "updated": 1791620513
    },
    {
      "id": "6ac9f5a10000000000d512b4",
      "text": "\t見出しの直前で空白行を入れないことにずっと違和感があったんだけど、段落を空白行で表現しているから、それはそうという気がしてきた",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791620514,
      "updated": 1791621291
    },
    {
      "id": "6ac9f8aa0000000000d512b5",
      "text": "\t\t段落間よりも見出しの上の方が広く空いていた方が良いという直感がある",
      "userId": "5a61856392ee03001413cde3",
      "created": 1791621291,
      "updated": 1791621313
    },
    {
      "id": "6ac9f8c10000000000d512b6",
      "text": "",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1791621313,
      "updated": 1791622261
    },
    {
      "id": "6ac9fc750000000000a48125",
      "text": "[wogikaze.icon]",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1791622261,
      "updated": 1791622263
    },
    {
      "id": "6ac9fc770000000000a48128",
      "text": "　[DenoがCloudflareに]",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1791622265,
      "updated": 1791622277
    },
    {
      "id": "6ac9c4320000000000d24d3c",
      "text": "  [米クラウドフレア、Deno開発チームが全員合流へ Denoランタイムは1年後に開発終了 ｜ビジネス+IT https://www.sbbit.jp/article/cont1/187401]",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1791607858,
      "updated": 1791622372
    },
    {
      "id": "6aca02f7000000000006807c",
      "text": "  ！？びっくりした[taktamur.icon]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791623933,
      "updated": 1791623955
    },
    {
      "id": "6ac9fce40000000000a4812a",
      "text": "   Denoは好きなので残ってほしいなぁ。[taktamur.icon]",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791622373,
      "updated": 1791623990
    },
    {
      "id": "6aca2c8b0000000000a4812c",
      "text": "   1年後に公式からの開発は終了になるみたいなので希望薄...コミュニティ側で続くのかもしれないけど[wogikaze.icon]",
      "userId": "64099110a39a5c001c8a016e",
      "created": 1791634571,
      "updated": 1791634598
    },
    {
      "id": "6aca218600000000003dc6d5",
      "text": "  Deno Slackで知らせきてびっくり[takker.icon]",
      "userId": "5ef2bdebb60650001e1280f0",
      "created": 1791631756,
      "updated": 1791631814
    },
    {
      "id": "6aca0324000000000006807d",
      "text": "",
      "userId": "58a90dd3ee5de7001150db17",
      "created": 1791623972,
      "updated": 1791623972
    },
    {
      "id": "6aca07b100000000002846f7",
      "text": "[基素.icon]",
      "userId": "59fb21121207900012774b17",
      "created": 1791625138,
      "updated": 1791625140
    },
    {
      "id": "6aca07b400000000002846fa",
      "text": " 服を買ったら、どさくさに紛れてカバンが一つ増えた。ジュエリーとメガネも欲しくなった。",
      "userId": "59fb21121207900012774b17",
      "created": 1791625141,
      "updated": 1791625206
    },
    {
      "id": "6aca0d500000000000f2f5e0",
      "text": "  仲間を呼んでいる[caki.icon]",
      "userId": "6923e3b6e09f0be0924872ef",
      "created": 1791626576,
      "updated": 1791626588
    },
    {
      "id": "6aca07b100000000002846f8",
      "text": "",
      "userId": "59fb21121207900012774b17",
      "created": 1791625138,
      "updated": 1791625138
    },
    {
      "id": "6aca302e0000000000311e10",
      "text": "[zatsma.icon]",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1791635502,
      "updated": 1791635503
    },
    {
      "id": "6aca302f0000000000311e12",
      "text": " 何年かヨガに通っていたものの[足首の固さ]が解消せず",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1791635504,
      "updated": 1791635559
    },
    {
      "id": "6aca30450000000000311e13",
      "text": "  引越しに伴いヨガはやめた",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1791635526,
      "updated": 1791635540
    },
    {
      "id": "6aca302e0000000000311e11",
      "text": " セルフストレッチを始めることにした",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1791635502,
      "updated": 1791635555
    },
    {
      "id": "6aca30680000000000311e15",
      "text": "  ",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1791635561,
      "updated": 1791635561
    },
    {
      "id": "6aca30550000000000311e14",
      "text": "",
      "userId": "58d101391094b20011d8c2f4",
      "created": 1791635542,
      "updated": 1791635542
    },
    {
      "id": "6aca6381000000000021125f",
      "text": "[Aria.icon]",
      "userId": "660605441655f300254ac7c2",
      "created": 1791648642,
      "updated": 1791648643
    },
    {
      "id": "6aca63830000000000211261",
      "text": "\t[すいちゃん]の[アコースティックライブ]を見ながら作業中",
      "userId": "660605441655f300254ac7c2",
      "created": 1791648643,
      "updated": 1791648674
    },
    {
      "id": "6aca63a10000000000211262",
      "text": "\t\t深夜にすごく合ってる",
      "userId": "660605441655f300254ac7c2",
      "created": 1791648674,
      "updated": 1791648704
    },
    {
      "id": "6aca63bf0000000000211263",
      "text": "\t\t\t[朝が嫌いな私の歌]を作るくらい朝が大嫌いなすいちゃんである",
      "userId": "660605441655f300254ac7c2",
      "created": 1791648704,
      "updated": 1791650061
    },
    {
      "id": "6aca66990000000000211264",
      "text": "\t\t\t\t[Stellar Stellar]",
      "userId": "660605441655f300254ac7c2",
      "created": 1791649434,
      "updated": 1791650062
    },
    {
      "id": "6aca63810000000000211260",
      "text": "",
      "userId": "660605441655f300254ac7c2",
      "created": 1791648642,
      "updated": 1791648642
    },
    {
      "id": "6acaa74a000000000013906e",
      "text": "[suto3.icon]",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791665995,
      "updated": 1791665997
    },
    {
      "id": "6acaa74d000000000013906f",
      "text": " #2026-10-10",
      "userId": "5b5e7121417cf700145b98c2",
      "created": 1791665997,
      "updated": 1791666008
    },
    {
      "id": "6acaa7560000000000139070",
