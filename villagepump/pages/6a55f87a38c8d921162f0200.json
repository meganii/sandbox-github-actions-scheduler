      "text": "[https://lh3.googleusercontent.com/a/ACg8ocLEHvPSxS3x-GqIuebKv6GWd2Lg4DoaYM0nWirI05oD9eD2dECU=s96-c#.png]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1784019068,
      "updated": 1784019068
    },
    {
      "id": "6a55f87b0000000000048605",
      "text": "kama pona!",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1784019068,
      "updated": 1784019084
    },
    {
      "id": "6a55f87b0000000000048608",
      "text": "",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1784019068,
      "updated": 1784019098
    },
    {
      "id": "6a55f89b0000000000048612",
      "text": " はすてといいます",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1784019100,
      "updated": 1784019111
    },
    {
      "id": "6a55f8e80000000000048614",
      "text": " [FlMML on HTML5]からここを見つけて面白そうだったので来ました",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1784019177,
      "updated": 1784019241
    },
    {
      "id": "6a55f9290000000000048615",
      "text": " 常に[多趣味]です",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1784019243,
      "updated": 1784036593
    },
    {
      "id": "6a55f9340000000000048616",
      "text": "  今特に興味あるのが、Rust(プログラミング言語)、ギター演奏、MML、[トキポナ]あたり？",
      "userId": "5c30ba88e98efe0017e5172d",
      "created": 1784019253,
      "updated": 1784036576
    },
    {
      "id": "6a55fa5d0000000000048618",
      "text": "   特にといってもこれ以外もガンガン気になりますが…w",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1784019552,
      "updated": 1784019587
    },
    {
      "id": "6a55f87b000000000004860c",
      "text": " よろしくお願いします！",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1784019068,
      "updated": 1787290430
    },
    {
      "id": "6a55f87b000000000004860f",
      "text": "",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1784019068,
      "updated": 1784019068
    },
    {
      "id": "6a877afd0000000000c974dd",
      "text": "リンク",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1787263741,
      "updated": 1787263741
    },
    {
      "id": "6a877afd0000000000c974de",
      "text": " [VRChat https://vrchat.com/home/user/usr_698a6517-8490-437a-8d57-5c6d536b1696]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1787263741,
      "updated": 1787263741
    },
    {
      "id": "6a877afd0000000000c974df",
      "text": " [不和 https://discord.com/users/1108690853997850675]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1787263741,
      "updated": 1787263741
    },
    {
      "id": "6a877afd0000000000c974e0",
      "text": " [GitHub https://github.com/h45te]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1787263741,
      "updated": 1787263741
    },
    {
      "id": "6a877afd0000000000c974e1",
      "text": " [Twitter https://twitter.com/h45te_]",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1787263741,
      "updated": 1787263741
    },
    {
      "id": "6a877afe0000000000c974e2",
      "text": "",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1787263742,
      "updated": 1787263744
    },
    {
      "id": "6a969d3700000000003ce2dd",
      "text": "code:style.css",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255544,
      "updated": 1788255554
    },
    {
      "id": "6a969d4300000000003ce2df",
      "text": " /* ============================================================",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255555,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2e0",
      "text": "    2026/08/32 ― 崩壊する日記",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2e1",
      "text": "    縦軸: 行が下にいくほど壊れ方の種類が増える（累積12段）",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2e2",
      "text": "    横軸: インデントが深いほど余計に壊れる",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2e3",
      "text": "    ============================================================ */",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2e4",
      "text": " @keyframes g-slice {",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2e5",
      "text": "   0%, 9%, 12%, 54%, 57%, 100% { clip-path: inset(0 0 0 0); transform: none; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2e6",
      "text": "   10% { clip-path: inset(22% 0 58% 0); transform: translateX(-14px); }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2e7",
      "text": "   55% { clip-path: inset(68% 0 12% 0); transform: translateX(9px); }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2e8",
      "text": " }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2e9",
      "text": " @keyframes g-spin { to { transform: rotate(360deg); } }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2ea",
      "text": " @keyframes g-drift {",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2eb",
      "text": "   0%, 100% { transform: translate(0, 0) rotate(0deg); }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2ec",
      "text": "   33% { transform: translate(6px, -3px) rotate(1.2deg); }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2ed",
      "text": "   66% { transform: translate(-5px, 4px) rotate(-1.6deg); }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2ee",
      "text": " }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2ef",
      "text": " @keyframes g-blink {",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2f0",
      "text": "   0%, 47%, 53%, 100% { opacity: 1; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2f1",
      "text": "   50% { opacity: .12; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2f2",
      "text": " }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2f3",
      "text": " @keyframes g-boom {",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2f4",
      "text": "   0% { transform: translate(0, 0) rotate(0deg) scale(1); opacity: 1; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2f5",
      "text": "   7% { transform: translate(var(--bx, 0px), var(--by, -30px)) rotate(var(--br, 90deg)) scale(1.4); opacity: 1; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2f6",
      "text": "   100% { transform: translate(calc(var(--bx, 0px) * 1.6), 94vh) rotate(calc(var(--br, 90deg) * 7)) scale(.65); opacity: 0; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2f7",
      "text": " }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2f8",
      "text": " /* 題が「2026/08/32」に完全一致するページだけ（10文字。11文字目が無いことも確認） */",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2f9",
      "text": " .page:has(.line-title .char-index.c-0[data-char=\"2\"]):has(.line-title .char-index.c-1[data-char=\"0\"]):has(.line-title .char-index.c-2[data-char=\"2\"]):has(.line-title .char-index.c-3[data-char=\"6\"]):has(.line-title .char-index.c-4[data-char=\"/\"]):has(.line-title .char-index.c-5[data-char=\"0\"]):has(.line-title .char-index.c-6[data-char=\"8\"]):has(.line-title .char-index.c-7[data-char=\"/\"]):has(.line-title .char-index.c-8[data-char=\"3\"]):has(.line-title .char-index.c-9[data-char=\"2\"]):not(:has(.line-title .char-index.c-10)) {",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2fa",
      "text": "   /* ---------- 縦軸 1: 5行目〜 色相がずれる ---------- */",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2fb",
      "text": "   & .lines .line:nth-child(n+5) .text { filter: hue-rotate(25deg) saturate(1.6); }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2fc",
      "text": "   /* ---------- 縦軸 2: 9行目〜 文字が少しずつ大きくなる ---------- */",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2fd",
      "text": "   & .lines .line:nth-child(n+9) .text { font-size: 1.05em; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2fe",
      "text": "   & .lines .line:nth-child(n+17) .text { font-size: 1.12em; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce2ff",
      "text": "   & .lines .line:nth-child(n+25) .text { font-size: 1.22em; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce300",
      "text": "   & .lines .line:nth-child(n+33) .text { font-size: 1.38em; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce301",
      "text": "   & .lines .line:nth-child(n+41) .text { font-size: 1.60em; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce302",
      "text": "   /* ---------- 縦軸 3: 13行目〜 RGB が分離する ---------- */",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce303",
      "text": "   & .lines .line:nth-child(n+13) .text {",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce304",
      "text": "     text-shadow: 1.5px 0 rgba(255,0,80,.85), -1.5px 0 rgba(0,255,255,.85);",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce305",
      "text": "   }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce306",
      "text": "   /* ---------- 縦軸 4: 17行目〜 文字が1字ずつ傾く ---------- */",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce307",
      "text": "   & .lines .line:nth-child(n+17) .char-index {",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce308",
      "text": "     display: inline-block;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce309",
      "text": "     transform: rotate(var(--r, 0deg)) translateY(var(--y, 0));",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce30a",
      "text": "   }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce30b",
      "text": "   & .char-index:nth-child(3n) { --r: 13deg; --y: -2px; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce30c",
      "text": "   & .char-index:nth-child(5n) { --r: -21deg; --y: 3px; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce30d",
      "text": "   & .char-index:nth-child(7n) { --r: 97deg; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce30e",
      "text": "   & .char-index:nth-child(11n) { --r: 180deg; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce30f",
      "text": "   /* ---------- 縦軸 5: 21行目〜 アイコンが回り始める ---------- */",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce310",
      "text": "   & .lines .line:nth-child(n+21) img.icon { animation: g-spin 2.3s linear infinite; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce311",
      "text": "   & .lines .line:nth-child(n+37) img.icon { animation: g-spin .7s steps(6) infinite reverse; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce312",
      "text": "   /* ---------- 縦軸 6: 25行目〜 行が斜めに歪む ---------- */",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce313",
      "text": "   & .lines .line:nth-child(n+25) .text { display: inline-block; transform: skewX(-7deg); }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce314",
      "text": "   /* ---------- 縦軸 7: 29行目〜 行がスライスしてちぎれる ---------- */",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce315",
      "text": "   & .lines .line:nth-child(n+29) { animation: g-slice 3.7s steps(1) infinite; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce316",
      "text": "   /* ---------- 縦軸 8: 33行目〜 ノイズ帯が重なる ---------- */",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce317",
      "text": "   & .lines .line:nth-child(n+33) { position: relative; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce318",
      "text": "   & .lines .line:nth-child(n+33)::after {",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce319",
      "text": "     content: \"▒▓█░▒█▓░▒▓█░█▒▓░▒█▓░▒▓█░\";",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce31a",
      "text": "     position: absolute; inset: 0; overflow: hidden;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce31b",
      "text": "     pointer-events: none;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce31c",
      "text": "     font-family: monospace; letter-spacing: -1px;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce31d",
      "text": "     opacity: .3; mix-blend-mode: difference;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce31e",
      "text": "   }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce31f",
      "text": "   /* ---------- 縦軸 9: 37行目〜 特定の文字が化ける ---------- */",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce320",
      "text": "   & .lines .line:nth-child(n+37) .char-index[data-char=\"の\"],",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce321",
      "text": "   & .lines .line:nth-child(n+37) .char-index[data-char=\"た\"],",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce322",
      "text": "   & .lines .line:nth-child(n+37) .char-index[data-char=\"い\"] {",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce323",
      "text": "     color: transparent; position: relative;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce324",
      "text": "   }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce325",
      "text": "   & .lines .line:nth-child(n+37) .char-index[data-char=\"の\"]::after,",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce326",
      "text": "   & .lines .line:nth-child(n+37) .char-index[data-char=\"た\"]::after,",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce327",
      "text": "   & .lines .line:nth-child(n+37) .char-index[data-char=\"い\"]::after {",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce328",
      "text": "     content: \"█\"; position: absolute; left: 0; top: 0;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce329",
      "text": "     color: #c0392b; pointer-events: none;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce32a",
      "text": "   }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce32b",
      "text": "   /* ---------- 縦軸 10: 41行目〜 行ごと回転して重なる ---------- */",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce32c",
      "text": "   & .lines .line:nth-child(n+41) .text { transform: skewX(-7deg) rotate(2.5deg); }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce32d",
      "text": "   & .lines .line:nth-child(4n+43) .text { transform: skewX(9deg) rotate(-4deg); }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce32e",
      "text": "   /* ---------- 縦軸 11: 45行目〜 画像が溶解し、色が反転する ---------- */",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce32f",
      "text": "   & .lines .line:nth-child(n+45) .text { filter: invert(1) hue-rotate(180deg) contrast(1.4); }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce330",
      "text": "   & .lines .line:nth-child(n+45) img.image,",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce331",
      "text": "   & .lines .line:nth-child(n+45) img.gyazo {",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce332",
      "text": "     filter: blur(1.5px) contrast(6) saturate(2.5) hue-rotate(140deg);",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce333",
      "text": "     transform: scaleX(-1) rotate(1.5deg);",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce334",
      "text": "     image-rendering: pixelated;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce335",
      "text": "   }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce336",
      "text": "   /* ---------- 縦軸 12: 49行目〜 文字が爆発して画面の下へ落ちる ---------- */",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce337",
      "text": "   & .lines .line:nth-child(n+49) .char-index {",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce338",
      "text": "     display: inline-block;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce339",
      "text": "     animation: g-boom 4.5s cubic-bezier(.2,.7,.4,1) var(--d, 0s) infinite both;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce33a",
      "text": "   }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce33b",
      "text": "   & .lines .line:nth-child(n+49) .char-index:nth-child(6n+1) { --bx: -52px; --by: -34px; --br: -160deg; --d: 0s; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce33c",
      "text": "   & .lines .line:nth-child(n+49) .char-index:nth-child(6n+2) { --bx: 38px; --by: -52px; --br: 210deg; --d: .18s; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce33d",
      "text": "   & .lines .line:nth-child(n+49) .char-index:nth-child(6n+3) { --bx: -18px; --by: -22px; --br: 95deg; --d: .36s; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce33e",
      "text": "   & .lines .line:nth-child(n+49) .char-index:nth-child(6n+4) { --bx: 64px; --by: -44px; --br: -260deg; --d: .54s; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce33f",
      "text": "   & .lines .line:nth-child(n+49) .char-index:nth-child(6n+5) { --bx: -70px; --by: -16px; --br: 140deg; --d: .72s; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce340",
      "text": "   & .lines .line:nth-child(n+49) .char-index:nth-child(6n) { --bx: 12px; --by: -60px; --br: -80deg; --d: .90s; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce341",
      "text": "   /* ============================================================",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce342",
      "text": "      横軸: インデントの深さ（.indent に当てるので縦軸とは干渉しない）",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce343",
      "text": "      ============================================================ */",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce344",
      "text": "   & .lines .line:has(.indent-mark > .char-index:nth-child(1) .pad) .indent { filter: saturate(1.9) hue-rotate(-30deg); }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce345",
      "text": "   & .lines .line:has(.indent-mark > .char-index:nth-child(2) .pad) .indent { animation: g-drift 6.1s ease-in-out infinite; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce346",
      "text": "   & .lines .line:has(.indent-mark > .char-index:nth-child(3) .pad) { animation: g-slice 2.3s steps(1) infinite; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce347",
      "text": "   & .lines .line:has(.indent-mark > .char-index:nth-child(4) .pad) .char-index {",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce348",
      "text": "     display: inline-block;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce349",
      "text": "     animation: g-boom 5.5s ease-in var(--d, .2s) infinite both;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce34a",
      "text": "   }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce34b",
      "text": "   /* 箇条書きの点が膨らむ / 存在しないページへのリンクが明滅する */",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce34c",
      "text": "   & .lines .line:nth-child(n+21) .dot { transform: scale(2.2); background: #c0392b; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce34d",
      "text": "   & .lines a.empty-page-link { animation: g-blink 1.9s steps(1) infinite; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce34e",
      "text": "   /* ============================================================",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce34f",
      "text": "      保険: 編集中の行と、マウスを乗せた行だけ正気に戻る",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce350",
      "text": "      書き込みに来た人が操作不能にならないための逃げ道。必ず最後に置く",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce351",
      "text": "      ============================================================ */",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce352",
      "text": "   & .lines .line.cursor-line,",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce353",
      "text": "   & .lines .line:hover {",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce354",
      "text": "     animation: none !important;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce355",
      "text": "     transform: none !important;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce356",
      "text": "     filter: none !important;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce357",
      "text": "   }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce358",
      "text": "   & .lines .line.cursor-line .text, & .lines .line:hover .text,",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce359",
      "text": "   & .lines .line.cursor-line .indent, & .lines .line:hover .indent,",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce35a",
      "text": "   & .lines .line.cursor-line .char-index, & .lines .line:hover .char-index {",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce35b",
      "text": "     animation: none !important;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce35c",
      "text": "     transform: none !important;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce35d",
      "text": "     filter: none !important;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce35e",
      "text": "     text-shadow: none !important;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce35f",
      "text": "     font-size: 1em !important;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce360",
      "text": "     color: inherit !important;",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce361",
      "text": "   }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce362",
      "text": "   & .lines .line.cursor-line .char-index::after, & .lines .line:hover .char-index::after,",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce363",
      "text": "   & .lines .line.cursor-line::after, & .lines .line:hover::after { content: none !important; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce364",
      "text": "   & .lines .line.cursor-line img.icon, & .lines .line:hover img.icon { animation: none !important; }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d4700000000003ce365",
      "text": " }",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255559,
      "updated": 1788255559
    },
    {
      "id": "6a969d3800000000003ce2de",
      "text": "",
      "userId": "69e54ae539ab55540cb29eba",
      "created": 1788255544,
      "updated": 1788255544
    },
