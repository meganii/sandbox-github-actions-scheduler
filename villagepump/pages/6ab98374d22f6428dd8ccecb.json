      "text": "[sta.icon]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1790586676,
      "updated": 1790586676
    },
    {
      "id": "6aba2f3200000000008b13ce",
      "text": "\t[GitHubのStarした人一覧が見れなくなった]",
      "userId": "5a4873ab2e26fb001479d3a9",
      "created": 1790586676,
      "updated": 1790586683
    },
    {
      "id": "6aba622800000000002364a8",
